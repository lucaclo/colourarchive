---
import Layout from '../layouts/Layout.astro';
import { readManifest } from '../lib/manifest';
import { oklchCss } from '../lib/color';
import { GENRES, GENRE_LABEL } from '../lib/types';

// Prerenderable: `astro build` bakes a static snapshot of the archive (from the
// current manifest) into dist/client — hostable read-only anywhere — while the
// upload page + API stay server-only for local ingest. `astro dev` still renders
// live, so newly-added photos show without a rebuild.
export const prerender = true;

const SITE_TITLE = 'Colour Archive';
// Every film frame was shot on this camera; its scanner EXIF is meaningless, so
// we label film with the real camera instead.
const FILM_CAMERA = 'Leica Mini Zoom';
// Static build (npm run export:static): the read-only, host-anywhere snapshot.
// Server-only chrome (Add/Remove, Inspiration, original-image zoom) is hidden.
const STATIC = import.meta.env.PUBLIC_STATIC === 'true';
const manifest = await readManifest();
const hasPhotos = manifest.count > 0;

const mediumCounts = { film: 0, digital: 0 };
for (const ch of manifest.chapters) for (const p of ch.photos) mediumCounts[p.medium]++;
const showMediumToggle = hasPhotos && mediumCounts.film > 0 && mediumCounts.digital > 0;

// Genre dropdown: only offer genres that actually appear, and only when there
// are at least two to choose between (else there's nothing to filter).
const genreCounts: Record<string, number> = { street: 0, portrait: 0, landscape: 0, architecture: 0 };
for (const ch of manifest.chapters) for (const p of ch.photos) if (p.genre) genreCounts[p.genre]++;
const presentGenres = GENRES.filter((g) => genreCounts[g] > 0);
const showGenreDrop = hasPhotos && presentGenres.length >= 2;

// --- Insights: quiet stats about the archive ---------------------------------
const allPhotos = manifest.chapters.flatMap((c) => c.photos);
const digitalPhotos = allPhotos.filter((p) => p.medium === 'digital'); // film EXIF is scanner noise
const topCounts = (values: Array<string | undefined>, n = 6): Array<[string, number]> => {
  const m = new Map<string, number>();
  for (const v of values) if (v) m.set(v, (m.get(v) ?? 0) + 1);
  return [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, n);
};
const insights = {
  cameras: topCounts(allPhotos.map((p) => (p.medium === 'film' ? FILM_CAMERA : p.exif.camera))),
  lenses: topCounts(digitalPhotos.map((p) => p.exif.lens)),
  focals: topCounts(digitalPhotos.map((p) => p.exif.focalLength)),
  years: topCounts(digitalPhotos.map((p) => (p.exif.capturedAt ? new Date(p.exif.capturedAt).getFullYear().toString() : undefined)))
    .sort((a, b) => Number(a[0]) - Number(b[0])),
  maxChapter: Math.max(1, ...manifest.chapters.map((c) => c.photos.length)),
};

// The stamp at the foot of the scroll. This page is prerendered, so on the
// published site this is the moment the build ran — which is the moment it was
// published, the deploy following its build by seconds. On the Mac the page
// renders per request and it reads as today, which is also true.
//
// It is here because the failure it answers is silence: a site ten days behind
// looks exactly like a current one. `npm run drift` asks the same question from
// the terminal; this is the version a reader can see.
const builtAt = new Date();
const builtLabel = builtAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const titleFg = (L: number) => (L > 0.62 ? '#0a0a0a' : '#f6f6f4');
const roman = (n: number) =>
  ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV','XV','XVI'][n] ?? String(n + 1);
---

<Layout title={SITE_TITLE}>
  <header class="topbar" id="topbar">
    <button type="button" class="brand" id="to-top" aria-label="Back to the cover">{SITE_TITLE}</button>
    {showMediumToggle && (
      <nav class="view-toggle" id="view-toggle" aria-label="Medium">
        <button type="button" data-view="all" aria-pressed="true">All</button>
        <button type="button" data-view="digital">Digital</button>
        <button type="button" data-view="film">Film</button>
      </nav>
    )}
    {showGenreDrop && (
      <div class="genre-drop" id="genre-drop">
        <button type="button" class="genre-btn" id="genre-btn" aria-haspopup="listbox" aria-expanded="false">
          <span id="genre-current">All genres</span>
          <svg class="genre-caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <ul class="genre-menu" id="genre-menu" role="listbox" aria-label="Genre" hidden>
          <li role="option" data-genre="all" aria-selected="true" tabindex="-1">All genres</li>
          {presentGenres.map((g) => (
            <li role="option" data-genre={g} aria-selected="false" tabindex="-1">{GENRE_LABEL[g]}</li>
          ))}
        </ul>
      </div>
    )}
    <span class="topbar-right">
      {/* Inspiration is the editing workbench — it writes to disk and shows
          other people's photographs pending credit, so it stays on the Mac.
          Scout reads nothing of yours and now prerenders, so it ships. */}
      {!STATIC && <a href="/inspiration">Inspiration</a>}
      <a href="/scout">Scout</a>
      <button type="button" class="ghost" id="insights-btn" aria-haspopup="dialog">Insights</button>
      {/* "/ Remove" is dropped on a phone: the full label pushed this link off
          the right edge of the screen, taking the way in to the upload page
          with it. The page it opens says "Add & remove" either way. */}
      {!STATIC && <a href="/upload">Add<span class="wide-only"> / Remove</span></a>}
    </span>
  </header>

  <section class="cover">
    <p class="cover-kicker">
      {hasPhotos ? `${manifest.count} · ${manifest.chapters.length} chapters` : 'In colour'}
    </p>
    <h1>{SITE_TITLE}</h1>
    <p class="cover-sub">Follow the colour</p>
    {hasPhotos && (
      <nav class="cover-spectrum" id="cover-spectrum" aria-label="Chapters">
        {manifest.chapters.map((ch, ci) => (
          <button class="cs-seg" data-jump={ci} style={`background:${oklchCss(ch.oklch)};flex-grow:${Math.max(1, ch.photos.length)}`} aria-label={`Jump to ${ch.name}`} />
        ))}
      </nav>
    )}
    {hasPhotos && <span class="scroll-hint">Scroll ↓</span>}
  </section>

  {
    hasPhotos ? (
      <main class="archive">
        {manifest.chapters.map((ch, ci) => {
          const bg = oklchCss(ch.oklch);
          const fg = titleFg(ch.oklch.L);
          return (
            <>
              <section
                class="chapter-gap"
                style={`--chapter-bg:${bg};--chapter-fg:${fg};color:${fg}`}
                aria-label={`Chapter ${ch.name}`}
              >
                <p class="chapter-index">Chapter {roman(ci)}</p>
                <h2 class="chapter-title">{ch.name}</h2>
                <span class="chapter-swatch" style={`background:${bg}`} />
              </section>
              <div class="collage">
                {ch.photos.map((p, pi) => {
                  const largest = p.derivatives[p.derivatives.length - 1];
                  // The first photographs of the first chapter are what the
                  // reader actually waits for. `loading="lazy"` on an image that
                  // is already in the viewport does not stop it loading, but it
                  // does push it behind everything else the browser has queued —
                  // and on a phone that is the difference between the archive
                  // opening on a picture and opening on a coloured rectangle.
                  const aboveFold = ci === 0 && pi < 3;
                  const avifSet = p.derivatives.map((d) => `${d.avif} ${d.width}w`).join(', ');
                  // EXIF is shown only for DIGITAL photos — film scans carry the
                  // scanner's EXIF (wrong camera, wrong date, no real location).
                  const exifAttrs = p.medium === 'digital' ? {
                    'data-captured': p.exif.capturedAt ?? '',
                    'data-camera': p.exif.camera ?? '',
                    'data-lens': p.exif.lens ?? '',
                    'data-focal': p.exif.focalLength ?? '',
                    'data-aperture': p.exif.aperture ?? '',
                    'data-shutter': p.exif.shutter ?? '',
                    'data-iso': p.exif.iso ? String(p.exif.iso) : '',
                    'data-location': p.exif.location ? `${p.exif.location.lat}, ${p.exif.location.lon}` : '',
                  } : { 'data-camera': FILM_CAMERA }; // film: label the real camera, hide scanner EXIF
                  return (
                    <figure
                      class="frame"
                      style={`--frame-bg:${oklchCss(p.oklch)};aspect-ratio:${p.width}/${p.height}`}
                      data-id={p.id}
                      data-chapter={ch.name}
                      data-ci={ci}
                      data-oklch={`L ${p.oklch.L} · C ${p.oklch.C} · H ${p.oklch.H}°`}
                      data-file={p.filename}
                      data-medium={p.medium}
                      data-genre={p.genre ?? ''}
                      data-full={largest.avif}
                      data-set={avifSet}
                      data-orig={STATIC ? '' : `/api/original/${p.id}`}
                      data-wash={oklchCss({ L: Math.min(0.16, ch.oklch.L), C: ch.oklch.C * 0.45, H: ch.oklch.H })}
                      data-ratio={(p.height / p.width).toFixed(4)}
                      {...exifAttrs}
                    >
                      <img class="ph" src={p.placeholder} alt="" aria-hidden="true" />
                      {/* Every derivative is AVIF, so <picture>/<source> had no
                          alternative format to offer — it only cost two nodes a
                          frame and left the fallback <img> pinned to the 2000w
                          file. srcset on the <img> gives the same negotiation. */}
                      <img
                        class="photo"
                        srcset={avifSet}
                        sizes="(max-width: 980px) 50vw, 33vw"
                        src={largest.avif}
                        width={p.width}
                        height={p.height}
                        loading={aboveFold ? 'eager' : 'lazy'}
                        fetchpriority={aboveFold ? 'high' : undefined}
                        decoding="async"
                        alt=""
                      />
                    </figure>
                  );
                })}
              </div>
            </>
          );
        })}
      </main>

      <!-- Outside <main>: .archive becomes a grid in the pinch-to-zoom overview,
           and a footer inside it would be dealt a cell in the colour wall. -->
      <footer class="colophon">
        <p>{manifest.count} photographs · {manifest.chapters.length} chapters</p>
        <p>Snapshot built <time datetime={builtAt.toISOString()}>{builtLabel}</time></p>
      </footer>

      <aside class="meta" id="meta" aria-live="polite" hidden>
        <dl id="meta-body" />
        <p class="hint">Press <kbd>i</kbd> to hide</p>
      </aside>

      <!-- Colour-spectrum scrubber: one segment per chapter, click to jump. -->
      <nav class="spectrum" id="spectrum" aria-label="Jump to colour">
        {manifest.chapters.map((ch, ci) => (
          <button
            class="spectrum-seg"
            data-jump={ci}
            style={`background:${oklchCss(ch.oklch)};flex-grow:${Math.max(1, ch.photos.length)}`}
            aria-label={`${ch.name} — ${ch.photos.length} photo${ch.photos.length === 1 ? '' : 's'}`}
          >
            <span class="spectrum-label">{ch.name}</span>
          </button>
        ))}
      </nav>

      <!-- Immersive single-photo view: full, uncropped, with metadata. -->
      <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photograph">
        <span class="lb-count" id="lb-count" aria-live="polite"></span>
        <!-- Every keyboard shortcut also needs a control: on the iPad — the
             device this is actually read on — `i` and `p` are unreachable, so
             details and the slideshow were invisible features there. -->
        <div class="lb-tools">
          <button class="lb-tool" id="lb-play" aria-label="Play slideshow" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path class="tri" d="M5 3.2v9.6l8-4.8z" fill="currentColor"/><g class="pause" fill="currentColor"><rect x="4.4" y="3.4" width="2.6" height="9.2" rx="0.6"/><rect x="9" y="3.4" width="2.6" height="9.2" rx="0.6"/></g></svg>
          </button>
          <button class="lb-tool" id="lb-info" aria-label="Photo details" aria-pressed="false">i</button>
          <button class="lb-tool lb-close" id="lb-close" aria-label="Close">×</button>
        </div>
        <button class="lb-nav lb-prev" id="lb-prev" aria-label="Previous">‹</button>
        <div class="lb-stage">
          <img id="lb-img" alt="" sizes="100vw" />
        </div>
        <button class="lb-nav lb-next" id="lb-next" aria-label="Next">›</button>
        <div class="lb-caption" id="lb-caption"></div>
        <p class="lb-hint">← →  ·  scroll to zoom  ·  esc</p>
        <span class="lb-progress" aria-hidden="true"></span>
      </div>

      <!-- Insights: a quiet stats overlay. -->
      <div class="insights" id="insights" hidden role="dialog" aria-modal="true" aria-label="Archive insights">
        <div class="insights-inner">
          <button class="insights-close" id="insights-close" aria-label="Close">×</button>
          <h2>Insights</h2>
          <p class="insights-sub">{manifest.count} photographs · {mediumCounts.digital} digital · {mediumCounts.film} film · {manifest.chapters.length} chapters</p>

          <section>
            <h3>Colour</h3>
            <ul class="stat">
              {manifest.chapters.map((ch) => (
                <li>
                  <span class="sw" style={`background:${oklchCss(ch.oklch)}`} />
                  <span class="lbl">{ch.name}</span>
                  <span class="barwrap"><span class="bar" style={`width:${(ch.photos.length / insights.maxChapter) * 100}%;background:${oklchCss(ch.oklch)}`} /></span>
                  <span class="num">{ch.photos.length}</span>
                </li>
              ))}
            </ul>
          </section>

          {insights.years.length > 0 && (
            <section>
              <h3>Year <span class="only">digital</span></h3>
              <ul class="stat">
                {insights.years.map(([k, n]) => (
                  <li><span class="lbl">{k}</span><span class="barwrap"><span class="bar" style={`width:${(n / Math.max(...insights.years.map((y) => y[1]))) * 100}%`} /></span><span class="num">{n}</span></li>
                ))}
              </ul>
            </section>
          )}

          {insights.cameras.length > 0 && (
            <section><h3>Camera</h3>
              <ul class="stat">{insights.cameras.map(([k, n]) => (<li><span class="lbl">{k}</span><span class="num">{n}</span></li>))}</ul>
            </section>
          )}
          {insights.lenses.length > 0 && (
            <section><h3>Lens <span class="only">digital</span></h3>
              <ul class="stat">{insights.lenses.map(([k, n]) => (<li><span class="lbl">{k}</span><span class="num">{n}</span></li>))}</ul>
            </section>
          )}
          {insights.focals.length > 0 && (
            <section><h3>Focal length <span class="only">digital</span></h3>
              <ul class="stat">{insights.focals.map(([k, n]) => (<li><span class="lbl">{k}</span><span class="num">{n}</span></li>))}</ul>
            </section>
          )}
        </div>
      </div>
    ) : (
      <section class="empty">
        <p class="empty-lead">Nothing here yet.</p>
        <a class="empty-cta" href="/upload">Begin →</a>
      </section>
    )
  }
</Layout>

<style>
  .empty {
    min-height: 60svh;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    text-align: center; padding: 6vh 8vw; gap: 1rem;
  }
  .empty-lead { color: var(--muted); font-size: 1.05rem; line-height: 1.6; margin: 0; max-width: 34rem; }
  .empty-cta { color: var(--fg); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  /* The end of the scroll. Quiet enough that arriving at it still feels like
     the last photograph, loud enough to answer "is this current?". The deep
     bottom padding keeps the last line clear of the metadata panel, which is
     fixed to the bottom-right corner whenever it is open. */
  .colophon {
    display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
    padding: 5rem 8vw 6.5rem;
    font-family: var(--font-label);
    font-size: 0.7rem; letter-spacing: 0.06em;
    color: var(--muted); text-align: center;
  }
  .colophon p { margin: 0; }
  kbd { font-family: var(--font-label); border: 1px solid var(--border); border-radius: 4px; padding: 0 4px; font-size: 0.72em; }
</style>

<script is:inline>
  // Own scroll restoration so a reload always lands on the cover (see restorePos).
  try { history.scrollRestoration = 'manual'; } catch (e) {}

  // --- One scroll listener for the page, coalesced into a single frame -----
  // The top bar, the ambient wash and the position-save each used to listen
  // separately, so a single scroll ran three callbacks on three different
  // schedules — each reading geometry after another had written style, which is
  // the classic layout thrash. They register here and run once per frame, in
  // order: all reads, then all writes.
  const scrollTasks = [];
  let scrollQueued = false;
  const runScrollTasks = () => {
    scrollQueued = false;
    const y = window.scrollY;
    for (const task of scrollTasks) task(y);
  };
  addEventListener('scroll', () => {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(runScrollTasks);
  }, { passive: true });

  // --- Top bar auto-hide on scroll down, reveal on scroll up --------------
  const bar = document.getElementById('topbar');
  let lastY = window.scrollY;
  scrollTasks.push((y) => {
    if (Math.abs(y - lastY) < 4) return;           // ignore rubber-band jitter
    bar.classList.toggle('hidden', y > lastY && y > 90);
    lastY = y;
  });

  // --- Fade photos in on load --------------------------------------------
  const markLoaded = (img) => {
    if (img.complete) img.classList.add('loaded');
    else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
  };
  document.querySelectorAll('.frame img.photo').forEach(markLoaded);

  // --- Track the frame nearest the viewport centre (reliable in a masonry);
  //     drive the ambient background wash from it. Also used by `i` and `f`. --
  let current = null;
  const specSegs = Array.from(document.querySelectorAll('#spectrum .spectrum-seg'));
  const setAmbient = (f) => {
    if (!f) return;
    if (f.dataset.wash) document.body.style.backgroundColor = f.dataset.wash;
    const ci = f.dataset.ci;                       // mark the current chapter on the scrubber
    for (const s of specSegs) s.classList.toggle('active', s.dataset.jump === ci);
  };
  const frameEls = Array.from(document.querySelectorAll('.frame'));
  // Frames currently passing the filter. Kept as a list rather than testing
  // `offsetParent === null` per frame per tick: that property read forces a
  // style+layout flush, so the old loop could trigger one per photo, per frame.
  let trackable = frameEls;
  /** The same set, for membership tests — rebuilt with it, never separately. */
  let trackableSet = new Set(frameEls);

  // Which frames are on screen, maintained by the browser rather than recomputed
  // by us.
  //
  // This used to measure every frame in the archive on every scroll frame to
  // find the one nearest the middle, discarding the off-screen ones *after*
  // measuring them. `getBoundingClientRect` forces layout, so at sixty frames a
  // second with seventy photographs that is four thousand forced layouts a
  // second to answer a question about two or three of them — and it gets worse
  // as the archive grows, which is the wrong direction for a scroll to scale in.
  //
  // An IntersectionObserver already knows the answer. Measuring only what it
  // reports makes the cost proportional to what is visible, which is a small
  // constant, rather than to the size of the archive.
  const onScreen = new Set();

  const trackCurrent = () => {
    const mid = window.innerHeight / 2;
    let best = null, bd = Infinity;
    for (const f of onScreen) {
      if (!trackableSet.has(f)) continue;          // hidden by the genre/medium filter
      const r = f.getBoundingClientRect();
      const d = Math.abs((r.top + r.bottom) / 2 - mid);
      if (d < bd) { bd = d; best = f; }
    }
    if (best && best !== current) { current = best; setAmbient(best); }
  };

  const visibility = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) onScreen.add(entry.target);
        else onScreen.delete(entry.target);
      }
      // A frame can enter or leave the viewport without the page scrolling — a
      // filter change, a repack — so the wash is refreshed here too rather than
      // waiting for a scroll event that may never come.
      trackCurrent();
    },
    // A margin either side, so the set is already correct by the time a frame
    // reaches the middle and does not churn at the exact moment of handover.
    { rootMargin: '100px 0px' },
  );
  for (const f of frameEls) visibility.observe(f);

  scrollTasks.push(trackCurrent);
  trackCurrent();

  // ======================================================================
  //  Aspect-balanced masonry — contiguous-run columns (preserves gradient)
  // ======================================================================
  const collageEls = Array.from(document.querySelectorAll('.collage'));

  // Filter state lives here (above the layout) so the masonry can repack around
  // it: when a genre/medium is chosen, only the passing frames get columns, so
  // the archive stays densely packed instead of leaving the hidden ones' gaps.
  let view = 'all';    // film / digital / all
  let genre = 'all';   // street / portrait / landscape / architecture / all
  const frameShown = (f) =>
    (view === 'all' || f.dataset.medium === view) &&
    (genre === 'all' || f.dataset.genre === genre);

  // Split an ordered list of item heights into <=k CONTIGUOUS groups with the
  // most equal total heights (classic linear partition; binary search on the
  // max column height). Returns an array of groups, each an array of indices.
  const balancedColumns = (heights, k) => {
    const n = heights.length;
    k = Math.min(k, n);
    if (k <= 1) return [heights.map((_, i) => i)];
    const feasible = (cap) => {
      let groups = 1, sum = 0;
      for (const h of heights) {
        if (h > cap) return false;
        if (sum + h > cap) { groups++; sum = h; if (groups > k) return false; } else sum += h;
      }
      return true;
    };
    let lo = Math.max(...heights), hi = heights.reduce((a, b) => a + b, 0);
    for (let it = 0; it < 60 && hi - lo > 1e-4; it++) {
      const mid = (lo + hi) / 2;
      if (feasible(mid)) hi = mid; else lo = mid;
    }
    const cap = hi;
    const cols = []; let cur = [], sum = 0;
    for (let i = 0; i < n; i++) {
      const h = heights[i];
      // Open a new column when this item would overflow the balanced cap.
      // (The binary search guarantees this yields at most k columns.)
      if (cur.length && sum + h > cap + 1e-6) { cols.push(cur); cur = []; sum = 0; }
      cur.push(i); sum += h;
    }
    if (cur.length) cols.push(cur);
    return cols;
  };

  const layoutCollage = (collage, k) => {
    // Capture the full gradient order ONCE; reuse it on every relayout so a
    // filter never scrambles or loses frames (columns hold contiguous runs, so
    // this cached list stays the true order no matter how it's later grouped).
    if (!collage._frames) collage._frames = Array.from(collage.querySelectorAll('.frame'));
    const all = collage._frames;
    if (all.length === 0) return;
    const shown = all.filter(frameShown);
    const hidden = all.filter((f) => !frameShown(f));
    const frag = document.createDocumentFragment();
    if (shown.length) {
      const heights = shown.map((f) => parseFloat(f.dataset.ratio) || 1);
      const groups = balancedColumns(heights, Math.min(k, shown.length));
      for (const group of groups) {
        const col = document.createElement('div');
        col.className = 'mcol';
        for (const idx of group) col.appendChild(shown[idx]); // moves the real element
        frag.appendChild(col);
      }
    }
    // Park filtered-out frames in a hidden holder so they're retained (and their
    // originals still available) until the filter clears.
    if (hidden.length) {
      const stash = document.createElement('div');
      stash.className = 'mcol-stash'; stash.hidden = true;
      for (const f of hidden) stash.appendChild(f);
      frag.appendChild(stash);
    }
    collage.replaceChildren(frag);
    collage.classList.add('balanced');
  };

  const colCount = () =>
    parseInt(getComputedStyle(document.documentElement).getPropertyValue('--cols'), 10) || 3;
  let lastK = 0;
  const layoutAll = () => {
    lastK = colCount();
    for (const c of collageEls) layoutCollage(c, lastK);
    trackable = frameEls.filter(frameShown);   // recomputed once, not per scroll
    trackableSet = new Set(trackable);
    // The visible set is unchanged by a repack, but which of it is *trackable*
    // is not, so the current frame may no longer be one — re-pick now instead of
    // leaving the wash on a photograph the filter has just hidden.
    trackCurrent();
  };
  layoutAll();
  let resizeTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      // The layout only depends on the column count. Mobile browsers fire
      // resize every time the URL bar slides, and re-running the masonry there
      // moved every photo in the DOM for nothing — visible jank mid-scroll.
      if (colCount() === lastK) return;
      layoutAll();
    }, 150);
  });

  // --- Press `i` to reveal / hide metadata for the photo in view ----------
  const panel = document.getElementById('meta');
  const body = document.getElementById('meta-body');
  const FIELDS = [
    ['file', 'File'], ['chapter', 'Chapter'], ['captured', 'Captured'],
    ['camera', 'Camera'], ['lens', 'Lens'], ['focal', 'Focal length'],
    ['aperture', 'Aperture'], ['shutter', 'Shutter'], ['iso', 'ISO'],
    ['location', 'Location'], ['oklch', 'Dominant colour'],
  ];
  const mapLink = (coords) => {
    const [lat, lon] = coords.split(',').map((s) => s.trim());
    const a = document.createElement('a');
    a.href = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=14/${lat}/${lon}`;
    a.target = '_blank'; a.rel = 'noopener noreferrer';
    a.textContent = `${coords} ↗`;
    return a;
  };
  const render = (f) => {
    body.innerHTML = '';
    for (const [key, label] of FIELDS) {
      const v = f.dataset[key];
      if (!v) continue;
      const dt = document.createElement('dt'); dt.textContent = label;
      const dd = document.createElement('dd');
      if (key === 'location') dd.append(mapLink(v));
      else dd.textContent = key === 'captured' ? new Date(v).toLocaleString() : v;
      body.append(dt, dd);
    }
  };
  addEventListener('keydown', (e) => {
    if (e.key !== 'i' || e.metaKey || e.ctrlKey || e.altKey) return;
    const lbEl = document.getElementById('lightbox');
    if (lbEl && !lbEl.hidden) return; // lightbox handles its own `i`
    if (!panel) return;
    if (panel.classList.contains('show')) { panel.classList.remove('show'); panel.hidden = true; }
    else if (current) { render(current); panel.hidden = false; requestAnimationFrame(() => panel.classList.add('show')); }
  });

  // --- Pinch to zoom out: photos merge into a colour wall / hue gradient ---
  const archive = document.querySelector('.archive');
  const OVER = 0.55;          // below this, enter the merged overview
  let z = 1;                  // 1 = reading, 0 = fully merged
  const applyZoom = () => {
    if (!archive) return;
    if (z < OVER) {
      archive.classList.add('overview');
      const t = (OVER - z) / OVER;                 // 0..1 through the overview
      archive.style.setProperty('--ocols', String(Math.round(5 + t * 11))); // 5..16
    } else {
      archive.classList.remove('overview');
    }
  };
  const setZoom = (nz) => { z = Math.min(1, Math.max(0, nz)); applyZoom(); };

  const lbActive = () => { const el = document.getElementById('lightbox'); return el && !el.hidden; };

  // Trackpad pinch arrives as a wheel event with ctrlKey set.
  addEventListener('wheel', (e) => {
    if (!e.ctrlKey || lbActive()) return; // lightbox open → its own image zoom
    e.preventDefault();
    setZoom(z + (e.deltaY > 0 ? -0.05 : 0.05));
  }, { passive: false });

  // Touch pinch.
  let startDist = 0, startZ = 1;
  const dist = (t) => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
  addEventListener('touchstart', (e) => {
    if (e.touches.length === 2 && !lbActive()) { startDist = dist(e.touches); startZ = z; }
  }, { passive: true });
  addEventListener('touchmove', (e) => {
    if (e.touches.length === 2 && startDist && !lbActive()) {
      e.preventDefault();
      setZoom(startZ + (dist(e.touches) - startDist) / 480);
    }
  }, { passive: false });

  // Persist zoom so returning from Add/Remove keeps your place (see below).
  const baseSetZoom = setZoom;
  const setZoomPersist = (nz) => { baseSetZoom(nz); savePos(); };

  // Click a tile: in the merged view, fall back into reading there; otherwise
  // open it in the immersive single-photo view.
  archive?.addEventListener('click', (e) => {
    const frame = e.target.closest('.frame');
    if (!frame) return;
    if (archive.classList.contains('overview')) {
      setZoomPersist(1);
      frame.scrollIntoView({ block: 'center' });
    } else {
      openLightbox(frame);
    }
  });

  // ======================================================================
  //  Immersive single-photo view (lightbox)
  // ======================================================================
  const frames = Array.from(document.querySelectorAll('.frame'));
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCap = document.getElementById('lb-caption');
  let lbIndex = -1;

  // --- Overlay plumbing: scroll lock + focus, shared by lightbox & insights --
  // Without the lock, a touch drag scrolled the archive underneath the overlay,
  // so closing it dropped you somewhere you'd never chosen to be.
  let modalDepth = 0;
  const lockScroll = () => {
    if (modalDepth++ > 0) return;
    const sbw = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.setProperty('--sbw', sbw + 'px');
    document.body.classList.add('modal-open');
  };
  const unlockScroll = () => {
    modalDepth = Math.max(0, modalDepth - 1);
    if (modalDepth === 0) document.body.classList.remove('modal-open');
  };
  // Keyboard focus must not wander into the archive behind an open overlay.
  let returnFocus = null;
  const FOCUSABLE = 'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])';
  const captureFocus = (root, first) => {
    returnFocus = document.activeElement;
    (first || root.querySelector(FOCUSABLE))?.focus({ preventScroll: true });
  };
  const releaseFocus = () => {
    const el = returnFocus; returnFocus = null;
    if (el && el.isConnected) el.focus({ preventScroll: true });
  };
  const trapTab = (e, root) => {
    if (e.key !== 'Tab') return;
    const items = Array.from(root.querySelectorAll(FOCUSABLE)).filter((el) => el.offsetParent !== null);
    if (!items.length) return;
    const first = items[0], last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  };

  const captionHtml = (f) => {
    const bits = [];
    const add = (label, key) => { const v = f.dataset[key]; if (v) bits.push(`<span class="k">${label}</span> ${key === 'captured' ? new Date(v).toLocaleDateString() : v}`); };
    add('', 'chapter'); add('·', 'captured'); add('·', 'camera'); add('·', 'lens');
    add('·', 'focal'); add('·', 'aperture'); add('·', 'shutter'); add('·', 'iso');
    const loc = f.dataset.location;
    if (loc) {
      const [lat, lon] = loc.split(',').map((s) => s.trim());
      bits.push(`<span class="k">·</span> <a href="https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=14/${lat}/${lon}" target="_blank" rel="noopener noreferrer">${loc} ↗</a>`);
    }
    return bits.join(' &nbsp; ');
  };

  // Where you are in the sequence, counted over what the filter actually shows.
  const lbCount = document.getElementById('lb-count');
  const updateCount = (i) => {
    if (!lbCount) return;
    let seen = 0, total = 0;
    for (let j = 0; j < frames.length; j++) {
      if (!visibleFrame(frames[j])) continue;
      total++;
      if (j === i) seen = total;
    }
    lbCount.textContent = total > 1 ? `${seen} / ${total}` : '';
  };

  // Warm the neighbours you're about to reach for. Arrow-stepping through the
  // archive used to show a blank stage while a 2000px AVIF decoded.
  const preloadNeighbours = (i) => {
    for (const dir of [1, -1]) {
      for (let j = i + dir; j >= 0 && j < frames.length; j += dir) {
        if (!visibleFrame(frames[j])) continue;
        const img = new Image();
        img.sizes = '100vw';
        if (frames[j].dataset.set) img.srcset = frames[j].dataset.set;
        img.src = frames[j].dataset.full || '';
        break;
      }
    }
  };
  function showAt(i) {
    if (i < 0 || i >= frames.length) return;
    lbIndex = i;
    const f = frames[i];
    // srcset here too: a phone opening a photo full-screen should not pull the
    // 2000px file when the 1280 is already more than its screen can show.
    lbImg.srcset = f.dataset.set || '';
    lbImg.src = f.dataset.full || f.querySelector('img.photo')?.currentSrc || '';
    lbCap.innerHTML = captionHtml(f);
    lbImg.alt = `${f.dataset.chapter || ''} — ${f.dataset.file || 'photograph'}`;
    currentOrig = f.dataset.orig || '';
    origSwapped = false;
    resetZoom();
    updateCount(i);
    if (!lb.hidden) syncUrl();
    requestAnimationFrame(() => preloadNeighbours(i));
  }
  function openLightbox(frame) {
    const i = frames.indexOf(frame);
    if (i < 0) return;
    showAt(i);
    lb.hidden = false;
    lockScroll();
    requestAnimationFrame(() => lb.classList.add('show'));
    captureFocus(lb, document.getElementById('lb-close'));
    syncUrl(true);   // a history entry, so Back / edge-swipe closes the photo
  }
  // fromHistory: we're already unwinding the entry pushed on open. Otherwise go
  // back first and let popstate come round to close — that way the viewer and
  // the URL can never disagree about whether a photo is open.
  function closeLightbox(fromHistory) {
    if (!fromHistory && lbPushed) { lbPushed = false; history.back(); return; }
    lbPushed = false;
    lb.classList.remove('show');
    stopSlideshow();
    unlockScroll();
    releaseFocus();
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    // syncUrl once hidden, so the #photo hash clears — including the case where
    // you arrived on a deep link and closed with Back, which would otherwise
    // leave a URL that reopens the photo on reload.
    setTimeout(() => { lb.hidden = true; resetZoom(); syncUrl(); }, 200);
  }
  addEventListener('popstate', () => { if (lbOpen()) closeLightbox(true); });

  // --- Zoom + pan the opened photo ---------------------------------------
  const MAXZ = 6;
  let zScale = 1, zX = 0, zY = 0, dragging = false, dragSX = 0, dragSY = 0;
  let currentOrig = '', origSwapped = false;
  // Past 1.6×, swap the derivative for the untouched original — pixel-sharp.
  const maybeLoadOriginal = () => {
    if (origSwapped || zScale < 1.6 || !currentOrig) return;
    origSwapped = true;
    const full = new Image();
    full.onload = () => { if (origSwapped) { lbImg.srcset = ''; lbImg.src = currentOrig; } };
    full.src = currentOrig;
  };
  const applyImgT = () => {
    lbImg.style.transform = `translate(${zX}px, ${zY}px) scale(${zScale})`;
    lbImg.classList.toggle('zoomed', zScale > 1);
  };
  function resetZoom() { zScale = 1; zX = 0; zY = 0; lbImg.style.transition = ''; applyImgT(); }
  function zoomAt(cx, cy, factor) {
    const ns = Math.min(MAXZ, Math.max(1, zScale * factor));
    if (ns === zScale) return;
    const r = lbImg.getBoundingClientRect();
    const ox = cx - (r.left + r.width / 2);
    const oy = cy - (r.top + r.height / 2);
    const k = ns / zScale;
    zX -= ox * (k - 1);
    zY -= oy * (k - 1);
    zScale = ns;
    if (zScale === 1) { zX = 0; zY = 0; }
    lbImg.style.transition = 'transform 120ms ease';
    applyImgT();
    maybeLoadOriginal();
  }
  // Wheel (mouse) and trackpad pinch (ctrl+wheel) both zoom the image.
  lb.addEventListener('wheel', (e) => {
    if (lb.hidden) return;
    e.preventDefault(); e.stopPropagation();
    zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.18 : 1 / 1.18);
  }, { passive: false });
  lbImg.addEventListener('dblclick', (e) => {
    e.preventDefault();
    if (zScale > 1) resetZoom(); else zoomAt(e.clientX, e.clientY, 2.6);
  });
  // Drag to pan when zoomed.
  lbImg.addEventListener('pointerdown', (e) => {
    if (zScale <= 1) return;
    dragging = true; dragSX = e.clientX - zX; dragSY = e.clientY - zY;
    lbImg.classList.add('grabbing');
    lbImg.setPointerCapture(e.pointerId);
  });
  lbImg.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    zX = e.clientX - dragSX; zY = e.clientY - dragSY;
    lbImg.style.transition = 'none';
    applyImgT();
  });
  const endDrag = () => { dragging = false; lbImg.classList.remove('grabbing'); lbImg.style.transition = ''; };
  lbImg.addEventListener('pointerup', endDrag);
  lbImg.addEventListener('pointercancel', endDrag);
  // Two-finger pinch on touch devices.
  const active = new Map();
  let pinchStart = 0, pinchScale0 = 1;
  lbImg.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'touch') return;
    active.set(e.pointerId, e);
    if (active.size === 2) {
      const [a, b] = [...active.values()];
      pinchStart = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
      pinchScale0 = zScale;
    }
  });
  lbImg.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'touch' || !active.has(e.pointerId)) return;
    active.set(e.pointerId, e);
    if (active.size === 2 && pinchStart) {
      const [a, b] = [...active.values()];
      const d = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
      const cx = (a.clientX + b.clientX) / 2, cy = (a.clientY + b.clientY) / 2;
      const target = Math.min(MAXZ, Math.max(1, pinchScale0 * (d / pinchStart)));
      zoomAt(cx, cy, target / zScale);
    }
  });
  const dropPointer = (e) => { active.delete(e.pointerId); if (active.size < 2) pinchStart = 0; };
  lbImg.addEventListener('pointerup', dropPointer);
  lbImg.addEventListener('pointercancel', dropPointer);

  // --- Swipe: sideways for the next photo, down to dismiss -----------------
  // The arrows are a mouse affordance. On a touch screen the photograph itself
  // is the control, and the drag has to track your finger — a gesture that only
  // reports its verdict on release feels broken until it works.
  let swiping = false, swSX = 0, swSY = 0, swDX = 0, swDY = 0;
  lb.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'touch' || zScale > 1 || active.size > 1) return;
    if (e.target.closest('button')) return;               // let the controls be tapped
    swiping = true; swSX = e.clientX; swSY = e.clientY; swDX = 0; swDY = 0;
    lbImg.style.transition = 'none';
  });
  lb.addEventListener('pointermove', (e) => {
    if (!swiping) return;
    if (active.size > 1 || zScale > 1) { swiping = false; lbImg.style.transition = ''; applyImgT(); return; }
    swDX = e.clientX - swSX;
    swDY = e.clientY - swSY;
    const down = Math.max(0, swDY);
    lbImg.style.transform = `translate(${swDX}px, ${down}px) scale(${1 - Math.min(0.1, down / 1600)})`;
    lb.style.opacity = String(1 - Math.min(0.55, down / 620));   // the archive shows through as you pull down
  });
  const endSwipe = () => {
    if (!swiping) return;
    swiping = false;
    lb.style.opacity = '';
    if (swDY > 90 && swDY > Math.abs(swDX)) { closeLightbox(); resetZoom(); return; }
    if (Math.abs(swDX) > 55 && Math.abs(swDX) > Math.abs(swDY)) { swDX < 0 ? lbNext() : lbPrev(); return; }
    resetZoom();   // not far enough — spring back
  };
  lb.addEventListener('pointerup', endSwipe);
  lb.addEventListener('pointercancel', endSwipe);
  const visibleFrame = (f) => f.offsetParent !== null; // display:none → offsetParent null
  const lbStep = (dir) => {
    stopSlideshow(); // manual navigation ends any running slideshow
    for (let i = lbIndex + dir; i >= 0 && i < frames.length; i += dir) {
      if (visibleFrame(frames[i])) { showAt(i); return; }
    }
  };
  const lbNext = () => lbStep(1);
  const lbPrev = () => lbStep(-1);
  const lbOpen = () => lb && !lb.hidden;

  document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lb-next')?.addEventListener('click', lbNext);
  document.getElementById('lb-prev')?.addEventListener('click', lbPrev);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });

  // --- Slideshow: auto-advance through the (filtered) photos, wrapping -----
  let slideTimer = 0;
  const nextVisibleWrap = () => {
    for (let step = 0; step < frames.length; step++) {
      const i = (lbIndex + 1 + step) % frames.length;
      if (visibleFrame(frames[i])) { showAt(i); return; }
    }
  };
  const playBtn = document.getElementById('lb-play');
  function stopSlideshow() {
    if (!slideTimer) return;
    clearInterval(slideTimer); slideTimer = 0;
    lb.classList.remove('playing');
    playBtn?.setAttribute('aria-pressed', 'false');
    playBtn?.setAttribute('aria-label', 'Play slideshow');
  }
  function toggleSlideshow() {
    if (slideTimer) { stopSlideshow(); return; }
    lb.classList.add('playing');
    playBtn?.setAttribute('aria-pressed', 'true');
    playBtn?.setAttribute('aria-label', 'Pause slideshow');
    slideTimer = setInterval(nextVisibleWrap, 4000);
  }
  // Details and the slideshow, reachable without a keyboard.
  const infoBtn = document.getElementById('lb-info');
  const toggleDetails = () => {
    const on = lb.classList.toggle('details');
    infoBtn?.setAttribute('aria-pressed', String(on));
  };
  infoBtn?.addEventListener('click', toggleDetails);
  playBtn?.addEventListener('click', toggleSlideshow);

  // --- Deep-linkable URL: #photo=<id> when the viewer is open --------------
  let lbPushed = false;
  function syncUrl(push) {
    const base = location.pathname + (view !== 'all' ? `?view=${view}` : '');
    const hash = lbOpen() && lbIndex >= 0 ? `#photo=${frames[lbIndex].dataset.id}` : '';
    // One entry for "a photo is open" — stepping through photos rewrites it, so
    // Back returns to the archive rather than replaying every frame you saw.
    if (push) { history.pushState({ lb: 1 }, '', base + hash); lbPushed = true; }
    else history.replaceState(history.state, '', base + hash);
  }

  function toggleFullscreen() {
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    else lb?.requestFullscreen?.().catch(() => {});
  }

  // ======================================================================
  //  Keyboard: chapter jump, fullscreen, and lightbox navigation
  // ======================================================================
  const gaps = Array.from(document.querySelectorAll('.chapter-gap'));
  // Lazy loading assumes you arrive by scrolling. Jump straight to a chapter and
  // you land on a wall of placeholders that only start loading once you're
  // there. Promote that chapter (and the next) to eager the moment you aim at
  // it, so the photographs are in flight before the scroll finishes.
  const wakeChapter = (ci) => {
    for (const c of [collageEls[ci], collageEls[ci + 1]]) {
      if (!c) continue;
      for (const img of c.querySelectorAll('img.photo[loading="lazy"]')) img.loading = 'eager';
    }
  };
  const chapterAt = (y) => {
    let ci = 0;
    for (let i = 0; i < gaps.length; i++) if (gaps[i].offsetTop <= y) ci = i;
    return ci;
  };
  const scrollToY = (top) => {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top, behavior: still ? 'auto' : 'smooth' });
  };
  const jumpChapter = (dir) => {
    const y = window.scrollY + 4;
    const tops = gaps.map((g) => g.offsetTop);
    let target = null;
    if (dir > 0) target = tops.find((t) => t > y + 8);
    else { const prev = tops.filter((t) => t < y - 8); target = prev.length ? prev[prev.length - 1] : 0; }
    if (target == null) return;
    wakeChapter(chapterAt(target));
    scrollToY(target);
  };

  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || e.target.isContentEditable) return;
    // Space/Enter belong to whatever control has focus — swallowing Space to
    // jump a chapter meant a keyboard user could never press the focused button.
    if ((e.key === ' ' || e.key === 'Enter') && (tag === 'button' || tag === 'a' || tag === 'li')) return;

    if (insightsOpen()) {
      trapTab(e, insightsEl);
      if (e.key === 'Escape') { e.preventDefault(); closeInsights(); }
      return;
    }

    if (lbOpen()) {
      trapTab(e, lb);
      if (e.key === 'Escape') { e.preventDefault(); closeLightbox(); }
      else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); lbNext(); }
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); lbPrev(); }
      else if (e.key === 'f') { e.preventDefault(); toggleFullscreen(); }
      else if (e.key === 'i') { e.preventDefault(); toggleDetails(); }
      else if (e.key === 'p' || e.key === ' ') { e.preventDefault(); toggleSlideshow(); }
      return;
    }

    // Archive view.
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); jumpChapter(1); }
    else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); jumpChapter(-1); }
    else if (e.key === 'f') { e.preventDefault(); if (current) openLightbox(current); }
  });

  // ======================================================================
  //  Insights overlay
  // ======================================================================
  const insightsEl = document.getElementById('insights');
  const insightsOpen = () => insightsEl && !insightsEl.hidden;
  const openInsights = () => {
    if (!insightsEl || insightsOpen()) return;
    insightsEl.hidden = false;
    lockScroll();
    requestAnimationFrame(() => insightsEl.classList.add('show'));
    captureFocus(insightsEl, document.getElementById('insights-close'));
  };
  const closeInsights = () => {
    if (!insightsEl || !insightsOpen()) return;
    insightsEl.classList.remove('show');
    unlockScroll();
    releaseFocus();
    setTimeout(() => { insightsEl.hidden = true; }, 200);
  };
  document.getElementById('insights-btn')?.addEventListener('click', openInsights);
  document.getElementById('insights-close')?.addEventListener('click', closeInsights);
  insightsEl?.addEventListener('click', (e) => { if (e.target === insightsEl) closeInsights(); });

  // ======================================================================
  //  Colour-spectrum scrubber: click a segment to jump to that chapter
  // ======================================================================
  const jumpTo = (i) => {
    const ci = Number(i);
    const gap = gaps[ci];
    if (!gap) return;
    wakeChapter(ci);
    scrollToY(gap.offsetTop);
  };
  document.getElementById('to-top')?.addEventListener('click', () => scrollToY(0));
  document.getElementById('spectrum')?.addEventListener('click', (e) => {
    const seg = e.target.closest('[data-jump]'); if (seg) jumpTo(seg.dataset.jump);
  });
  document.getElementById('cover-spectrum')?.addEventListener('click', (e) => {
    const seg = e.target.closest('[data-jump]'); if (seg) jumpTo(seg.dataset.jump);
  });

  // ======================================================================
  //  Film / Digital / All view toggle
  // ======================================================================
  const archiveEl = document.querySelector('.archive');
  const viewToggle = document.getElementById('view-toggle');
  const collages = Array.from(document.querySelectorAll('.collage'));
  // view / genre / frameShown are declared above the layout code so the masonry
  // can repack around the active filter.
  const countVisible = (collage) =>
    Array.from(collage.querySelectorAll('.frame')).filter(frameShown).length;

  function refreshEmpties() {
    collages.forEach((c, i) => {
      const has = countVisible(c) > 0;
      c.style.display = has ? '' : 'none';
