      if (gap && gap.classList.contains('chapter-gap')) gap.style.display = has ? '' : 'none';
      const seg = document.querySelector(`.spectrum-seg[data-jump="${i}"]`);
      if (seg) seg.style.display = has ? '' : 'none';
    });
  }
  function applyView(v) {
    view = v;
    if (archiveEl) {
      archiveEl.classList.remove('view-all', 'view-film', 'view-digital');
      archiveEl.classList.add('view-' + v);
    }
    layoutAll();      // repack visible frames into tight columns
    refreshEmpties();
    viewToggle?.querySelectorAll('[data-view]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.view === v)));
    savePos();
  }
  viewToggle?.addEventListener('click', (e) => {
    const b = e.target.closest('[data-view]');
    if (b) applyView(b.dataset.view);
  });

  // ---- Genre dropdown ---------------------------------------------------
  const genreDrop = document.getElementById('genre-drop');
  const genreBtn = document.getElementById('genre-btn');
  const genreMenu = document.getElementById('genre-menu');
  const genreCurrent = document.getElementById('genre-current');
  const openGenre = () => { if (!genreMenu) return; genreMenu.hidden = false; genreBtn?.setAttribute('aria-expanded', 'true'); genreDrop?.classList.add('open'); };
  const closeGenre = () => { if (!genreMenu) return; genreMenu.hidden = true; genreBtn?.setAttribute('aria-expanded', 'false'); genreDrop?.classList.remove('open'); };
  function applyGenre(g, label) {
    genre = g;
    if (archiveEl) {
      archiveEl.classList.remove('genre-all', 'genre-street', 'genre-portrait', 'genre-landscape', 'genre-architecture');
      archiveEl.classList.add('genre-' + g);
    }
    if (genreCurrent) genreCurrent.textContent = g === 'all' ? 'All genres' : label;
    genreMenu?.querySelectorAll('[data-genre]').forEach((li) =>
      li.setAttribute('aria-selected', String(li.dataset.genre === g)));
    layoutAll();      // repack visible frames into tight columns
    refreshEmpties();
    savePos();
  }
  genreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    genreMenu?.hidden ? openGenre() : closeGenre();
  });
  genreMenu?.addEventListener('click', (e) => {
    const li = e.target.closest('[data-genre]');
    if (!li) return;
    applyGenre(li.dataset.genre, li.textContent.trim());
    closeGenre();
  });
  document.addEventListener('click', (e) => {
    if (genreDrop && !genreDrop.contains(e.target)) closeGenre();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && genreMenu && !genreMenu.hidden) { closeGenre(); genreBtn?.focus(); }
  });

  // ======================================================================
  //  Remember scroll + zoom + view, so returning from Add/Remove keeps place
  // ======================================================================
  const POS_KEY = 'ca-pos';
  let saveTimer = 0;
  function savePos() {
    try { sessionStorage.setItem(POS_KEY, JSON.stringify({ y: window.scrollY, view })); } catch (err) {}
  }
  scrollTasks.push(() => {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(savePos, 160);
  });
  addEventListener('pagehide', savePos);
  // Restore your place ONLY when you navigate back (e.g. from Add/Remove) — a
  // plain reload starts fresh at the cover, so the look is always consistent.
  // Zoom-out is never restored.
  (function restorePos() {
    let navType = 'navigate';
    try { navType = performance.getEntriesByType('navigation')[0]?.type || 'navigate'; } catch (e) {}
    if (navType === 'reload') { try { sessionStorage.removeItem(POS_KEY); } catch (e) {} return; }
    try {
      const raw = sessionStorage.getItem(POS_KEY);
      if (!raw) return;
      const { y, view: sv } = JSON.parse(raw);
      if (sv && sv !== 'all' && viewToggle) applyView(sv);
      if (typeof y === 'number' && y > 0) requestAnimationFrame(() => window.scrollTo(0, y));
    } catch (err) {}
  })();

  // --- Apply deep-linked state from the URL (shareable) -------------------
  (function initFromUrl() {
    const params = new URLSearchParams(location.search);
    const v = params.get('view');
    if ((v === 'film' || v === 'digital') && viewToggle) applyView(v);
    const m = location.hash.match(/photo=([a-f0-9]+)/i);
    if (m) {
      const target = frames.find((f) => f.dataset.id === m[1]);
      if (target) requestAnimationFrame(() => openLightbox(target));
    }
  })();
</script>
