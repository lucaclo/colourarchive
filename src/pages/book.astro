  .book-print { display: inline-flex; align-items: center; gap: var(--sp-2); margin-left: auto; }
  .book-bleed {
    display: inline-flex; align-items: center; gap: var(--sp-2); cursor: pointer;
    min-height: var(--hit); padding: 0 var(--sp-3); border-radius: var(--r-pill); color: var(--secondary);
  }
  .book-bleed:hover { background: var(--fill); }
  .book-bleed:has(input:checked) { color: var(--fg); }
  .book-bleed:has(input:focus-visible) { outline: 2px solid var(--mark); outline-offset: 2px; }
  .book-bleed input { accent-color: var(--fg); width: 18px; height: 18px; margin: 0; }
  .book-pdf, .book-blank {
    appearance: none; cursor: pointer; font: inherit; color: var(--fg); background: var(--fill); border: 0;
    min-height: var(--hit); padding: 0 var(--sp-4); border-radius: var(--r-pill); font-weight: 600;
  }
  .book-pdf:hover, .book-blank:hover { background: var(--fill-hover); }
  /* The one primary action. */
  .book-pdf { background: var(--fg); color: var(--bg); padding: 0 var(--sp-5); }
  .book-pdf:hover { background: color-mix(in oklab, var(--fg) 86%, var(--bg)); }
  .book-pdf:active { transform: scale(0.97); }
  .book-pdf:disabled { cursor: progress; background: var(--fill); color: var(--secondary); }
  .book-blank { font-weight: 500; }
  .book-blank[aria-pressed='true'] { background: var(--fill-active); font-weight: 600; }
  .book-pdf-status { color: var(--secondary); }
  @media (max-width: 640px) {
    .book-print { margin-left: 0; }
    #book-trim { max-width: 100%; }
    .book-check { white-space: normal; }
  }

  .book-spreads { margin-bottom: 4rem; }
  .book-pagectl {
    position: sticky; top: calc(env(safe-area-inset-top, 0px) + 0.75rem); z-index: 5;
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2) var(--sp-3);
    padding: var(--sp-2) var(--sp-3); margin-bottom: var(--sp-5); border-radius: var(--r-md);
    background: var(--surface-2); border: 1px solid var(--glass-edge);
    font-family: var(--font-ui); font-size: var(--t-footnote);
  }
