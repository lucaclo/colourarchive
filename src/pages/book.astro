  .book-seg { display: inline-flex; padding: 3px; border-radius: var(--r-pill); background: var(--fill); }
  .book-seg input { position: absolute; opacity: 0; pointer-events: none; }
  .book-pagectl-note { color: var(--secondary); font-family: var(--font-note); font-style: italic; }
  .book-spread-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: var(--sp-6) var(--sp-5); }
  .bs-spread { display: grid; grid-template-columns: 1fr 1fr; }
  .bs-spread > .bs-page:not(.bs-none) { box-shadow: 0 12px 30px -16px rgb(0 0 0 / 0.7); }
  /* The gutter: a soft fold line on the inside edge of each page. */
  .bs-spread > .bs-page:first-child:not(.bs-none) { box-shadow: inset -6px 0 8px -6px rgb(0 0 0 / 0.18), 0 12px 30px -16px rgb(0 0 0 / 0.7); }
  .bs-spread > .bs-page:last-child:not(.bs-none) { box-shadow: inset 6px 0 8px -6px rgb(0 0 0 / 0.18), 0 12px 30px -16px rgb(0 0 0 / 0.7); }
  .bs-page {
    position: relative; display: block; width: 100%; padding: 0; border: 0; margin: 0; overflow: hidden;
    background: #fff; color: inherit; font: inherit;
  }
  button.bs-page { cursor: pointer; }
  .bs-page.bs-none { background: transparent; box-shadow: none; }
  .bs-page img { position: absolute; object-fit: cover; display: block; }
  .bs-page[aria-pressed='true'] { outline: 2px solid var(--mark); outline-offset: 2px; z-index: 1; }
  .bs-page:focus-visible { outline: 2px solid var(--mark); outline-offset: 2px; z-index: 1; }
  .bs-opener { display: grid; place-items: center; }
  .bs-opener > span:not(.bs-num) { font-family: var(--font-display); font-style: italic; font-size: clamp(0.8rem, 2vw, 1.1rem); }
  .bs-fallback::after { content: ''; position: absolute; left: 10%; right: 10%; bottom: 4%; border-bottom: 1.5px dotted #0a0a0a; opacity: 0.6; }
  .bs-num { position: absolute; bottom: 2%; font-family: var(--font-data); font-size: 9px; color: #0a0a0a; opacity: 0.55; }
  .bs-spread > :first-child .bs-num { left: 4%; }
  .bs-spread > :last-child .bs-num { right: 4%; }
</style>
