    font-family: var(--font-ui); font-size: var(--t-footnote);
  }
  .book-viewtoggle { display: inline-flex; padding: 3px; border-radius: var(--r-pill); background: var(--fill); }
  .book-viewtoggle button, .book-seg label {
    appearance: none; border: 0; cursor: pointer; font: inherit; color: var(--secondary); background: transparent;
