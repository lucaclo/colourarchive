---
import Layout from '../layouts/Layout.astro';
import { readManifest, readStore } from '../lib/manifest';
import { readBookCuration, orderedChaptersWithExclusions, curatedChapters } from '../lib/book';
import { duplicateGroups } from '../lib/duplicates';
import { readNotes } from '../lib/notes';
import { oklchCss, readableInk } from '../lib/color';
import { oklchToHex } from '../lib/colour-search';
import { DEFAULT_TRIM, TRIMS, checkPages, padToEven, paginate, withColophon } from '../lib/book-pages';

export const prerender = false;

const manifest = await readManifest();
const curation = await readBookCuration();
const chapters = orderedChaptersWithExclusions(manifest.chapters, curation);
const includedCount = chapters.reduce((n, ch) => n + ch.photos.filter((p) => !p.excluded).length, 0);
// One divider page per chapter that survives exclusion, plus one plate page
// per included photo — the same count `export:print` actually produces.
const trimId = curation.trim ?? DEFAULT_TRIM;
const pageCount = padToEven(withColophon(
  paginate(
    curatedChapters(manifest.chapters, curation).map((ch) => ({
      key: ch.key, name: ch.name, colour: '', photos: ch.photos.map((p) => ({ id: p.id, width: p.width, height: p.height })),
    })),
    { treatment: curation.layout, blankBefore: curation.blankBefore },
  ),
)).length;
const pageCheck = checkPages(pageCount, TRIMS[trimId]);
const layoutInit = { layout: curation.layout ?? {}, blankBefore: curation.blankBefore ?? [], trim: trimId };
const chapterColour = new Map(manifest.chapters.map((ch) => [ch.key, oklchToHex(ch.oklch)] as const));
const chapterInk = new Map(manifest.chapters.map((ch) => [ch.key, readableInk(ch.oklch)] as const));
// Issue #141: the colours the rhythm strip reads, as "L C H".
const toneOf = (o: { L: number; C: number; H: number }) => `${o.L.toFixed(3)} ${o.C.toFixed(3)} ${o.H.toFixed(1)}`;
const chapterTone = new Map(manifest.chapters.map((ch) => [ch.key, toneOf(ch.oklch)] as const));
// Every chapter, for the per-photo "move to chapter" control — includes
// chapters a move has emptied, so a photo can always be moved back.
const chapterList = manifest.chapters.map((ch) => ({ key: ch.key, name: ch.name }));

// The archive's own notebook (see notes.ts) — why a photo matters, not
// anything measured. Read once here so every cell can show whether it
// already carries one; the editor itself is a single reusable overlay,
// opened from whichever cell's caption was clicked.
const notes = await readNotes();

// Possible bursts/duplicates — see duplicates.ts for why this is scoped per
// chapter and uses an absolute embedding-distance ceiling rather than a
// percentile of the chapter's own spread. Flagged, never acted on
// automatically: the tool has no principled way to judge which frame of a
// burst is the one worth keeping, so it surfaces the group and leaves the
// choice — and the exclude button — to whoever is looking at them.
//
// manifest.json deliberately strips embeddings to keep the rendered page
// lean (see manifest.ts's groupChapters) — they only ever lived in the flat
// store. Read that separately and match back up by id, purely to compute
// the groups below; only each match's key and size (never the vectors
// themselves) make it into the template.
const vectorsById = new Map((await readStore()).map((p) => [p.id, { embedding: p.embedding, clipEmbedding: p.clipEmbedding }] as const));
const dupGroups = duplicateGroups(
  chapters.map((ch) => ({
    key: ch.key,
    photos: ch.photos.map((p) => ({ ...p, ...vectorsById.get(p.id) })),
  })),
);
const dupByPhoto = new Map(dupGroups.flatMap((g) => g.ids.map((id) => [id, { key: g.key, size: g.ids.length }] as const)));
const dupCountByChapter = new Map<string, number>();
for (const g of dupGroups) dupCountByChapter.set(g.chapterKey, (dupCountByChapter.get(g.chapterKey) ?? 0) + 1);

// Same static echo as upload.astro's — see Layout's `accent` prop.
const accent = manifest.chapters[0]
  ? oklchCss({ L: 0.78, C: Math.min(manifest.chapters[0].oklch.C, 0.11), H: manifest.chapters[0].oklch.H })
  : undefined;
---

<Layout title="The book — Colour Archive" accent={accent} tab="book">

  <main class="book-page">
    <header class="book-head">
      {/* Title and where else the book goes on one line; what's in it under the
          title; then the tools, each group with its own job, the one primary
          action last. */}
      <div class="book-titlerow">
        <h1>The book</h1>
        <nav class="book-links" aria-label="The book elsewhere">
          <a href="/book/view" target="_blank" rel="noopener noreferrer" class="book-link" data-cmdk="Share the book" data-cmdk-keywords="view, link">Share<span aria-hidden="true"> ↗</span></a>
          <a href="/book/zine" class="book-link">Magazine</a>
        </nav>
      </div>
      <p class="book-sub"><span id="book-count">{includedCount} of {manifest.count}{chapters.length === 0 ? ` · ${pageCount} pages` : ''}</span></p>
      {chapters.length > 0 && (
        <div class="book-tools">
          <div class="book-viewtoggle" role="group" aria-label="View">
            <button type="button" data-bookview="list" aria-pressed="true" data-cmdk="List view">List</button>
            <button type="button" data-bookview="spreads" aria-pressed="false" data-cmdk="Spreads" data-cmdk-keywords="pages, layout">Spreads</button>
          </div>
          {/* Size, page count and bleed are only needed when printing, so they
              live behind Print rather than in the header all the time. */}
          <span class="book-printwrap">
            <span class="book-pdf-status" id="book-pdf-status" role="status" aria-live="polite"></span>
            <button type="button" class="book-printbtn" id="book-print-open" data-cmdk="Print" data-cmdk-keywords="pdf, export, trim, bleed" aria-expanded="false" aria-controls="book-printpop" data-warn={pageCheck.ok ? '' : '1'}>Print</button>
            <div class="book-printpop" id="book-printpop" hidden role="dialog" aria-label="Print">
              <label class="book-poprow">
                <span>Size</span>
                <select id="book-trim" aria-label="Book size">
                  {Object.entries(TRIMS).map(([id, t]) => <option value={id} selected={id === trimId}>{t.label}</option>)}
                </select>
              </label>
              <span class="book-check" id="book-check" data-ok={pageCheck.ok ? '1' : ''}>{pageCheck.message}</span>
              <label class="book-bleed"><input type="checkbox" id="book-bleed" checked /> Bleed</label>
              {/* Issue #140: the pages that will print soft, before the PDF is made. */}
              <details class="book-soft" id="book-soft" hidden>
                <summary id="book-soft-head"></summary>
                <ul id="book-soft-list"></ul>
              </details>
              <button type="button" class="book-pdf" id="book-pdf">Make PDF</button>
              <div class="book-cover">
                <label class="book-poprow"><span>Spine</span><span><input type="number" id="book-spine" min="0" max="100" step="0.1" inputmode="decimal" aria-label="Spine width in millimetres" /> mm</span></label>
                <button type="button" class="book-cover-btn" id="book-cover">Cover spread PDF</button>
                <span class="book-cover-hint">Back, spine and front in one file. Use your printer’s spine width.</span>
              </div>
              {/* Issue #147: sequence with small prints on the floor, then read the order back. */}
              <div class="book-cover">
                <button type="button" class="book-cover-btn" id="book-workprints">Work prints PDF</button>
                <label class="book-cover-btn book-floor-pick">
                  Read the floor from a photo
                  <input type="file" id="book-floor-file" accept="image/*" capture="environment" hidden />
                </label>
                <span class="book-cover-hint">Cut the prints out, lay them in order with a little space between, photograph them from above.</span>
              </div>
              {/* Issue #158: a card per lens, for the bag. */}
              <div class="book-cover">
                <a class="book-cover-btn book-cards" href="/scout/cards">Hyperfocal cards</a>
                <span class="book-cover-hint">A small table for each of your lenses, to cut out.</span>
              </div>
            </div>
          </span>
        </div>
      )}
    </header>
    <script type="application/json" id="book-layout-init" is:inline set:html={JSON.stringify(layoutInit)} />

    <section class="book-floor" id="book-floor" hidden aria-label="Order read from the floor">
      <p class="book-floor-head" id="book-floor-head"></p>
      <ol class="book-floor-strip" id="book-floor-strip"></ol>
      <div class="book-floor-actions">
        <button type="button" class="book-floor-use" id="book-floor-use">Use this order</button>
        <button type="button" class="book-floor-cancel" id="book-floor-cancel">Leave it</button>
      </div>
    </section>

    <section class="book-spreads" id="book-spreads" hidden aria-label="Spreads">
      <div class="book-pagectl" id="book-pagectl" hidden>
        <span class="book-pagectl-name" id="book-pagectl-name"></span>
        <div class="book-seg" role="radiogroup" aria-label="Page layout" id="book-treatment">
          <label><input type="radio" name="book-treatment" value="border" /> <span>Border</span></label>
          <label><input type="radio" name="book-treatment" value="bleed" /> <span>Full bleed</span></label>
          <label><input type="radio" name="book-treatment" value="pair" /> <span>Two-up</span></label>
        </div>
        <button type="button" class="book-blank" id="book-blank" aria-pressed="false">Blank before</button>
        <span class="book-pagectl-note" id="book-pagectl-note"></span>
        <button type="button" class="book-rhymes-btn" id="book-rhymes-btn" aria-expanded="false" aria-controls="book-rhymes">Rhymes</button>
        <span class="book-ppi" id="book-ppi" hidden>
          <span id="book-ppi-text"></span>
          <button type="button" id="book-ppi-fix" hidden></button>
        </span>
      </div>
      {/* Issue #141: what the photographs here echo, in shape not colour. A list
          to place from; the order is never changed for you. */}
      <div class="book-rhymes" id="book-rhymes" hidden>
        <p class="book-rhymes-head" id="book-rhymes-head"></p>
        <ul class="book-rhymes-list" id="book-rhymes-list"></ul>
      </div>
      {/* Issue #141: one tick per page, its height the page's lightness, its
          colour the page's colour; a mark where neighbouring spreads jolt. */}
      <div class="book-rhythm" id="book-rhythm" role="img" aria-label="The book's rhythm, page by page"></div>
      <p class="book-rhythm-note" id="book-rhythm-note"></p>
      <div class="book-spread-list" id="book-spread-list"></div>
    </section>

    {
      chapters.length === 0 ? (
        <p class="book-empty">Nothing in the archive yet.</p>
      ) : (
        <div id="book-chapters">
          <template id="book-chapter-options">
            {chapterList.map((c) => <option value={c.key}>{c.name}</option>)}
          </template>
          {chapters.map((ch) => (
            <section class="book-chapter" data-chapter={ch.key} data-name={ch.name} data-colour={chapterColour.get(ch.key)} data-ink={chapterInk.get(ch.key)} data-tone={chapterTone.get(ch.key)}>
              <h2 class="book-chapter-head">
                {ch.name}
                <span class="book-chapter-count" data-chapter-count={ch.key}>
                  {ch.photos.filter((p) => !p.excluded).length}/{ch.photos.length}
                </span>
                {
                  (dupCountByChapter.get(ch.key) ?? 0) > 0 && (
                    <button type="button" class="book-dup-summary" title="Compare them side by side">
                      {dupCountByChapter.get(ch.key)} possible duplicate{dupCountByChapter.get(ch.key) === 1 ? '' : 's'}
                    </button>
                  )
                }
              </h2>
              <ul class="book-grid" data-chapter-list={ch.key}>
                {ch.photos.map((p) => {
                  const dup = dupByPhoto.get(p.id);
                  return (
                    <li
                      class="book-cell"
                      tabindex="0"
                      data-id={p.id}
                      data-home={p.chapter}
                      data-stem={p.filename.split('.')[0]}
                      data-excluded={p.excluded ? '1' : ''}
                      data-dup-group={dup?.key}
                      data-note={notes[p.id] ?? ''}
                      data-tone={toneOf(p.oklch)}
                      data-swatch={oklchToHex(p.oklch)}
                      data-w={p.width}
                      data-h={p.height}
                      data-large={(p.derivatives[1] ?? p.derivatives[p.derivatives.length - 1]).avif}
                      style={`aspect-ratio:${p.width}/${p.height}`}
                      aria-label={`${p.filename} — drag the handle or use arrow keys to move within this chapter`}
                    >
                      <img src={p.derivatives[0].avif} alt="" loading="lazy" />
                      <button
                        type="button"
                        class="book-exclude"
                        data-exclude={p.id}
                        aria-pressed={p.excluded}
                        title={p.excluded ? 'Include in the book' : 'Leave out of the book'}
                      >
                        {p.excluded ? '+' : '×'}
                      </button>
                      <span class="book-handle" aria-hidden="true" title="Drag to reorder">⠿⠿</span>
                      <div class="book-foot">
                        <button type="button" class="book-caption" data-note-btn={p.id} title={notes[p.id] ? 'Edit note' : 'Add a note'}>
                          {notes[p.id] && <span class="book-note-mark" aria-hidden="true">✎</span>}
                          {p.filename.split('.')[0]}
                        </button>
                        {
                          dup && (
                            <button
                              type="button"
                              class="book-dup"
                              data-dup-keep={p.id}
                              data-dup-group={dup.key}
                              title={`${dup.size} similar shots, probably the same moment: compare them and keep one`}
                              aria-label={`Compare ${dup.size} similar shots`}
                            >
                              ⧉{dup.size}
                            </button>
                          )
                        }
                        {/* Only the current chapter until it's touched; the rest come
                            from #book-chapter-options then (see the script). */}
                        <select class="book-move" data-move={p.id} title="Move to a different chapter" aria-label={`Chapter for ${p.filename.split(".")[0]}`}>
                          <option value={ch.key} selected>{ch.name}</option>
                        </select>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </main>

  <div class="book-undo" id="book-undo" hidden role="status">
    <span id="book-undo-text"></span>
    <button type="button" id="book-undo-btn">Undo</button>
  </div>

  <!-- Survey: a burst side by side before keeping one (Narrative's Survey
       Mode, Lightroom's Survey view). Hold a photo to look closer: every
       photo zooms to the same spot together. -->
  <dialog class="survey" id="book-survey" aria-labelledby="survey-title">
    <header class="survey-head">
      <h2 id="survey-title" class="survey-title">Similar shots</h2>
      <span class="survey-hint">Hold to look closer</span>
      <button type="button" class="survey-close" id="survey-close" aria-label="Close">×</button>
    </header>
    <div class="survey-row" id="survey-row"></div>
  </dialog>

  <div class="book-savebar" id="book-savebar" hidden>
    <span id="book-savebar-text">Unsaved changes</span>
    <button type="button" class="ghost" id="book-save">Save</button>
  </div>

  <!-- The notebook: why a photo matters, not anything measured. One reusable
       overlay rather than an inline field per cell — a cell is too small to
       hold a comfortable textarea, and this way the same editor works from
       any chapter without duplicating markup 90-odd times. -->
  <div class="book-noteedit" id="book-noteedit" hidden>
    <div class="book-noteedit-body">
      <img id="book-noteedit-img" alt="" />
      <div class="book-noteedit-form">
        <p class="book-noteedit-name" id="book-noteedit-name"></p>
        <textarea id="book-noteedit-text" placeholder="Note" rows="5"></textarea>
        <p class="book-noteedit-error" id="book-noteedit-error" role="alert" hidden></p>
        <div class="book-noteedit-actions">
          {/* Issue #149: say it instead of typing it. Written down on the Mac. */}
          <button type="button" class="ghost book-voice" id="book-noteedit-voice" aria-label="Hold to speak a note">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
            <span id="book-noteedit-voice-label">Hold to speak</span>
          </button>
          <span class="book-noteedit-spacer"></span>
          <button type="button" class="ghost" id="book-noteedit-cancel">Cancel</button>
          <button type="button" id="book-noteedit-save">Save</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .book-page { max-width: 72rem; margin: 0 auto; padding: calc(env(safe-area-inset-top, 0px) + 4.5rem) 6vw calc(var(--tabbar-space) + 6rem); }
  .kicker { font-size: var(--t-caption); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .book-head h1 {
    font-family: var(--font-display); font-weight: var(--title-weight); font-style: var(--title-style);
    font-size: clamp(2.2rem, 5.5vw, 3.8rem); letter-spacing: var(--title-tracking);
    margin: 0.3rem 0 0.6rem; line-height: 1;
  }
  .lead { color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0 0 2.6rem; max-width: 44rem; }
  .lead code { font-size: 0.92em; }
  .book-titlerow { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--sp-2) var(--sp-4); }
  .book-titlerow h1 { margin-bottom: 0; }
  .book-links { display: flex; gap: var(--sp-1); margin-bottom: 0.2rem; }
  .book-link {
    display: inline-flex; align-items: center; min-height: var(--hit); padding: 0 var(--sp-3); border-radius: var(--r-pill);
    font-family: var(--font-ui); font-size: var(--t-footnote); color: var(--secondary); text-decoration: none; white-space: nowrap;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .book-link:hover { color: var(--fg); background: var(--fill); }
  .book-link:focus-visible { outline: 2px solid var(--mark); outline-offset: 2px; }
  .book-sub { margin: var(--sp-2) 0 var(--sp-5); font-family: var(--font-ui); font-size: var(--t-footnote); color: var(--secondary); }
  /* The PDF's Download link, written by the print script. */
  .book-share-link { color: var(--fg); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 4px; white-space: nowrap; }
  .book-empty { color: var(--muted); }

  .book-chapter { margin-bottom: 3rem; }
  .book-chapter-head {
    font-family: var(--font-display); font-style: var(--title-style); font-weight: var(--title-weight);
    font-size: 1.4rem; margin: 0 0 1rem; display: flex; align-items: baseline; gap: 0.6rem;
  }
  .book-chapter-count { font-family: var(--font-label); font-size: 0.85rem; color: var(--muted); }
  .book-dup-summary {
    font-family: var(--font-ui); font-size: var(--t-caption);
    color: #c9973a; padding: 0.15rem 0.5rem; border-radius: 999px; background: color-mix(in oklab, #c9973a 14%, transparent);
    appearance: none; border: 0; cursor: pointer; align-self: center;
    transition: background var(--dur-fast) var(--ease);
  }
  .book-dup-summary:hover { background: color-mix(in oklab, #c9973a 24%, transparent); }
  .book-dup-summary:focus-visible { outline: 2px solid #c9973a; outline-offset: 2px; }

  .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); align-items: start; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .book-cell {
    /* aspect-ratio is set inline per-cell, from the photo's own dimensions — a
       thumbnail cropped to a square here could hide a composition that would
       decide an include/exclude or reorder call differently at full frame. */
    position: relative; margin: 0; overflow: hidden; background: var(--border);
    border-radius: 2px; transition: box-shadow 220ms var(--ease), opacity 200ms var(--ease);
  }
  .book-cell img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .book-cell[data-excluded='1'] { opacity: 0.32; }
  .book-cell:focus-visible { outline: 2px solid var(--accent-mix); outline-offset: 2px; }
  /* Possible duplicate/burst — a signal, not a verdict: the ring says "look
     at this one," the existing × exclude button (or the ⧉ shortcut below)
     is still what actually acts on it. */
  .book-cell[data-dup-group] { box-shadow: 0 0 0 2px #c9973a inset; }
  .book-cell.drop-before { box-shadow: -3px 0 0 var(--accent-mix) inset; }
  .book-cell.drop-after { box-shadow: 3px 0 0 var(--accent-mix) inset; }
  .book-foot {
    position: absolute; left: 0; bottom: 0; right: 0; z-index: 2;
    display: flex; align-items: center; justify-content: space-between; gap: 0.3rem;
    padding: 0.3rem 0.3rem; pointer-events: none;
    background: linear-gradient(to top, color-mix(in oklab, #000 70%, transparent), transparent);
  }
  .book-caption {
    pointer-events: auto; appearance: none; border: 0; background: none; cursor: pointer; text-align: left;
    padding: 0; font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.02em;
    color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
  }
  .book-caption:hover, .book-caption:focus-visible { color: var(--accent-mix, #fff); }
  .book-note-mark { margin-right: 0.2rem; }
  /* .book-move/.book-dup/.book-exclude/.book-handle: the Clear variant, same
     as .lb-tool in global.css — every one of these floats over a photograph,
     not over app chrome, and was at 6px, under Apple's stated 8-16px range
     for that case. */
  .book-move {
    pointer-events: auto; appearance: none; border: 0; border-radius: 999px; cursor: pointer;
    background: color-mix(in oklab, #000 55%, transparent); color: #fff;
    font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.02em;
    padding: 0.2rem 0.4rem; max-width: 5.2rem; flex: none;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
  }
  .book-move:focus-visible { outline: 2px solid var(--accent-mix); outline-offset: 1px; }
  /* "Keep this one" — excludes the rest of its duplicate group in one step,
     same one-step-undo path the × exclude button already uses. */
  .book-dup {
    pointer-events: auto; appearance: none; border: 0; border-radius: 999px; cursor: pointer;
    background: color-mix(in oklab, #c9973a 55%, #000 45%); color: #fff;
    font-family: var(--font-ui); font-size: 0.6875rem;
    padding: 0.2rem 0.4rem; flex: none;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
    transition: transform 110ms ease-out, background 140ms;
  }
  .book-dup:hover { background: color-mix(in oklab, #c9973a 78%, #000 22%); }
  .book-dup:active { transform: scale(0.92); }
  .book-dup:focus-visible { outline: 2px solid var(--accent-mix); outline-offset: 1px; }
  .book-exclude {
    position: absolute; top: 6px; right: 6px; z-index: 2;
    width: 26px; height: 26px; border-radius: 50%; border: 0; cursor: pointer;
    background: color-mix(in oklab, #000 55%, transparent); color: #fff;
    font-size: 15px; line-height: 26px; text-align: center;
    transition: background 140ms, transform 110ms ease-out;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
  }
  .book-exclude:hover { background: color-mix(in oklab, #c0392b 82%, transparent); }
  .book-exclude:active { transform: scale(0.88); }
  .book-cell[data-excluded='1'] .book-exclude { background: color-mix(in oklab, #2e7d32 78%, transparent); }
  .book-cell[data-excluded='1'] .book-exclude:hover { background: color-mix(in oklab, #2e7d32 95%, transparent); }
  .book-handle {
    position: absolute; top: 6px; left: 6px; z-index: 2;
    width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 11px; line-height: 1; letter-spacing: -2px;
    background: color-mix(in oklab, #000 55%, transparent); border-radius: 999px;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
    cursor: grab; touch-action: none;
  }
  .book-handle:active { cursor: grabbing; }
  .book-cell.touch-dragging { opacity: 0.4; z-index: 5; }

  .book-undo, .book-savebar {
    position: fixed; left: 50%; transform: translateX(-50%); z-index: 40;
    display: flex; align-items: center; gap: 1rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem; border-radius: 999px;
    background: var(--glass-bg-strong); border: 1px solid var(--glass-edge); box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  }
  /* Stacked above the tab bar, save nearest the thumb. */
  .book-savebar { bottom: calc(var(--tabbar-space) + 0.25rem); }
  .book-undo { bottom: calc(var(--tabbar-space) + 4rem); }
  .book-undo[hidden], .book-savebar[hidden] { display: none; }
  #book-undo-text { font-family: var(--font-ui); font-size: var(--t-footnote); color: var(--muted); }
  #book-undo-btn {
    appearance: none; cursor: pointer; border: 0; border-radius: 999px; background: var(--fill-hover); color: var(--fg);
    font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 600;
    min-height: 2.5rem; padding: 0 1.1rem;
  }
  #book-savebar-text { font-family: var(--font-ui); font-size: var(--t-footnote); color: var(--muted); }
  #book-save {
    appearance: none; cursor: pointer; border: 0; border-radius: 999px;
    background: var(--fg); color: var(--bg); font-family: var(--font-ui);
    font-size: var(--t-footnote); font-weight: 600;
    min-height: 2.5rem; padding: 0 1.2rem; transition: transform 110ms ease-out, opacity 140ms;
  }
  #book-save:active { transform: scale(0.96); }
  #book-save:disabled { opacity: 0.6; cursor: default; }

  .book-noteedit {
    position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center;
    background: color-mix(in oklab, var(--bg) 88%, #000); padding: 1.4rem;
    opacity: 0; transition: opacity 200ms var(--ease);
  }
  .book-noteedit[hidden] { display: none; }
  .book-noteedit.show { opacity: 1; }
  .book-noteedit-body {
    display: flex; gap: 1.4rem; max-width: 40rem; width: 100%;
    background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 1.2rem;
    transform: scale(0.97); transition: transform 200ms var(--ease);
  }
  .book-noteedit.show .book-noteedit-body { transform: none; }
  @media (prefers-reduced-motion: reduce) { .book-noteedit, .book-noteedit-body { transition: none; } }
  .book-noteedit-body img { width: 9rem; height: 9rem; object-fit: cover; border-radius: 3px; flex: 0 0 auto; background: var(--border); }
  .book-noteedit-form { display: flex; flex-direction: column; gap: 0.6rem; flex: 1 1 auto; min-width: 0; }
  .book-noteedit-name { margin: 0; font-family: var(--font-label); font-size: var(--t-caption); color: var(--muted); }
  #book-noteedit-text {
    flex: 1 1 auto; resize: vertical; min-height: 6rem; background: color-mix(in oklab, var(--fg) 4%, transparent);
    border: 1px solid var(--border); border-radius: 3px; color: var(--fg); font: inherit; font-size: 0.86rem;
    line-height: 1.5; padding: 0.6rem; font-family: var(--font-display); font-style: var(--title-style);
  }
  #book-noteedit-text:focus-visible { outline: 2px solid var(--accent-mix); outline-offset: 1px; }
  /* #c0392b measures ~3.5:1 on --bg, below the 4.5:1 floor for text this size —
     everywhere else in the app an error/warning reads in #e0603a (~5.4:1)
     instead, and #c0392b is reserved for filled backgrounds (remove buttons,
     armed states) where a light glyph sits on top of it, not as text colour
     on the dark ground itself. This was the one place that drifted. */
  .book-noteedit-error { margin: 0; font-family: var(--font-ui); font-size: var(--t-caption); color: #e0603a; }
  .book-noteedit-error[hidden] { display: none; }
  .book-noteedit-actions { display: flex; justify-content: flex-end; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .book-noteedit-spacer { flex: 1 1 auto; }
  .book-noteedit-actions button {
    appearance: none; cursor: pointer; min-height: 2.25rem; padding: 0 0.95rem; border-radius: var(--r-pill);
    font: 500 var(--t-footnote) var(--font-ui); border: 1px solid var(--rule); background: none; color: var(--fg);
    transition: transform 120ms ease-out, border-color var(--dur-fast) var(--ease);
  }
  .book-noteedit-actions button:hover { border-color: var(--fg); }
  .book-noteedit-actions button:active { transform: scale(0.97); }
  .book-noteedit-actions button:disabled { opacity: 0.5; cursor: default; }
  #book-noteedit-save { background: var(--fg); color: var(--bg); border-color: var(--fg); font-weight: 600; }
  .book-voice { display: inline-flex; align-items: center; gap: 0.4rem; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .book-voice svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .book-voice[data-state='listening'] { color: #e0603a; border-color: #e0603a; }
  .book-voice[data-state='listening'] svg { animation: book-voice-pulse 1s ease-in-out infinite; }
  @keyframes book-voice-pulse { 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .book-voice[data-state='listening'] svg { animation: none; } }

  @media (max-width: 620px) {
    .book-page { padding: calc(env(safe-area-inset-top, 0px) + 3rem) 5vw calc(var(--tabbar-space) + 7rem); }
    .book-grid { grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 6px; }
  }

  /* Neither corner control ever got the touch-target pass the rest of the app's
     icon buttons did (see .pin/.cell-remove's own transparent-ring fix) — both
     sit at 26px, and .book-handle is the one control on this page meant to be
     dragged, which is a worse miss on touch than a button that only needs one
     accurate tap. Same answer as everywhere else: the visible mark stays
     26px, only the invisible target grows — held 9px off each edge, not 6,
     because .book-cell clips its overflow (that's how the thumbnail itself
     stays cropped square) and a ring hanging past the cell is clipped with
     it. 9px off each side lands the full 44px ring flush inside even the
     narrowest grid cell (96px on a phone), with room to spare between the
     two corners. */
  @media (pointer: coarse) {
    .book-exclude { top: 9px; right: 9px; }
    .book-handle { top: 9px; left: 9px; }
    .book-exclude::after,
    .book-handle::after {
      content: '';
      position: absolute;
      inset: -9px;
      border-radius: 50%;
    }
  }
  /* Phone: the corner marks take less of each thumbnail. The chapter picker
     is a <select>, so it keeps 16px type (iOS zooms on focus below that) and
     is drawn smaller with a transform instead, which iOS doesn't look at. */
  /* Round 3: quiet tiles. At rest a tile is only its photograph; the
     handle, ×, name and chapter appear on hover or keyboard focus, or after
     a first tap on touch (Lightroom's "clickable items on mouse over only",
     Photos' tap to select). The duplicate badge stays, because it is the one
     overlay that is a warning, and so does the + on a left-out photo. */
  .book-handle, .book-exclude, .book-caption, .book-move { opacity: 0; transition: opacity 160ms var(--ease); }
  .book-foot { background: none; transition: background 160ms var(--ease); }
  .book-cell:is(:hover, :focus-within, .is-active) :is(.book-handle, .book-exclude, .book-caption, .book-move),
  .book-cell[data-excluded='1'] .book-exclude { opacity: 1; }
  .book-cell:is(:hover, :focus-within, .is-active) .book-foot {
    background: linear-gradient(to top, color-mix(in oklab, #000 70%, transparent), transparent);
  }
  /* A finger can't hover, so hidden controls must not catch the first tap:
     it only reveals them (see the script). */
  @media (hover: none) {
    .book-cell:not(.is-active):not(:focus-within) :is(.book-handle, .book-caption, .book-move),
    .book-cell:not(.is-active):not(:focus-within):not([data-excluded='1']) .book-exclude { pointer-events: none; }
  }
  @media (prefers-reduced-motion: reduce) { .book-handle, .book-exclude, .book-caption, .book-move, .book-foot { transition: none; } }

  @media (max-width: 640px) {
    .book-exclude { width: 22px; height: 22px; line-height: 22px; font-size: 13px; }
    .book-handle { width: 22px; height: 22px; }
    .book-move {
      min-height: 0; font-size: 16px; padding: 0.15rem 0.45rem;
      transform: scale(0.7); transform-origin: right bottom; max-width: 7.4rem;
    }
  }
</style>

<script is:inline>
  // Drag-reorder within a chapter (Pointer Events — no library), a per-photo
  // include/exclude toggle, and moving a photo to a different chapter, saved
  // together as one POST to /api/book. See src/lib/book.ts for the curation
  // this reads and writes.
  let dirty = false;
  const savebar = document.getElementById('book-savebar');
  const saveBtn = document.getElementById('book-save');
  const saveText = document.getElementById('book-savebar-text');
  const undoBar = document.getElementById('book-undo');
  const undoText = document.getElementById('book-undo-text');
  const undoBtn = document.getElementById('book-undo-btn');

  // The beforeunload confirm dialog is not a real safety net — several
  // browsers suppress or ignore it — so a crash, an accidental swipe-close or
  // a forgotten tab used to lose every reorder in the session. Debounce-write
  // instead: 2s after the last change with nothing more coming, save() fires
  // on its own. It's the same POST the button already made — autosave and the
  // manual click both funnel through it, so there is one save path, not two.
  const AUTOSAVE_DELAY = 2000;
  let autosaveTimer = null;
  // Bumped on every change, so a save already in flight can tell whether the
  // state it captured is still the latest state once its POST resolves.
  let version = 0;

  function markDirty() {
    version++;
    dirty = true;
    savebar.hidden = false;
    saveText.textContent = 'Unsaved changes';
    saveBtn.disabled = false;
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(save, AUTOSAVE_DELAY);
    window.dispatchEvent(new Event('book:changed'));
  }
  // The spread view (module script below) changes page layout through the
  // same dirty/autosave path, and its state rides along with every save.
  window.bookMarkDirty = markDirty;
  // Issue #141: the spread view's "Place after" moves a cell like a drag does.
  window.bookPlaceAfter = (cell, after) => {
    const from = cell.closest('.book-chapter');
    after.after(cell);
    updateChapterCount(from);
    updateChapterCount(cell.closest('.book-chapter'));
    updateTotalCount();
    markDirty();
  };

  // --- Exclude toggle, with a one-step undo -------------------------------
  // A misclick during a fast curation pass used to be silent until the
  // caption's dimming was noticed later. showUndo keeps only the most recent
  // toggle reachable — this is a quick-recovery affordance, not a history —
  // and its own timer means it never has to be dismissed explicitly. It
  // takes a *batch* of {cell, previous} pairs, not one, so "keep this one"
  // below (which can exclude several photos at once) is a single undo step
  // too, not one the undo bar can only halfway reverse.
  let undoTimer = null;
  let undoTarget = null;

  function setExcluded(cell, excluded) {
    cell.dataset.excluded = excluded ? '1' : '';
    const btn = cell.querySelector('.book-exclude');
    btn.setAttribute('aria-pressed', String(excluded));
    btn.textContent = excluded ? '+' : '×';
    btn.title = excluded ? 'Include in the book' : 'Leave out of the book';
    updateChapterCount(cell.closest('.book-chapter'));
    updateTotalCount();
  }

  function showUndo(entries, message) {
    clearTimeout(undoTimer);
    undoTarget = entries;
    undoText.textContent = message;
    undoBar.hidden = false;
    undoTimer = setTimeout(() => { undoBar.hidden = true; undoTarget = null; }, 6000);
  }

  undoBtn?.addEventListener('click', () => {
    if (!undoTarget) return;
    for (const { cell, previous } of undoTarget) setExcluded(cell, previous);
    markDirty();
    clearTimeout(undoTimer);
    undoBar.hidden = true;
    undoTarget = null;
  });

  document.getElementById('book-chapters')?.addEventListener('click', (e) => {
    // The chapter's count is a way in too: it opens the first group it counts.
    const summary = e.target.closest('.book-dup-summary');
    if (summary) {
      const first = summary.closest('.book-chapter')?.querySelector('.book-dup');
      if (first) openSurvey(first.dataset.dupGroup, null);
      return;
    }
    const dupBtn = e.target.closest('.book-dup');
    if (dupBtn) { openSurvey(dupBtn.dataset.dupGroup, e.detail === 0 ? dupBtn.dataset.dupKeep : null); return; }
    const btn = e.target.closest('.book-exclude');
    if (!btn) return;
    const cell = btn.closest('.book-cell');
    const nowExcluded = cell.dataset.excluded !== '1';
    setExcluded(cell, nowExcluded);
    showUndo([{ cell, previous: !nowExcluded }], `${nowExcluded ? 'Left out' : 'Included'}: ${cell.dataset.stem || cell.dataset.id}`);
    markDirty();
  });

  // --- Survey a burst --------------------------------------------------------
  // The ⧉ badge used to keep its photo and drop the rest in one tap, without
  // a look at them together. Now it lays the group side by side at one height,
  // and "Keep" on any of them does what the badge did, with the same Undo.
  const survey = document.getElementById('book-survey');
  const surveyRow = document.getElementById('survey-row');
  document.getElementById('survey-close')?.addEventListener('click', () => survey.close());
  survey?.addEventListener('click', (e) => { if (e.target === survey) survey.close(); });

  function openSurvey(groupKey, focusId) {
    const cells = [...document.querySelectorAll(`.book-cell[data-dup-group="${CSS.escape(groupKey)}"]`)];
    if (!cells.length || !survey) return;
    surveyRow.replaceChildren(...cells.map((cell) => {
      const fig = document.createElement('figure');
      fig.className = 'survey-item';
      fig.dataset.id = cell.dataset.id;
      if (cell.dataset.excluded === '1') fig.classList.add('out');
      const frame = document.createElement('div');
      frame.className = 'survey-frame';
      const img = document.createElement('img');
      img.src = cell.dataset.large || cell.querySelector('img')?.src || '';
      img.alt = cell.dataset.stem || '';
      img.style.aspectRatio = `${cell.dataset.w}/${cell.dataset.h}`;
      frame.append(img);
      const cap = document.createElement('figcaption');
      const name = document.createElement('span');
      name.className = 'survey-name';
      name.textContent = cell.dataset.stem || cell.dataset.id;
      const keep = document.createElement('button');
      keep.type = 'button';
      keep.className = 'survey-keep';
      keep.textContent = 'Keep';
      keep.setAttribute('aria-label', `Keep ${cell.dataset.stem || cell.dataset.id}, leave the others out`);
      keep.addEventListener('click', () => keepFromSurvey(cells, cell));
      cap.append(name, keep);
      fig.append(frame, cap);
      return fig;
    }));
    survey.style.setProperty('--n', String(cells.length));
    survey.showModal();
    // From the keyboard, focus lands on the badge's own photo; from a tap the
    // dialog keeps its default (the close button) so no ring shows.
    if (focusId) surveyRow.querySelector(`.survey-item[data-id="${CSS.escape(focusId)}"] .survey-keep`)?.focus();
  }

  function keepFromSurvey(cells, keepCell) {
    const entries = [];
    for (const cell of cells) {
      const was = cell.dataset.excluded === '1';
      const now = cell !== keepCell;
      if (was === now) continue;
      entries.push({ cell, previous: was });
      setExcluded(cell, now);
    }
    survey.close();
    if (!entries.length) return;
    const left = entries.filter((x) => x.cell !== keepCell).length;
    showUndo(entries, `Kept ${keepCell.dataset.stem || keepCell.dataset.id}${left ? `, left out ${left}` : ''}`);
    markDirty();
  }

  // Hold to look closer: every photo zooms to the same point, so focus and
  // eyes can be compared across the burst (Narrative's survey zoom).
  let zoomFrame = null;
  function zoomAt(e) {
    const r = zoomFrame.getBoundingClientRect();
    const x = Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100));
    const y = Math.min(100, Math.max(0, ((e.clientY - r.top) / r.height) * 100));
    surveyRow.style.setProperty('--zx', `${x}%`);
    surveyRow.style.setProperty('--zy', `${y}%`);
  }
  surveyRow?.addEventListener('pointerdown', (e) => {
    const frame = e.target.closest('.survey-frame');
    if (!frame) return;
    e.preventDefault();
    zoomFrame = frame;
    frame.setPointerCapture?.(e.pointerId);
    zoomAt(e);
    surveyRow.classList.add('zooming');
  });
  surveyRow?.addEventListener('pointermove', (e) => { if (zoomFrame) zoomAt(e); });
  const endZoom = () => { zoomFrame = null; surveyRow?.classList.remove('zooming'); };
  surveyRow?.addEventListener('pointerup', endZoom);
  surveyRow?.addEventListener('pointercancel', endZoom);
  survey?.addEventListener('close', endZoom);

  function updateChapterCount(section) {
    const key = section.dataset.chapter;
    const cells = section.querySelectorAll('.book-cell');
    const included = [...cells].filter((c) => c.dataset.excluded !== '1').length;
    const countEl = document.querySelector(`[data-chapter-count="${CSS.escape(key)}"]`);
    if (countEl) countEl.textContent = `${included}/${cells.length}`;
  }

  function updateTotalCount() {
    const cells = document.querySelectorAll('.book-cell');
    const included = [...cells].filter((c) => c.dataset.excluded !== '1').length;
    const el = document.getElementById('book-count');
    // The page count lives in the tools row (#book-check), with the print
    // service's limits beside it.
    if (el) el.textContent = `${included} of ${cells.length}`;
  }

  // --- Chapter menus, filled on first touch ---------------------------------
  // Every cell's menu used to carry all the chapters: 888 <option>s on the
  // page, nearly none of them ever opened. Each now ships with its own chapter
  // and takes the full list from one template the first time it's pressed or
  // focused, which comes before the menu opens, on a tap or from the keyboard.
  const chapterOptions = document.getElementById('book-chapter-options');
  function fillMenu(e) {
    const select = e.target.closest?.('.book-move');
    if (!select || select.dataset.full || !chapterOptions) return;
    const current = select.value;
    select.replaceChildren(chapterOptions.content.cloneNode(true));
    select.value = current;
    select.dataset.full = '1';
  }
  document.getElementById('book-chapters')?.addEventListener('pointerdown', fillMenu, true);
  document.getElementById('book-chapters')?.addEventListener('focusin', fillMenu);

  // --- Move a photo to a different chapter --------------------------------
  // Book-only — see book.ts's `moved` field. Physically relocating the <li>
  // is enough: save() below reads chapter membership straight from the DOM,
  // the same way it already reads order.
  document.getElementById('book-chapters')?.addEventListener('change', (e) => {
    const select = e.target.closest('.book-move');
    if (!select) return;
    const cell = select.closest('.book-cell');
    const fromSection = cell.closest('.book-chapter');
    const toList = document.querySelector(`[data-chapter-list="${CSS.escape(select.value)}"]`);
    if (!toList || !cell) return;
    toList.appendChild(cell);
    updateChapterCount(fromSection);
    updateChapterCount(cell.closest('.book-chapter'));
    updateTotalCount();
    markDirty();
  });

  // --- Reorder, one chapter's list at a time ------------------------------
  // Pointer Events cover mouse, pen and touch alike from one code path — the
  // previous native HTML5 DnD never fired from a touch drag (iOS Safari does
  // not dispatch dragstart for touch), which meant reordering only worked
  // with a mouse. The drag handle is the only pointerdown target so a touch
  // scroll through the grid is never mistaken for the start of a drag.
  let ptr = null; // { cell, list, pointerId }

  function clearDropMarks(list) {
    list.querySelectorAll('.drop-before, .drop-after').forEach((c) => c.classList.remove('drop-before', 'drop-after'));
  }

  document.querySelectorAll('.book-handle').forEach((handle) => {
    handle.addEventListener('pointerdown', (e) => {
      const cell = handle.closest('.book-cell');
      const list = handle.closest('.book-grid');
      if (!cell || !list) return;
      e.preventDefault();
      handle.setPointerCapture(e.pointerId);
      ptr = { cell, list, pointerId: e.pointerId };
      cell.classList.add('touch-dragging');
    });
  });

  document.addEventListener('pointermove', (e) => {
    if (!ptr || e.pointerId !== ptr.pointerId) return;
    const { list, cell } = ptr;
    const over = document.elementFromPoint(e.clientX, e.clientY)?.closest('.book-cell');
    clearDropMarks(list);
    if (!over || over === cell || !list.contains(over)) return;
    const rect = over.getBoundingClientRect();
    over.classList.add(e.clientX - rect.left < rect.width / 2 ? 'drop-before' : 'drop-after');
  });

  function endDrag(e) {
    if (!ptr || e.pointerId !== ptr.pointerId) return;
    const { list, cell } = ptr;
    cell.classList.remove('touch-dragging');
    const over = document.elementFromPoint(e.clientX, e.clientY)?.closest('.book-cell');
    clearDropMarks(list);
    ptr = null;
    if (!over || over === cell || !list.contains(over)) return;
    const rect = over.getBoundingClientRect();
    const before = e.clientX - rect.left < rect.width / 2;
    over.insertAdjacentElement(before ? 'beforebegin' : 'afterend', cell);
    markDirty();
  }
  document.addEventListener('pointerup', endDrag);
  document.addEventListener('pointercancel', endDrag);

  // --- Keyboard-precise reorder, one chapter's list at a time ---------------
  // Drag is imprecise for "move this plate exactly one spot left" — curation
  // here is precision-over-speed work, so arrow keys nudge the focused photo
  // by one position (Left/Right) or one row (Up/Down), alongside drag rather
  // than instead of it.
  function columnsInRow(cells) {
    if (!cells.length) return 1;
    const firstTop = cells[0].offsetTop;
    let cols = 0;
    for (const c of cells) {
      if (c.offsetTop !== firstTop) break;
      cols++;
    }
    return Math.max(cols, 1);
  }

  document.querySelectorAll('.book-grid').forEach((list) => {
    list.addEventListener('keydown', (e) => {
      // The chapter <select> uses arrow keys natively to change its own
      // value — don't hijack those into a reorder.
      if (e.target.closest('.book-move')) return;
      const cell = e.target.closest('.book-cell');
      if (!cell || !list.contains(cell)) return;
      const deltas = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: 0, ArrowDown: 0 };
      if (!(e.key in deltas)) return;
      e.preventDefault();
      const cells = [...list.querySelectorAll('.book-cell')];
      const from = cells.indexOf(cell);
      const cols = columnsInRow(cells);
      const delta = e.key === 'ArrowUp' ? -cols : e.key === 'ArrowDown' ? cols : deltas[e.key];
      const to = Math.min(Math.max(from + delta, 0), cells.length - 1);
      if (to === from) return;
      const ref = cells[to];
      if (to < from) ref.insertAdjacentElement('beforebegin', cell);
      else ref.insertAdjacentElement('afterend', cell);
      cell.focus();
      markDirty();
    });
  });

  // --- Save ------------------------------------------------------------
  // One save path for both the button and the debounce timer above.
  let saving = false;
  async function save() {
    clearTimeout(autosaveTimer);
    if (saving || !dirty) return;
    saving = true;
    const startVersion = version;
    saveBtn.disabled = true;
    saveText.textContent = 'Saving…';
    const chapters = {};
    const excluded = [];
    const moved = {};
    document.querySelectorAll('.book-grid').forEach((list) => {
      const key = list.dataset.chapterList;
      chapters[key] = [...list.querySelectorAll('.book-cell')].map((c) => c.dataset.id);
      list.querySelectorAll('.book-cell').forEach((c) => {
        if (c.dataset.excluded === '1') excluded.push(c.dataset.id);
        // Only a photo actually sitting outside its own manifest chapter
        // needs an entry — everything else falls back to its home chapter.
        if (c.dataset.home && c.dataset.home !== key) moved[c.dataset.id] = key;
      });
    });
    try {
      const res = await fetch('/api/book', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ chapters, excluded, moved, ...(window.bookLayoutState ? window.bookLayoutState() : {}) }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Save failed.');
      if (version === startVersion) {
        // Nothing changed while this POST was in flight — the archive now
        // matches what's on screen.
        dirty = false;
        saveText.textContent = 'Saved';
        setTimeout(() => { if (!dirty) savebar.hidden = true; }, 1600);
      } else {
        // A later change arrived mid-save. That edit's own markDirty() already
        // rescheduled the autosave timer — this save just wasn't the last
        // word, so the bar stays up rather than reporting "Saved" over work
        // that isn't on the server yet.
        saveText.textContent = 'Unsaved changes';
        saveBtn.disabled = false;
      }
    } catch (err) {
      saveText.textContent = err.message || 'Save failed.';
      saveBtn.disabled = false;
      // A failed autosave still gets another try on the next edit (markDirty
      // reschedules it) or the visible button — either way there is no
      // silent dead end.
    } finally {
      saving = false;
    }
  }
  saveBtn?.addEventListener('click', save);

  // --- Notes: the archive's own notebook -----------------------------------
  // One reusable overlay, opened from whichever cell's caption was clicked.
  // Saves straight to /api/notes on its own — a note isn't book curation, so
  // it does not go through markDirty/save above and is never lost to a
  // closed tab the way an unsaved reorder would be.
  const noteEdit = document.getElementById('book-noteedit');
  const noteEditImg = document.getElementById('book-noteedit-img');
  const noteEditName = document.getElementById('book-noteedit-name');
  const noteEditText = document.getElementById('book-noteedit-text');
  const noteEditError = document.getElementById('book-noteedit-error');
  const noteEditSave = document.getElementById('book-noteedit-save');
  let noteEditCell = null;

  function openNoteEdit(cell) {
    noteEditCell = cell;
    noteEditImg.src = cell.querySelector('img').src;
    noteEditName.textContent = cell.dataset.stem || cell.dataset.id;
    noteEditText.value = cell.dataset.note || '';
    noteEditError.hidden = true;
    noteEdit.hidden = false;
    requestAnimationFrame(() => {
      noteEdit.classList.add('show');
      // On a touch screen the keyboard would cover the photo and the voice
      // button; tap the field to type.
      if (!matchMedia('(pointer: coarse)').matches) noteEditText.focus();
    });
  }
  function closeNoteEdit() {
    if (noteEdit.hidden) return;
    noteEdit.classList.remove('show');
    setTimeout(() => { noteEdit.hidden = true; noteEditCell = null; }, 200);
  }
  function updateNoteMark(cell, text) {
    cell.dataset.note = text;
    const btn = cell.querySelector('.book-caption');
    const existingMark = btn.querySelector('.book-note-mark');
    if (text && !existingMark) {
      const mark = document.createElement('span');
      mark.className = 'book-note-mark';
      mark.setAttribute('aria-hidden', 'true');
      mark.textContent = '✎';
      btn.prepend(mark);
    } else if (!text && existingMark) {
      existingMark.remove();
    }
    btn.title = text ? 'Edit note' : 'Add a note';
  }

  document.getElementById('book-chapters')?.addEventListener('click', (e) => {
    const btn = e.target.closest('.book-caption');
    if (!btn) return;
    openNoteEdit(btn.closest('.book-cell'));
  });
  document.getElementById('book-noteedit-cancel').addEventListener('click', closeNoteEdit);
  noteEdit.addEventListener('click', (e) => { if (e.target === noteEdit) closeNoteEdit(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !noteEdit.hidden) closeNoteEdit(); });

  noteEditSave.addEventListener('click', async () => {
    if (!noteEditCell) return;
    const id = noteEditCell.dataset.id;
    const text = noteEditText.value;
    noteEditSave.disabled = true;
    noteEditError.hidden = true;
    try {
      const res = await fetch('/api/notes', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, text }),
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Save failed.');
      updateNoteMark(noteEditCell, text.trim());
      closeNoteEdit();
    } catch (err) {
      noteEditError.textContent = err.message || 'Save failed.';
      noteEditError.hidden = false;
    } finally {
      noteEditSave.disabled = false;
    }
  });

  addEventListener('beforeunload', (e) => {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = '';
  });
</script>

<script>
  // The spread view and the print PDF. Pages come from book-pages.ts, the
  // same pagination /api/book/pdf prints from, read off the list view's DOM
  // so an unsaved reorder or exclusion shows up here straight away.
  import { TRIMS, checkPages, isTrimId, padToEven, paginate, placements, spreads, type Page, type PageChapter, type Treatment, type TrimId, withColophon, printCheck, printFlagMessage, estimateSpineMM, type PrintFlag } from '../lib/book-pages';
  import { meanTone, pageTone, pickRhymes, spreadJumps, type Tone } from '../lib/book-rhythm';
  import { holdToSpeak } from '../lib/voice-note';

  // Voice notes (issue #149): the words land in the note for a look, then Save.
  {
    const voice = document.getElementById('book-noteedit-voice') as HTMLButtonElement | null;
    const label = document.getElementById('book-noteedit-voice-label');
    const text = document.getElementById('book-noteedit-text') as HTMLTextAreaElement | null;
    const error = document.getElementById('book-noteedit-error');
    if (voice && label && text && error) {
      holdToSpeak(
        voice,
        (words) => { if (words) text.value = text.value.trim() ? `${text.value.trim()} ${words}` : words; },
        (state, problem) => {
          voice.dataset.state = state;
          label.textContent = state === 'listening' ? 'Listening… let go to stop' : state === 'writing' ? 'Writing it down…' : 'Hold to speak';
          error.textContent = problem ?? '';
          error.hidden = !problem;
        },
      );
    }
  }


  // Quiet tiles on touch: a first tap on a tile shows its controls, a tap
  // elsewhere hides them again. Pointers get the same through :hover.
  document.getElementById('book-chapters')?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('button, select')) return;
    const cell = target.closest<HTMLElement>('.book-cell');
    for (const other of document.querySelectorAll('.book-cell.is-active')) {
      if (other !== cell) other.classList.remove('is-active');
    }
    cell?.classList.toggle('is-active');
  });
  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('.book-cell')) {
      for (const cell of document.querySelectorAll('.book-cell.is-active')) cell.classList.remove('is-active');
    }
  });

  const init = JSON.parse(document.getElementById('book-layout-init')?.textContent || '{}');
  const state: { layout: Record<string, Treatment>; blankBefore: Set<string>; trim: TrimId } = {
    layout: { ...(init.layout ?? {}) },
    blankBefore: new Set(init.blankBefore ?? []),
    trim: isTrimId(init.trim) ? init.trim : 'blurb-land',
  };
  const w = window as unknown as {
    bookMarkDirty?: () => void;
    bookLayoutState?: () => unknown;
    bookPlaceAfter?: (cell: HTMLElement, after: HTMLElement) => void;
  };
  w.bookLayoutState = () => ({ layout: state.layout, blankBefore: [...state.blankBefore], trim: state.trim });

  const thumbs = new Map<string, string>();
  const inks = new Map<string, string>();
  const names = new Map<string, string>();
  function readChapters(): PageChapter[] {
    const out: PageChapter[] = [];
    for (const section of document.querySelectorAll<HTMLElement>('.book-chapter')) {
      const photos = [];
      for (const cell of section.querySelectorAll<HTMLElement>('.book-cell')) {
        if (cell.dataset.excluded === '1') continue;
        const id = cell.dataset.id!;
        thumbs.set(id, cell.querySelector('img')?.getAttribute('src') || '');
        names.set(id, cell.dataset.stem || id);
        photos.push({ id, width: +(cell.dataset.w || 3), height: +(cell.dataset.h || 2) });
      }
      inks.set(section.dataset.chapter!, section.dataset.ink || '#0a0a0a');
      if (photos.length) out.push({ key: section.dataset.chapter!, name: section.dataset.name || '', colour: section.dataset.colour || '#888', photos });
    }
    return out;
  }
  const pages = () => padToEven(withColophon(paginate(readChapters(), { treatment: state.layout, blankBefore: [...state.blankBefore] })));
  // Issue #140: photos that print under 240 ppi, by the first photo id of their page.
  let flags: PrintFlag[] = [];
  const flagsOn = (page: Page) => (page.kind === 'photo' ? flags.filter((f) => page.photos.some((p) => p.id === f.id)) : []);

  const list = document.getElementById('book-chapters');
  const spreadsEl = document.getElementById('book-spreads')!;
  const spreadList = document.getElementById('book-spread-list')!;
  const trimSel = document.getElementById('book-trim') as HTMLSelectElement | null;
  const check = document.getElementById('book-check');
  const ctl = document.getElementById('book-pagectl')!;
  const ctlName = document.getElementById('book-pagectl-name')!;
  const ctlNote = document.getElementById('book-pagectl-note')!;
  const blankBtn = document.getElementById('book-blank')!;
  const ppiBox = document.getElementById('book-ppi')!;
  const ppiText = document.getElementById('book-ppi-text')!;
  const ppiFix = document.getElementById('book-ppi-fix') as HTMLButtonElement;
  let selected: string | null = null; // the first photo id on the selected page
  let current: Page[] = [];

  const softEl = document.getElementById('book-soft');
  const softHead = document.getElementById('book-soft-head');
  const softList = document.getElementById('book-soft-list');
  const spineIn = document.getElementById('book-spine') as HTMLInputElement | null;
  function updateCheck() {
    const all = pages();
    flags = printCheck(all, TRIMS[state.trim]);
    if (spineIn && !spineIn.dataset.touched) spineIn.value = String(estimateSpineMM(all.length));
    if (softEl && softHead && softList) {
      softEl.hidden = flags.length === 0;
      softHead.textContent = `${flags.length} ${flags.length === 1 ? 'photo' : 'photos'} may print soft`;
      softList.replaceChildren(...flags.map((f) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.softPage = String(f.page);
        b.textContent = `p. ${f.page + 1} · ${names.get(f.id) ?? f.id} · ${f.ppi} ppi${f.fix ? ` → ${f.fix.treatment === 'pair' ? 'two-up' : f.fix.treatment}` : ''}`;
        li.append(b);
        return li;
      }));
    }
    if (!check) return;
    const c = checkPages(all.length, TRIMS[state.trim]);
    check.textContent = c.message;
    check.dataset.ok = c.ok ? '1' : '';
  }
  spineIn?.addEventListener('input', () => { spineIn.dataset.touched = '1'; });

  const pct = (v: number, of: number) => `${(v / of) * 100}%`;
  function pageEl(page: Page | null, number: number | null): HTMLElement {
    const trim = TRIMS[state.trim];
    const el = document.createElement(page && page.kind === 'photo' ? 'button' : 'div');
    el.className = 'bs-page';
    el.style.aspectRatio = `${trim.widthMM} / ${trim.heightMM}`;
    if (!page) { el.classList.add('bs-none'); return el; }
    if (page.kind === 'opener') {
      el.classList.add('bs-opener');
      el.style.background = page.colour;
      const t = document.createElement('span');
      t.textContent = page.name;
      t.style.color = inks.get(page.chapterKey) || '#0a0a0a';
      el.append(t);
    } else if (page.kind === 'colophon') {
      el.classList.add('bs-blank', 'bs-colophon');
      const t = document.createElement('span');
      t.textContent = 'Colophon';
      el.append(t);
      el.title = 'Cameras, lenses, dates and places, from the photographs';
    } else if (page.kind === 'blank') {
      el.classList.add('bs-blank');
      if (page.reason === 'even') el.title = 'Added to make an even page count';
    } else {
      const btn = el as HTMLButtonElement;
      btn.type = 'button';
      const first = page.photos[0].id;
      btn.dataset.first = first;
      btn.setAttribute('aria-pressed', String(first === selected));
      btn.setAttribute('aria-label', `Page ${number}: ${page.photos.map((p) => names.get(p.id)).join(' and ')}`);
      if (page.note) btn.classList.add('bs-fallback');
      const soft = flagsOn(page);
      if (soft.length) {
        // A quiet mark; the reason is in the page controls once tapped.
        const mark = document.createElement('span');
        mark.className = 'bs-soft';
        mark.textContent = `${Math.min(...soft.map((f) => f.ppi))} ppi`;
        btn.append(mark);
        btn.setAttribute('aria-label', `${btn.getAttribute('aria-label')}, may print soft`);
      }
      for (const pl of placements(page, trim)) {
        const img = document.createElement('img');
        img.src = thumbs.get(pl.id) || '';
        img.alt = '';
        img.style.left = pct(pl.box.x, trim.widthMM);
        img.style.top = pct(pl.box.y, trim.heightMM);
        img.style.width = pct(pl.box.w, trim.widthMM);
        img.style.height = pct(pl.box.h, trim.heightMM);
        el.append(img);
      }
    }
    if (number !== null) {
      const n = document.createElement('span');
      n.className = 'bs-num';
      n.textContent = String(number);
      el.append(n);
    }
    return el;
  }

  // --- Rhythm (issue #141) -------------------------------------------------
  const parseTone = (s?: string): Tone | undefined => {
    const [L, C, H] = (s || '').split(' ').map(Number);
    return Number.isFinite(L) ? { L, C, H } : undefined;
  };
  const cellOf = (id: string) => document.querySelector<HTMLElement>(`.book-cell[data-id="${CSS.escape(id)}"]`);
  const photoTone = (id: string) => parseTone(cellOf(id)?.dataset.tone);
  const chapterTone = (key: string) => parseTone(document.querySelector<HTMLElement>(`.book-chapter[data-chapter="${CSS.escape(key)}"]`)?.dataset.tone);
  const toneCss = (t: Tone) => `oklch(${t.L} ${t.C} ${t.H})`;
  const rhythmEl = document.getElementById('book-rhythm')!;
  const rhythmNote = document.getElementById('book-rhythm-note')!;
  function renderRhythm(all: [Page | null, Page | null][]) {
    const tones = all.map(([l, r]) => [pageTone(l, photoTone, chapterTone), pageTone(r, photoTone, chapterTone)] as const);
    const jumps = spreadJumps(
      tones.map(([a, b]) => meanTone([a, b].filter((t): t is Tone => Boolean(t)))),
      all.map(([l, r]) => l?.kind === 'opener' || r?.kind === 'opener'),
    );
    const jumpAfter = new Map(jumps.map((j) => [j.after, j.reason]));
    rhythmEl.replaceChildren(...tones.map((pair, i) => {
      const g = document.createElement('button');
      g.type = 'button';
      g.className = 'br-spread';
      g.dataset.spread = String(i);
      g.title = `Spread ${i + 1}${jumpAfter.has(i - 1) ? ` · ${jumpAfter.get(i - 1)}` : ''}`;
      if (jumpAfter.has(i - 1)) g.classList.add('br-jump');
      for (const t of pair) {
        const tick = document.createElement('span');
        tick.className = 'br-tick';
        if (t) { tick.style.height = `${Math.max(6, t.L * 100)}%`; tick.style.background = toneCss(t); }
        else tick.classList.add('br-paper');
        g.append(tick);
      }
      return g;
    }));
    rhythmNote.textContent = jumps.length ? `${jumps.length} ${jumps.length === 1 ? 'place jolts' : 'places jolt'} between spreads, marked above. Tap one to see it.` : 'No hard jolts between spreads.';
  }
  rhythmEl.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-spread]');
    if (!b) return;
    const row = spreadList.children[Number(b.dataset.spread)] as HTMLElement | undefined;
    row?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    row?.classList.add('bs-flash');
    setTimeout(() => row?.classList.remove('bs-flash'), 1200);
  });

  // --- Rhymes (issue #141) --------------------------------------------------
  const rhymesBtn = document.getElementById('book-rhymes-btn') as HTMLButtonElement;
  const rhymesBox = document.getElementById('book-rhymes')!;
  const rhymesHead = document.getElementById('book-rhymes-head')!;
  const rhymesList = document.getElementById('book-rhymes-list')!;
  let rhymesFor: string | null = null;
  async function showRhymes() {
    const page = selectedPage();
    if (!page) return;
    rhymesFor = page.photos[0].id;
    rhymesBox.hidden = false;
    rhymesBtn.setAttribute('aria-expanded', 'true');
    rhymesHead.textContent = 'Looking…';
    rhymesList.replaceChildren();
    const ask = rhymesFor;
    try {
      const q = page.photos.map((p) => `ref=${encodeURIComponent(p.id)}`).join('&');
      const data = await fetch(`/api/similar?${q}`).then((r) => r.json());
      if (ask !== rhymesFor) return;
      if (!data.ok) throw new Error(data.error);
      const onPage = new Set(page.photos.map((p) => p.id));
      const inBook = (data.matches as { id: string; avif: string; comp: number; col: number }[])
        .filter((m) => !onPage.has(m.id) && cellOf(m.id) && cellOf(m.id)!.dataset.excluded !== '1');
      const rhymes = data.ready ? pickRhymes(inBook) : [];
      rhymesHead.textContent = rhymes.length
        ? 'Rhymes: the same shape in another colour. Place one after this page, or leave it.'
        : data.ready ? 'Nothing in the book echoes this one closely.' : 'Rhymes need the photos analysed first.';
      rhymesList.replaceChildren(...rhymes.map((m) => {
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = m.avif;
        img.alt = '';
        const where = document.createElement('span');
        where.className = 'book-rhymes-where';
        const at = current.findIndex((p) => p.kind === 'photo' && p.photos.some((x) => x.id === m.id));
        where.textContent = at >= 0 ? `p. ${at + 1}` : '';
        const place = document.createElement('button');
        place.type = 'button';
        place.textContent = 'Place after';
        place.addEventListener('click', () => {
          const cell = cellOf(m.id);
          const after = cellOf(page.photos[page.photos.length - 1].id);
          if (!cell || !after || !w.bookPlaceAfter) return;
          w.bookPlaceAfter(cell, after);
          render();
          li.remove();
        });
        li.append(img, where, place);
        return li;
      }));
    } catch (err) {
      rhymesHead.textContent = err instanceof Error ? err.message : 'Rhymes couldn’t be found.';
    }
  }
  function hideRhymes() {
    rhymesBox.hidden = true;
    rhymesFor = null;
    rhymesBtn.setAttribute('aria-expanded', 'false');
  }
  rhymesBtn.addEventListener('click', () => { if (rhymesBox.hidden) void showRhymes(); else hideRhymes(); });

  function render() {
    current = pages();
    updateCheck();
    if (spreadsEl.hidden) return;
    const frag = document.createDocumentFragment();
    let n = 0;
    const all = spreads(current);
    renderRhythm(all);
    for (const [l, r] of all) {
      const row = document.createElement('div');
      row.className = 'bs-spread';
      const ln = l ? ++n : null;
      row.append(pageEl(l, ln));
      const rn = r ? ++n : null;
      row.append(pageEl(r, rn));
      frag.append(row);
    }
    spreadList.replaceChildren(frag);
    syncControls();
  }

  function selectedPage(): Extract<Page, { kind: 'photo' }> | null {
    return (current.find((p) => p.kind === 'photo' && p.photos[0].id === selected) as Extract<Page, { kind: 'photo' }>) ?? null;
  }
  function syncControls() {
    const page = selectedPage();
    ctl.hidden = !page;
    if (!page || page.photos[0].id !== rhymesFor) hideRhymes();
    if (!page || !selected) return;
    ctlName.textContent = page.photos.map((p) => names.get(p.id)).join(' + ');
    const t = state.layout[selected] ?? 'border';
    for (const r of ctl.querySelectorAll<HTMLInputElement>('input[name="book-treatment"]')) r.checked = r.value === t;
    blankBtn.setAttribute('aria-pressed', String(state.blankBefore.has(selected)));
    ctlNote.textContent = page.note ?? '';
    const soft = flagsOn(page)[0];
    ppiBox.hidden = !soft;
    if (soft) {
      ppiText.textContent = printFlagMessage(soft);
      ppiFix.hidden = !soft.fix;
      if (soft.fix) {
        ppiFix.textContent = `Use ${soft.fix.treatment === 'pair' ? 'two-up' : soft.fix.treatment === 'border' ? 'a border' : soft.fix.treatment}`;
        ppiFix.dataset.treatment = soft.fix.treatment;
      }
    }
    for (const b of spreadList.querySelectorAll<HTMLElement>('[data-first]')) b.setAttribute('aria-pressed', String(b.dataset.first === selected));
  }

  function change() {
    render();
    w.bookMarkDirty?.();
  }

  spreadList.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-first]');
    if (!b) return;
    selected = b.dataset.first!;
    syncControls();
  });
  spreadList.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const all = [...spreadList.querySelectorAll<HTMLElement>('[data-first]')];
    const i = all.findIndex((b) => b === document.activeElement);
    const next = all[i + (e.key === 'ArrowRight' ? 1 : -1)];
    if (!next) return;
    e.preventDefault();
    next.focus();
    selected = next.dataset.first!;
    syncControls();
  });
  ctl.addEventListener('change', (e) => {
    const r = e.target as HTMLInputElement;
    if (r.name !== 'book-treatment' || !selected) return;
    if (r.value === 'border') delete state.layout[selected];
    else state.layout[selected] = r.value as Treatment;
    change();
  });
  ppiFix.addEventListener('click', () => {
    const t = ppiFix.dataset.treatment as Treatment | undefined;
    if (!selected || !t) return;
    if (t === 'border') delete state.layout[selected];
    else state.layout[selected] = t;
    change();
  });
  // A flagged page in the Print panel: show it in Spreads.
  softList?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-soft-page]');
    if (!b) return;
    const page = current[Number(b.dataset.softPage)];
    if (!page || page.kind !== 'photo') return;
    selected = page.photos[0].id;
    (document.querySelector('[data-bookview="spreads"]') as HTMLElement | null)?.click();
    setPrintOpen(false);
    spreadList.querySelector<HTMLElement>(`[data-first="${selected}"]`)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
  });
  blankBtn.addEventListener('click', () => {
    if (!selected) return;
    if (state.blankBefore.has(selected)) state.blankBefore.delete(selected);
    else state.blankBefore.add(selected);
    change();
  });
  trimSel?.addEventListener('change', () => {
    if (isTrimId(trimSel.value)) { state.trim = trimSel.value; change(); }
  });

  document.querySelector('.book-viewtoggle')?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-bookview]');
    if (!b) return;
    const spreadsOn = b.dataset.bookview === 'spreads';
    for (const x of document.querySelectorAll('[data-bookview]')) x.setAttribute('aria-pressed', String(x === b));
    spreadsEl.hidden = !spreadsOn;
    if (list) list.hidden = spreadsOn;
    render();
  });
  // A reorder, exclusion or move in the list view.
  window.addEventListener('book:changed', () => { if (!spreadsEl.hidden) render(); else updateCheck(); });
  updateCheck();

  // --- Print panel --------------------------------------------------------
  const printOpen = document.getElementById('book-print-open') as HTMLButtonElement | null;
  const printPop = document.getElementById('book-printpop');
  const setPrintOpen = (open: boolean) => {
    if (!printPop || !printOpen) return;
    printPop.hidden = !open;
    printOpen.setAttribute('aria-expanded', String(open));
  };
  printOpen?.addEventListener('click', () => setPrintOpen(!!printPop?.hidden));
  document.addEventListener('click', (e) => {
    const path = e.composedPath();
    if (printPop && printOpen && !path.includes(printPop) && !path.includes(printOpen)) setPrintOpen(false);
  });
  printPop?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { setPrintOpen(false); printOpen?.focus(); }
  });
  // The warning dot follows the page check as the size or the book changes.
  if (check && printOpen) {
    new MutationObserver(() => { printOpen.dataset.warn = check.dataset.ok === '1' ? '' : '1'; })
      .observe(check, { attributes: true, attributeFilter: ['data-ok'] });
  }

  // --- Print PDF --------------------------------------------------------
  const pdfBtn = document.getElementById('book-pdf') as HTMLButtonElement | null;
  const pdfStatus = document.getElementById('book-pdf-status');
  const bleed = document.getElementById('book-bleed') as HTMLInputElement | null;
  pdfBtn?.addEventListener('click', async () => {
    if (!pdfStatus) return;
    pdfBtn.disabled = true;
    const label = pdfBtn.textContent;
    pdfBtn.textContent = 'Building…';
    pdfStatus.textContent = '';
    // The PDF is built from what's saved, so save first.
    const saveBtn = document.getElementById('book-save') as HTMLButtonElement | null;
    const savebar = document.getElementById('book-savebar');
    if (savebar && !savebar.hidden && saveBtn && !saveBtn.disabled) {
      saveBtn.click();
      for (let i = 0; i < 50 && !(document.getElementById('book-savebar-text')?.textContent === 'Saved' || savebar.hidden); i++) {
        await new Promise((r) => setTimeout(r, 100));
      }
    }
    try {
      const res = await fetch(`/api/book/pdf?trim=${state.trim}&bleed=${bleed?.checked ? '1' : '0'}`, { method: 'POST' });
      if (!res.ok || !res.body) throw new Error('The server could not build it.');
      const reader = res.body.pipeThrough(new TextDecoderStream()).getReader();
      let buf = '';
      let href = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += value;
        let nl;
        while ((nl = buf.indexOf('\n')) >= 0) {
          const msg = JSON.parse(buf.slice(0, nl));
          buf = buf.slice(nl + 1);
          if (msg.type === 'progress') pdfBtn.textContent = `Building… ${msg.done} of ${msg.total}`;
          if (msg.type === 'done') {
            if (!msg.ok) throw new Error(msg.error || 'Build failed.');
            href = msg.href;
          }
        }
      }
      if (!href) throw new Error('Build stopped early.');
      const a = document.createElement('a');
      a.href = href;
      a.textContent = 'Download';
      a.className = 'book-share-link';
      pdfStatus.replaceChildren(a);
      a.click();
    } catch (err) {
      pdfStatus.textContent = err instanceof Error ? err.message : String(err);
    } finally {
      pdfBtn.disabled = false;
      pdfBtn.textContent = label;
    }
  });
</script>

<script>
  // The cover spread (issue #140): one page, so a plain request.
  const coverBtn = document.getElementById('book-cover') as HTMLButtonElement | null;
  coverBtn?.addEventListener('click', async () => {
    const status = document.getElementById('book-pdf-status');
    const trim = (document.getElementById('book-trim') as HTMLSelectElement | null)?.value ?? '';
    const bleed = (document.getElementById('book-bleed') as HTMLInputElement | null)?.checked ? '1' : '0';
    const spine = (document.getElementById('book-spine') as HTMLInputElement | null)?.value ?? '';
    coverBtn.disabled = true;
    const label = coverBtn.textContent;
    coverBtn.textContent = 'Building…';
    try {
      const data = await fetch(`/api/book/pdf?cover=1&trim=${encodeURIComponent(trim)}&bleed=${bleed}&spine=${encodeURIComponent(spine)}`, { method: 'POST' }).then((r) => r.json());
      if (!data.ok) throw new Error(data.error || 'The cover could not be built.');
      const a = document.createElement('a');
      a.href = data.href;
      a.textContent = 'Download cover';
      a.className = 'book-share-link';
      status?.replaceChildren(a);
      a.click();
    } catch (err) {
      if (status) status.textContent = err instanceof Error ? err.message : String(err);
    } finally {
      coverBtn.disabled = false;
      coverBtn.textContent = label;
    }
  });
</script>

<script>
  // Sequence on the floor (issue #147): work prints out, the floor's order in.
  import { applyOrder } from '../lib/floor/detect';

  const status = () => document.getElementById('book-pdf-status');
  document.getElementById('book-workprints')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'Building…';
    try {
      const d = await fetch('/api/book/floor?make=1', { method: 'POST' }).then((r) => r.json());
      if (!d.ok) throw new Error(d.error);
      const a = document.createElement('a');
      a.href = d.href;
      a.textContent = `Download work prints (${d.pages} pages)`;
      a.className = 'book-share-link';
      status()?.replaceChildren(a);
      a.click();
    } catch (err) {
      const s = status();
      if (s) s.textContent = err instanceof Error ? err.message : 'The work prints couldn’t be made.';
    } finally {
      btn.disabled = false;
      btn.textContent = label;
    }
  });

  const floor = document.getElementById('book-floor')!;
  const head = document.getElementById('book-floor-head')!;
  const strip = document.getElementById('book-floor-strip')!;
  let proposed: string[] = [];
  const cellOf = (id: string) => document.querySelector<HTMLElement>(`.book-cell[data-id="${CSS.escape(id)}"]`);

  document.getElementById('book-floor-file')?.addEventListener('change', async (e) => {
    const input = e.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    floor.hidden = false;
    head.textContent = 'Reading the prints…';
    strip.replaceChildren();
    try {
      const fd = new FormData();
      fd.append('photo', file);
      const d = await fetch('/api/book/floor', { method: 'POST', body: fd }).then((r) => r.json());
      if (!d.ok) throw new Error(d.error);
      const prints = d.prints as { id: string | null; score: number; pairedWithNext: boolean }[];
      proposed = prints.map((p) => p.id).filter((id): id is string => Boolean(id) && Boolean(cellOf(id!)));
      const unread = prints.length - proposed.length;
      // What changes, chapter by chapter, if this order is used.
      const moved = [...document.querySelectorAll<HTMLElement>('.book-chapter')].filter((ch) => {
        const ids = [...ch.querySelectorAll<HTMLElement>('.book-cell')].map((c) => c.dataset.id!);
        return applyOrder(ids, proposed).some((id, i) => id !== ids[i]);
      }).map((ch) => ch.dataset.name);
      head.textContent = `Read ${proposed.length} of ${prints.length} prints${unread ? ` (${unread} couldn’t be matched)` : ''}. `
        + (moved.length ? `Using this order changes ${moved.join(', ')}; each chapter keeps its own photos.` : 'That’s the order the book already has.');
      strip.replaceChildren(...prints.map((p, i) => {
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = p.id ? cellOf(p.id)?.querySelector('img')?.getAttribute('src') || '' : '';
        img.alt = '';
        const n = document.createElement('span');
        n.textContent = p.id ? String(i + 1) : '?';
        if (p.pairedWithNext) li.classList.add('paired');
        li.append(img, n);
        return li;
      }));
      (document.getElementById('book-floor-use') as HTMLButtonElement).disabled = moved.length === 0;
    } catch (err) {
      head.textContent = err instanceof Error ? err.message : 'The photo couldn’t be read.';
    }
  });

  document.getElementById('book-floor-use')?.addEventListener('click', () => {
    for (const ch of document.querySelectorAll<HTMLElement>('.book-chapter')) {
      const list = ch.querySelector<HTMLElement>('[data-chapter-list]');
      if (!list) continue;
      const cells = [...list.querySelectorAll<HTMLElement>('.book-cell')];
      const next = applyOrder(cells.map((c) => c.dataset.id!), proposed);
      list.append(...next.map((id) => cells.find((c) => c.dataset.id === id)!));
    }
    (window as unknown as { bookMarkDirty?: () => void }).bookMarkDirty?.();
    window.dispatchEvent(new Event('book:changed'));
    floor.hidden = true;
  });
  document.getElementById('book-floor-cancel')?.addEventListener('click', () => { floor.hidden = true; });
</script>

