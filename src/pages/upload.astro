---
import Layout from '../layouts/Layout.astro';
import { readManifest, readOverrides } from '../lib/manifest';
import { oklchCss, baseKeyOf } from '../lib/color';
import { GENRE_LABEL } from '../lib/types';
import { borderlineOf, chapterChoices } from '../lib/borderline';

export const prerender = false;
const manifest = await readManifest();
const overrides = await readOverrides();
// Issue #105/#106: every photo carries the base chapter the pipeline would
// choose (`auto`), the one it is actually filed under (`base`), and the
// chapter across the edge it sits on, if it sits on one.
const allPhotos = manifest.chapters.flatMap((c) =>
  c.photos.map((p) => {
    const auto = baseKeyOf(p.autoChapter);
    const moved = p.chapter !== auto;
    // The edge is kept even for a moved photo — it is a fact about the
    // colour, not the filing — and only shown while the photo is automatic,
    // so moving one back brings its marker back without another request.
    return { ...p, chapterName: c.name, auto, base: p.chapter, moved, edge: borderlineOf(p.oklch)?.alternative ?? '' };
  }),
);
const choices = chapterChoices(overrides.chapters);
const onEdge = allPhotos.filter((p) => p.edge && !p.moved).length;
// Same static echo as the archive's first chapter — see Layout's `accent`
// prop. Upload feeds this exact chapter system, so it earns the same tint.
const accent = manifest.chapters[0]
  ? oklchCss({ L: 0.78, C: Math.min(manifest.chapters[0].oklch.C, 0.11), H: manifest.chapters[0].oklch.H })
  : undefined;
---

<Layout title="Add & remove — Colour Archive" accent={accent} tab="upload">

  <main class="ingest">
    <header class="ingest-head">
      <h1>Add &amp; remove</h1>
    </header>

    <form id="form" class="drop" aria-label="Upload photographs">
      <input id="file" name="photos" type="file" accept="image/*" multiple hidden />
      <div class="drop-inner" id="zone" tabindex="0" role="button"
           aria-label="Choose photos or drop them here">
        <p class="drop-title">Drop photos, or <span class="link">browse</span></p>
        <p class="drop-sub">JPEG · PNG · TIFF · WebP · AVIF · HEIC · GIF</p>
      </div>
    </form>

    <div id="status" class="status" hidden>
      <div class="bar"><div class="bar-fill" id="bar"></div></div>
      <div class="status-row">
        <p id="status-text" class="status-text"></p>
        <button type="button" class="cancel" id="cancel" hidden>Cancel</button>
      </div>
    </div>

    <ul id="results" class="results" aria-live="polite"></ul>

    {/* Rendered even when empty, so photos added in this session can drop
        straight into it without a page reload. */}
    <section class="manage" id="manage" hidden={allPhotos.length === 0} data-choices={JSON.stringify(choices)}>
      <h2 class="manage-head">
        In the archive <span class="manage-count" id="manage-count">{allPhotos.length}</span>
      </h2>
      <div class="search-box manage-search" id="manage-search-box" hidden={allPhotos.length === 0}>
        <svg class="search-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="6.5" cy="6.5" r="5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input type="search" id="manage-search-input" placeholder="Search" aria-label="Search the archive by description" autocomplete="off" />
      </div>
      {/* Issue #106: the photos standing on a chapter edge are the ones worth
          checking by eye, so they can be pulled out of the grid on their own. */}
      <button type="button" class="edge-filter" id="edge-filter" aria-pressed="false" hidden={onEdge === 0}>
        <span class="edge-mark" aria-hidden="true">≈</span> On a chapter edge <span class="edge-count" id="edge-count">{onEdge}</span>
      </button>
      <div class="bulk-bar" id="bulk-bar" hidden>
        <span class="bulk-count" id="bulk-count">0 selected</span>
        <div class="bulk-actions">
          <button type="button" class="bulk-btn" id="bulk-film">Film</button>
          <button type="button" class="bulk-btn" id="bulk-digital">Digital</button>
          <select class="bulk-genre" id="bulk-genre" aria-label="Set genre for selected">
            <option value="" selected disabled>Genre…</option>
            <option value="street">Street</option>
            <option value="portrait">Portrait</option>
            <option value="landscape">Landscape</option>
            <option value="architecture">Architecture</option>
          </select>
          <select class="bulk-genre" id="bulk-chapter" aria-label="Move selected to a chapter">
            <option value="" selected disabled>Chapter…</option>
            <option value="auto">Automatic</option>
            {choices.map((c) => <option value={c.key}>{c.name}</option>)}
          </select>
          <button type="button" class="bulk-btn bulk-remove" id="bulk-remove">Remove</button>
          <button type="button" class="bulk-btn bulk-clear" id="bulk-clear">Clear</button>
        </div>
      </div>
      <div class="grid" id="grid">
        {allPhotos.map((p) => (
          <figure class="cell" data-id={p.id} data-medium={p.medium} data-genre={p.genre ?? ''} data-auto={p.auto} data-base={p.base} data-edge={p.edge} data-file={p.filename}>
            <img src={p.placeholder} data-src={p.derivatives[0].avif} alt="" loading="lazy" />
            <button class="cell-remove" type="button" data-remove={p.id} aria-label={`Remove ${p.filename}`}>×</button>
            <button class="cell-medium" type="button" data-medium-btn={p.id} title="Toggle film / digital">{p.medium}</button>
            <button class="cell-genre" type="button" data-genre-btn={p.id} title="Change genre">{p.genre ? GENRE_LABEL[p.genre] : '— genre'}</button>
            <span class="cell-select-mark" aria-hidden="true">✓</span>
            <figcaption>{p.chapterName}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  /* No topbar above this any more (the tab bar carries navigation), so the
     page opens on its own title; the foot clears the tab bar. */
  .ingest { max-width: 62rem; margin: 0 auto; padding: calc(env(safe-area-inset-top, 0px) + 4.5rem) 6vw calc(var(--tabbar-space) + 4rem); }
  .kicker { font-size: var(--t-caption); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .ingest-head h1 {
    font-family: var(--font-display); font-weight: var(--title-weight); font-style: var(--title-style);
    font-size: clamp(2.2rem, 5.5vw, 3.8rem); letter-spacing: var(--title-tracking);
    margin: 0.3rem 0 2.4rem; line-height: 1;
  }
  .lead { color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0 0 2.4rem; max-width: 40rem; }

  .drop { margin: 0; }
  /* Printer's crop marks, the same drop target Inspiration uses — one
     vocabulary for "put a file here" across the app, not two. */
  .drop-inner {
    border: 1px solid var(--separator); border-radius: 2px;
    padding: 4.5rem 2rem; text-align: center; cursor: pointer;
    transition: border-color 160ms, background-color 160ms, transform 120ms ease-out;
    background-color: transparent;
    background-image: var(--cropmarks-image); background-size: var(--cropmarks-size);
    background-position: var(--cropmarks-pos); background-repeat: no-repeat;
  }
  .drop-inner:hover, .drop-inner:focus-visible, .drop-inner.over {
    border-color: var(--rule); --mark: var(--fg);
    background-color: color-mix(in oklab, var(--fg) 3%, transparent);
  }
  .drop-inner:active { transform: scale(0.995); }
  .drop-title { font-family: var(--font-display); font-style: var(--title-style); font-size: 1.6rem; margin: 0 0 0.5rem; }
  .drop-sub { color: var(--secondary); font-size: var(--t-footnote); margin: 0; }
  .drop-note { font-size: var(--t-caption); margin-top: 0.5rem; opacity: 0.7; }
  .link { text-decoration: underline; text-underline-offset: 3px; }

  .status { margin-top: 1.6rem; }
  .bar { height: 2px; background: var(--border); overflow: hidden; }
  .bar-fill { height: 100%; width: 0; background: var(--fg); transition: width 200ms linear; }
  .status-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .status-text { color: var(--muted); font-size: 0.82rem; margin: 0.6rem 0 0; font-variant-numeric: tabular-nums; }
  .cancel {
    appearance: none; background: transparent; border: 0; cursor: pointer; flex: 0 0 auto;
    font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 500;
    color: var(--secondary); padding: 0.3rem 0; min-height: var(--hit);
    border-bottom: 1px solid transparent; transition: color 180ms, border-color 180ms, transform 110ms ease-out;
  }
  .cancel:hover { color: var(--accent-mix); border-bottom-color: currentColor; }
  .cancel:active { transform: scale(0.94); }

  /* The result rows and the manage cells are built in JS, so they never carry
     Astro's scope attribute — these rules have to be global or they simply do
     not apply to them. */
  .results { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  :global(.results li) {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.3rem 0.8rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border); font-size: 0.86rem;
    /* Same shape as .just-added below — a result arriving is the same kind of
       event as a cell arriving, so it gets the same entrance rather than a
       second, slightly different one. */
    animation: cellIn 420ms var(--ease) both;
  }
  @media (prefers-reduced-motion: reduce) { :global(.results li) { animation: none; } }
  :global(.results .sw) { width: 1.1rem; height: 1.1rem; border-radius: 50%; flex: 0 0 auto; border: 1px solid color-mix(in oklab, var(--fg) 18%, transparent); }
  :global(.results .fn) { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.results .ch) { color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; font-size: var(--t-caption); }
  :global(.results .skip) { color: var(--muted); font-style: italic; }
  :global(.results .err) { color: #e0603a; }
  /* Issue #61 — a chapter-fit verdict, on its own line under the row it
     belongs to (flex-basis 100% wraps it there without a second list item). */
  :global(.results .fit) { flex-basis: 100%; font-size: var(--t-footnote); color: var(--muted); }
  :global(.results .fit-keeps) { color: color-mix(in oklab, var(--fg) 70%, transparent); }
  :global(.results .fit-new-look) { color: #e0a63a; }

  .manage { margin-top: 4rem; }
  .manage-head { font-family: var(--font-display); font-style: var(--title-style); font-weight: var(--title-weight); font-size: 1.7rem; margin: 0 0 0.3rem; display: flex; align-items: baseline; gap: 0.6rem; }
  .manage-count { font-family: var(--font-label); font-size: 0.9rem; color: var(--muted); }
  .manage-note { color: var(--muted); font-size: 0.8rem; margin: 0 0 1.4rem; }
  .manage-note code { font-size: 0.92em; }
  .manage-search { margin: -0.6rem 0 1rem; }
  .manage-search input { width: 14rem; }

  .bulk-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin: -0.4rem 0 1rem; padding: 0.45rem 0.45rem 0.45rem 1rem;
    border: 1px solid var(--separator); border-radius: var(--r-pill);
    background: var(--surface-1);
  }
  /* `display: flex` above outranks the UA's [hidden], so the bar showed
     "0 selected" with nothing selected. */
  .bulk-bar[hidden], .edge-filter[hidden] { display: none; }
  .bulk-count {
    font-family: var(--font-label); font-size: var(--t-caption); letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted); flex: 0 0 auto;
  }
  .bulk-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .bulk-btn, .bulk-genre {
    appearance: none; cursor: pointer; border: 1px solid transparent; border-radius: 999px;
    background: var(--fill); color: var(--fg);
    font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 500;
    min-height: 2.25rem; padding: 0 0.95rem; transition: border-color 140ms, background 140ms;
  }
  .bulk-btn:hover, .bulk-genre:hover { background: var(--fill-hover); }
  .bulk-remove.armed { border-color: #c0392b; background: color-mix(in oklab, #c0392b 25%, transparent); }

  :global(.cell.selected) { box-shadow: 0 0 0 2px var(--accent-mix) inset; cursor: pointer; }
  :global(.cell) { cursor: pointer; }
  :global(.cell .cell-select-mark) {
    position: absolute; right: 6px; bottom: 6px; z-index: 2;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--accent-mix); color: #fff;
    font-size: 11px; line-height: 18px; text-align: center;
    opacity: 0; transform: scale(0.6); transition: opacity 120ms, transform 120ms;
  }
  :global(.cell.selected .cell-select-mark) { opacity: 1; transform: none; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 6px; }
  :global(.cell) {
    position: relative; margin: 0; aspect-ratio: 1; overflow: hidden; background: var(--border);
    transition: box-shadow 220ms var(--ease);
  }
  :global(.cell img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: filter 320ms var(--ease), transform 220ms var(--ease);
  }
  /* A restrained version of the archive/board's hover lift — this is a
     management grid meant to be scanned quickly, not a gallery, so the zoom
     is smaller and there's no colour/blur "develop" effect: these thumbnails
     need to stay legible the instant they're visible, not resolve into it. */
  @media (hover: hover) {
    :global(.cell:hover img) { transform: scale(1.04); }
    :global(.cell:hover) { box-shadow: 0 10px 28px -10px color-mix(in oklab, #000 55%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cell img) { transition: filter 320ms var(--ease); }
  }
  :global(.cell img[data-src]) { filter: blur(6px); }   /* placeholder until the real thumb lands */
  /* A photo added in this session announces itself, so you can see where in the
     grid it went. */
  :global(.just-added) { animation: cellIn 520ms var(--ease) both; }
  @keyframes cellIn { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.just-added) { animation: none; }
    :global(.cell img) { transition: none; }
  }
  :global(.cell figcaption) {
    position: absolute; left: 0; bottom: 0; right: 0;
    font-family: var(--font-ui); font-size: var(--t-caption); font-weight: 500; letter-spacing: 0; text-transform: capitalize;
    color: #fff; padding: 0.3rem 0.4rem;
    /* .cell-medium sits at left:6px on the same edge (bottom:6px), so this
       full-width caption needs to clear it or a long chapter name shows its
       tail past the pill ("Deep Yellow" → "FILM ELLOW"). 5rem clears the
       widest pill (.cell-medium showing "digital" at the touch-target size
       used under `pointer: coarse` — measured 73.6px) with a small margin;
       overflow/ellipsis is the backstop for whatever's still too long for
       what's left of the cell. */
    padding-left: 5rem;
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    background: linear-gradient(to top, color-mix(in oklab, #000 70%, transparent), transparent);
  }
  /* .cell-remove/.cell-medium/.cell-genre: Clear variant, same fix as
     .lb-tool/book.astro's cell buttons — icon/label chips floating over a
     photo thumbnail, was 6px, under Apple's stated 8-16px range. */
  :global(.cell-remove) {
    position: absolute; top: 6px; right: 6px; z-index: 2;
    width: 26px; height: 26px; border-radius: 50%; border: 0; cursor: pointer;
    background: color-mix(in oklab, #000 55%, transparent); color: #fff;
    font-size: 15px; line-height: 26px; text-align: center;
    opacity: 0; transition: opacity 140ms, background 140ms, transform 110ms ease-out;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
  }
  :global(.cell:hover .cell-remove), :global(.cell:focus-within .cell-remove) { opacity: 1; }
  :global(.cell-remove:hover) { background: color-mix(in oklab, #c0392b 82%, transparent); }
  :global(.cell-remove.armed) { background: #c0392b; opacity: 1; }
  :global(.cell-remove:active) { transform: scale(0.88); }
  :global(.cell-medium) {
    position: absolute; left: 6px; bottom: 6px; z-index: 2;
    border: 0; cursor: pointer; border-radius: 999px;
    font-family: var(--font-ui); font-size: var(--t-caption); font-weight: 500; letter-spacing: 0;
    text-transform: capitalize; padding: 0.2rem 0.55rem;
    background: color-mix(in oklab, #000 55%, transparent); color: #fff;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
    transition: background 140ms, transform 110ms ease-out;
  }
  :global(.cell[data-medium='film'] .cell-medium) { background: color-mix(in oklab, #b08968 78%, #000); }
  :global(.cell[data-medium='digital'] .cell-medium) { background: color-mix(in oklab, #4a6fa5 78%, #000); }
  :global(.cell-medium:hover) { filter: brightness(1.2); }
  :global(.cell-medium:active) { transform: scale(0.94); }
  :global(.cell-genre) {
    position: absolute; left: 6px; top: 6px; z-index: 2; max-width: calc(100% - 12px);
    border: 0; cursor: pointer; border-radius: 999px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-family: var(--font-ui); font-size: var(--t-caption); font-weight: 500; letter-spacing: 0;
    text-transform: capitalize; padding: 0.2rem 0.55rem;
    background: color-mix(in oklab, #000 55%, transparent); color: #fff;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
    transition: background 140ms, filter 140ms, transform 110ms ease-out;
  }
  :global(.cell[data-genre=''] .cell-genre) { color: color-mix(in oklab, #fff 60%, transparent); }
  :global(.cell-genre:hover) { filter: brightness(1.2); }
  :global(.cell-genre:active) { transform: scale(0.94); }
  @media (prefers-reduced-motion: reduce) {
    :global(.cell-remove:active), :global(.cell-medium:active), :global(.cell-genre:active) { transform: none; }
  }

  /* Round 3: quiet tiles, as on the Book page. At rest only the photograph;
     the ×, medium, genre and chapter appear on hover or focus, and on touch
     once a tile is selected (a tap already selects it here). */
  :global(.cell-medium), :global(.cell-genre), :global(.cell figcaption) {
    opacity: 0; transition: opacity 160ms var(--ease);
  }
  :global(.cell:is(:hover, :focus-within, .selected) :is(.cell-medium, .cell-genre, figcaption)),
  :global(.cell:is(.selected) .cell-remove) { opacity: 1; }
  /* An edge photo keeps its small amber mark at rest: it's a prompt to act. */
  :global(.cell.on-edge figcaption) { opacity: 1; background: none; }
  :global(.cell.on-edge:not(:hover):not(:focus-within):not(.selected) figcaption .cell-ch-name) { visibility: hidden; }
  @media (hover: none) {
    :global(.cell:not(.selected):not(:focus-within) :is(.cell-remove, .cell-medium, .cell-genre, figcaption)) { pointer-events: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cell-medium), :global(.cell-genre), :global(.cell figcaption) { transition: none; }
  }
  /* .cell-remove got the opacity fix above but stayed 26px; .cell-medium and
     .cell-genre had no touch accommodation at all — 18px tall, on a page
     whose whole job is managing photos, plausibly from a phone. Not pushed
     to the usual 44px floor: these sit on a 120px thumbnail, and three
     full-size targets stacked on one that small would cover more photo than
     it left visible. This is the size that fits without doing that. */
  @media (pointer: coarse) {
    :global(.cell-remove) { width: 32px; height: 32px; font-size: 17px; line-height: 32px; }
    :global(.cell-medium), :global(.cell-genre) { min-height: 28px; padding: 0.35rem 0.6rem; font-size: var(--t-caption); }
  }

  /* --- Chapter moves — issues #105/#106 ------------------------------------
     The caption *is* the control: a native <select> laid invisibly over it,
     so a tap on the iPad opens the system picker rather than a hand-built
     menu squeezed onto a 120px thumbnail. It starts where .cell-medium ends,
     so the medium pill underneath stays tappable. */
  :global(.cell figcaption .cell-chapter) {
    position: absolute; top: 0; bottom: 0; left: 5rem; right: 0; z-index: 1;
    width: calc(100% - 5rem); opacity: 0; cursor: pointer;
    font-size: 16px; /* under 16px iOS zooms the page on focus */
    appearance: none; border: 0; background: transparent;
  }
  :global(.cell figcaption) { pointer-events: auto; }
  :global(.cell figcaption:focus-within) { outline: 2px solid var(--accent-mix); outline-offset: -2px; }
  :global(.cell-edge) { color: #f0b54a; margin-right: 0.3em; font-family: var(--font-ui); letter-spacing: 0; }
  :global(.cell.moved .cell-ch-name)::after { content: ' ✎'; letter-spacing: 0; opacity: 0.8; }
  .edge-filter {
    appearance: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;
    margin: -0.4rem 0 1rem; min-height: 2.25rem; padding: 0 0.95rem;
    border: 1px solid var(--separator); border-radius: var(--r-pill); background: var(--surface-1); color: var(--fg);
    font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 500;
    transition: background 140ms, border-color 140ms;
  }
  .edge-filter:hover { background: var(--fill-hover); }
  .edge-filter[aria-pressed='true'] { border-color: #f0b54a; background: color-mix(in oklab, #f0b54a 14%, transparent); }
  .edge-mark { color: #f0b54a; }
  .edge-count { font-family: var(--font-label); color: var(--muted); }
  :global(.grid.edge-only .cell:not(.on-edge):not(.just-moved)) { display: none; }

  /* A new arrival's placement: the photos it now sits among, and the way to
     move it if they are the wrong company. */
  :global(.results .place) {
    flex-basis: 100%; display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.7rem;
    font-size: var(--t-footnote); color: var(--muted);
  }
  :global(.results .nb) { display: flex; gap: 3px; }
  :global(.results .nb img) { width: 36px; height: 36px; object-fit: cover; border-radius: 3px; background: var(--border); }
  :global(.results .row-chapter), :global(.results .edge-move) {
    appearance: none; cursor: pointer; border: 1px solid var(--separator); border-radius: 999px;
    background: var(--fill); color: var(--fg); font-family: var(--font-ui);
    font-size: var(--t-footnote); min-height: 2rem; padding: 0 0.8rem;
  }
  :global(.results .edge-move) { border-color: color-mix(in oklab, #f0b54a 60%, transparent); }
  :global(.results .edge-move:hover), :global(.results .row-chapter:hover) { background: var(--fill-hover); }
  @media (pointer: coarse) { :global(.results .row-chapter) { font-size: 16px; } }

  .foot { margin-top: 3rem; }
</style>

<script is:inline>
  const input = document.getElementById('file');
  const zone = document.getElementById('zone');
  const statusEl = document.getElementById('status');
  const bar = document.getElementById('bar');
  const statusText = document.getElementById('status-text');
  const results = document.getElementById('results');

  // Swap manage thumbnails from placeholder to the real derivative as they come
  // into view. This used to fire `new Image()` for every cell the instant the
  // page loaded — the whole archive at once, ahead of anything you could see,
  // competing with the upload you came here to do.
  const grid = document.getElementById('grid');
  const manage = document.getElementById('manage');
  const manageCount = document.getElementById('manage-count');
  const manageSearchBox = document.getElementById('manage-search-box');
  const swapIn = (img) => {
    const real = img.dataset.src;
    if (!real) return;
    delete img.dataset.src;
    const pre = new Image();
    pre.onload = () => { img.src = real; img.classList.add('in'); };
    pre.src = real;
  };
  const thumbObserver = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries, obs) => {
        for (const e of entries) if (e.isIntersecting) { obs.unobserve(e.target); swapIn(e.target); }
      }, { rootMargin: '300px' })
    : null;
  const watchThumb = (img) => (thumbObserver ? thumbObserver.observe(img) : swapIn(img));
  document.querySelectorAll('.cell img[data-src]').forEach(watchThumb);

  const pick = () => input.click();
  zone.addEventListener('click', pick);
  zone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); } });
  input.addEventListener('change', () => upload(input.files));

  ['dragenter', 'dragover'].forEach((ev) => zone.addEventListener(ev, (e) => { e.preventDefault(); zone.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => zone.addEventListener(ev, (e) => { e.preventDefault(); zone.classList.remove('over'); }));
  zone.addEventListener('drop', (e) => { if (e.dataTransfer?.files?.length) upload(e.dataTransfer.files); });
  // Dropping onto the page but missing the zone used to make the browser
  // navigate away and *open the photo*, losing the page you were working on.
  ['dragover', 'drop'].forEach((ev) => addEventListener(ev, (e) => {
    if (!zone.contains(e.target)) e.preventDefault();
  }));
  // Paste an image straight from the clipboard (⌘V) — screenshots, or a frame
  // copied out of another app.
  addEventListener('paste', (e) => {
    const files = Array.from(e.clipboardData?.files || []);
    if (files.length) { e.preventDefault(); upload(files); }
  });

  // Camera RAW can't be decoded by this sharp build. Catching it here rather
  // than server-side means you're told immediately, instead of after pushing
  // 50MB per file across the network to be rejected on arrival.
  const RAW_EXT = /\.(cr2|cr3|nef|arw|dng|raf|orf|rw2|pef|srw|x3f)$/i;
  const IMAGE_EXT = /\.(jpe?g|png|tiff?|webp|avif|heic|heif|gif)$/i;
  const CONCURRENCY = 3;   // the Mac processes these in parallel; the store write is serialised server-side
  const fmtBytes = (n) =>
    n >= 1e9 ? (n / 1e9).toFixed(1) + ' GB' : n >= 1e6 ? Math.round(n / 1e6) + ' MB' : Math.max(1, Math.round(n / 1e3)) + ' kB';

  let run = null;   // the upload in flight, so Cancel can stop it

  // One file, one request, with byte-level progress. fetch() cannot report
  // upload progress, and a whole batch in a single request meant the bar sat
  // still for minutes and one bad file failed the other seven.
  function send(file, onProgress) {
    return new Promise((resolve) => {
      const xhr = new XMLHttpRequest();
      run.inflight.add(xhr);
      xhr.open('POST', '/api/upload');
      xhr.upload.addEventListener('progress', (e) => { if (e.lengthComputable) onProgress(e.loaded); });
      xhr.addEventListener('load', () => {
        run.inflight.delete(xhr);
        onProgress(file.size);
        try {
          const data = JSON.parse(xhr.responseText);
          if (!data.ok) return resolve([{ filename: file.name, status: 'error', error: data.error || `HTTP ${xhr.status}` }]);
          resolve(data.results);
        } catch {
          resolve([{ filename: file.name, status: 'error', error: `Server returned ${xhr.status}` }]);
        }
      });
      xhr.addEventListener('error', () => {
        run.inflight.delete(xhr);
        resolve([{ filename: file.name, status: 'error', error: 'Connection lost' }]);
      });
      xhr.addEventListener('abort', () => { run.inflight.delete(xhr); resolve(null); });
      const fd = new FormData();
      fd.append('photos', file);
      xhr.send(fd);
    });
  }

  async function upload(fileList) {
    if (run) return;   // one run at a time
    const dropped = Array.from(fileList);
    const raw = [], other = [], files = [];
    for (const f of dropped) {
      if (RAW_EXT.test(f.name)) raw.push(f);
      else if (f.type.startsWith('image/') || IMAGE_EXT.test(f.name)) files.push(f);
      else other.push(f);
    }
    // Anything we won't send is said out loud. Dropping a folder of ARWs used
    // to do nothing whatsoever — no upload, no error, no acknowledgement.
    for (const f of raw) results.prepend(renderRow({ filename: f.name, status: 'unsupported', error: 'Camera RAW — export to JPEG or TIFF first' }));
    for (const f of other) results.prepend(renderRow({ filename: f.name, status: 'unsupported', error: 'Not an image' }));
    if (!files.length) {
      if (raw.length || other.length) {
        statusEl.hidden = false; bar.style.width = '0%'; cancelBtn.hidden = true;
        statusText.textContent = `Nothing to add — ${raw.length + other.length} file${raw.length + other.length > 1 ? 's' : ''} can't be read.`;
      }
      input.value = '';
      return;
    }

    const totalBytes = files.reduce((a, f) => a + f.size, 0);
    run = { cancelled: false, inflight: new Set() };
    statusEl.hidden = false; cancelBtn.hidden = false; bar.style.width = '0%';
    zone.setAttribute('aria-busy', 'true');

    const sent = new Array(files.length).fill(0);
    let done = 0, added = 0, failed = 0;
    // Two phases, and the slow one is not always the network: sending is
    // weighted by BYTES (a 40MB frame beside a 2MB one makes a file count lie),
    // but the Mac then decodes, derives and fingerprints each photo, which on a
    // large frame is seconds of work after its last byte arrives. Giving that a
    // real share of the bar keeps it from reaching 100% and sitting there.
    const XFER_SHARE = 0.7;
    const paint = () => {
      if (!run || run.cancelled) return;
      const bytes = sent.reduce((a, b) => a + b, 0);
      const xfer = totalBytes ? bytes / totalBytes : 1;
      bar.style.width = ((xfer * XFER_SHARE + (done / files.length) * (1 - XFER_SHARE)) * 100).toFixed(1) + '%';
      const tail = added ? ` · ${added} added` : '';
      statusText.textContent = bytes >= totalBytes
        // Everything's across; say plainly that the wait is now this machine
        // working, not a stalled transfer.
        ? `Processing on your Mac · ${done} of ${files.length}${tail}`
        : `Sending ${fmtBytes(bytes)} of ${fmtBytes(totalBytes)} · ${done} of ${files.length}${tail}`;
    };
    paint();

    let next = 0;
    const worker = async () => {
      while (!run.cancelled) {
        const i = next++;
        if (i >= files.length) return;
        const rows = await send(files[i], (loaded) => { sent[i] = loaded; paint(); });
        if (rows === null) return;                     // aborted
        for (const r of rows) {
          if (r.status === 'added') { added++; addCell(r); }
          else if (r.status === 'error' || r.status === 'unsupported') failed++;
          results.prepend(renderRow(r));
        }
        done++;
        paint();
      }
    };
    await Promise.all(Array.from({ length: Math.min(CONCURRENCY, files.length) }, worker));

    const cancelled = run.cancelled;
    run = null;
    cancelBtn.hidden = true;
    zone.removeAttribute('aria-busy');
    input.value = '';
    if (cancelled) {
      statusText.textContent = `Stopped. ${added} added, ${files.length - done} not sent.`;
      return;
    }
    bar.style.width = '100%';
    const parts = [`${added} added`];
    if (failed) parts.push(`${failed} skipped`);
    statusText.innerHTML = added
      ? `${esc(parts.join(' · '))}. <a href="/">View the archive →</a>`
      : esc(parts.join(' · ') + '.');
  }

  const cancelBtn = document.getElementById('cancel');
  cancelBtn.addEventListener('click', () => {
    if (!run) return;
    run.cancelled = true;
    statusText.textContent = 'Stopping…';
    // Photos already accepted by the Mac are kept; only what's still in flight
    // is dropped. Anything half-sent was never written to the archive.
    for (const xhr of run.inflight) xhr.abort();
  });
  // A run in progress is worth protecting from an accidental navigation.
  addEventListener('beforeunload', (e) => { if (run) { e.preventDefault(); e.returnValue = ''; } });

  function renderRow(r) {
    const li = document.createElement('li');
    if (r.status === 'skipped') {
      li.innerHTML = `<span class="sw" style="background:transparent"></span><span class="fn">${esc(r.filename)}</span><span class="ch skip">already added</span>`;
    } else if (r.status === 'unsupported' || r.status === 'error') {
      li.innerHTML = `<span class="sw" style="background:transparent"></span><span class="fn">${esc(r.filename)}</span><span class="ch err">${esc(r.error || r.status)}</span>`;
    } else {
      // Issue #61: how this photo's own measured look sits against the
      // chapter it just landed in — absent when the chapter has too few
      // other photos yet to have a settled look worth comparing to.
      const fit = r.chapterFit
        ? `<span class="fit fit-${esc(r.chapterFit.verdict)}">${esc(fitLabel(r.chapterFit.verdict))}</span>`
        : '';
      li.innerHTML = `<span class="sw" style="background:${r.swatch}"></span><span class="fn">${esc(r.filename)}</span><span class="ch">${esc(r.medium)} · ${esc(r.chapterName)}</span>${fit}`;
      li.dataset.id = r.id;
      li.dataset.medium = r.medium;
      li.append(placeRow(r));
    }
    return li;
  }

  // Issue #105: where a new arrival landed, shown as the company it now keeps,
  // with the one-tap move when it sits on an edge and the full picker always.
  function placeRow(r) {
    const place = document.createElement('div');
    place.className = 'place';
    const base = baseOf(r.chapterKey);
    if (r.neighbours?.length) {
      const nb = document.createElement('span');
      nb.className = 'nb';
      nb.title = `Closest in colour, in ${r.chapterName}`;
      for (const src of r.neighbours) {
        const img = document.createElement('img');
        img.src = src; img.alt = ''; img.decoding = 'async';
        nb.append(img);
      }
      place.append(nb);
    }
    if (r.borderline) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'edge-move';
      b.dataset.moveId = r.id; b.dataset.moveTo = r.borderline.alternative;
      b.textContent = `≈ Belongs in ${choiceName(r.borderline.alternative)}?`;
      b.title = r.borderline.edge === 'chroma'
        ? 'Its colour is right on the line between grey and a hue'
        : 'Its hue is right on the line between two chapters';
      place.append(b);
    }
    place.append(chapterSelect('row-chapter', r.id, base, base, r.filename));
    return place;
  }

  results.addEventListener('change', (e) => {
    const sel = e.target.closest('.row-chapter');
    if (sel) onChapterChange(sel);
  });
  results.addEventListener('click', async (e) => {
    const b = e.target.closest('.edge-move');
    if (!b) return;
    b.disabled = true;
    if (!(await moveTo([b.dataset.moveId], b.dataset.moveTo))) b.disabled = false;
  });

  function fitLabel(verdict) {
    if (verdict === 'keeps') return 'keeps the chapter’s look';
    if (verdict === 'new-look') return 'starts a new look here';
    return 'between this chapter’s look and a new one';
  }

  // ======================================================================
  //  Chapter moves — issues #105/#106. One path for all three places a
  //  photo can be moved from here (its cell, the bulk bar, a new arrival's
  //  row), so they can never disagree about where it went.
  // ======================================================================
  const CHOICES = JSON.parse(document.getElementById('manage')?.dataset.choices || '[]');
  const choiceName = (k) => CHOICES.find((c) => c.key === k)?.name || k;
  const baseOf = (k) => String(k || '').replace(/-(deep|pale)$/, '');
  const edgeFilter = document.getElementById('edge-filter');
  const edgeCount = document.getElementById('edge-count');

  function chapterSelect(cls, id, auto, base, label) {
    const sel = document.createElement('select');
    sel.className = cls;
    sel.dataset.chapterFor = id;
    sel.setAttribute('aria-label', `Chapter for ${label}`);
    sel.add(new Option(`Automatic · ${choiceName(auto)}`, 'auto'));
    for (const c of CHOICES) sel.add(new Option(c.name, c.key));
    sel.value = base && base !== auto ? base : 'auto';
    return sel;
  }

  // The name shown is the chapter the photo is actually *in*. That is
  // usually the one chosen, but a band split or the fold of a chapter too
  // small to stand alone can put it in a neighbour — the tooltip says so
  // rather than letting the caption quietly contradict the picker.
  function paintCaption(cell, name, landedKey) {
    const nm = cell.querySelector('.cell-ch-name');
    if (!nm) return;
    const moved = cell.dataset.base !== cell.dataset.auto;
    const edge = moved ? '' : cell.dataset.edge;
    nm.textContent = name;
    if (edge) {
      const mark = document.createElement('span');
      mark.className = 'cell-edge'; mark.textContent = '≈';
      nm.prepend(mark);
    }
    cell.classList.toggle('moved', moved);
    cell.classList.toggle('on-edge', Boolean(edge));
    const folded = landedKey && moved && baseOf(landedKey) !== cell.dataset.base;
    cell.querySelector('figcaption').title =
      folded ? `Filed under ${choiceName(cell.dataset.base)} — shown in ${name} until ${choiceName(cell.dataset.base)} has enough photos to be its own chapter`
      : moved ? `Moved here by you — the colour alone says ${choiceName(cell.dataset.auto)}`
      : edge ? `On the edge with ${choiceName(edge)}`
      : '';
  }

  function decorateCell(cell) {
    const cap = cell.querySelector('figcaption');
    if (!cap || cap.querySelector('.cell-chapter')) return;
    const name = cap.textContent.trim();
    cap.textContent = '';
    const nm = document.createElement('span');
    nm.className = 'cell-ch-name';
    cap.append(nm, chapterSelect('cell-chapter', cell.dataset.id, cell.dataset.auto, cell.dataset.base, cell.dataset.file || 'this photo'));
    paintCaption(cell, name);
  }

  function refreshEdgeCount() {
    const n = grid ? grid.querySelectorAll('.cell.on-edge').length : 0;
    if (edgeCount) edgeCount.textContent = String(n);
    if (edgeFilter) edgeFilter.hidden = n === 0 && edgeFilter.getAttribute('aria-pressed') !== 'true';
  }

  async function moveTo(ids, value) {
    let data;
    try {
      const res = await fetch('/api/chapter', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ids, chapter: value === 'auto' ? null : value }),
      });
      data = await res.json();
      if (!data.ok) throw new Error(data.error || `HTTP ${res.status}`);
    } catch (err) {
      console.error(err);
      return null;
    }
    for (const [id, where] of Object.entries(data.landed)) {
      const cell = cellFor(id);
      if (cell) {
        cell.dataset.base = where.base;
        // Stays put in the "on an edge" view even once it is off the edge —
        // vanishing mid-decision would take the undo with it.
        cell.classList.add('just-moved');
        const sel = cell.querySelector('.cell-chapter');
        if (sel) sel.value = where.auto ? 'auto' : where.base;
        paintCaption(cell, where.name, where.key);
      }
      const row = results.querySelector(`li[data-id="${id}"]`);
      if (row) {
        const ch = row.querySelector('.ch');
        if (ch) ch.textContent = `${row.dataset.medium} · ${where.name}`;
        const sel = row.querySelector('.row-chapter');
        if (sel) sel.value = where.auto ? 'auto' : where.base;
        row.querySelector('.edge-move')?.remove();
      }
    }
    refreshEdgeCount();
    return data.landed;
  }

  // Restore the picker to what the photo is filed under when a move fails,
  // so it never shows a chapter the server refused.
  async function onChapterChange(sel) {
    const id = sel.dataset.chapterFor;
    const cell = cellFor(id);
    const was = cell ? (cell.dataset.base !== cell.dataset.auto ? cell.dataset.base : 'auto') : null;
    sel.disabled = true;
    const ok = await moveTo([id], sel.value);
    sel.disabled = false;
    if (!ok && was) sel.value = was;
  }

  const GENRE_ORDER = ['street', 'portrait', 'landscape', 'architecture'];
  const GENRE_LABELS = { street: 'Street', portrait: 'Portrait', landscape: 'Landscape', architecture: 'Architecture' };

  // A photo added in this session joins the grid straight away, fully wired —
  // relabel or remove it without reloading the page first.
  function addCell(r) {
    if (!grid || grid.querySelector(`.cell[data-id="${r.id}"]`)) return;
    const fig = document.createElement('figure');
    fig.className = 'cell just-added';
    fig.dataset.id = r.id;
    fig.dataset.medium = r.medium || 'digital';
    fig.dataset.genre = r.genre || '';
    fig.dataset.auto = fig.dataset.base = baseOf(r.chapterKey);
    fig.dataset.edge = r.borderline?.alternative || '';
    fig.dataset.file = r.filename;
    const img = document.createElement('img');
    img.alt = ''; img.loading = 'lazy';
    img.src = r.placeholder || '';
    if (r.thumb) { img.dataset.src = r.thumb; watchThumb(img); }
    const btn = (cls, text, attr, val, label) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = cls; b.textContent = text;
      b.dataset[attr] = val;
      if (label) b.setAttribute('aria-label', label); else b.title = 'Change';
      return b;
    };
    const cap = document.createElement('figcaption');
    cap.textContent = r.chapterName || '';
    const mark = document.createElement('span');
    mark.className = 'cell-select-mark'; mark.setAttribute('aria-hidden', 'true'); mark.textContent = '✓';
    fig.append(
      img,
      btn('cell-remove', '×', 'remove', r.id, `Remove ${r.filename}`),
      btn('cell-medium', r.medium || 'digital', 'mediumBtn', r.id),
      btn('cell-genre', r.genre ? GENRE_LABELS[r.genre] : '— genre', 'genreBtn', r.id),
      mark,
      cap,
    );
    grid.prepend(fig);
    decorateCell(fig);
    refreshEdgeCount();
    if (manage) manage.hidden = false;
    if (manageSearchBox) manageSearchBox.hidden = false;
    if (manageCount) manageCount.textContent = String(grid.children.length);
  }

  // ======================================================================
  //  Manage-grid search (/api/search) — same CLIP text-vs-embedding endpoint
  //  and debounce/token pattern as the archive's own search box
  //  (index.astro), wired to filter #grid's cells instead of .collage.
  // ======================================================================
  const manageSearchInput = document.getElementById('manage-search-input');
  let manageSearchTimer = 0;
  let manageSearchToken = 0;
  function applyManageSearch(ids) {
    if (!grid) return;
    for (const cell of grid.children) {
      cell.hidden = ids !== null && !ids.has(cell.dataset.id);
    }
  }
  async function runManageSearch(q) {
    const token = ++manageSearchToken;
    if (!q) { applyManageSearch(null); return; }
    let data;
    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
      data = await res.json();
    } catch (err) { return; } // offline / server-only route missing — leave unfiltered
    if (token !== manageSearchToken) return; // a newer query has since started; this response is stale
    if (!data.ok || !data.ready) return;
    applyManageSearch(new Set(data.matches.map((m) => m.id)));
  }
  manageSearchInput?.addEventListener('input', (e) => {
    clearTimeout(manageSearchTimer);
    const q = e.target.value.trim();
    manageSearchTimer = setTimeout(() => runManageSearch(q), 350);
  });

  // ======================================================================
  //  Bulk select — shift-click range-select, the interaction already
  //  familiar from Finder/Photos, feeding /api/label and /api/genre in a
  //  loop rather than one photo, one confirm, one request at a time.
  // ======================================================================
  const bulkBar = document.getElementById('bulk-bar');
  const bulkCount = document.getElementById('bulk-count');
  const bulkFilm = document.getElementById('bulk-film');
  const bulkDigital = document.getElementById('bulk-digital');
  const bulkGenre = document.getElementById('bulk-genre');
  const bulkRemove = document.getElementById('bulk-remove');
  const bulkClear = document.getElementById('bulk-clear');

  const selected = new Set(); // photo ids
  let selectAnchor = null;

  const cellFor = (id) => grid?.querySelector(`.cell[data-id="${id}"]`);
  const orderedIds = () => (grid ? [...grid.children].map((c) => c.dataset.id) : []);

  function updateBulkBar() {
    if (!bulkBar) return;
    bulkBar.hidden = selected.size === 0;
    if (bulkCount) bulkCount.textContent = `${selected.size} selected`;
  }
  function setSelected(id, on) {
    const cell = cellFor(id);
    if (!cell) return;
    if (on) { selected.add(id); cell.classList.add('selected'); }
    else { selected.delete(id); cell.classList.remove('selected'); }
  }
  function clearSelection() {
    for (const id of selected) cellFor(id)?.classList.remove('selected');
    selected.clear();
    selectAnchor = null;
    updateBulkBar();
  }

  grid?.addEventListener('click', (e) => {
    if (e.target.closest('button, select')) return; // per-cell controls have their own handlers
    const cell = e.target.closest('.cell');
    if (!cell) return;
    const id = cell.dataset.id;
    if (e.shiftKey && selectAnchor && cellFor(selectAnchor)) {
      const ids = orderedIds();
      const a = ids.indexOf(selectAnchor);
      const b = ids.indexOf(id);
      if (a !== -1 && b !== -1) {
        const [lo, hi] = a < b ? [a, b] : [b, a];
        for (let i = lo; i <= hi; i++) setSelected(ids[i], true);
      }
    } else {
      setSelected(id, !selected.has(id));
      selectAnchor = id;
    }
    updateBulkBar();
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && selected.size) clearSelection(); });

  async function bulkSetMedium(next) {
    await Promise.all([...selected].map(async (id) => {
      const cell = cellFor(id);
      if (!cell) return;
      const prev = cell.dataset.medium;
      if (prev === next) return;
      cell.dataset.medium = next;
      const btn = cell.querySelector('.cell-medium');
      if (btn) btn.textContent = next;
      if (!(await post('/api/label', { id, medium: next }))) {
        cell.dataset.medium = prev;
        if (btn) btn.textContent = prev;
      }
    }));
  }
  bulkFilm?.addEventListener('click', () => bulkSetMedium('film'));
  bulkDigital?.addEventListener('click', () => bulkSetMedium('digital'));

  const bulkChapter = document.getElementById('bulk-chapter');
  bulkChapter?.addEventListener('change', async () => {
    const next = bulkChapter.value;
    if (!next || !selected.size) return;
    bulkChapter.disabled = true;
    await moveTo([...selected], next);
    bulkChapter.disabled = false;
    bulkChapter.value = '';
  });

  grid?.querySelectorAll('.cell').forEach(decorateCell);
  refreshEdgeCount();
  grid?.addEventListener('change', (e) => {
    const sel = e.target.closest('.cell-chapter');
    if (sel) onChapterChange(sel);
  });
  edgeFilter?.addEventListener('click', () => {
    const on = edgeFilter.getAttribute('aria-pressed') !== 'true';
    edgeFilter.setAttribute('aria-pressed', String(on));
    grid?.classList.toggle('edge-only', on);
    grid?.querySelectorAll('.just-moved').forEach((c) => c.classList.remove('just-moved'));
    refreshEdgeCount();
  });

  bulkGenre?.addEventListener('change', async () => {
    const next = bulkGenre.value;
    if (!next) return;
    await Promise.all([...selected].map(async (id) => {
      const cell = cellFor(id);
      if (!cell) return;
      const prev = cell.dataset.genre;
      cell.dataset.genre = next;
      const btn = cell.querySelector('.cell-genre');
      if (btn) btn.textContent = GENRE_LABELS[next];
      if (!(await post('/api/genre', { id, genre: next }))) {
        cell.dataset.genre = prev;
        if (btn) btn.textContent = prev ? GENRE_LABELS[prev] : '— genre';
      }
    }));
    bulkGenre.value = '';
  });

  // No auto-expiry: an armed confirm only cancels on an explicit outside
  // click (below), never just because the user paused to think it over.
  let bulkRemoveArmed = false;
  const disarmBulkRemove = () => {
    bulkRemoveArmed = false;
    if (bulkRemove) { bulkRemove.textContent = 'Remove'; bulkRemove.classList.remove('armed'); }
  };
  bulkRemove?.addEventListener('click', async () => {
    if (!bulkRemoveArmed) {
      bulkRemoveArmed = true;
      bulkRemove.textContent = `Remove ${selected.size}? Click again`;
      bulkRemove.classList.add('armed');
      return;
    }
    bulkRemoveArmed = false;
    bulkRemove.textContent = '…';
    const ids = [...selected];
    const results = await Promise.all(ids.map((id) => post('/api/remove', { id })));
    ids.forEach((id, i) => {
      if (results[i]) { cellFor(id)?.remove(); selected.delete(id); }
    });
    bulkRemove.textContent = 'Remove';
    bulkRemove.classList.remove('armed');
    if (manageCount) manageCount.textContent = String(grid.children.length);
    if (manage && grid.children.length === 0) manage.hidden = true;
    if (manageSearchBox && grid.children.length === 0) manageSearchBox.hidden = true;
    updateBulkBar();
  });
  bulkClear?.addEventListener('click', clearSelection);
  // Clicking anywhere outside the bar or the grid's cells cancels an armed
  // bulk-remove, same reasoning as the per-cell confirm below.
  document.addEventListener('click', (e) => {
    if (bulkRemoveArmed && !e.target.closest('.bulk-remove')) disarmBulkRemove();
  }, true);

  // One delegated listener for the whole grid, so cells added after load behave
  // exactly like the ones rendered on the server.
  let armed = null;
  const disarm = () => { if (armed) { armed.textContent = '×'; armed.classList.remove('armed'); armed = null; } };

  grid?.addEventListener('click', async (e) => {
    const target = e.target.closest('button');
    if (!target) return;
    const cell = target.closest('.cell');
    if (!cell) return;

    // --- medium (film ⇄ digital) ---
    if (target.classList.contains('cell-medium')) {
      const prev = cell.dataset.medium;
      const next = prev === 'film' ? 'digital' : 'film';
      cell.dataset.medium = next; target.textContent = next;      // optimistic
      if (!(await post('/api/label', { id: cell.dataset.id, medium: next }))) {
        cell.dataset.medium = prev; target.textContent = prev;    // revert
      }
      return;
    }

    // --- genre (cycles Street → Portrait → Landscape → Architecture) ---
    if (target.classList.contains('cell-genre')) {
      const prev = cell.dataset.genre;
      const next = GENRE_ORDER[(GENRE_ORDER.indexOf(prev) + 1) % GENRE_ORDER.length];
      cell.dataset.genre = next; target.textContent = GENRE_LABELS[next];
      if (!(await post('/api/genre', { id: cell.dataset.id, genre: next }))) {
        cell.dataset.genre = prev; target.textContent = prev ? GENRE_LABELS[prev] : '— genre';
      }
      return;
    }

    // --- remove (two-step confirm) ---
    if (target.classList.contains('cell-remove')) {
      if (armed !== target) {
        disarm();
        armed = target; target.textContent = '✓'; target.classList.add('armed');
        target.title = 'Click again to remove';
        return;
      }
      armed = null; target.textContent = '…';
      if (await post('/api/remove', { id: cell.dataset.id })) {
        selected.delete(cell.dataset.id);
        updateBulkBar();
        cell.remove();
        if (manageCount) manageCount.textContent = String(grid.children.length);
        if (manage && grid.children.length === 0) manage.hidden = true;
        if (manageSearchBox && grid.children.length === 0) manageSearchBox.hidden = true;
      } else {
        target.textContent = '×';
        target.classList.remove('armed');
      }
    }
  });
  // Clicking anywhere else cancels an armed delete, rather than leaving a photo
  // one stray click from removal indefinitely.
  document.addEventListener('click', (e) => { if (armed && !e.target.closest('.cell-remove')) disarm(); }, true);

  async function post(url, body) {
    try {
      const res = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || `HTTP ${res.status}`);
      return true;
    } catch (err) {
      console.error(err);
      return false;
    }
  }

  function esc(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
</script>
