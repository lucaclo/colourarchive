---
import Layout from '../layouts/Layout.astro';
import { readInspManifest, readInspStore } from '../lib/inspiration';
import { readManifest } from '../lib/manifest';
import { oklchCss } from '../lib/color';
import { warmRegionModels } from '../lib/match/regions';
import { warmGenre } from '../lib/genre';
import { clusterByEmbedding } from '../lib/similar';
import { GENRES, GENRE_LABEL } from '../lib/types';
import { encodePalette, searchPalette } from '../lib/colour-search';
import ColourFilter from '../components/ColourFilter.astro';

export const prerender = false;

// Fire-and-forget: get the segmentation/CLIP models loading into memory the
// moment this page is requested, not the moment someone presses "match" —
// each getX() below is a memoized singleton, so a second visit is a no-op,
// and a failed/slow download here just means the first match still falls
// back to loading on demand, same as before this existed.
void warmRegionModels().catch(() => {});
void warmGenre().catch(() => {});

const manifest = await readInspManifest();
const hasItems = manifest.count > 0;

// Alternate ways to group the same board — issue #88. Colour chapters (above)
// are already the default, server-built grouping; genre and embedding-cluster
// are computed here too, once per request, so switching between them on the
// client is just moving existing DOM nodes around rather than a second model
// call or a fetch. `genre` survives onto `manifest`'s own photos (unlike the
// embeddings — see `buildManifest`'s stripping, manifest.ts), so only the
// cluster pass needs the raw store.
interface GroupBucket { label: string; ids: string[]; }

const genreGroups: GroupBucket[] = (() => {
  const byGenre = new Map<string, string[]>();
  for (const ch of manifest.chapters) {
    for (const p of ch.photos) {
      const key = p.genre ?? 'unclassified';
      const ids = byGenre.get(key);
      if (ids) ids.push(p.id); else byGenre.set(key, [p.id]);
    }
  }
  const ordered = GENRES.filter((g) => byGenre.has(g)).map((g) => ({ label: GENRE_LABEL[g], ids: byGenre.get(g)! }));
  const rest = byGenre.get('unclassified');
  return rest ? [...ordered, { label: 'No genre yet', ids: rest }] : ordered;
})();

const clusterGroups: GroupBucket[] = await (async () => {
  const clustered = clusterByEmbedding(await readInspStore());
  const inACluster = new Set(clustered.flatMap((g) => g.map((p) => p.id)));
  const groups = clustered.map((g, i) => ({ label: `Group ${i + 1}`, ids: g.map((p) => p.id) }));
  const leftOver = manifest.chapters.flatMap((ch) => ch.photos.map((p) => p.id)).filter((id) => !inACluster.has(id));
  return leftOver.length ? [...groups, { label: 'On their own', ids: leftOver }] : groups;
})();

// Arriving from the archive lightbox's "Match this look" (index.astro,
// ?match=<archive id>) — resolved here rather than client-side because the
// photo is not necessarily on this board's own DOM at all, the way a
// `.cell-match` reference is.
const matchId = Astro.url.searchParams.get('match');
let matchArchiveRef: { id: string; full: string; name: string } | null = null;
if (matchId) {
  const archive = await readManifest();
  const photo = archive.chapters.flatMap((c) => c.photos).find((p) => p.id === matchId);
  if (photo) {
    const largest = photo.derivatives[photo.derivatives.length - 1];
    matchArchiveRef = { id: photo.id, full: largest.avif, name: photo.filename };
  }
}
// A static echo of the board's own palette — see Layout's `accent` prop.
// Inspiration has no scroll narrative to drive this dynamically the way the
// archive does, so it's one representative hue for the whole page rather
// than something that changes as you scroll.
const accent = manifest.chapters[0]
  ? oklchCss({ L: 0.78, C: Math.min(manifest.chapters[0].oklch.C, 0.11), H: manifest.chapters[0].oklch.H })
  : undefined;
---

<Layout title="Inspiration — Colour Archive" accent={accent} tab="inspiration">

  <main class="insp">
    <!-- The board comes first; adding sits behind one button (Cosmos,
         Are.na). It starts open only when there is nothing on the board yet.
         Dragging files over the page or pasting anywhere also adds. -->
    <header class="insp-head">
      <h1>Reference</h1>
      <button class="insp-addbtn" id="add-toggle" type="button" aria-expanded={hasItems ? 'false' : 'true'} aria-controls="insp-add">Add</button>
    </header>

    <section class="insp-add" id="insp-add" hidden={hasItems}>
      <form id="form">
        <input id="file" type="file" accept="image/*" multiple hidden />
        <div class="drop" id="zone" tabindex="0" role="button" aria-label="Drop images or browse">
          <p class="drop-title">Drop pictures here, or <span class="link">choose some</span></p>
        </div>
      </form>
      <div class="urlrow">
        <input id="url" type="url" placeholder="Or paste a link to the image" />
        <input id="source" type="text" placeholder="Whose is it? (optional)" />
        <button id="addurl" type="button">Add</button>
      </div>
    </section>
    <div id="status" class="status" hidden><div class="bar"><div class="bar-fill" id="bar"></div></div><p id="status-text"></p></div>
    <ul id="results" class="results"></ul>
    <div class="drop-veil" id="drop-veil" hidden aria-hidden="true"><p>Drop to pin up</p></div>

    <!-- Style Match reports you've explicitly kept (POST /api/match/keep) —
         the library that mx-keep's "Kept" button used to write to with no way
         back. Populated client-side (see the module script below), because
         which reports are kept can change without a page reload: keeping one
         from inside the workbench should make it appear here the moment the
         panel closes, not after a refresh. Hidden until that first fetch
         finds at least one, so an archive with none yet shows nothing. -->
    <section class="kept" id="kept" hidden>
      <header class="kept-head">
        <h2 class="kept-kicker">Matches I kept</h2>
        <p class="kept-sub" id="kept-sub"></p>
      </header>
      <ul class="kept-strip" id="kept-strip"></ul>
    </section>

    {
      hasItems ? (
        <>
          <div class="insp-groupby" id="groupby" role="group" aria-label="Group the board by">
            <button type="button" class="on" data-groupby="colour">Colour</button>
            <button type="button" data-groupby="genre">Genre</button>
            <button type="button" data-groupby="cluster">Similar</button>
            <span class="insp-cf"><ColourFilter items=".insp-frame" /></span>
          </div>
          <p class="insp-cf-empty" id="insp-cf-empty" hidden>No references near this colour.</p>
          <script type="application/json" id="insp-groupings" is:inline set:html={JSON.stringify({ genre: genreGroups, cluster: clusterGroups })} />
          <div class="insp-board" id="board">
            {/* Three parallel groupings of the same photos, not three copies —
                only "colour" ever renders the actual <figure> elements; genre
                and cluster start as empty, labelled collages that the client
                script fills by *moving* those same nodes in, so state (drag,
                selection, event listeners) never has to survive a rebuild.
                See #88 and the script below ("Group by"). */}
            <div class="insp-view" data-view="colour">
              {manifest.chapters.map((ch) => (
                <section class="insp-chapter">
                  <h2 class="insp-chtitle">
                    <span class="sw" style={`background:${oklchCss(ch.oklch)}`} />
                    {ch.name}<span class="n">{ch.photos.length}</span>
                  </h2>
                  <div class="collage insp-collage">
                    {ch.photos.map((p) => {
                      const largest = p.derivatives[p.derivatives.length - 1];
                      return (
                        <figure class="frame insp-frame" data-id={p.id} data-full={largest.avif}
                                data-source={p.source ?? ''}
                                data-palette={p.palette ? encodePalette(searchPalette(p.palette, p.oklch)) : ''}
                                style={`--frame-bg:${oklchCss(p.oklch)};aspect-ratio:${p.width}/${p.height}`}>
                          <img class="ph" src={p.placeholder} alt="" aria-hidden="true" />
                          {/* Every derivative is AVIF, so <picture> had no second
                              format to offer — see the archive for the same fix. */}
                          <img
                            class="photo"
                            srcset={p.derivatives.map((d) => `${d.avif} ${d.width}w`).join(', ')}
                            sizes="(max-width:980px) 50vw, 33vw"
                            src={largest.avif}
                            width={p.width}
                            height={p.height}
                            loading="lazy"
                            decoding="async"
                            alt={p.source ? `Reference — ${p.source}` : 'Reference image'}
                          />
                          <button class="cell-remove" type="button" data-remove={p.id} aria-label="Remove">×</button>
                          <button class="cell-similar" type="button" data-similar={p.id} data-full={largest.avif} data-source={p.source ?? ''} aria-label="Find similar in your archive">Similar</button>
                          <button class="cell-match" type="button" data-match={p.id} data-full={largest.avif} data-name={p.filename} aria-label="Match this look in Lightroom">Match</button>
                          <button class="cell-group" type="button" data-group={p.id} data-full={largest.avif} data-source={p.source ?? ''} aria-pressed="false" aria-label="Add to a group of similarly-edited references">+ group</button>
                          {p.source && <figcaption class="src">{p.source}</figcaption>}
                        </figure>
                      );
                    })}
                  </div>
                </section>
              ))}
            </div>
            <div class="insp-view" data-view="genre" hidden>
              {genreGroups.map((g) => (
                <section class="insp-chapter">
                  <h2 class="insp-chtitle">{g.label}<span class="n">{g.ids.length}</span></h2>
                  <div class="collage insp-collage" data-collage={g.label} />
                </section>
              ))}
            </div>
            <div class="insp-view" data-view="cluster" hidden>
              {clusterGroups.map((g) => (
                <section class="insp-chapter">
                  <h2 class="insp-chtitle">{g.label}<span class="n">{g.ids.length}</span></h2>
                  <div class="collage insp-collage" data-collage={g.label} />
                </section>
              ))}
            </div>
          </div>
        </>
      ) : (
        <p class="insp-empty">Nothing pinned up yet.</p>
      )
    }
  </main>

  <script type="application/json" id="match-archive-data" is:inline set:html={JSON.stringify(matchArchiveRef)} />

  <!-- Floating tray: the group of similarly-edited references being built up
       across the board, one "+ group" tap at a time. Only ever visible with
       at least one member — see `renderTray()`. -->
  <div class="group-tray" id="group-tray" hidden role="status">
    <span class="group-tray-count" id="group-tray-count"></span>
    <button class="group-tray-clear" id="group-tray-clear" type="button">Clear</button>
    <button class="group-tray-find" id="group-tray-find" type="button">Find mine like these</button>
    <button class="group-tray-find" id="group-tray-match" type="button">Match the look</button>
  </div>

  <!-- Split view: reference(s) pinned left, ranked archive matches right. A
       single reference gets the large centred image it always has; two or
       more switch to a strip so every member of the group is visible, each
       removable, an outlier from the group's own colour flagged in place. -->
  <div class="sim" id="sim" hidden>
    <button class="lb-close" id="sim-close" aria-label="Close">×</button>
    <div class="sim-left">
      <img id="sim-ref" alt="" />
      <p class="sim-count" id="sim-count" hidden></p>
      <div class="sim-strip" id="sim-strip" hidden></div>
      <p class="lb-src" id="sim-src"></p>
      <div class="sim-controls">
        <div class="sim-slider">
          <span>Colour</span>
          <input type="range" id="sim-w" min="0" max="100" value="60" aria-label="Colour to composition" />
          <span>Composition</span>
        </div>
        <p class="sim-hint" id="sim-hint"></p>
      </div>
    </div>
    <div class="sim-right" id="sim-right"></div>
  </div>

  <!-- Style match: reference + your photo -> measured evidence, Lightroom
       values, a live preview, and an importable preset. -->
  <div class="mx" id="mx" hidden>
    <header class="mx-head">
      <div>
        <p class="mx-kicker">Match the look</p>
        <p class="mx-sub" id="mx-sub"></p>
      </div>
      <button class="lb-close mx-close" id="mx-close" aria-label="Close">×</button>
    </header>

    <div class="mx-body">
      <section class="mx-start" id="mx-start">
        <div class="mx-refcol">
          <ul class="mx-refs" id="mx-refs"></ul>
          <div class="mx-addref">
            <button type="button" class="mx-addref-toggle" id="mx-addref-toggle" aria-expanded="false">
              Add another reference
            </button>
            <ul class="mx-addref-strip" id="mx-addref-strip" hidden></ul>
          </div>
        </div>
        <div class="mx-startcol">
          <div class="drop mx-zone" id="mx-zone" tabindex="0" role="button" aria-label="Drop your photo or browse">
            <p class="drop-title">Drop your photo here, or <span class="link">choose it</span></p>
            <p class="drop-sub mx-batch-hint">Several at once for a preset each</p>
          </div>
          <input id="mx-file" type="file" multiple hidden />
          <div class="mx-working" id="mx-working" hidden>
            <div class="mx-workbar"><span id="mx-workbar-fill"></span></div>
            <p class="mx-workline">
              <span id="mx-workstage">Measuring</span>
              <span class="mx-elapsed" id="mx-elapsed"></span>
              <button type="button" class="mx-stop" id="mx-stop">Stop waiting</button>
            </p>
          </div>
          <!-- Batch: several of your photos, each solved on its own against the
               same reference, one preset per photo in a zip. -->
          <div class="mx-batch" id="mx-batch" hidden>
            <p class="mx-batch-head">
              <span id="mx-batch-count" aria-live="polite"></span>
              <button type="button" class="mx-stop" id="mx-batch-stop">Stop</button>
            </p>
            <ul class="mx-batch-list" id="mx-batch-list"></ul>
            <div class="mx-batch-foot" id="mx-batch-foot" hidden>
              <label class="mx-batch-strength">
                <span>Strength</span>
                <input type="range" id="mx-batch-strength" min="0" max="100" value="50" aria-label="Strength for every preset" />
                <output id="mx-batch-strength-out">50%</output>
              </label>
              <button type="button" class="mx-batch-download" id="mx-batch-download">Download presets</button>
            </div>
          </div>
          <label class="mx-field">
            <span>If it’s a RAW, start from</span>
            <select id="mx-baseline">
              <option value="macos">The Mac’s decode</option>
              <option value="export">A zero-slider JPEG (exact)</option>
              <option value="preview">The camera preview (quickest)</option>
            </select>
          </label>
          <p class="mx-note" id="mx-status" aria-live="polite"></p>
        </div>

        <!-- Before you edit anything: the photographs in the archive that
             already measure like this one. Some evenings the answer is that you
             took it already, and being shown those frames is worth more than
             being handed a preset.

             On the *start* screen, spanning both columns, because it is the
             question you would ask first if it occurred to you to ask it —
             putting it after the report would make it a footnote to work you
             might not have needed to do. -->
        <section class="already" id="already" hidden>
          <header class="already-head">
            <p class="already-kicker">Already in the archive</p>
            <p class="already-sub" id="already-sub"></p>
          </header>
          <ul class="already-strip" id="already-strip"></ul>
          <p class="already-note" id="already-note"></p>
        </section>
      </section>

      <section class="mx-result" id="mx-result" hidden>
        <!-- Stage: collapses as the report scrolls, so the reading area grows
             instead of the pictures permanently owning half the screen. -->
        <div class="mx-stage" id="mx-stage">
          <div class="mx-frames">
            <figure class="mx-fig">
              <canvas id="mx-canvas"></canvas>
              <figcaption><span id="mx-wipehint">Yours, graded</span></figcaption>
              <span class="mx-holdhint" aria-hidden="true">Hold for the original</span>
            </figure>
            <figure class="mx-fig">
              <img id="mx-refside" alt="" />
              <figcaption><span id="mx-refside-caption">The reference</span></figcaption>
            </figure>
          </div>

          <div class="mx-bar">
            <div class="mx-strength">
              <span class="mx-end">None</span>
              <input type="range" id="mx-strength" min="0" max="100" value="50" aria-label="Match strength" />
              <span class="mx-end">Full</span>
            </div>
            <p class="mx-strengthlabel" id="mx-strengthlabel"></p>
            <button type="button" class="mx-groupreveal" id="mx-groupreveal" aria-expanded="false">
              Separate sliders ›
            </button>
            <label class="mx-check">
              <input type="checkbox" id="mx-wipe" /><span>Before / after</span>
            </label>
          </div>

          <!-- One flat strength moves Light, Colour and Effects together, which is
               the default and all most matches need. This row lets any of the
               three come off that master and move on its own — full strength on
               Colour Grading while Light holds back, say — without needing three
               sliders visible all the time. Dragging a group's own slider unlinks
               it; the ⚭ button relinks it to the master. -->
          <div class="mx-groupbar" id="mx-groupbar" hidden>
            <label class="mx-groupslider">
              <span class="mx-grouplabel">Light</span>
              <input type="range" id="mx-strength-light" min="0" max="100" value="50" aria-label="Light strength" />
              <button type="button" class="mx-unlink" id="mx-unlink-light" aria-pressed="false" aria-label="Light follows the main slider" title="Follows the main slider"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></button>
            </label>
            <label class="mx-groupslider">
              <span class="mx-grouplabel">Colour</span>
              <input type="range" id="mx-strength-colour" min="0" max="100" value="50" aria-label="Colour strength" />
              <button type="button" class="mx-unlink" id="mx-unlink-colour" aria-pressed="false" aria-label="Colour follows the main slider" title="Follows the main slider"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></button>
            </label>
            <label class="mx-groupslider">
              <span class="mx-grouplabel">Effects</span>
              <input type="range" id="mx-strength-effects" min="0" max="100" value="50" aria-label="Effects strength" />
              <button type="button" class="mx-unlink" id="mx-unlink-effects" aria-pressed="false" aria-label="Effects follows the main slider" title="Follows the main slider"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></button>
            </label>
          </div>
        </div>

        <!-- Tabs mirror Lightroom's own panel order, so what you read here maps
             onto where you'll type it there. -->
        <nav class="mx-tabs" id="mx-tabs" role="tablist">
          <button type="button" role="tab" data-tab="light" class="on">Light</button>
          <button type="button" role="tab" data-tab="colour">Colour</button>
          <button type="button" role="tab" data-tab="details">Details</button>
          <button type="button" role="tab" data-tab="measured">Measured</button>
          <button type="button" role="tab" data-tab="notes">
            Notes<span class="count" id="mx-notecount"></span>
          </button>
          <button type="button" role="tab" data-tab="check" id="mx-tab-check">Check</button>
        </nav>

        <div class="mx-scroll" id="mx-scroll">
          <div class="mx-badges" id="mx-badges"></div>
          <div class="mx-panel" data-panel="light" id="mx-light"></div>
          <div class="mx-panel" data-panel="colour" id="mx-colour" hidden></div>
          <div class="mx-panel" data-panel="details" id="mx-details" hidden></div>
          <div class="mx-panel" data-panel="measured" id="mx-evidence" hidden></div>
          <div class="mx-panel" data-panel="notes" id="mx-notes" hidden></div>
          <div class="mx-panel" data-panel="check" id="mx-rt" hidden></div>
        </div>

        <!-- Always reachable, so the primary action never scrolls away. -->
        <footer class="mx-actions">
          <button id="mx-dl" type="button">Download preset</button>
          <button id="mx-keep" type="button" class="ghost">Keep</button>
          <div class="mx-more">
            <button id="mx-more" type="button" class="ghost mx-more-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="mx-more-menu" aria-label="More downloads" title="More downloads">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="18" cy="12" r="1.6"/></svg>
            </button>
            <div class="mx-more-menu" id="mx-more-menu" role="menu" hidden>
              <button id="mx-dl-safe" type="button" role="menuitem">Download without masks</button>
            </div>
          </div>
        </footer>
      </section>
    </div>
  </div>

  <div class="insp-lb" id="lb" hidden>
    <button class="lb-close" id="lb-close" aria-label="Close">×</button>
    <img id="lb-img" alt="" />
    <div class="lb-src" id="lb-src"></div>
  </div>

  <!-- Enlarged tone curve: the in-panel curve is 116px, too small to read a
       point's exact position against Lightroom's own 0-255 axes. This is the
       same curve, bigger, with quarter gridlines and the exact input/output
       of every point printed below it. -->
  <div class="curve-lb" id="curve-lb" hidden>
    <button class="lb-close" id="curve-lb-close" aria-label="Close">×</button>
    <div class="curve-lb-body">
      <div id="curve-lb-svg"></div>
      <div class="curve-lb-points">
        <p class="curve-lb-hint">Input → output, 0–255</p>
        <div id="curve-lb-list"></div>
      </div>
    </div>
  </div>
<script>
  // Colour search on the board (components/ColourFilter.astro). Frames move
  // between the Colour, Genre and Similar views, so the filter hides frames
  // by id wherever they sit, then hides any group left with nothing in it.
  const empty = document.getElementById('insp-cf-empty');
  window.addEventListener('colourfilter', (e) => {
    const { ids } = (e as CustomEvent<{ ids: Set<string> | null }>).detail;
    let shown = 0;
    for (const f of document.querySelectorAll<HTMLElement>('.insp-frame')) {
      const out = ids !== null && !ids.has(f.dataset.id || '');
      f.classList.toggle('cf-out', out);
      if (!out) shown++;
    }
    for (const c of document.querySelectorAll<HTMLElement>('.insp-chapter, [data-collage]')) {
      const box = c.matches('[data-collage]') ? c.closest<HTMLElement>('section') ?? c : c;
      box.classList.toggle('cf-out', ids !== null && !c.querySelector('.insp-frame:not(.cf-out)'));
    }
    if (empty) empty.hidden = ids === null || shown > 0;
  });
</script>

<style is:global>
  .insp-frame.cf-out, .insp-chapter.cf-out, .insp-view section.cf-out { display: none !important; }
  .insp-cf { display: inline-flex; margin-left: var(--sp-2); }
  .insp-cf-empty { text-align: center; color: var(--secondary); font-family: var(--font-ui); font-size: var(--t-body); margin: var(--sp-6) 0; }
</style>
<style is:global>
  .mx-batch-hint { margin-top: 0.3rem; }
  .mx-batch[hidden], .mx-batch-foot[hidden] { display: none; }
  .mx-batch { margin-top: var(--sp-3); font-family: var(--font-ui); font-size: var(--t-footnote); }
  .mx-batch-head { display: flex; align-items: center; justify-content: space-between; margin: 0 0 var(--sp-2); font-family: var(--font-data); font-size: var(--t-caption); color: var(--secondary); }
