  .curve-lb-points { max-width: 22rem; }
  .curve-lb-hint { font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); line-height: 1.5; margin: 0 0 0.9rem; }
  /* #curve-lb-list, not .curve-lb-list — the element carries the id, not a
     class of the same name. The container rule stays scoped (it's the real
     template element); the row rule is :global because those rows are built
     at runtime (openCurveLb's document.createElement) and never carry
     Astro's scoping attribute — same trap as astro-scoped-styles-runtime-elements. */
  #curve-lb-list { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--font-label); font-size: var(--t-caption); letter-spacing: 0.02em; }
  :global(#curve-lb-list .row) { display: flex; justify-content: space-between; gap: 1rem; padding: 0.3rem 0.6rem; border-radius: 3px; background: color-mix(in oklab, var(--fg) 4%, transparent); }
  :global(#curve-lb-list .row.identity) { color: var(--muted); }

  /* The in-panel curve is a button now, not inert — matches the app's own
     press feedback and gives it a visible affordance to click. */
  .mx-curve-btn { all: unset; cursor: zoom-in; display: block; border-radius: 4px; }
  /* Focus ring now comes from the panel-wide rule near .mx's own definition. */

  /* --- Style match ---------------------------------------------------- */
  .cell-match {
    position: absolute; left: 6px; top: 34px; z-index: 3;
    border: 0; cursor: pointer; border-radius: 999px;
    font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.28rem 0.62rem; color: #fff; background: color-mix(in oklab, #000 55%, transparent);
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
    opacity: 0; transition: opacity 140ms, background 140ms;
  }
  .insp-frame:hover .cell-match, .insp-frame:focus-within .cell-match { opacity: 1; }
  .cell-match:hover { background: color-mix(in oklab, var(--fg) 22%, #000); }

  /* ── Touch ───────────────────────────────────────────────────────────────
     Every action on a reference was revealed by :hover, which a finger does
     not have. `.cell-remove` and `.cell-similar` at least had a fallback in
     global.css; `.cell-match` had none, so on the iPad — the device this is
     actually used from — Style Match could not be started at all.
     The pills stay visually small so they don't bury the photograph; the
     tappable area is grown to 44px around them instead. */
  /* `pointer: coarse` as well as `hover: none`: an iPad with a Magic Keyboard
     reports hover, but it is still a screen you reach out and touch. */
  @media (hover: none), (pointer: coarse) {
    .cell-match, .cell-similar, .cell-remove, .cell-group { opacity: 0.9; }
    .cell-match::after, .cell-similar::after, .cell-remove::after, .cell-group::after {
      content: ''; position: absolute; inset: -12px;
    }
    /* Held 12px off each edge, not 6: `.insp-frame` clips its overflow, so an
       expanded hit area hanging past the tile is clipped away with it. */
    .cell-similar { left: 12px; top: 12px; }
    .cell-remove { right: 12px; top: 12px; }
    /* Three corners. Stacked 28px apart, two 44px targets overlap — and a
       mis-tap here starts a twenty-second measurement. */
    .cell-match { top: auto; left: auto; bottom: 12px; right: 12px; }
    /* The fourth corner. Same reasoning as `.cell-match` above — a fourth
       stacked at top-left would overlap `.cell-similar`'s grown hit area
       just as a third once did. */
    .cell-group { left: 12px; bottom: 12px; }
    /* The credit is hover-revealed too, and on touch that means never. */
    .insp-frame .src { opacity: 1; padding-right: 5.5rem; }

    /* ── The Add URL row ──────────────────────────────────────────────────
       The three controls on a reference tile grow their target with the
       `::after` inset above; this row never got the same pass and is the one
       part of the page you type into.

       The font size is the part that actually bites. Safari zooms the page in
       when a control with text under 16px takes focus and then leaves it
       zoomed — `scout.astro` already opts its own fields out for this reason,
       and these were at 0.8rem, which is 12.8px. So pasting a URL on an iPhone
       zoomed the archive and stranded it there.

       44px on the button and the fields for the same reason as everywhere
       else: these are pressed one-handed. Only the height changes, so the row
       keeps its wrapping behaviour at every width. */
    .urlrow input,
    #addurl { min-height: 44px; }
    .urlrow input { font-size: 16px; }

    /* The split-view comparison strip's own remove button never got the pass
       above — 20px, same guess-and-tap problem, same fix. Held 12px off each
       edge rather than the usual 3px, same reasoning as .cell-similar's own
       fix nearby: the 84px figure clips its overflow, so a ring that hangs
       past its edge is clipped away with it — moving the button in is what
       lets the full 44px ring actually land inside the box. */
    :global(.sim-strip .rm) { touch-action: none; top: 12px; right: 12px; }
    :global(.sim-strip .rm)::after {
      content: '';
      position: absolute;
      inset: -12px;
      border-radius: 50%;
    }
  }

  .mx { position: fixed; inset: 0; z-index: 84; display: flex; flex-direction: column; background: color-mix(in oklab, var(--bg) 98%, #000); }
  /* One rule for every interactive element in the panel, rather than a
     focus-visible line hand-added per component — this used to mean most
     of the panel (tabs, wheels, unlink buttons, the strength sliders)
     fell back to the browser's plain default ring, which reads as
     unfinished against everything else here that already carries --accent. */
  .mx button:focus-visible, .mx input:focus-visible, .mx select:focus-visible, .mx [tabindex]:focus-visible {
    outline: 2px solid var(--accent-mix); outline-offset: 2px;
  }
  .mx[hidden] { display: none; }
  .mx-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1rem var(--edge) 0.85rem; border-bottom: 1px solid var(--accent-hair); flex: 0 0 auto; }
  .mx-kicker { font-family: var(--font-ui); font-size: var(--t-caption); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0;
    font-weight: 600;
  }
  .mx-sub { font-family: var(--font-ui); font-size: var(--t-footnote); color: var(--fg); margin: 0.28rem 0 0; }
  .mx-close { position: static; flex: 0 0 auto; }
  .mx-body { flex: 1 1 auto; overflow: hidden; display: flex; }

  /* An author `display:` rule beats the hidden attribute's UA `display:none`,
     so every togglable block here needs its own [hidden] guard. */
  .mx-start[hidden], .mx-result[hidden] { display: none; }
  /* min-width:0 throughout: the baseline <select> is intrinsically as wide as
     its longest option ("The Mac’s own decode (easy, about 95% right)"),
     and as a flex/grid child with the default min-width:auto it dragged the
     whole start screen out to 522px inside a 390px phone. */
  .mx-start { display: grid; grid-template-columns: minmax(0, 34%) minmax(0, 1fr); gap: 2rem; align-items: start; padding: var(--edge); width: 100%; min-width: 0; overflow: auto; }
  .mx-refcol { display: flex; flex-direction: column; gap: 0.7rem; min-width: 0; }
  .mx-refs { display: flex; flex-direction: column; gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  :global(.mx-ref) { display: flex; align-items: center; gap: 0.6rem; }
  :global(.mx-ref img) { width: 4.5rem; height: 4.5rem; object-fit: cover; border-radius: 2px; flex: 0 0 auto; }
  :global(.mx-ref .mx-ref-meta) { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; flex: 1 1 auto; }
  :global(.mx-ref .mx-ref-name) { font-family: var(--font-ui); font-size: var(--t-footnote); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.mx-ref .mx-ref-weight) { display: flex; align-items: center; gap: 0.4rem; font-family: var(--font-label); font-size: var(--t-caption); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  :global(.mx-ref .mx-ref-weight input) { width: 4.5rem; accent-color: var(--fg); }
  :global(.mx-ref-remove) { appearance: none; background: transparent; border: 0; cursor: pointer; color: var(--muted); font-size: 1rem; line-height: 1; padding: 0.2rem; flex: 0 0 auto; }
  :global(.mx-ref-remove:hover) { color: var(--fg); }
  .mx-addref-toggle {
    appearance: none; background: transparent; border: 1px dashed var(--border); color: var(--muted);
    cursor: pointer; font-family: var(--font-ui); font-size: var(--t-caption); padding: 0.5rem 0.7rem; border-radius: 2px; width: 100%; text-align: left;
    transition: border-color 160ms, color 160ms;
  }
  .mx-addref-toggle:hover { border-color: var(--fg); color: var(--fg); }
  .mx-addref-strip[hidden] { display: none; }
  .mx-addref-strip { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.6rem 0 0; padding: 0; list-style: none; max-height: 14rem; overflow-y: auto; }
  :global(.mx-addref-pick) {
    appearance: none; background: transparent; border: 1px solid var(--border); cursor: pointer;
    padding: 0; border-radius: 2px; overflow: hidden; width: 3.4rem; height: 3.4rem; flex: 0 0 auto;
    transition: border-color 160ms;
  }
  :global(.mx-addref-pick:hover) { border-color: var(--fg); }
  :global(.mx-addref-pick img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mx-startcol { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .mx-zone { margin: 0; }
  .mx-field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); }
  .mx-field select { width: 100%; max-width: 100%; background: transparent; border: 1px solid var(--border); color: var(--fg); font-family: var(--font-ui); font-size: var(--t-footnote); letter-spacing: 0; text-transform: none; padding: 0.6rem 0.7rem; border-radius: 2px; }
  .mx-note { font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); margin: 0; min-height: 1.2em; }
  .mx-note :global(.err) { color: #e0603a; }

  /* Working state. The measurement is long and entirely invisible from here,
     so it names its stage, counts, and offers a way out. */
  .mx-working[hidden] { display: none; }
  .mx-working { display: block; }
  .mx-workbar { height: 2px; background: var(--border); overflow: hidden; }
  .mx-workbar span {
    display: block; height: 100%; width: 0; background: var(--accent-mix);
    transition: width 600ms var(--ease);
  }
  .mx-workline {
    display: flex; align-items: baseline; gap: 0.7rem; margin: 0.6rem 0 0;
    font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted);
  }
  .mx-workline #mx-workstage { flex: 1 1 auto; color: var(--fg); }
  .mx-elapsed { flex: 0 0 auto; font-variant-numeric: tabular-nums; }
  .mx-stop {
    flex: 0 0 auto; appearance: none; background: transparent; border: 0; cursor: pointer;
    font-family: var(--font-ui); font-size: var(--t-caption); letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--muted); padding: 0;
    border-bottom: 1px solid transparent; transition: color 180ms, border-color 180ms;
    font-weight: 600;
  }
  .mx-stop:hover { color: var(--accent-mix); border-bottom-color: currentColor; }

  /* --- Stage ------------------------------------------------------------
     `--s` runs 1 (expanded) to 0 (collapsed) and is set from the report's
     scroll position. Every dimension below interpolates on it, so the
     pictures give their space back to the reading area as you scroll rather
     than permanently occupying half the screen. */
  .mx-result { --s: 1; display: flex; flex-direction: column; width: 100%; overflow: hidden; }
  .mx-stage { flex: 0 0 auto; border-bottom: 1px solid var(--accent-hair); background: var(--bg); }
  .mx-frames { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--accent-hair); }
  .mx-fig { margin: 0; position: relative; background: var(--bg); display: flex; align-items: center; justify-content: center; overflow: hidden; min-height: 0; }
  .mx-fig canvas, .mx-fig img {
    max-width: 100%;
    max-height: calc(9vh + 24vh * var(--s));
    object-fit: contain; display: block;
    transition: max-height 120ms linear;
  }
  .mx-fig figcaption {
    position: absolute; left: 8px; bottom: 8px;
    font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: #fff; background: color-mix(in oklab, #000 62%, transparent);
    padding: 2px 8px; border-radius: 999px;
    backdrop-filter: blur(10px) saturate(1.2); -webkit-backdrop-filter: blur(10px) saturate(1.2);
    opacity: var(--s); transition: opacity 120ms linear; pointer-events: none;
  }

  /* Hold for the original. The canvas is the control, so it must not start a
     text selection or the iPad's long-press callout. */
  #mx-canvas { cursor: zoom-in; touch-action: pan-y; -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }
  .mx-holding #mx-canvas { cursor: zoom-out; }
  .mx-holdhint {
    position: absolute; right: 10px; top: 8px; pointer-events: none;
    font-family: var(--font-ui); font-size: 0.6875rem; color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.7), 0 0 10px rgb(0 0 0 / 0.45);
    opacity: calc(var(--s) * 0.75); transition: opacity 160ms;
  }
  .mx-holding .mx-holdhint { opacity: 0; }
  @media (hover: hover) and (pointer: fine) {
    .mx-holdhint { opacity: 0; }
    .mx-fig:hover .mx-holdhint { opacity: calc(var(--s) * 0.75); }
  }

  .mx-bar {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    padding: calc(0.45rem + 0.5rem * var(--s)) var(--edge);
    transition: padding 120ms linear;
  }
  .mx-strength { display: flex; align-items: center; gap: 0.8rem; flex: 1 1 22rem; max-width: 30rem; }
  .mx-strength input { flex: 1; accent-color: var(--fg); }
  .mx-end { font-family: var(--font-ui); font-size: 0.6875rem; color: var(--muted); flex: 0 0 auto; }
  /* The one line in this panel that reads as a verdict rather than a
     measurement ("Restrained — adopts the reference's character…") — the
     panel's single earned use of the display face, same idiom as the
     archive's own chapter titles, so the workbench still reads as part of
     the same system rather than a spreadsheet dropped into it. */
  .mx-strengthlabel { font-family: var(--font-display); font-style: var(--title-style); font-size: 1rem; color: var(--fg); margin: 0; flex: 0 1 auto; text-align: center; line-height: 1.3; }
  .mx-check { display: flex; align-items: center; gap: 0.45rem; font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); flex: 0 0 auto; cursor: pointer; }
  /* Chip treatment, matching the confidence/calibration badges below it —
     plain text here had no affordance at all on touch, where there is no
     hover to reveal it's tappable. */
  .mx-groupreveal {
    background: transparent; cursor: pointer; color: var(--muted);
    border: 1px solid var(--border); border-radius: 999px;
    font-family: var(--font-ui); font-size: 0.6875rem;
    padding: 0.3rem 0.7rem; flex: 0 0 auto; transition: color 140ms, border-color 140ms;
  }
  .mx-groupreveal:hover { color: var(--accent-mix); border-color: var(--accent-mix); }
  .mx-groupreveal[aria-expanded="true"] { color: var(--fg); border-color: var(--fg); }

  /* `display: flex` below would otherwise beat the attribute, and the three
     sliders never folded away. */
  .mx-groupbar[hidden] { display: none; }
  .mx-groupbar {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.6rem;
    padding: 0 var(--edge) 0.6rem;
  }
  .mx-groupslider { display: flex; align-items: center; gap: 0.5rem; flex: 1 1 15rem; max-width: 20rem; }
  .mx-groupslider input { flex: 1; accent-color: var(--fg); }
  .mx-grouplabel {
    font-family: var(--font-ui); font-size: 0.6875rem;
    color: var(--muted); flex: 0 0 3.4rem;
  }
  .mx-unlink {
    background: transparent; border: 1px solid var(--hair); border-radius: 999px; cursor: pointer;
    color: var(--muted); font-size: var(--t-caption); line-height: 1; width: 1.4rem; height: 1.4rem; flex: 0 0 auto;
    display: flex; align-items: center; justify-content: center; transition: color 140ms, border-color 140ms;
  }
  .mx-unlink svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  /* Pressed = this group has its own value; the link draws broken. */
  .mx-unlink[aria-pressed="true"] { color: var(--fg); border-color: var(--fg); }
  .mx-unlink[aria-pressed="true"] svg { stroke-dasharray: 3 2.4; }
  .mx-unlink:hover { color: var(--fg); }

  /* --- Tabs --------------------------------------------------------------- */
  .mx-tabs { flex: 0 0 auto; display: flex; gap: 0.2rem; padding: 0 var(--edge); border-bottom: 1px solid var(--accent-hair); overflow-x: auto; scrollbar-width: none; }
  .mx-tabs::-webkit-scrollbar { display: none; }
  /* Set by updateTabsOverflow() only while there's actually more to scroll
     to — a fade that outlived the content it promised would be worse than
     the clipped edge it replaces. */
  .mx-tabs.has-overflow {
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent 100%);
  }
  .mx-tabs button {
    position: relative; background: transparent; border: 0; cursor: pointer; color: var(--muted);
    font-family: var(--font-ui); font-size: var(--t-caption);
    padding: 0.78rem 0.95rem 0.7rem; white-space: nowrap; transition: color 140ms;
  }
  .mx-tabs button::after { content: ''; position: absolute; left: 0.95rem; right: 0.95rem; bottom: -1px; height: 1px; background: transparent; transition: background 140ms; }
  .mx-tabs button:hover { color: var(--accent-mix); }
  .mx-tabs button.on { color: var(--fg); }
  .mx-tabs button.on::after { background: var(--fg); }
  .mx-tabs .count { display: inline-block; margin-left: 0.4rem; font-size: 0.6875rem; color: var(--bg); background: #e0603a; border-radius: 999px; padding: 0 0.36rem; line-height: 1.4; vertical-align: 1px; }
  .mx-tabs .count:empty { display: none; }

  /* --- Round trip (Check tab) — built at runtime, hence :global --------- */
  #mx-rt { margin-top: 1.4rem; }
  :global(.mx-rt-form) { display: grid; gap: 0.9rem; max-width: 40rem; margin-bottom: 1.4rem; }
  :global(.mx-rt-field) { display: grid; gap: 0.35rem; font-size: var(--t-footnote); color: var(--muted); }
  :global(.mx-rt-field select) {
    font: inherit; font-size: 16px; color: var(--fg); background: var(--fill); border: 1px solid var(--separator);
    border-radius: var(--r-md, 10px); min-height: 2.6rem; padding: 0 0.7rem;
  }
  :global(.mx-rt-applied) { border: 0; margin: 0; padding: 0; display: grid; gap: 0.4rem; font-size: var(--t-footnote); }
  :global(.mx-rt-applied legend) { color: var(--muted); margin-bottom: 0.3rem; padding: 0; }
  :global(.mx-rt-applied label) { display: flex; gap: 0.55rem; align-items: center; min-height: 2rem; cursor: pointer; }
  :global(.mx-rt-drop) {
    border: 1.5px dashed var(--glass-edge); border-radius: var(--r-lg); padding: 1.8rem 1rem; text-align: center;
    cursor: pointer; font-size: var(--t-body, 0.95rem); color: var(--fg); background: var(--surface-1);
    transition: border-color 160ms, background 160ms;
  }
  :global(.mx-rt-drop:hover), :global(.mx-rt-drop:focus-visible), :global(.mx-rt-drop.over) { border-color: var(--accent-mix); outline: none; }
  :global(.mx-rt-drop.busy) { cursor: progress; color: var(--muted); }
  :global(.mx-rt-drop .link) { text-decoration: underline; text-underline-offset: 3px; }
  :global(.mx-rt-empty), :global(.mx-rt-error) { font-size: var(--t-footnote); color: var(--muted); max-width: 40rem; }
  :global(.mx-rt-error) { color: #e0603a; }
  :global(.mx-rt-result) { border-top: 1px solid var(--accent-hair); padding-top: 1.2rem; margin-bottom: 1.8rem; max-width: 46rem; }
  :global(.mx-rt-overall) { margin: 0 0 0.9rem; font-size: var(--t-footnote); color: var(--muted); display: flex; align-items: baseline; gap: 0.6rem; }
  :global(.mx-rt-overall .fig) { font-family: var(--font-label); font-variant-numeric: tabular-nums; font-size: 1.9rem; color: var(--fg); line-height: 1; }
  :global(.mx-rt-overall .unit) { font-size: 1rem; color: var(--muted); }
  :global(.mx-rt-rows) { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.5rem; }
  :global(.mx-rt-rows li) { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.8rem; align-items: center; font-size: var(--t-footnote); line-height: 1.45; }
  :global(.mx-rt-bar) { height: 6px; border-radius: 3px; background: var(--fill); overflow: hidden; }
  :global(.mx-rt-bar span) { display: block; height: 100%; background: var(--fg); border-radius: 3px; }
  :global(.mx-rt-bar.away) { background: color-mix(in oklab, #e0603a 45%, transparent); }
  :global(.mx-rt-bar.none) { background: repeating-linear-gradient(90deg, var(--fill) 0 4px, transparent 4px 7px); }
  :global(.mx-rt-follow) { display: grid; gap: 0.5rem; margin: 0 0 1.2rem; }
  :global(.mx-rt-follow button), :global(.mx-rt-caltable button) {
    justify-self: start; appearance: none; cursor: pointer; font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 500;
    border: 1px solid var(--separator); border-radius: 999px; background: var(--fg); color: var(--bg); min-height: 2.4rem; padding: 0 1.1rem;
  }
  :global(.mx-rt-caltable button) { min-height: 2rem; padding: 0 0.8rem; }
  :global(.mx-rt-caltable button.ghost) { background: transparent; color: var(--fg); margin-left: 0.3rem; }
  :global(.mx-rt-follow p) { margin: 0; font-size: var(--t-footnote); color: var(--muted); max-width: 40rem; }
  :global(.mx-rt-moves) { border-collapse: collapse; font-size: var(--t-footnote); margin-bottom: 1.2rem; }
  :global(.mx-rt-moves td) { padding: 0.3rem 1rem 0.3rem 0; border-bottom: 1px solid var(--border); }
  :global(.mx-rt-moves td:first-child) { color: var(--muted); }
  :global(.mx-rt-moves td:last-child) { font-family: var(--font-label); font-variant-numeric: tabular-nums; }
  :global(.mx-rt-ok) { font-size: var(--t-footnote); color: var(--fg); margin: 0; }
  :global(.mx-rt-no) { font-size: var(--t-footnote); color: var(--muted); }
  :global(.mx-rt-no p) { margin: 0 0 0.3rem; }
  :global(.mx-rt-no ul) { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.25rem; }
  :global(.mx-rt-h) { font-family: var(--font-ui); font-size: var(--t-caption); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin: 1.6rem 0 0.5rem; }
  :global(.mx-rt-tablewrap) { overflow-x: auto; }
  :global(.mx-rt-caltable) { border-collapse: collapse; font-size: var(--t-footnote); min-width: 40rem; }
  :global(.mx-rt-caltable th), :global(.mx-rt-caltable td) { text-align: left; padding: 0.45rem 0.9rem 0.45rem 0; border-bottom: 1px solid var(--border); vertical-align: top; }
  :global(.mx-rt-caltable thead th) { color: var(--muted); font-weight: 500; }
  :global(.mx-rt-caltable td:nth-child(2)), :global(.mx-rt-caltable td:nth-child(3)) { font-family: var(--font-label); font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(.mx-rt-caltable .why) { color: var(--muted); max-width: 22rem; }
  :global(.mx-rt-caltable .act) { white-space: nowrap; }
  :global(.mx-rt-caltable .tag) { font-family: var(--font-ui); font-size: 0.6875rem; padding: 0.05rem 0.4rem; border-radius: 999px; background: color-mix(in oklab, var(--fg) 14%, transparent); }
  :global(.mx-rt-caltable .tag.est) { background: transparent; color: var(--muted); }
  :global(.mx-rt-caltable tr.st-implausible .why), :global(.mx-rt-caltable tr.st-confounded .why) { color: #e0a63a; }
  :global(.mx-rt-never) { margin-top: 0.9rem; font-size: var(--t-footnote); color: var(--muted); }
  :global(.mx-rt-never summary) { cursor: pointer; min-height: 2rem; }
  :global(.mx-rt-never ul) { padding-left: 1.1rem; display: grid; gap: 0.3rem; }
  :global(.mx-rt-history) { list-style: none; padding: 0; margin: 0; font-size: var(--t-footnote); color: var(--muted); display: grid; gap: 0.25rem; }

  /* --- Report ------------------------------------------------------------- */
  .mx-scroll { flex: 1 1 auto; overflow: auto; padding: 1.4rem var(--edge) 2.5rem; }
  .mx-panel[hidden] { display: none; }
  .mx-panel { max-width: 76rem; }
  /* Cards flow into columns on a wide screen instead of leaving half the
     panel empty, but never so narrow that a row wraps. */
  :global(.mx-grid) { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 0 0.9rem; align-items: start; }
  .mx-h { font-family: var(--font-ui); font-size: var(--t-caption); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.5rem;
    font-weight: 600;
  }
  :global(.mx-lede) { font-size: var(--t-footnote); color: var(--muted); margin: 0 0 1.1rem; max-width: 46rem; }
  /* Two columns only where a panel genuinely has two independent halves. */
  :global(.mx-two) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.6rem; }
  /* Everything below is built with innerHTML from the module script. Astro's
     scoped styles work by stamping a data-astro-* attribute onto elements in
     the TEMPLATE, and nodes created at runtime never receive it — so these
     rules must be :global() or they simply do not apply. */
  .mx-badges { display: flex; flex-direction: column; gap: 0.7rem; }
  /* Numeric readings: a measured value, not a note about one — the largest,
     most figure-like thing in the panel, spec-sheet style (tabular mono
     figure + a small unit riding its baseline, a smaller caption below). */
  /* :global: this wrapper, like .mx-stat below, is injected client-side by
     renderBadges() and so never gets Astro's scoping attribute. */
  :global(.mx-stats) { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  :global(.mx-stat) { display: flex; flex-direction: column; gap: 0.18rem; }
  :global(.mx-stat .mx-stat-figure) { font-family: var(--font-label); font-variant-numeric: tabular-nums; font-size: 1.7rem; line-height: 1; letter-spacing: -0.01em; color: var(--fg); }
  :global(.mx-stat .mx-stat-unit) { font-size: 0.95rem; margin-left: 0.06rem; color: var(--muted); }
  :global(.mx-stat .mx-stat-label) { font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  :global(.mx-stat.warn .mx-stat-figure) { color: #e0603a; }
  /* Structural caveats: not a reading, an honesty note about one — no pill,
     no mono, no uppercase. Quiet italic Fraunces (the site's display cut,
     already italic via --title-style) reads as prose aside rather than
     data, which is the whole point of separating it from .mx-stat. */
  :global(.mx-caveats) { display: flex; flex-direction: column; gap: 0.3rem; }
  :global(.mx-caveat) { margin: 0; font-family: var(--font-display); font-style: var(--title-style); font-size: var(--t-footnote); line-height: 1.4; color: var(--muted); }
  :global(.mx-caveat.warn) { color: #e0603a; }

  .mx-notes { display: grid; gap: 0.5rem; }
  :global(.mx-noterow) {
    display: grid; grid-template-columns: 8rem 1fr; gap: 0.2rem 1rem;
    font-size: var(--t-footnote); line-height: 1.6; color: var(--muted);
    border-left: 2px solid var(--border); padding: 0.55rem 0 0.55rem 0.9rem;
    background: color-mix(in oklab, var(--fg) 3%, transparent);
  }
  :global(.mx-noterow.caution) { border-left-color: #e0603a; color: var(--fg); background: color-mix(in oklab, #e0603a 8%, transparent); }
  :global(.mx-noterow .panel) { font-family: var(--font-ui); font-size: 0.6875rem; color: var(--muted); padding-top: 0.25rem; }

  .mx-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; }

  /* Cards. Grouping the panels visually is what stops a long list of numbers
     reading as one undifferentiated wall. */
  :global(.mx-group) {
    border: 1px solid var(--border); border-radius: 3px;
    padding: 0.75rem 0.9rem 0.6rem; margin-bottom: 0.8rem;
    background: color-mix(in oklab, var(--fg) 2%, transparent);
  }
  :global(.mx-grouphead) {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem;
    font-family: var(--font-ui); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--fg); margin-bottom: 0.45rem;
    font-weight: 600;
  }
  :global(.mx-grouphead .tag) { font-size: 0.6875rem; letter-spacing: 0.1em; color: var(--muted); text-transform: none; }
  :global(.mx-row) { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--t-footnote); padding: 0.2rem 0; font-variant-numeric: tabular-nums; }
  :global(.mx-row + .mx-row) { border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent); }
  :global(.mx-row .k) { color: var(--muted); }
  :global(.mx-row .v) { font-family: var(--font-label); white-space: nowrap; }
  :global(.mx-rowhint) { font-size: var(--t-caption); color: var(--muted); line-height: 1.55; margin: 0.1rem 0 0.5rem; }

  /* Colour Mixer: one row per band with three aligned columns beats 24
     separate key/value rows for scanning. */
  :global(.mx-mixer) { display: grid; grid-template-columns: auto 1fr 1fr 1fr; gap: 0.1rem 0.7rem; font-size: var(--t-footnote); font-variant-numeric: tabular-nums; }
  :global(.mx-mixer .hdr) { font-family: var(--font-ui); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding-bottom: 0.25rem;
    font-weight: 600;
  }
  :global(.mx-mixer .band) { display: flex; align-items: center; gap: 0.4rem; color: var(--muted); }
  :global(.mx-mixer .chip) { width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: 0 0 auto; }
  :global(.mx-mixer .n) { text-align: right; font-family: var(--font-label); }
  :global(.mx-mixer .z) { color: color-mix(in oklab, var(--muted) 45%, transparent); }

  /* Colour Grading, drawn as Lightroom draws it: a hue ring desaturating to
     the centre, with a dot at the chosen hue and saturation. A pair of
     numbers is arithmetic; seeing the dot sitting low-saturation
     in the greens tells you everything. */
  /* One large "active" wheel plus two small ones, mirroring Lightroom's
     single-wheel view — not a flat row of four equal wheels. Global lives
     behind its own toggle below, exactly as in Lightroom, rather than
     sitting in the row as a fourth range. */
  :global(.mx-gradebox) { display: flex; align-items: center; justify-content: center; gap: 2.2rem; flex-wrap: wrap; }
  :global(.mx-gradewheels) { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; }
  :global(.mx-gradestats) { flex: 0 1 14rem; min-width: 10rem; align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  :global(.mx-wheelcluster) { display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
  :global(.mx-wheelcluster[hidden]) { display: none; }
  :global(.mx-wheelsmalls) { display: flex; flex-direction: column; gap: 0.9rem; }
  :global(.mx-wheelglobalbox) { display: flex; justify-content: center; }
  :global(.mx-globaltoggle) {
    font-family: var(--font-ui); font-size: var(--t-caption);
    color: var(--muted); background: none; border: 1px solid var(--border); border-radius: 999px;
    padding: 0.3rem 0.8rem; cursor: pointer; transition: color 140ms, border-color 140ms;
  }
  :global(.mx-globaltoggle:hover) { color: var(--accent-mix); border-color: var(--accent-mix); }
  :global(.mx-globaltoggle[aria-pressed="true"]) { color: var(--fg); border-color: var(--fg); }
  :global(.mx-cw) { text-align: center; background: none; border: none; padding: 0; font: inherit; color: inherit; cursor: default; }
  :global(button.mx-cw) { cursor: pointer; }
  :global(button.mx-cw:hover .disc) { border-color: var(--accent-mix); }
  :global(.mx-cw-lg .disc) { width: 9rem; }
  :global(.mx-cw-sm .disc) { width: 5rem; }
  :global(.mx-cw .disc) {
    position: relative; margin: 0 auto 0.55rem;
    aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--border);
    /* Desaturating toward a NEUTRAL grey, not toward the page background —
       the centre of the wheel means "no colour", which has to look like grey
       rather than like a hole. Saturation then reads as distance from centre,
       exactly as it does in Lightroom. */
    background:
      radial-gradient(circle at 50% 50%,
        #8a8a8a 0%,
        color-mix(in oklab, #8a8a8a 82%, transparent) 22%,
        color-mix(in oklab, #8a8a8a 34%, transparent) 55%,
        transparent 80%),
      conic-gradient(hsl(0 90% 58%), hsl(60 90% 58%), hsl(120 90% 58%), hsl(180 90% 58%),
                     hsl(240 90% 58%), hsl(300 90% 58%), hsl(360 90% 58%));
  }
  :global(.mx-cw .dot) {
    position: absolute; width: 0.6rem; height: 0.6rem; border-radius: 50%;
    border: 2px solid #fff;
    /* The white ring reads at any hue; the second shadow is a soft glow in
       the dot's own colour (--glow, set inline per dot) — a bit more life
       on the one mark in this panel that's already meant to carry colour. */
    box-shadow: 0 0 0 1px color-mix(in oklab, #000 70%, transparent), 0 0 9px 1px color-mix(in oklab, var(--glow, transparent) 65%, transparent);
    transform: translate(-50%, -50%);
  }
  :global(.mx-cw .nm) { font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); display: block; }
  :global(.mx-cw .v) { font-family: var(--font-label); font-size: var(--t-caption); color: var(--fg); font-variant-numeric: tabular-nums; margin-top: 0.15rem; }
  :global(.mx-cw.off .disc) { filter: grayscale(1); opacity: 0.28; }
  :global(.mx-cw.off .v) { color: var(--muted); }

  /* Tone curve, drawn. "0,0 28,26 56,50 …" is data, not a curve. */
  :global(.mx-curvebox) { display: flex; align-items: center; gap: 1rem; }
  :global(.mx-curvebox svg) { flex: 0 0 auto; background: color-mix(in oklab, var(--fg) 4%, transparent); border-radius: 2px; }
  :global(.mx-curvebox .legend) { font-size: var(--t-caption); color: var(--muted); line-height: 1.6; }

  /* Evidence deltas, with a bar so direction and size read at a glance. */
  :global(.mx-ev) { display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem; align-items: center; font-size: var(--t-footnote); }
  :global(.mx-ev .lbl) { color: var(--muted); }
  :global(.mx-ev .val) { font-family: var(--font-label); font-variant-numeric: tabular-nums; white-space: nowrap; font-size: var(--t-caption); }
  :global(.mx-bars) { grid-column: 1 / -1; display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.5rem; align-items: center; margin: 0.1rem 0 0.45rem; }
  :global(.mx-bars .cap) { font-family: var(--font-label); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in oklab, var(--muted) 70%, transparent); }
  /* 3px read as near-identical regardless of how different two rows'
     magnitudes actually were — the bar DOES scale with the value (see
     `bar()`), it was just too thin to see it at a glance. */
  :global(.mx-track) { position: relative; height: 5px; background: color-mix(in oklab, var(--fg) 8%, transparent); border-radius: 3px; }
  :global(.mx-track i) { position: absolute; top: 0; bottom: 0; background: var(--fg); border-radius: 3px; }
  :global(.mx-track::after) { content: ''; position: absolute; left: 50%; top: -2px; bottom: -2px; width: 1px; background: color-mix(in oklab, var(--fg) 22%, transparent); }
  :global(.mx-ev .none) { color: color-mix(in oklab, var(--muted) 60%, transparent); font-style: italic; }

  .mx-actions {
    flex: 0 0 auto; display: flex; flex-wrap: wrap; gap: 0.6rem;
    padding: 0.85rem var(--edge); border-top: 1px solid var(--accent-hair);
    background: color-mix(in oklab, var(--bg) 96%, #000);
  }
  .mx-actions button { background: var(--fg); color: var(--bg); border: 0; cursor: pointer; font-family: var(--font-ui); font-size: var(--t-caption); padding: 0.66rem 1.1rem; border-radius: 2px; }
  .mx-actions button.ghost { background: transparent; color: var(--fg); border: 1px solid var(--border); }
  .mx-actions button:disabled { opacity: 0.4; cursor: default; }
  .mx-actions button:not(:disabled):hover { opacity: 0.85; }
  /* More: the variant downloads in a small menu above the footer, so the
     one filled button is the only loud thing at the bottom. */
  .mx-more { position: relative; flex: 0 0 auto; display: flex; }
  .mx-actions .mx-more-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.6rem; padding: 0; flex: 0 0 auto;
  }
  .mx-more-btn svg { width: 18px; height: 18px; fill: currentColor; }
  .mx-more-menu {
    position: absolute; right: 0; bottom: calc(100% + 0.5rem); z-index: 5;
    min-width: 13rem; padding: 0.3rem;
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-edge); border-radius: var(--r-md, 12px); box-shadow: var(--glass-shadow);
  }
  .mx-more-menu[hidden] { display: none; }
  .mx-actions .mx-more-menu button {
    display: block; width: 100%; text-align: left;
    background: transparent; color: var(--fg); border-radius: 8px; padding: 0.6rem 0.75rem;
  }
  .mx-actions .mx-more-menu button:hover, .mx-actions .mx-more-menu button:focus-visible { background: var(--surface-2); opacity: 1; }

  /* ── Already in the archive ─────────────────────────────────────────────
     Spans both columns of the start grid and scrolls sideways rather than
     wrapping: this is a shortlist read left to right, and a strip that reflowed
     into a block would compete with the reference for the eye. */
  .already[hidden] { display: none; }
  .already {
    grid-column: 1 / -1;
    border-top: 1px solid var(--accent-hair);
    padding-top: 1.2rem;
    min-width: 0;
  }
  .already-head { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .already-kicker {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--t-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .already-sub { margin: 0; font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); }
  .already-strip {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    gap: 0.7rem;
    overflow-x: auto;
    /* Each card is a decision point, so the strip stops on one rather than
       drifting between two. */
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  /* The cards are built at runtime, so every selector inside the strip has to be
     :global — Astro stamps its scoping attribute onto the template's elements,
     and anything created later never gets one. Same reason `.sim-grid` and
     `.mx-noterow` are global. Without it the whole strip falls back to inline
     anchors and unsized images, which then never load at all. */
  :global(.already-strip li) { flex: 0 0 auto; scroll-snap-align: start; width: 150px; }
  :global(.already-card) {
    display: block;
    width: 100%;
    text-align: left;
    color: inherit;
    text-decoration: none;
  }
  :global(.already-card img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--accent-hair);
  }
  :global(.already-dist) {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-label);
    font-size: var(--t-caption);
    color: var(--fg);
  }
  /* The measurements are the working, not the answer: at rest the strip is
     pictures, and "Same grade" is the only word. The distances come up over
     the picture on hover, and are the card's label for VoiceOver. */
  :global(.already-pic) { position: relative; display: block; }
  :global(.already-parts) {
    position: absolute; inset: auto 0 0 0;
    padding: 1.4rem 0.45rem 0.35rem;
    font-family: var(--font-data);
    font-size: 0.625rem;
    line-height: 1.4;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0));
    opacity: 0; transition: opacity 160ms;
    pointer-events: none;
  }
  :global(.already-card:hover .already-parts), :global(.already-card:focus-visible .already-parts) { opacity: 1; }
  .already-note {
    margin: 0.3rem 0 0;
    font-family: var(--font-ui);
    font-size: var(--t-caption);
    line-height: 1.55;
    color: var(--muted);
  }
  .already-note:empty { display: none; }

  @media (max-width: 900px) {
    .mx-start { grid-template-columns: 1fr; }
    .mx-frames { grid-template-columns: 1fr 1fr; }
    .mx-fig canvas, .mx-fig img { max-height: calc(6vh + 15vh * var(--s)); }
    .mx-cols { grid-template-columns: 1fr; gap: 1.8rem; }
    .mx-bar { gap: 0.5rem 1rem; }
    .mx-strengthlabel { flex-basis: 100%; }
    :global(.mx-noterow) { grid-template-columns: 1fr; }
  }

  /* ── Phone ───────────────────────────────────────────────────────────────
     The whole feature is meant to be used from the iPad over the LAN, and a
     phone is the same client one size down. Nothing here changes what the
     match does — only whether you can reach it with a thumb. */
  @media (max-width: 640px) {
    .insp { padding: calc(env(safe-area-inset-top, 0px) + 3rem) 1.1rem calc(var(--tabbar-space) + 5rem); }
    .insp-head h1 { margin-bottom: 0.4rem; }
    .insp-lead { margin-bottom: 1.8rem; }
    .drop { padding: 2.2rem 1rem; }

    /* Credit / URL row: full-width fields stack rather than squeeze. */
    .urlrow { gap: 0.5rem; }
    .urlrow input { flex: 1 1 100%; }
    .urlrow .or { display: none; }
    .urlrow button { flex: 1 1 100%; padding: 0.8rem 1rem; }

    /* Reference tiles stay two-up — one-up would mean scrolling past four
       screens of board to reach the fifth reference. */
    .insp-collage { columns: 2; column-gap: 4px; }
    .insp-frame { margin-bottom: 4px; }
    .insp-frame .src { font-size: 0.6875rem; padding: 0.4rem 0.45rem 0.4rem 1.9rem; }

    /* Match panel */
    .mx-head { padding: 0.8rem 1.1rem 0.7rem; }
    .mx-sub { font-size: var(--t-caption); }
    .mx-start { gap: 1.2rem; padding: 1.1rem; align-content: start; }
    :global(.mx-ref img) { width: 3.6rem; height: 3.6rem; }
    .mx-zone { padding: 1.8rem 1rem; }
    .mx-workline { flex-wrap: wrap; row-gap: 0.3rem; }

    /* Already in the archive. Cards narrow but the strip still scrolls sideways,
       which on a phone is the *better* gesture — the alternative is a grid that
       pushes the drop zone off the screen it was the reason for opening. The
       edge fade is what says there is more to the right; without it a strip cut
       flush at the bezel reads as the end of the list. */
    .already { padding-top: 1rem; }
    .already-strip {
      margin: 0 -1.1rem;
      padding-left: 1.1rem;
      padding-right: 1.1rem;
      scroll-padding-left: 1.1rem;
    }
    :global(.already-strip li) { width: 42vw; max-width: 190px; }
    .already-strip::after {
      content: '';
      position: sticky;
      right: -1.1rem;
      flex: 0 0 1.6rem;
      align-self: stretch;
      margin-right: -1.1rem;
      background: linear-gradient(to right, transparent, var(--bg));
      pointer-events: none;
    }
    /* A whole card is the tap target, and its picture is most of it — but the
       two lines under it must not be so tight that a thumb lands between cards. */
    :global(.already-card) { padding-bottom: 0.2rem; }

    /* The tab strip scrolls; without an edge fade the last tab (Notes, and its
       count of the solver's refusals) simply looks like it isn't there. */
    .mx-tabs { padding: 0 1.1rem; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; }
    .mx-tabs button { flex: 0 0 auto; min-height: var(--hit); scroll-snap-align: start; }
    .mx-tabs::after { content: ''; position: sticky; right: 0; flex: 0 0 1.6rem; align-self: stretch; background: linear-gradient(to right, transparent, var(--bg)); pointer-events: none; }

    .mx-scroll { padding-left: 1.1rem; padding-right: 1.1rem; }
    .mx-actions { padding: 0.75rem 1.1rem calc(0.75rem + env(safe-area-inset-bottom, 0px)); gap: 0.45rem; }
    .mx-actions button { flex: 1 1 8rem; min-height: var(--hit); padding: 0.7rem 0.8rem; }

    /* Split view: four columns of thumbnails on a phone is a contact sheet you
       cannot see. Two, and the reference keeps a third of the screen. */
    .sim { grid-template-rows: 34% 66%; }
    .sim-left { padding: 1rem; }
    .sim-right { padding: 3.6rem 1.1rem 1.6rem; }
    :global(.sim-grid) { columns: 2; column-gap: 5px; }
    :global(.sim-cell) { margin-bottom: 5px; }
  }

  /* ── Notebook pass ──────────────────────────────────────────────────────
     Later in the cascade on purpose, so it reads as one layer over the rules
     above. Labels become sentence-case Fraunces italic instead of
     tracked capitals, boxed cards become hairline rules, glass pills on photos
     become plain tags, and value rows get a dotted leader. Controls keep the
     UI face and data keeps the mono. Only the words that name things change. */
  /* Round 3: title and Add on one line, the capture form behind Add. */
  .insp-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .insp-head h1 { margin-bottom: 1.4rem; }
  .insp-addbtn {
    appearance: none; border: 0; cursor: pointer; border-radius: var(--r-pill);
    min-height: 2.5rem; padding: 0 1.2rem; background: var(--fg); color: var(--bg);
    font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 600;
    transition: transform 110ms ease-out, opacity 140ms;
  }
  .insp-addbtn:active { transform: scale(0.96); }
  .insp-addbtn[aria-expanded='true'] { background: var(--fill); color: var(--fg); }
  .insp-addbtn:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .insp-add[hidden] { display: none; }
  .insp-add { margin-bottom: 2.4rem; }
  .insp-add .drop { padding: 1.8rem 1rem; }
  .insp-add .drop-title { margin: 0; font-size: 1.2rem; }
  .status, .results { margin-top: 0; }
  .results:empty { display: none; }
  /* Files dragged over the page: the whole page is the drop zone. */
  .drop-veil {
    position: fixed; inset: 0.8rem; z-index: 80; display: grid; place-items: center; pointer-events: none;
    border: 1px solid var(--rule); border-radius: 4px;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    background-image: var(--cropmarks-image); background-size: var(--cropmarks-size);
    background-position: var(--cropmarks-pos); background-repeat: no-repeat;
  }
  .drop-veil[hidden] { display: none; }
  .drop-veil p { margin: 0; font-family: var(--font-note); font-style: italic; font-size: 1.6rem; color: var(--fg); }

  .insp-head .page-kicker {
    font-family: var(--font-note); font-style: italic; font-size: var(--t-note);
    letter-spacing: 0; text-transform: none; color: var(--secondary); gap: 0.7rem;
  }
  .insp-lead { font-family: var(--font-note); font-style: italic; font-size: 1.1rem; color: var(--secondary); max-width: 34rem; }

  .drop {
    border: 1px solid var(--separator); border-radius: 2px;
    background: transparent;
    background-image: var(--cropmarks-image); background-size: var(--cropmarks-size);
    background-position: var(--cropmarks-pos); background-repeat: no-repeat;
  }
  .drop:hover, .drop:focus-visible, .drop.over {
    border-color: var(--rule); --mark: var(--fg);
    background-color: color-mix(in oklab, var(--fg) 3%, transparent);
  }
  .drop-sub { font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); }

  .urlrow { gap: 0.4rem 1.2rem; align-items: end; }
  .urlrow input {
    background: transparent; border: 0; border-bottom: 1px solid var(--rule); border-radius: 0; padding: 0 0.1rem;
  }
  .urlrow input:focus-visible { border-bottom-color: var(--fg); }
  .urlrow .or { font-family: var(--font-note); font-style: italic; font-size: var(--t-note); align-self: center; }
  .urlrow button { border-radius: 2px; }
  .results :global(.ch) { font-family: var(--font-note); font-style: italic; text-transform: none; letter-spacing: 0; font-size: var(--t-footnote); }

  .insp-groupby {
    background: none; border: 0; border-radius: 0; padding: 0; gap: 0; align-items: baseline;
    margin-bottom: 2rem;
  }
  .insp-groupby button {
    border-radius: 0; padding: 0 0.15rem; min-height: var(--hit); color: var(--muted);
    font-size: var(--t-body);
    text-decoration: underline transparent; text-underline-offset: 6px; text-decoration-thickness: 1px;
    transition: color 140ms var(--ease), text-decoration-color 140ms var(--ease);
  }
  .insp-groupby button + button::before {
    content: '/'; color: var(--separator); margin: 0 0.7rem 0 0.55rem; text-decoration: none; display: inline-block;
  }
  .insp-groupby button:hover { background: none; color: var(--fg); }
  .insp-groupby button.on { background: none; color: var(--fg); text-decoration-color: currentColor; }

  .insp-chtitle {
    font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: 1.2rem;
    letter-spacing: 0; text-transform: none; color: var(--fg); gap: 0.7rem;
    align-items: baseline;
  }
  .insp-chtitle .sw { align-self: center; width: 0.7rem; height: 0.7rem; }
  .insp-chtitle .n { font-family: var(--font-label); font-style: normal; font-size: var(--t-caption); color: var(--muted); }
  .insp-chtitle::after { content: ''; flex: 1 1 auto; height: 1px; background: var(--separator); align-self: center; }

  /* On-photo tags: a small square label, no frosted capsule. */
  .cell-similar, .cell-match {
    border-radius: 2px; letter-spacing: 0; text-transform: none;
    font-family: var(--font-ui); font-size: var(--t-caption); font-weight: 500;
    padding: 0.3rem 0.55rem; background: color-mix(in oklab, #0b0a09 84%, transparent);
    -webkit-backdrop-filter: none; backdrop-filter: none;
  }
  .cell-match { top: 38px; }
  .cell-similar:hover, .cell-match:hover { background: var(--fg); color: var(--bg); }
  .insp-frame .src { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); }
  @media (hover: none), (pointer: coarse) { .cell-match { top: auto; } }

  .kept-kicker, .already-kicker, .mx-kicker {
    font-family: var(--font-note); font-style: italic; font-weight: 500; letter-spacing: 0;
    text-transform: none; color: var(--fg); font-size: 1.15rem;
  }
  .kept-title { font-family: var(--font-label); font-size: var(--t-caption); color: var(--muted); }
  .mx-kicker { font-size: 1.35rem; }
  .already-head, .kept-head { align-items: baseline; }
  .mx-sub { color: var(--secondary); margin-top: 0.15rem; }
  :global(.already-dist) { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); }
  :global(.kept-name) { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); }
  :global(.kept-card img), :global(.mx-ref img) { border-radius: 0; }

  .sim-count, .sim-slider {
    font-family: var(--font-note); font-style: italic; font-size: var(--t-note);
    letter-spacing: 0; text-transform: none;
  }
  .sim-hint { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); }
  :global(.sim-cell .pct) {
    border-radius: 2px; -webkit-backdrop-filter: none; backdrop-filter: none;
    background: color-mix(in oklab, #0b0a09 84%, transparent); letter-spacing: 0;
  }

  :global(.mx-ref .mx-ref-weight) {
    font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote);
    letter-spacing: 0; text-transform: none;
  }
  .mx-addref-toggle {
    border: 0; border-bottom: 1px solid var(--separator); border-radius: 0; padding: 0.6rem 0;
    font-family: var(--font-note); font-style: italic; font-size: var(--t-note); color: var(--secondary);
  }
  .mx-addref-toggle:hover { border-color: var(--fg); }
  .mx-field > span { font-family: var(--font-note); font-style: italic; font-size: var(--t-note); color: var(--secondary); }
  .mx-field select { border: 0; border-bottom: 1px solid var(--rule); border-radius: 0; padding-left: 0; }
  .mx-stop {
    font-family: var(--font-ui); font-size: var(--t-footnote); font-weight: 500;
    letter-spacing: 0; text-transform: none; border-bottom-color: var(--separator);
  }
  .mx-workline #mx-workstage { font-family: var(--font-note); font-style: italic; font-size: var(--t-note); }

  /* Caption written on the print, not stuck on in a capsule. */
  .mx-fig figcaption {
    left: 12px; bottom: 10px; padding: 0; border-radius: 0; background: none;
    -webkit-backdrop-filter: none; backdrop-filter: none;
    font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote);
    letter-spacing: 0; text-transform: none;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.7), 0 0 10px rgb(0 0 0 / 0.45);
  }
  .mx-end { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); }
  .mx-groupreveal, :global(.mx-globaltoggle) {
    border: 0; border-bottom: 1px solid var(--separator); border-radius: 0; padding: 0.3rem 0;
    font-size: var(--t-caption);
  }
  .mx-grouplabel { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); }
  .mx-check { font-size: var(--t-footnote); }

  .mx-h, :global(.mx-rt-h) {
    font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: 1.15rem;
    letter-spacing: 0; text-transform: none; color: var(--fg);
  }
  :global(.mx-stats) { gap: 2.2rem; }
  :global(.mx-stat .mx-stat-label) {
    font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote);
    letter-spacing: 0; text-transform: none;
  }

  /* Groups: a ruled section heading, not a card. */
  :global(.mx-group) {
    border: 0; border-top: 1px solid var(--rule); border-radius: 0; background: none;
    padding: 0.7rem 0 0.9rem; margin-bottom: 0.4rem;
  }
  :global(.mx-grouphead) {
    font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: 1.1rem;
    letter-spacing: 0; text-transform: none; margin-bottom: 0.35rem;
  }
  :global(.mx-grouphead .tag) { font-family: var(--font-ui); font-style: normal; font-size: var(--t-caption); letter-spacing: 0; }
  /* A dotted leader carries the eye from the name to its number. */
  :global(.mx-row) { align-items: baseline; gap: 0.5rem; }
  :global(.mx-row + .mx-row) { border-top: 0; }
  :global(.mx-row .k) { order: 0; flex: 0 1 auto; }
  :global(.mx-row::after) {
    content: ''; order: 1; flex: 1 1 1.5rem; min-width: 1.5rem;
    border-bottom: 1px dotted var(--leader); transform: translateY(-0.28em);
  }
  :global(.mx-row .v) { order: 2; }

  :global(.mx-mixer .hdr), :global(.mx-cw .nm), :global(.mx-bars .cap) {
    font-family: var(--font-note); font-style: italic; font-weight: 500; font-size: var(--t-footnote);
    letter-spacing: 0; text-transform: none;
  }
  :global(.mx-curvebox svg), .curve-lb-body svg { border-radius: 0; }
  :global(.mx-track), :global(.mx-track i) { border-radius: 0; }
  :global(.mx-track) { height: 3px; }

  /* Notes read as margin notes: a rule, a pencilled label, no tinted box. */
  :global(.mx-noterow), :global(.mx-noterow.caution) { background: none; border-left-width: 1px; }
  :global(.mx-noterow .panel) { font-family: var(--font-note); font-style: italic; font-size: var(--t-footnote); padding-top: 0.1rem; }
  :global(.mx-rt-caltable .tag) { border-radius: 2px; }
</style>

<script is:inline>
  const zone = document.getElementById('zone');
  const file = document.getElementById('file');
  const sourceEl = document.getElementById('source');
  const urlEl = document.getElementById('url');
  const statusEl = document.getElementById('status');
  const bar = document.getElementById('bar');
  const statusText = document.getElementById('status-text');
  const results = document.getElementById('results');

  // --- Group by: colour (default), genre, or embedding-cluster — #88 -------
  // Only "colour" ever holds the real <figure> elements at first render; the
  // genre and cluster views start as empty, labelled collages (see the
  // markup above) that this fills by moving those same nodes in, never by
  // rebuilding them — so drag state, the group tray's selection below, and
  // every listener stay attached to the one node that ever existed instead
  // of needing to be reattached after a switch.
  const groupings = JSON.parse(document.getElementById('insp-groupings')?.textContent || '{"genre":[],"cluster":[]}');
  // Captured once, before any move: each frame's original collage, so
  // "Colour" can be reconstructed exactly by walking this same order back —
  // not approximated by re-sorting on some other key.
  const originalOrder = [...document.querySelectorAll('.insp-view[data-view="colour"] .insp-frame')];
  const originalCollage = new Map(originalOrder.map((f) => [f, f.parentElement]));

  function applyGrouping(view) {
    if (view === 'colour') {
      for (const frame of originalOrder) originalCollage.get(frame)?.appendChild(frame);
    } else {
      const collages = new Map(
        [...document.querySelectorAll(`.insp-view[data-view="${view}"] [data-collage]`)].map((el) => [el.dataset.collage, el]),
      );
      for (const { label, ids } of groupings[view] || []) {
        const collage = collages.get(label);
        if (!collage) continue;
        for (const id of ids) {
          const frame = document.querySelector(`.insp-frame[data-id="${CSS.escape(id)}"]`);
          if (frame) collage.appendChild(frame);
        }
      }
    }
    document.querySelectorAll('.insp-view').forEach((el) => { el.hidden = el.dataset.view !== view; });
  }

  document.getElementById('groupby')?.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-groupby]');
    if (!btn) return;
    document.querySelectorAll('#groupby button').forEach((b) => b.classList.toggle('on', b === btn));
    applyGrouping(btn.dataset.groupby);
  });

  // --- The group: similarly-edited references marked with "+ group" -------
  // A `Map` rather than a `Set` of ids: `findSimilarGroup` needs each
  // member's large derivative and source line to render the strip and the
  // single-reference view, and re-reading the board for them stops working
  // once you're inside the split view looking at a different photo.
  // Persisted to sessionStorage — the same tab, the same visit — so leaving
  // to look at something else and coming back doesn't lose what you built.
  const GROUP_KEY = 'insp-group';
  let group = new Map();
  try {
    const saved = JSON.parse(sessionStorage.getItem(GROUP_KEY) || '[]');
    group = new Map(saved.map((g) => [g.id, g]));
  } catch (err) { /* private mode, or nothing saved */ }

  function saveGroup() {
    try { sessionStorage.setItem(GROUP_KEY, JSON.stringify([...group.values()])); }
    catch (err) { /* private mode */ }
  }

  /** A group member's large derivative + source, from the cache or (for a
   *  photo never added to the group — the plain "≈ similar" tap) straight
   *  off its own board button, which carries the same two attributes. */
  function refInfo(id) {
    const cached = group.get(id);
    if (cached) return cached;
    const btn = document.querySelector(`.cell-similar[data-similar="${CSS.escape(id)}"]`);
    return btn ? { id, full: btn.dataset.full, source: btn.dataset.source } : null;
  }

  const tray = document.getElementById('group-tray');
  const trayCount = document.getElementById('group-tray-count');

  function renderTray() {
    const n = group.size;
    trayCount.innerHTML = n ? `<b>${n}</b> reference${n === 1 ? '' : 's'} selected` : '';
    tray.hidden = n === 0;
    if (n > 0) requestAnimationFrame(() => tray.classList.add('show'));
    else tray.classList.remove('show');
    document.querySelectorAll('.cell-group').forEach((btn) => {
      const on = group.has(btn.dataset.group);
      btn.setAttribute('aria-pressed', String(on));
      btn.textContent = on ? '✓' : '+';
      btn.closest('.insp-frame')?.classList.toggle('in-group', on);
    });
  }

  function toggleGroupMember(id, full, source) {
    if (group.has(id)) group.delete(id);
    else group.set(id, { id, full, source });
    saveGroup();
    renderTray();
  }

  // Read-only bridge to the "Match this look" workbench below, which is a
  // separate `type=module` script (it imports the solver and the WebGL
  // renderer) and so does not share this script's closure — `group` itself
  // is a `let`, which even a classic script never attaches to `window`.
  window.getGroupIds = () => [...group.keys()];

  document.getElementById('group-tray-find').addEventListener('click', () => {
    if (group.size) findSimilarGroup([...group.keys()]);
  });
  document.getElementById('group-tray-clear').addEventListener('click', () => {
    group.clear();
    saveGroup();
    renderTray();
  });

  zone.addEventListener('click', () => file.click());
  zone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); file.click(); } });
  file.addEventListener('change', () => uploadFiles(file.files));
  ['dragenter', 'dragover'].forEach((ev) => zone.addEventListener(ev, (e) => { e.preventDefault(); zone.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) => zone.addEventListener(ev, (e) => { e.preventDefault(); zone.classList.remove('over'); }));
  zone.addEventListener('drop', (e) => { if (e.dataTransfer?.files?.length) uploadFiles(e.dataTransfer.files); });
  document.getElementById('addurl').addEventListener('click', addUrl);

  // Add: one button opens the capture form; it's open from the start only
  // when the board is empty.
  const addToggle = document.getElementById('add-toggle');
  const addPanel = document.getElementById('insp-add');
  function setAddOpen(open) {
    addPanel.hidden = !open;
    addToggle.setAttribute('aria-expanded', String(open));
    addToggle.textContent = open ? 'Done' : 'Add';
    if (open) urlEl.focus({ preventScroll: true });
  }
  if (!addPanel.hidden) addToggle.textContent = 'Done';
  addToggle.addEventListener('click', () => setAddOpen(addPanel.hidden));

  // Files dragged anywhere over the page: the page is the drop zone. The
  // Style Match workbench has its own zones and handles its own drops.
  const veil = document.getElementById('drop-veil');
  const hasFiles = (e) => [...(e.dataTransfer?.types ?? [])].includes('Files');
  const inWorkbench = (e) => e.target instanceof Element && e.target.closest('.mx, #mx, dialog');
  let dragDepth = 0;
  document.addEventListener('dragenter', (e) => {
    if (!hasFiles(e) || inWorkbench(e)) return;
    dragDepth++;
    veil.hidden = false;
  });
  document.addEventListener('dragleave', (e) => {
    if (!hasFiles(e)) return;
    dragDepth = Math.max(0, dragDepth - 1);
    if (!dragDepth) veil.hidden = true;
  });
  document.addEventListener('dragover', (e) => { if (hasFiles(e) && !inWorkbench(e)) e.preventDefault(); });
  document.addEventListener('drop', (e) => {
    dragDepth = 0;
    veil.hidden = true;
    if (!hasFiles(e) || inWorkbench(e) || e.target === zone || zone.contains(e.target)) return;
    e.preventDefault();
    if (e.dataTransfer.files.length) uploadFiles(e.dataTransfer.files);
  });

  // Paste anywhere that isn't a text field: an image is added as it is, a
  // link is fetched as if typed into the link field.
  document.addEventListener('paste', (e) => {
    const t = e.target;
    if (t instanceof HTMLElement && (t.closest('input, textarea, [contenteditable="true"]'))) return;
    const files = [...(e.clipboardData?.files ?? [])].filter((f) => f.type.startsWith('image/'));
    if (files.length) { e.preventDefault(); uploadFiles(files); return; }
    const text = e.clipboardData?.getData('text/plain')?.trim() ?? '';
    if (/^https?:\/\/\S+$/.test(text)) { e.preventDefault(); urlEl.value = text; addUrl(); }
  });

  function begin(msg) { statusEl.hidden = false; bar.style.width = '10%'; statusText.textContent = msg; }
  function esc(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
  function row(r) {
    const li = document.createElement('li');
    if (r.status === 'added') li.innerHTML = `<span class="sw" style="background:${r.swatch}"></span><span class="fn">${esc(r.filename)}</span><span class="ch">${esc(r.chapterName)}</span>`;
    else if (r.status === 'skipped') li.innerHTML = `<span class="sw" style="background:transparent"></span><span class="fn">${esc(r.filename)}</span><span class="ch">already saved</span>`;
    else li.innerHTML = `<span class="sw" style="background:transparent"></span><span class="fn">${esc(r.filename)}</span><span class="ch err">${esc(r.error || r.status)}</span>`;
    results.prepend(li);
  }

  async function uploadFiles(list) {
    const all = Array.from(list);
    const files = all.filter((f) => f.type.startsWith('image/') || /\.(heic|heif|gif)$/i.test(f.name));
    // Anything filtered out is named. Dropping a PDF or a folder of RAWs used
    // to be indistinguishable from the page ignoring you.
    for (const f of all.filter((f) => !files.includes(f))) {
      row({ filename: f.name, status: 'error', error: /\.(cr2|cr3|nef|arw|dng|raf|orf|rw2)$/i.test(f.name) ? 'Camera RAW — export a JPEG first' : 'Not an image' });
    }
    if (!files.length) {
      if (all.length) { statusEl.hidden = false; bar.style.width = '0%'; statusText.textContent = `Nothing added — ${all.length} file${all.length > 1 ? 's' : ''} can't be read.`; }
      return;
    }
    begin(`Adding ${files.length} image${files.length > 1 ? 's' : ''}…`);
    const fd = new FormData();
    fd.append('source', sourceEl.value);
    files.forEach((f) => fd.append('images', f));
    try {
      const res = await fetch('/api/inspiration/add', { method: 'POST', body: fd });
      const data = await res.json(); bar.style.width = '100%';
      if (!data.ok) throw new Error(data.error);
      data.results.forEach(row);
      statusText.textContent = `${data.added} added.`;
      file.value = '';
      // Several images dropped in together are exactly the case the group
      // match exists for — carried through the reload so they can be
      // pre-selected, rather than making you go find and re-tap what you
      // just added.
      const addedIds = data.results.filter((r) => r.status === 'added' && r.id).map((r) => r.id);
      if (data.added > 0) reloadKeepingPlace(addedIds);
    } catch (err) { statusText.innerHTML = `<span class="err">${esc(err.message)}</span>`; }
  }

  // The board is grouped into colour chapters on the server, so a new reference
  // can land anywhere in it — a reload is the honest way to show that. What was
  // not honest was throwing away where you were and what you had typed: the
  // credit field emptied itself and the page jumped to the top, every time.
  const RESUME_KEY = 'insp-resume';
  function reloadKeepingPlace(newIds) {
    try {
      sessionStorage.setItem(RESUME_KEY, JSON.stringify({ y: window.scrollY, source: sourceEl.value, newIds: newIds || [] }));
    } catch (err) { /* private mode — just reload */ }
    setTimeout(() => location.reload(), 650);
  }
  (function resume() {
    let saved;
    try {
      saved = JSON.parse(sessionStorage.getItem(RESUME_KEY) || 'null');
      sessionStorage.removeItem(RESUME_KEY);
    } catch (err) { return; }
    if (!saved) return;
    if (saved.source) sourceEl.value = saved.source;   // the credit still applies to the next batch
    if (saved.y > 0) requestAnimationFrame(() => window.scrollTo(0, saved.y));
    // One image added alone already has its own "≈ similar" button right on
    // it — the group is for when there were several, submitted as a set.
    if (saved.newIds && saved.newIds.length > 1) {
      for (const id of saved.newIds) {
        const btn = document.querySelector(`.cell-similar[data-similar="${CSS.escape(id)}"]`);
        if (btn) group.set(id, { id, full: btn.dataset.full, source: btn.dataset.source });
      }
      saveGroup();
    }
  })();
  renderTray(); // reflects a group restored above, or one already in sessionStorage from before this load

  async function addUrl() {
    const url = urlEl.value.trim(); if (!url) return;
    begin('Fetching image…');
    try {
      const res = await fetch('/api/inspiration/add', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url, source: sourceEl.value }) });
      const data = await res.json(); bar.style.width = '100%';
      if (!data.ok) throw new Error(data.error);
      data.results.forEach(row);
      urlEl.value = '';
      statusText.textContent = `${data.added ?? data.results.length} added.`;
      reloadKeepingPlace();
    } catch (err) { statusText.innerHTML = `<span class="err">${esc(err.message)}</span>`; }
  }
  // Enter in the URL field submits it. The inputs sit outside a <form>, so
  // pressing Enter did nothing at all and looked like the field was dead.
  urlEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addUrl(); } });
  sourceEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); urlEl.focus(); } });

  // --- Fade references in on load ----------------------------------------
  // `.frame img` is opacity:0 in global.css and waits for `.loaded`. The
  // archive marks its own; the board has to mark its own too, or every
  // reference stays invisible and the wall reads as blocks of flat colour.
  document.querySelectorAll('.insp-frame img.photo').forEach((img) => {
    if (img.complete) img.classList.add('loaded');
    else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
  });

  // --- Develop on scroll ---------------------------------------------------
  // `.frame img.photo` also carries the archive's "develop" filter (arrives
  // desaturated/blurred, resolves once `.reveal` lands on the frame — see
  // global.css) because `.insp-frame` is `.frame` too, sharing that rule by
  // design so the board reads as the same kind of wall. Without this observer
  // the filter would apply here with nothing ever clearing it — every
  // reference stuck permanently blurred. One-way, same as the archive: once
  // developed, a reference stays developed when you scroll back past it.
  const revealBoard = new IntersectionObserver(
    (entries) => { for (const e of entries) if (e.isIntersecting) { e.target.classList.add('reveal'); revealBoard.unobserve(e.target); } },
    { rootMargin: '120px 0px' },
  );
  document.querySelectorAll('.insp-frame').forEach((f) => revealBoard.observe(f));

  // Remove (two-step confirm)
  let armed = null;
  document.querySelectorAll('.cell-remove').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (armed !== btn) { if (armed) { armed.textContent = '×'; armed.classList.remove('armed'); } armed = btn; btn.textContent = '✓'; btn.classList.add('armed'); setTimeout(() => { if (armed === btn) { btn.textContent = '×'; btn.classList.remove('armed'); armed = null; } }, 2600); return; }
      armed = null; btn.textContent = '…';
      try { const res = await fetch('/api/inspiration/remove', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: btn.dataset.remove }) }); const d = await res.json(); if (!d.ok) throw new Error(d.error); btn.closest('.insp-frame').remove(); } catch (err) { btn.textContent = '×'; }
    });
  });

  // --- Enlarge (shared by references and match cells) --------------------
  // These overlays cover the page, but the board behind them still scrolled —
  // a touch drag or a stray wheel moved it, so closing dropped you somewhere
  // you never chose. Counted, because the enlarge view opens on top of the
  // split view and the two must not fight over the lock.
  let overlayDepth = 0;
  const lockBoard = () => { if (overlayDepth++ === 0) document.body.style.overflow = 'hidden'; };
  const unlockBoard = () => { overlayDepth = Math.max(0, overlayDepth - 1); if (!overlayDepth) document.body.style.overflow = ''; };

  const lb = document.getElementById('lb'), lbImg = document.getElementById('lb-img'), lbSrc = document.getElementById('lb-src');
  const srcHtml = (s) => s ? (/^https?:\/\//i.test(s) ? `<a href="${esc(s)}" target="_blank" rel="noopener noreferrer">${esc(s)} ↗</a>` : esc(s)) : '';
  const openLb = (full, source) => {
    if (!lb.hidden) return;
    lbImg.src = full; lbSrc.innerHTML = srcHtml(source); lb.hidden = false; lockBoard();
    requestAnimationFrame(() => lb.classList.add('show'));
  };
  const closeLb = () => {
    if (lb.hidden) return;
    lb.classList.remove('show'); unlockBoard();
    setTimeout(() => { lb.hidden = true; lbImg.src = ''; }, 220);
  };
  document.getElementById('lb-close').addEventListener('click', closeLb);
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });

  // --- Find similar → split view ----------------------------------------
  const sim = document.getElementById('sim');
  const simRef = document.getElementById('sim-ref');
  const simCount = document.getElementById('sim-count');
  const simStrip = document.getElementById('sim-strip');
  const simSrc = document.getElementById('sim-src');
  const simRight = document.getElementById('sim-right');
  const simW = document.getElementById('sim-w');
  const simHint = document.getElementById('sim-hint');
  let simMatches = [];
  /** The group this open split view is showing — kept so removing one
   *  member from the strip knows what's left to re-rank against. */
  let simGroupIds = [];

  /** One reference: the large centred image this view has always shown. */
  function renderSimSingle(ref) {
    const local = ref && refInfo(ref.id);
    simCount.hidden = true;
    simStrip.hidden = true;
    simRef.hidden = false;
    simRef.src = (local && local.full) || (ref ? ref.avif : '');
    simSrc.hidden = false;
    simSrc.innerHTML = ref ? srcHtml((local && local.source) || ref.source) : '';
  }
  /** Several: a strip, one tile per reference, each removable, an outlier
   *  from the group's own colour flagged in place — see `groupOutliers`. */
  function renderSimStrip(refs) {
    simRef.hidden = true;
    simSrc.hidden = true;
    simSrc.innerHTML = '';
    simCount.hidden = false;
    simCount.textContent = refs.length + ' references, blended';
    simStrip.hidden = false;
    simStrip.innerHTML = refs.map((r) => `
      <figure data-id="${esc(r.id)}" data-full="${esc(r.avif)}">
        <img loading="lazy" src="${esc(r.avif)}" alt="">
        ${r.outlier ? '<span class="outlier" title="Colours differ noticeably from the rest of the group">!</span>' : ''}
        <button type="button" class="rm" data-remove-ref="${esc(r.id)}" aria-label="Remove from group">×</button>
      </figure>`).join('');
  }
  function renderSimRefs(refs) {
    if (refs.length <= 1) renderSimSingle(refs[0]);
    else renderSimStrip(refs);
  }
  function describeReadiness(d) {
    const flagged = (d.refs || []).filter((r) => r.outlier).length;
    const warn = flagged
      ? ` ${flagged} reference${flagged === 1 ? '' : 's'} ${flagged === 1 ? 'looks' : 'look'} like a different edit — see the ⚠ mark.`
      : '';
    const base = simGroupIds.length > 1
      ? ''
      : '';
    return (d.ready ? base : 'Composition hasn’t been analysed yet. Run  npm run reanalyze  once.') + warn;
  }

  async function findSimilarGroup(ids) {
    if (!ids.length) return;
    simGroupIds = ids;
    simRight.innerHTML = '<p style="color:var(--muted);font-size:0.8rem;font-family:var(--font-label)">Ranking…</p>';
    if (sim.hidden) { sim.hidden = false; lockBoard(); requestAnimationFrame(() => sim.classList.add('show')); }
    try {
      const qs = ids.map((id) => 'ref=' + encodeURIComponent(id)).join('&');
      const res = await fetch('/api/similar?' + qs);
      const d = await res.json();
      if (!d.ok) throw new Error(d.error || 'failed');
      simMatches = d.matches || [];
      renderSimRefs(d.refs || []);
      simHint.textContent = describeReadiness(d);
      renderSim();
    } catch (err) {
      simRight.innerHTML = '<p style="color:#e0603a">' + esc(err.message) + '</p>';
    }
  }
  /** The plain "≈ similar" tap — a group of one, not routed through the
   *  persisted group tray at all, so trying a quick single match never
   *  disturbs whatever set you're still building. */
  function findSimilar(id) { return findSimilarGroup([id]); }

  simStrip.addEventListener('click', (e) => {
    const rm = e.target.closest('[data-remove-ref]');
    if (rm) {
      e.stopPropagation();
      const id = rm.dataset.removeRef;
      group.delete(id);
      saveGroup();
      renderTray();
      const remaining = simGroupIds.filter((x) => x !== id);
      if (remaining.length) findSimilarGroup(remaining);
      else closeSim();
      return;
    }
    const fig = e.target.closest('figure');
    if (fig) openLb(fig.dataset.full, '');
  });

  function renderSim() {
    const v = +simW.value / 100; // 0 = pure colour, 1 = pure composition
    const scored = simMatches
      .map((m) => ({ ...m, score: v * m.comp + (1 - v) * m.col }))
      .sort((a, b) => a.score - b.score)
      .slice(0, 30);
    simRight.innerHTML = '<div class="sim-grid">' + scored.map((m) =>
      `<figure class="sim-cell" data-full="${m.avif}" style="aspect-ratio:${m.w}/${m.h}"><img loading="lazy" src="${m.avif}" alt=""><span class="pct">${Math.round((1 - m.score) * 100)}</span></figure>`
    ).join('') + '</div>';
    simRight.querySelectorAll('img').forEach((img) => {
      if (img.complete) img.classList.add('on');
      else img.addEventListener('load', () => img.classList.add('on'), { once: true });
    });
  }
  simW.addEventListener('input', renderSim);
  const closeSim = () => {
    if (sim.hidden) return;
    sim.classList.remove('show'); unlockBoard();
    setTimeout(() => { sim.hidden = true; }, 220);
  };
  document.getElementById('sim-close').addEventListener('click', closeSim);
  sim.addEventListener('click', (e) => { const c = e.target.closest('.sim-cell'); if (c) openLb(c.dataset.full, ''); });

  // --- Board clicks: similar/group buttons, remove (handled above), else enlarge -
  document.getElementById('board')?.addEventListener('click', (e) => {
    const simBtn = e.target.closest('.cell-similar');
    if (simBtn) { e.stopPropagation(); findSimilar(simBtn.dataset.similar); return; }
    const groupBtn = e.target.closest('.cell-group');
    if (groupBtn) { e.stopPropagation(); toggleGroupMember(groupBtn.dataset.group, groupBtn.dataset.full, groupBtn.dataset.source); return; }
    // The match button lives in the processed module script below; ignore it
    // here so it does not also open the lightbox.
    if (e.target.closest('.cell-remove') || e.target.closest('.cell-match')) return;
    const f = e.target.closest('.insp-frame'); if (!f) return;
    openLb(f.dataset.full, f.dataset.source);
  });

  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!lb.hidden) closeLb();
    else if (!sim.hidden) closeSim();
  });
</script>

<script>
  // Style match. A processed module (not is:inline) because it imports the
  // solver's own adjustment blending and the WebGL renderer — the preview is
  // driven by exactly the values shown on screen, never a parallel copy.
  import { atGroupStrength, type GroupStrength } from '../lib/match/adjustments';
  import { MatchPreview, deriveRenderSpec } from '../lib/match/preview-render';
  import { HSL_BANDS, REGION_LABEL, REGION_ORDER, BASELINE_LABEL } from '../lib/match/types';
  import { mergeReferences, solveMatch } from '../lib/match/solve';
  import { buildPresetFiles } from '../lib/match/xmp';
  import { photoName, matchTitle } from '../lib/match/names';
  import { analyseInBrowser, analyseReferenceInBrowser } from '../lib/match/browser/analyse';
  import { DEFAULT_CALIBRATION } from '../lib/match/calibration';
  import { CAL_TARGETS } from '../lib/match/roundtrip';
  import type { Adjustments } from '../lib/match/adjustments';
  import type { PhotoAnalysis, RegionKey } from '../lib/match/types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const panel = $('mx');
  const startEl = $('mx-start');
  const resultEl = $('mx-result');
  const subEl = $('mx-sub');
  const statusEl = $('mx-status');
  const refsEl = $('mx-refs');
  const addRefToggle = $<HTMLButtonElement>('mx-addref-toggle');
  const addRefStrip = $('mx-addref-strip');
  const refSide = $<HTMLImageElement>('mx-refside');
  const refSideCaption = $('mx-refside-caption');
  const zoneEl = $('mx-zone');
  const fileEl = $<HTMLInputElement>('mx-file');
  const baselineEl = $<HTMLSelectElement>('mx-baseline');
  const canvas = $<HTMLCanvasElement>('mx-canvas');
  const strengthEl = $<HTMLInputElement>('mx-strength');
  const strengthLabel = $('mx-strengthlabel');
  const wipeEl = $<HTMLInputElement>('mx-wipe');
  const wipeHint = $('mx-wipehint');
  const curveLb = $('curve-lb');
  const curveLbClose = $('curve-lb-close');
  const curveLbSvgHost = $('curve-lb-svg');
  const curveLbList = $('curve-lb-list');

  // ── Per-group strength (issue #41) ────────────────────────────────────────
  //
  // Light, Colour and Effects each default to following the master slider.
  // Dragging a group's own slider unlinks that one group from the master;
  // its ⚭ button links it back. `null` means "linked" — the group's live
  // value is read through `groupT()`, never stored separately while linked,
  // so the master stays the single source of truth until a group opts out.
  type GroupKey = keyof GroupStrength;
  const GROUP_KEYS: GroupKey[] = ['light', 'colour', 'effects'];
  const groupOverride: Record<GroupKey, number | null> = { light: null, colour: null, effects: null };
  const groupEl: Record<GroupKey, HTMLInputElement> = {
    light: $('mx-strength-light'),
    colour: $('mx-strength-colour'),
    effects: $('mx-strength-effects'),
  };
  const groupUnlinkEl: Record<GroupKey, HTMLButtonElement> = {
    light: $('mx-unlink-light'),
    colour: $('mx-unlink-colour'),
    effects: $('mx-unlink-effects'),
  };
  const groupReveal = $<HTMLButtonElement>('mx-groupreveal');
  const groupBar = $('mx-groupbar');

  const groupT = (g: GroupKey): number => groupOverride[g] ?? Number(strengthEl.value) / 100;
  const currentGroupStrength = (): GroupStrength => ({
    light: groupT('light'),
    colour: groupT('colour'),
    effects: groupT('effects'),
  });
  /** Keeps every unlinked slider's displayed value honest after the master
   *  moves — a linked slider is a read-out of the master, not its own state. */
  function syncGroupSliders() {
    for (const g of GROUP_KEYS) {
      groupEl[g].value = String(Math.round(groupT(g) * 100));
      groupUnlinkEl[g].setAttribute('aria-pressed', String(groupOverride[g] !== null));
    }
  }

  groupReveal.addEventListener('click', () => {
    const open = groupBar.hidden;
    groupBar.hidden = !open;
    groupReveal.setAttribute('aria-expanded', String(open));
    groupReveal.textContent = open ? 'Separate sliders ‹' : 'Separate sliders ›';
    if (open) syncGroupSliders();
  });

  for (const g of GROUP_KEYS) {
    groupEl[g].addEventListener('input', () => {
      groupOverride[g] = Number(groupEl[g].value) / 100;
      groupUnlinkEl[g].setAttribute('aria-pressed', 'true');
      draw();
    });
    groupUnlinkEl[g].addEventListener('click', () => {
      groupOverride[g] = null;
      syncGroupSliders();
      draw();
    });
  }

  const esc = (s: unknown) =>
    String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const sig = (v: number, d = 0) => {
    const r = Number(v.toFixed(d));
    return (r > 0 ? '+' : '') + r.toFixed(d);
  };

  /** One reference photo picked for the match, with its weight against any
   *  others picked alongside it (issue #41 — "several reference photos share
   *  the look you're after"). Populated either by a plain "◐ match" tap
   *  (one, weight 1) or by "Match this look" from the group tray (several,
   *  weight 1 each until adjusted) — see `openWorkbench`. */
  interface RefPick { id: string; url: string; name: string; weight: number }
  let refs: RefPick[] = [];
  let current: any = null;
  let preview: MatchPreview | null = null;

  /** Which Colour Grading wheel is drawn large, and whether Global — reached
   *  by a separate toggle, as in Lightroom — is showing instead of the
   *  Shadows/Midtones/Highlights cluster. */
  // `active: null` — not 'midtones' — is load-bearing: renderValues's
  // `gradeUi.active ?? …sort…` fallback only ever runs when this is nullish.
  // Initialising it to a real key made the fallback dead code, so the
  // largest wheel always showed Midtones regardless of which range actually
  // carried a grade, until a user clicked a small wheel to override it.
  const gradeUi = { active: null as 'shadows' | 'midtones' | 'highlights' | null, showGlobal: false };

  // ── Reference picking ─────────────────────────────────────────────────
  //
  // Opening the panel always starts from exactly one reference — the board
  // cell that was clicked — because that is by far the common case and it
  // should stay a single click. `renderAddRefStrip` then offers every OTHER
  // reference on this same board as an optional addition, so weighted
  // multi-reference matching (Capture One's "Match Look" against several
  // photos at once) is available without complicating the common path.

  function renderRefs() {
    const multi = refs.length > 1;
    refsEl.replaceChildren(
      ...refs.map((r, i) => {
        const li = document.createElement('li');
        li.className = 'mx-ref';
        li.innerHTML = `
          <img src="${esc(r.url)}" alt="" />
          <span class="mx-ref-meta">
            <span class="mx-ref-name" title="${esc(r.name)}">${esc(photoName(r.name) || (multi ? `Reference ${i + 1}` : 'Reference'))}</span>
            ${multi ? `<span class="mx-ref-weight">Weight <input type="number" min="0.1" max="10" step="0.1" value="${r.weight}" data-refweight="${i}" /></span>` : ''}
          </span>
          ${multi ? `<button type="button" class="mx-ref-remove" data-refremove="${i}" aria-label="Remove ${esc(r.name)} from this match">×</button>` : ''}
        `;
        return li;
      }),
    );
    renderAddRefStrip();
  }

  refsEl.addEventListener('input', (e) => {
    const inp = (e.target as HTMLElement).closest<HTMLInputElement>('[data-refweight]');
    if (!inp) return;
    const i = Number(inp.dataset.refweight);
    const w = Number(inp.value);
    refs[i].weight = Number.isFinite(w) && w > 0 ? w : 1;
  });
  refsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-refremove]');
    if (!btn || refs.length <= 1) return;
    refs.splice(Number(btn.dataset.refremove), 1);
    renderRefs();
    void loadAlready(refs.map((r) => r.id));
  });

  function renderAddRefStrip() {
    const chosen = new Set(refs.map((r) => r.id));
    const candidates = [...document.querySelectorAll<HTMLElement>('#board .cell-match')].filter(
      (btn) => !chosen.has(btn.dataset.match || ''),
    );
    addRefStrip.replaceChildren(
      ...candidates.map((btn) => {
        const li = document.createElement('li');
        const pick = document.createElement('button');
        pick.type = 'button';
        pick.className = 'mx-addref-pick';
        pick.dataset.pickId = btn.dataset.match || '';
        pick.dataset.pickUrl = btn.dataset.full || '';
        pick.dataset.pickName = btn.dataset.name || btn.dataset.match || '';
        pick.innerHTML = `<img src="${esc(btn.dataset.full || '')}" alt="" />`;
        li.appendChild(pick);
        return li;
      }),
    );
    addRefToggle.hidden = candidates.length === 0 && refs.length <= 1;
    addRefToggle.disabled = candidates.length === 0;
    addRefToggle.textContent = candidates.length
      ? 'Add another reference'
      : 'Every reference on the board is already in';
  }

  addRefToggle.addEventListener('click', () => {
    const open = addRefStrip.hidden;
    addRefStrip.hidden = !open;
    addRefToggle.setAttribute('aria-expanded', String(open));
  });
  addRefStrip.addEventListener('click', (e) => {
    const pick = (e.target as HTMLElement).closest<HTMLElement>('.mx-addref-pick');
    if (!pick) return;
    refs.push({
      id: pick.dataset.pickId || '',
      url: pick.dataset.pickUrl || '',
      name: pick.dataset.pickName || pick.dataset.pickId || '',
      weight: 1,
    });
    renderRefs();
    addRefStrip.hidden = true;
    addRefToggle.setAttribute('aria-expanded', 'false');
  });

  // ── Opening ────────────────────────────────────────────────────────────

  /** A board tile's own `.cell-match` attributes, for a reference that isn't
   *  necessarily the one that was clicked — the group path resolves several
   *  ids this way at once. */
  function boardMatchRef(id: string): { full: string; name: string } | null {
    const btn = document.querySelector<HTMLElement>(`.cell-match[data-match="${CSS.escape(id)}"]`);
    return btn?.dataset.full ? { full: btn.dataset.full, name: btn.dataset.name || id } : null;
  }

  /** Opens the workbench for references already resolved to a preview URL
   *  and name — shared by a board tap (resolved via `boardMatchRef`) and a
   *  reference arriving pre-resolved from elsewhere, such as the archive
   *  lightbox's "Match this look", which is not on this board's DOM at all. */
  function openWorkbenchWithRefs(picked: { id: string; full: string; name: string }[]) {
    if (!picked.length) return;
    refs = picked.map((r) => ({ id: r.id, url: r.full, name: r.name, weight: 1 }));
    renderRefs();
    addRefStrip.hidden = true;
    addRefToggle.setAttribute('aria-expanded', 'false');
    startEl.hidden = false;
    resultEl.hidden = true;
    statusEl.textContent = '';
    stopWorking();
    fileEl.value = '';        // so re-dropping the same file still fires `change`
    subEl.textContent = '';
    panel.hidden = false;
    requestAnimationFrame(() => panel.classList.add('show'));
    void loadAlready(refs.map((r) => r.id));
    // Without this, a scroll that starts outside the report's own scroller
    // moves the board behind the panel instead — the page shifts under a
    // supposedly fixed overlay, which reads as the layout breaking.
    document.body.style.overflow = 'hidden';
  }

  /** Opens the workbench for one or several board references — a plain
   *  "◐ match" tap passes one id, "Match this look" from the group tray
   *  passes several at once. */
  function openWorkbench(ids: string[]) {
    const picked = ids
      .map((id) => ({ id, ...boardMatchRef(id) }))
      .filter((r): r is { id: string; full: string; name: string } => Boolean(r.full));
    openWorkbenchWithRefs(picked);
  }

  document.getElementById('board')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.cell-match');
    if (!btn) return;
    e.stopPropagation();
    openWorkbench([btn.dataset.match || '']);
  });

  // Arriving from the archive lightbox's "Match this look" (index.astro,
  // ?match=<archive id>) — pre-resolved server-side in the frontmatter into
  // #match-archive-data, since the photo is not necessarily on this board.
  {
    const raw = document.getElementById('match-archive-data')?.textContent;
    const ref = raw ? (JSON.parse(raw) as { id: string; full: string; name: string } | null) : null;
    if (ref) openWorkbenchWithRefs([ref]);
  }

  // The group tray lives in the *other* script on this page (`is:inline`,
  // sharing no scope with this module) — see `window.getGroupIds` there.
  document.getElementById('group-tray-match')?.addEventListener('click', () => {
    const ids = (window as unknown as { getGroupIds?: () => string[] }).getGroupIds?.() ?? [];
    if (ids.length) openWorkbench(ids);
  });

  // ── Already in the archive ─────────────────────────────────────────────
  //
  // Ranks the archive against this reference on *grade alone* — the tone curve,
  // the cast, the saturation, the contrast, the split. It is not the "find
  // similar" ranking on the board, which is about subject and composition; the
  // two disagree constantly and that disagreement is the point.
  //
  // Fired on open and left to arrive. The first run has to measure every
  // photograph in the archive, which takes a few seconds; after that they are
  // cached and it comes back immediately. Either way the drop zone above stays
  // usable throughout, so nothing waits on this.

  const alreadyEl = $('already');
  const alreadyStrip = $('already-strip');
  /** The reference(s) the last request went out for, so a stale reply is dropped. */
  let alreadyFor = '';

  async function loadAlready(ids: string[]) {
    const key = ids.join(',');
    alreadyFor = key;
    alreadyEl.hidden = true;
    alreadyStrip.replaceChildren();
    $('already-sub').textContent = 'Measuring…';
    $('already-note').textContent = '';

    let data: any;
    try {
      const qs = ids.map((id) => 'ref=' + encodeURIComponent(id)).join('&');
      const response = await fetch(`/api/match/resemble?${qs}`);
      data = await response.json();
    } catch {
      data = { ok: false };
    }
    if (alreadyFor !== key) return;

    // A failure here is silence, not an error: this is an aside on the way to
    // the feature you opened the panel for, and a red line about it would read
    // as the match itself having gone wrong.
    if (!data?.ok) return;

    const matches: any[] = data.matches ?? [];
    alreadyEl.hidden = false;
    if (!matches.length) {
      $('already-sub').textContent = 'Nothing in the archive is graded like this.';
      $('already-note').textContent =
        `Checked ${data.considered} of ${data.archiveSize} photographs, by the numbers only.`;
      return;
    }

    $('already-sub').textContent =
      matches.length === 1 ? 'One of mine is graded like it' : `${matches.length} of mine are graded like it`;

    alreadyStrip.replaceChildren(
      ...matches.map((match) => {
        const item = document.createElement('li');
        // Links into the archive's own deep link rather than a lightbox of its
        // own, and opens in a new tab: the panel behind it is mid-task, and
        // navigating away from a reference you were about to match would lose it.
        item.innerHTML = `
          <a class="already-card" href="/#photo=${esc(match.id)}" target="_blank" rel="noopener" title="${esc(match.note)}" aria-label="${match.distance <= 0.75 ? 'Same grade' : 'Near it'}: ${esc(match.partsText)}">
            <span class="already-pic">
              <img src="${esc(match.thumb ?? match.placeholder)}" alt="" onerror="this.onerror=null;this.src='${esc(match.placeholder)}'" />
              <span class="already-parts" aria-hidden="true">${esc(match.partsText)}</span>
            </span>
            ${match.distance <= 0.75 ? '<span class="already-dist">Same grade</span>' : ''}
          </a>`;
        return item;
      }),
    );

    const short = data.considered < data.archiveSize;
    $('already-note').textContent = [
      '',
      short
        ? `Only ${data.considered} of ${data.archiveSize} photographs have a file to measure, so the rest weren’t checked.`
        : '',
    ]
      .filter(Boolean)
      .join(' ');
  }

  // ── Kept matches ───────────────────────────────────────────────────────
  //
  // The library `mx-keep`'s "Kept" button writes into (GET/DELETE
  // /api/match/kept). Loaded once on page arrival and refreshed after every
  // keep or remove, since either can happen without a navigation.

  const keptEl = $('kept');
  const keptStrip = $('kept-strip');
  const dateFmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

  async function loadKept() {
    let data: any;
    try {
      data = await (await fetch('/api/match/kept')).json();
    } catch {
      data = { ok: false };
    }
    if (!data?.ok) return;
    const items: any[] = data.items ?? [];
    keptEl.hidden = items.length === 0;
    if (!items.length) return;

    $('kept-sub').textContent = items.length === 1 ? 'one so far' : `${items.length} so far`;
    // Every value below goes through `esc()` before it reaches the template —
    // same convention as `loadAlready`'s cards just above, which this mirrors.
    keptStrip.replaceChildren(
      ...items.map((it) => {
        const li = document.createElement('li');
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'kept-card';
        card.dataset.open = it.id;
        card.title = 'Open this match again';
        const img = document.createElement('img');
        img.src = it.previewUrl ?? it.referencePreviewUrl ?? '';
        img.alt = '';
        img.loading = 'lazy';
        const name = document.createElement('span');
        name.className = 'kept-name';
        name.textContent = `${it.myName} as ${it.referenceName}`;
        const date = document.createElement('span');
        date.className = 'kept-date';
        date.textContent = dateFmt.format(new Date(it.createdAt));
        card.append(img, name, date);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'kept-remove';
        remove.dataset.remove = it.id;
        remove.setAttribute('aria-label', 'Remove from kept');
        remove.textContent = '×';
        li.append(card, remove);
        return li;
      }),
    );
  }
  void loadKept();

  keptStrip.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const removeBtn = target.closest<HTMLElement>('[data-remove]');
    if (removeBtn) {
      removeBtn.setAttribute('disabled', '');
      try {
        await fetch('/api/match/kept', {
          method: 'DELETE',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: removeBtn.dataset.remove }),
        });
      } catch { /* the strip reload below will show the true state either way */ }
      void loadKept();
      return;
    }
    const openBtn = target.closest<HTMLElement>('[data-open]');
    if (openBtn) void openKept(openBtn.dataset.open!);
  });

  /** Reopens a kept comparison straight into the result view — no photo to
   *  drop, no reference to pick, the measurement already happened. Shares
   *  `showResult` with a fresh `analyse()` rather than a second renderer, so
   *  a kept report and a just-finished one never drift apart. */
  async function openKept(id: string) {
    let data: any;
    try {
      data = await (await fetch(`/api/match/kept?id=${encodeURIComponent(id)}`)).json();
    } catch {
      data = { ok: false };
    }
    if (!data?.ok) { void loadKept(); return; }   // gone since the strip loaded — refresh it away
    current = { ...data, local: false };
    addRefStrip.hidden = true;
    addRefToggle.setAttribute('aria-expanded', 'false');
    statusEl.textContent = '';
    stopWorking();
    fileEl.value = '';
    panel.hidden = false;
    requestAnimationFrame(() => panel.classList.add('show'));
    document.body.style.overflow = 'hidden';
    await showResult(current);
    const keepBtn = $<HTMLButtonElement>('mx-keep');
    keepBtn.disabled = false;
    keepBtn.textContent = 'Kept';
  }

  const close = () => {
    panel.classList.remove('show');
    document.body.style.overflow = '';
    // Closing the panel stops the waiting too — otherwise the timer kept
    // running against a report nobody was going to see.
    if (abort) abort.abort();
    stopWorking();
    setTimeout(() => { panel.hidden = true; }, 220);
  };
  $('mx-close').addEventListener('click', close);

  // ── Enlarged tone curve ────────────────────────────────────────────────
  // The 116px in-panel curve is enough to see the shape but not to place a
  // point precisely. This redraws the same points bigger, with quarter
  // gridlines, plus every point's exact input/output printed below it — the
  // numbers Lightroom's own Tone Curve panel uses, on the same 0-255 scale.
  // Built with DOM calls rather than innerHTML, matching the rest of the
  // panel's own numbers-only content.
  function buildCurveSvgEl(curve: Adjustments['curve'], size: number): SVGSVGElement {
    const NS = 'http://www.w3.org/2000/svg';
    const S = size;
    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${S} ${S}`);
    svg.setAttribute('width', String(S));
    svg.setAttribute('height', String(S));
    svg.setAttribute('aria-hidden', 'true');
    const line = (x1: number, y1: number, x2: number, y2: number, opacity: number, dash?: string) => {
      const el = document.createElementNS(NS, 'line');
      el.setAttribute('x1', x1.toFixed(1));
      el.setAttribute('y1', y1.toFixed(1));
      el.setAttribute('x2', x2.toFixed(1));
      el.setAttribute('y2', y2.toFixed(1));
      el.setAttribute('stroke', 'currentColor');
      el.setAttribute('stroke-opacity', String(opacity));
      if (dash) el.setAttribute('stroke-dasharray', dash);
      svg.appendChild(el);
    };
    for (const t of [0, 64, 128, 192, 255]) {
      const v = (t / 255) * S;
      line(v, 0, v, S, 0.08);
      line(0, v, S, v, 0.08);
    }
    line(0, S, S, 0, 0.16, '2 3'); // no-change diagonal
    const px = (p: { x: number; y: number }): [number, number] => [(p.x / 255) * S, S - (p.y / 255) * S];
    const poly = document.createElementNS(NS, 'polyline');
    poly.setAttribute('points', curve.map((p) => px(p).map((n) => n.toFixed(1)).join(',')).join(' '));
    poly.setAttribute('fill', 'none');
    poly.setAttribute('stroke', 'currentColor');
    poly.setAttribute('stroke-width', '2');
    poly.setAttribute('stroke-linejoin', 'round');
    poly.setAttribute('stroke-linecap', 'round');
    svg.appendChild(poly);
    for (const p of curve) {
      const [cx, cy] = px(p);
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', cx.toFixed(1));
      c.setAttribute('cy', cy.toFixed(1));
      c.setAttribute('r', '3.4');
      c.setAttribute('fill', 'currentColor');
      svg.appendChild(c);
    }
    return svg;
  }
  // No separate scroll-lock here: this only ever opens on top of the match
  // panel, which has already set `document.body.style.overflow` itself.
  const openCurveLb = (curve: Adjustments['curve']) => {
    if (!curveLb.hidden) return;
    curveLbSvgHost.replaceChildren(buildCurveSvgEl(curve, 255));
    curveLbList.replaceChildren(
      ...curve.map((p) => {
        const row = document.createElement('div');
        row.className = Math.abs(p.x - p.y) <= 1 ? 'row identity' : 'row';
        const inEl = document.createElement('span');
        inEl.textContent = `In ${Math.round(p.x)}`;
        const outEl = document.createElement('span');
        outEl.textContent = `Out ${Math.round(p.y)}`;
        row.append(inEl, outEl);
        return row;
      }),
    );
    curveLb.hidden = false;
    requestAnimationFrame(() => curveLb.classList.add('show'));
  };
  const closeCurveLb = () => {
    if (curveLb.hidden) return;
    curveLb.classList.remove('show');
    setTimeout(() => { curveLb.hidden = true; }, 220);
  };
  curveLbClose.addEventListener('click', closeCurveLb);
  curveLb.addEventListener('click', (e) => { if (e.target === curveLb) closeCurveLb(); });
  // Delegated because renderValues() replaces mx-light's innerHTML on every
  // strength-slider move, same reasoning as the mx-colour listener above.
  $('mx-light').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.mx-curve-btn');
    if (!btn?.dataset.curve) return;
    openCurveLb(JSON.parse(btn.dataset.curve));
  });

  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!curveLb.hidden) closeCurveLb();
    else if (!panel.hidden) close();
  });

  // ── Upload ─────────────────────────────────────────────────────────────
  zoneEl.addEventListener('click', () => fileEl.click());
  zoneEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileEl.click(); }
  });
  const pick = (files: FileList | null | undefined) => {
    if (!files?.length) return;
    if (files.length > 1) void batch([...files]);
    else analyse(files[0]);
  };
  fileEl.addEventListener('change', () => { pick(fileEl.files); fileEl.value = ''; });
  ['dragenter', 'dragover'].forEach((ev) =>
    zoneEl.addEventListener(ev, (e) => { e.preventDefault(); zoneEl.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) =>
    zoneEl.addEventListener(ev, (e) => { e.preventDefault(); zoneEl.classList.remove('over'); }));
  zoneEl.addEventListener('drop', (e) => pick((e as DragEvent).dataTransfer?.files));

  // ── Batch ──────────────────────────────────────────────────────────────
  // One request per photo, one at a time: each is seconds of model work on
  // the Mac, and a queue that reports as it goes can be stopped part-way.
  // Each photo gets its own solve, so a preset fits its own exposure and
  // light rather than one compromise for the lot.
  const batchEl = $('mx-batch');
  const batchList = $('mx-batch-list');
  const batchCount = $('mx-batch-count');
  const batchStop = $<HTMLButtonElement>('mx-batch-stop');
  const batchFoot = $('mx-batch-foot');
  const batchStrength = $<HTMLInputElement>('mx-batch-strength');
  const batchStrengthOut = $('mx-batch-strength-out');
  const batchDownload = $<HTMLButtonElement>('mx-batch-download');
  let batchIds: string[] = [];
  let batchAbort: AbortController | null = null;

  batchStrength.addEventListener('input', () => { batchStrengthOut.textContent = `${batchStrength.value}%`; });
  batchStop.addEventListener('click', () => batchAbort?.abort());
  batchDownload.addEventListener('click', () => {
    if (!batchIds.length) return;
    const q = new URLSearchParams({ ids: batchIds.join(','), strength: String(Number(batchStrength.value) / 100) });
    location.href = `/api/match/presets.zip?${q}`;
  });

  async function batch(files: File[]) {
    if (!refs.length) { statusEl.textContent = 'Pick a reference first.'; return; }
    statusEl.textContent = '';
    batchIds = [];
    batchEl.hidden = false;
    batchFoot.hidden = true;
    batchStop.hidden = false;
    const rows = files.map((f) => {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.className = 'mx-batch-name';
      name.textContent = f.name;
      const state = document.createElement('span');
      state.className = 'mx-batch-state';
      state.textContent = 'Waiting';
      li.append(name, state);
      return { li, state };
    });
    batchList.replaceChildren(...rows.map((r) => r.li));
    batchAbort = new AbortController();
    let done = 0;
    for (let i = 0; i < files.length; i++) {
      if (batchAbort.signal.aborted) { rows[i].state.textContent = 'Stopped'; continue; }
      batchCount.textContent = `${i + 1} of ${files.length}`;
      rows[i].state.textContent = 'Measuring…';
      rows[i].li.dataset.state = 'running';
      const fd = new FormData();
      for (const r of refs) { fd.append('ref', r.id); fd.append('weight', String(r.weight)); }
      fd.append('photo', files[i]);
      fd.append('baseline', baselineEl.value);
      try {
        const res = await fetch('/api/match/analyse', { method: 'POST', body: fd, signal: batchAbort.signal });
        const data = await res.json();
        if (!data?.ok) throw new Error(data?.error || 'Could not match this one.');
        batchIds.push(data.id);
        done++;
        rows[i].state.textContent = 'Ready';
        rows[i].li.dataset.state = 'done';
      } catch (err) {
        const stopped = (err as Error).name === 'AbortError';
        rows[i].state.textContent = stopped ? 'Stopped' : (err as Error).message;
        rows[i].li.dataset.state = stopped ? 'stopped' : 'refused';
      }
    }
    batchStop.hidden = true;
    batchCount.textContent = `${done} of ${files.length} ready`;
    batchFoot.hidden = done === 0;
    batchDownload.textContent = `Download presets (${done})`;
  }

  /**
   * Analyse, preferring the Mac.
   *
   * A `fetch` that REJECTS means the server could not be reached — that is the
   * fallback case. A fetch that RESOLVES with ok:false is the server saying no
   * for a real reason (bad file, missing reference), and falling back there
   * would replace a clear error with a worse measurement.
   */
  async function analyse(file: File) {
    statusEl.innerHTML = '';
    const fd = new FormData();
    for (const r of refs) {
      fd.append('ref', r.id);
      fd.append('weight', String(r.weight));
    }
    fd.append('photo', file);
    fd.append('baseline', baselineEl.value);
    fd.append('stream', '1');

    startWorking();
    let reachedServer = false;
    try {
      const res = await fetch('/api/match/analyse', { method: 'POST', body: fd, signal: abort!.signal });
      reachedServer = true;
      const data = (res.headers.get('content-type') || '').includes('ndjson')
        ? await readStages(res)
        : await res.json();
      if (!data?.ok) throw new Error(data?.error || 'Analysis failed.');
      stopWorking();
      current = { ...data, local: false };
      await showResult(current);
      return;
    } catch (err) {
      if ((err as Error).name === 'AbortError') {
        stopWorking();
        // The Mac does not stop when the browser does — and that is worth
        // saying, because it means the retry is free rather than another wait.
        statusEl.textContent = 'Stopped waiting. The Mac keeps measuring in the background, so dropping the same photo again will be instant.';
        return;
      }
      if (reachedServer) {
        stopWorking();
        statusEl.innerHTML = `<span class="err">${esc((err as Error).message)}</span>`;
        return;
      }
    }

    // Offline path. Blending a weighted group of references works exactly as
    // it does server-side — see analyseLocally's own doc comment — so masks
    // are the only thing this path cannot do.
    setStage('Can’t reach the Mac, so measuring here');
    statusEl.innerHTML = 'No masks without the Mac. Everything else still works.';
    try {
      current = { ...(await analyseLocally(file)), local: true };
      stopWorking();
      await showResult(current);
    } catch (err) {
      stopWorking();
      statusEl.innerHTML = `<span class="err">${esc((err as Error).message)}</span>`;
    }
  }

  // ── Working state ──────────────────────────────────────────────────────
  // Four stages, weighted by how long each actually takes: decoding and
  // segmenting your photo is the bulk of it, the solve is nearly instant.
  const STAGE_PROGRESS: Record<string, number> = { reference: 0.12, mine: 0.3, solve: 0.86, preview: 0.92, cached: 0.96 };
  const workingEl = $('mx-working');
  const workFill = $('mx-workbar-fill');
  const stageEl = $('mx-workstage');
  const elapsedEl = $('mx-elapsed');
  let abort: AbortController | null = null;
  let tick = 0;
  let began = 0;

  const setStage = (label: string) => { stageEl.textContent = label; };

  function startWorking() {
    abort = new AbortController();
    began = Date.now();
    workingEl.hidden = false;
    workFill.style.width = '4%';
    setStage('Reading the file');
    elapsedEl.textContent = '';
    clearInterval(tick);
    tick = window.setInterval(() => {
      const s = Math.round((Date.now() - began) / 1000);
      elapsedEl.textContent = s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${s % 60}s`;
      // The very first match of a session also downloads the segmentation
      // models. Nothing reports that, so a run that has clearly overshot says
      // why rather than looking hung.
      if (s === 45) {
        statusEl.textContent = 'Slower than usual. If this is the first match since the app started, it’s also downloading the segmentation models, which only happens once.';
      }
    }, 1000);
  }

  function stopWorking() {
    clearInterval(tick);
    tick = 0;
    abort = null;
    workingEl.hidden = true;
    workFill.style.width = '0';
  }

  $('mx-stop').addEventListener('click', () => abort?.abort());

  /** Read the newline-delimited stage stream, returning the final result. */
  async function readStages(res: Response): Promise<any> {
    const reader = res.body!.getReader();
    const decoder = new TextDecoder();
    let buf = '';
    let result: any = null;
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += decoder.decode(value, { stream: true });
      const lines = buf.split('\n');
      buf = lines.pop() ?? '';
      for (const line of lines) {
        if (!line.trim()) continue;
        let msg: any;
        try { msg = JSON.parse(line); } catch { continue; }
        if (msg.type === 'stage') {
          setStage(msg.label);
          workFill.style.width = `${(STAGE_PROGRESS[msg.stage] ?? 0.5) * 100}%`;
        } else if (msg.type === 'result') {
          result = msg;
          workFill.style.width = '100%';
        }
      }
    }
    return result ?? { ok: false, error: 'The measurement finished but came back empty.' };
  }

  /** Measure every reference and the photo here, with no server and no
   *  models — masks are unavailable offline, but the blend across several
   *  references works exactly as it does server-side, since mergeReferences
   *  and solveMatch are the same isomorphic code either way. */
  async function analyseLocally(file: File) {
    const [analyses, mine] = await Promise.all([
      Promise.all(refs.map((r) => analyseReferenceInBrowser(r.url, r.name))),
      analyseInBrowser(file, file.name, baselineEl.value as any),
    ]);
    const weighted = refs.map((r, i) => ({ analysis: analyses[i], weight: r.weight }));
    const reference = mergeReferences(weighted);
    const solution = solveMatch(reference, mine);
    return {
      id: `local-${Date.now()}`,
      references: refs.map((r, i) => ({ analysis: analyses[i], weight: r.weight, name: r.name, previewUrl: r.url })),
      reference,
      mine,
      solution,
      // The photo is already in memory; no need to round-trip it anywhere.
      preview: { photo: URL.createObjectURL(file), maskTexture: null, maskChannels: [], width: mine.width, height: mine.height },
      maskChannels: [],
      referenceName: refs.map((r) => r.name).join(' + '),
      myName: file.name,
    };
  }

  // ── Result ─────────────────────────────────────────────────────────────
  async function showResult(data: any) {
    const refNames = ((data.references ?? []) as { name?: string }[]).map((r) => r.name ?? '').filter(Boolean);
    subEl.textContent = matchTitle(String(data.myName ?? ''), refNames.length ? refNames : String(data.referenceName ?? '').split(' + '));
    subEl.title = `${data.myName} · ${data.referenceName}`;
    refSide.src = data.references[0].previewUrl;
    refSideCaption.textContent =
      data.references.length > 1 ? `The reference, blended with ${data.references.length - 1} more` : 'The reference';
    startEl.hidden = true;
    resultEl.hidden = false;

    renderBadges(data);
    renderNotes(data.solution.notes);
    renderEvidence(data.reference, data.mine);
    // The round trip measures on the Mac; a match solved on this device has
    // nothing there to check against.
    $('mx-tab-check').hidden = Boolean(data.local);
    rt.result = null;
    rt.error = '';
    void loadRoundTrip();
    showTab('light');
    // Tabs were hidden (inside the just-revealed .mx-result) until now, so
    // this is the first point scrollWidth/clientWidth are measurable.
    updateTabsOverflow();

    try {
      preview = new MatchPreview(canvas);
      await preview.setImages(data.preview.photo, data.preview.maskTexture);
      draw();
    } catch (err) {
      // A failed preview must not take the numbers down with it — they are the
      // part that actually goes into Lightroom.
      canvas.replaceWith(
        Object.assign(document.createElement('p'), {
          className: 'mx-note',
          textContent: `No live preview (${(err as Error).message}). The numbers and the preset are fine.`,
        }),
      );
      preview = null;
      renderValues();
    }
  }

  const GROUP_LABEL: Record<GroupKey, string> = { light: 'Light', colour: 'Colour', effects: 'Effects' };

  let holding = false;   // the picture is being held for the original
  function draw() {
    const t = Number(strengthEl.value) / 100;
    syncGroupSliders();
    const adj = atGroupStrength(current.solution.restrained, current.solution.faithful, currentGroupStrength());
    const base =
      t === 0 ? 'No change' :
      t < 0.5 ? `${Math.round(t * 200)}% of the restrained grade` :
      t === 0.5 ? 'Restrained: the reference’s feel, skin left alone' :
      t === 1 ? 'Faithful: as close as the sliders can get' :
      `${Math.round((t - 0.5) * 200)}% of the way from restrained to faithful`;
    const overridden = GROUP_KEYS.filter((g) => groupOverride[g] !== null);
    strengthLabel.textContent = overridden.length
      ? `${base} · ${overridden.map((g) => GROUP_LABEL[g]).join('/')} set independently`
      : base;
    if (preview) {
      const spec = deriveRenderSpec(adj, current.maskChannels ?? []);
      preview.render(spec, holding ? 1.01 : wipeEl.checked ? 0.5 : -1);
    }
    renderValues(adj);
  }

  strengthEl.addEventListener('input', draw);
  const wipeCaption = () => (holding ? 'The original' : wipeEl.checked ? 'Left: original · Right: graded' : 'Yours, graded');
  wipeEl.addEventListener('change', () => {
    wipeHint.textContent = wipeCaption();
    draw();
  });

  // Press and hold the picture for the original, let go for the grade: the
  // gesture Lightroom and Photos both use, so it needs no button. `\` does
  // the same from a keyboard (Lightroom's before key); the Before / after
  // switch stays for a split you can look at without holding anything.
  const setHolding = (on: boolean) => {
    if (holding === on) return;
    holding = on;
    resultEl.classList.toggle('mx-holding', on);
    wipeHint.textContent = wipeCaption();
    draw();
  };
  const canvasEl = $<HTMLCanvasElement>('mx-canvas');
  canvasEl.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    canvasEl.setPointerCapture(e.pointerId);
    setHolding(true);
  });
  for (const ev of ['pointerup', 'pointercancel', 'lostpointercapture'] as const) canvasEl.addEventListener(ev, () => setHolding(false));
  canvasEl.addEventListener('contextmenu', (e) => e.preventDefault());
  addEventListener('keydown', (e) => {
    if (e.key !== '\\' || resultEl.hidden || (e.target as HTMLElement).closest('input, textarea, select')) return;
    e.preventDefault();
    setHolding(true);
  });
  addEventListener('keyup', (e) => { if (e.key === '\\') setHolding(false); });

  // More: the variant downloads, out of the way of the one filled button.
  const moreBtn = $<HTMLButtonElement>('mx-more');
  const moreMenu = $('mx-more-menu');
  const closeMore = () => { moreMenu.hidden = true; moreBtn.setAttribute('aria-expanded', 'false'); };
  moreBtn.addEventListener('click', () => {
    const open = moreMenu.hidden;
    moreMenu.hidden = !open;
    moreBtn.setAttribute('aria-expanded', String(open));
    if (open) moreMenu.querySelector<HTMLButtonElement>('button')?.focus();
  });
  moreMenu.addEventListener('click', closeMore);
  addEventListener('pointerdown', (e) => { if (!moreMenu.hidden && !e.composedPath().includes(moreBtn.parentElement!)) closeMore(); });
  moreMenu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); closeMore(); moreBtn.focus(); } });

  // ── Stage collapse ─────────────────────────────────────────────────────
  // The pictures hand their space back to the report as you scroll. `--s`
  // reaches 0 over the first COLLAPSE_OVER pixels; everything in the stage
  // interpolates on it in CSS.
  const COLLAPSE_OVER = 240;
  const scroller = $('mx-scroll');
  scroller.addEventListener(
    'scroll',
    () => {
      const s = Math.max(0, Math.min(1, 1 - scroller.scrollTop / COLLAPSE_OVER));
      resultEl.style.setProperty('--s', s.toFixed(3));
    },
    { passive: true },
  );

  // ── Tabs ───────────────────────────────────────────────────────────────
  const tabs = $('mx-tabs');
  function showTab(name: string) {
    tabs.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) =>
      b.classList.toggle('on', b.dataset.tab === name),
    );
    scroller.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
      p.hidden = p.dataset.panel !== name;
    });
    // Switching tab should start at the top of the new panel, and give the
    // stage its full height back rather than leaving it collapsed for content
    // that may be short.
    scroller.scrollTop = 0;
    resultEl.style.setProperty('--s', '1');
  }

  // On a narrow phone the five tabs don't all fit — `.mx-tabs` already
  // scrolls (overflow-x, scrollbar hidden), but with nothing to say so, the
  // last tab (Notes, carrying a live count badge) just looked clipped rather
  // than swipeable. `.has-overflow` fades the right edge exactly when
  // there's more to scroll to, and clears once scrolled to the end, so it
  // never claims more content exists than actually does.
  function updateTabsOverflow() {
    const more = tabs.scrollWidth - tabs.clientWidth > 4 && tabs.scrollLeft + tabs.clientWidth < tabs.scrollWidth - 4;
    tabs.classList.toggle('has-overflow', more);
  }
  tabs.addEventListener('scroll', updateTabsOverflow, { passive: true });
  addEventListener('resize', updateTabsOverflow);
  tabs.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
    if (btn?.dataset.tab) showTab(btn.dataset.tab);
  });

  // ── Colour Grading wheel cluster ─────────────────────────────────────────
  // Delegated because renderValues() replaces mx-colour's innerHTML on every
  // strength-slider move.
  $('mx-colour').addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const rangeBtn = target.closest<HTMLElement>('[data-range]');
    if (rangeBtn?.dataset.range) {
      gradeUi.active = rangeBtn.dataset.range as typeof gradeUi.active;
      renderValues();
      return;
    }
    if (target.closest('#mx-globaltoggle')) {
      gradeUi.showGlobal = !gradeUi.showGlobal;
      renderValues();
    }
  });

  // ── Badges ─────────────────────────────────────────────────────────────
  // Two distinct kinds share this panel and now get distinct chrome: a
  // *reading* (confidence, gap — a number the solver measured) renders as a
  // spec-sheet figure; a *caveat* (calibration, reference counts, refusal
  // prose — a note about the measurement rather than one) renders as a quiet
  // italic annotation. Same underlying honesty-as-UI content, typography
  // only — every caveat/refusal string below is unchanged from before.
  function renderBadges(data: any) {
    const s = data.solution;
    const stats: Array<[string, number, boolean]> = [
      ['sure of the measurements', Math.round(s.confidence * 100), s.confidence < 0.7],
      ['of the gap can close', Math.round(s.reachability * 100), s.reachability < 0.55],
    ];
    const caveats: Array<[string, boolean]> = [
      [`Your photo was read as: ${BASELINE_LABEL[data.mine.baseline as keyof typeof BASELINE_LABEL].toLowerCase()}`, data.mine.baseline === 'preview'],
      // Which constants were measured, as of when THIS match was solved — a
      // kept report from before any were approved stays "estimated".
      (data.calibrated || []).length
        ? [`Slider calibration: ${data.calibrated.length} of ${CAL_TARGETS.length} measured from your round trips, the rest estimated`, false]
        : ['Slider calibration is estimated for now', true],
    ];
    // Only known once the group's own references have actually been
    // analysed — the start screen (see `openWorkbench`) shows what's about
    // to be measured, not this, because this can't exist yet at that point.
    if (data.referenceCount > 1) {
      const n = (data.outlierIds || []).length;
      caveats.push([`Blended from ${data.referenceCount} references`, false]);
      if (n) {
        caveats.push([
          `${n} reference${n === 1 ? '' : 's'} measure${n === 1 ? 's' : ''} like a different edit`,
          true,
        ]);
      }
    }
    if (data.local) caveats.unshift(['Measured on this device, so no masks', true]);
    $('mx-badges').innerHTML =
      `<div class="mx-stats">${stats
        .map(
          ([label, value, warn]) =>
            `<span class="mx-stat${warn ? ' warn' : ''}"><span class="mx-stat-figure">${value}<span class="mx-stat-unit">%</span></span><span class="mx-stat-label">${esc(label)}</span></span>`,
        )
        .join('')}</div>` +
      `<div class="mx-caveats">${caveats.map(([t, warn]) => `<p class="mx-caveat${warn ? ' warn' : ''}">${esc(t)}</p>`).join('')}</div>`;
    // Keeping a report writes it to the Mac, which is exactly what is missing.
    const keep = $<HTMLButtonElement>('mx-keep');
    keep.disabled = Boolean(data.local);
    keep.textContent = data.local ? 'Keeping needs the Mac' : 'Keep this match';
  }

  function renderNotes(notes: Array<{ severity: string; panel: string; text: string }>) {
    const cautions = notes.filter((n) => n.severity === 'caution').length;
    // Only cautions get a count — a badge on every informational note would
    // train you to ignore it.
    $('mx-notecount').textContent = cautions ? String(cautions) : '';
    $('mx-notes').innerHTML =
      ''+
      (notes.length
        ? notes
            .map(
              (n) =>
                `<div class="mx-noterow ${n.severity === 'caution' ? 'caution' : ''}">
                   <span class="panel">${esc(n.panel)}</span><span>${esc(n.text)}</span>
                 </div>`,
            )
            .join('')
        : '<p class="mx-rowhint">Nothing held back this time.</p>');
  }

  // ── Values ─────────────────────────────────────────────────────────────
  function group(title: string, rows: string[], hint?: string, tag?: string) {
    if (!rows.filter(Boolean).length) return '';
    return `<div class="mx-group"><div class="mx-grouphead"><span>${esc(title)}</span>${
      tag ? `<span class="tag">${esc(tag)}</span>` : ''
    }</div>${hint ? `<p class="mx-rowhint">${esc(hint)}</p>` : ''}${rows.filter(Boolean).join('')}</div>`;
  }
  const row = (k: string, v: string) => `<div class="mx-row"><span class="k">${esc(k)}</span><span class="v">${esc(v)}</span></div>`;
  const rowIf = (k: string, n: number, d = 0) => (Math.abs(n) < (d ? 0.005 : 0.5) ? '' : row(k, sig(n, d)));

  /** The *global* Temp readout only — masks keep the plain relative-scale
   *  rowIf('Temp', m.temp) untouched, since a mask's Temp has no Kelvin
   *  equivalent (it isn't a real slider on a RAW the way the global one is).
   *  See calibration.ts's tempKelvinPer100 for why this is a labelled
   *  estimate, rounded to the nearest 50K so it doesn't read as more
   *  precise than it is. */
  const tempKelvinRowIf = (n: number): string => {
    if (Math.abs(n) < 0.5) return '';
    const kelvin = Math.round(((n / 100) * DEFAULT_CALIBRATION.tempKelvinPer100) / 50) * 50;
    if (kelvin === 0) return '';
    return row('Temp', `≈ ${kelvin > 0 ? '+' : ''}${kelvin}K`);
  };

  /** Draw the tone curve. A list of coordinates is data; this is the shape.
   *  144px — the same scale as the large Colour Grading wheel (`.mx-cw-lg`,
   *  9rem) — since the curve is this panel's other "authoritative" control
   *  and was reading as an afterthought at its old, much smaller size. */
  function curveSvg(curve: Adjustments['curve']): string {
    const S = 144;
    const px = (p: { x: number; y: number }) => `${((p.x / 255) * S).toFixed(1)},${(S - (p.y / 255) * S).toFixed(1)}`;
    return `<svg width="${S}" height="${S}" viewBox="0 0 ${S} ${S}" aria-hidden="true">
      <line x1="0" y1="${S}" x2="${S}" y2="0" stroke="currentColor" stroke-opacity="0.16" stroke-dasharray="2 3"/>
      <polyline points="${curve.map(px).join(' ')}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
      ${curve.map((p) => `<circle cx="${((p.x / 255) * S).toFixed(1)}" cy="${(S - (p.y / 255) * S).toFixed(1)}" r="1.7" fill="currentColor"/>`).join('')}
    </svg>`;
  }

  /**
   * One Colour Grading wheel, drawn the way Lightroom draws it.
   *
   * Hue runs clockwise from the top (matching the conic-gradient in CSS) and
   * saturation runs centre-to-edge, so the dot's position alone tells you what
   * the grade is doing — which "163° / 15" never does.
   */
  function wheel(name: string, g: { hue: number; sat: number }, size: 'lg' | 'sm' = 'lg', range?: string): string {
    const on = g.sat >= 0.5;
    const rad = (g.hue * Math.PI) / 180;
    const r = Math.min(1, g.sat / 100) * 40; // percent of the disc's half-width
    const left = 50 + r * Math.sin(rad);
    const top = 50 - r * Math.cos(rad);
    const dotColor = `hsl(${Math.round(g.hue)} ${Math.max(22, Math.round(g.sat))}% 55%)`;
    const dot = on
      ? `<span class="dot" style="left:${left.toFixed(1)}%;top:${top.toFixed(1)}%;background:${dotColor};--glow:${dotColor}"></span>`
      : '';
    const tag = range ? 'button' : 'div';
    const attrs = range ? ` type="button" data-range="${esc(range)}"` : '';
    return `<${tag} class="mx-cw mx-cw-${size}${on ? '' : ' off'}"${attrs}>
        <div class="disc">${dot}</div>
        <span class="nm">${esc(name)}</span>
        <span class="v">${on ? `${Math.round(g.hue)}° · ${Math.round(g.sat)}` : '—'}</span>
      </${tag}>`;
  }

  function renderValues(adj?: Adjustments) {
    if (!adj) adj = atGroupStrength(current.solution.restrained, current.solution.faithful, currentGroupStrength());
    const a = adj;

    // ── Light ────────────────────────────────────────────────────────────
    const flat = a.curve.every((p) => Math.abs(p.x - p.y) <= 1);
    $('mx-light').innerHTML =
      ''+
      group(
        'Light',
        [
          rowIf('Exposure', a.exposure, 2),
          `<div class="mx-curvebox"><button type="button" class="mx-curve-btn" data-curve='${esc(JSON.stringify(a.curve))}' aria-label="Enlarge the tone curve">${curveSvg(a.curve)}</button><div class="legend">
             <strong>Tone curve</strong>${flat ? ' — flat at this strength, so no tonal change.' : '. The dashed diagonal is no change. Click it to enlarge.'}
           </div></div>`,
        ],
        undefined,
        'the real move',
      ) +
      group(
        'Basic sliders',
        [rowIf('Contrast', a.contrast), rowIf('Highlights', a.highlights), rowIf('Shadows', a.shadows), rowIf('Whites', a.whites), rowIf('Blacks', a.blacks)],
        'Use these or the curve, not both.',
        'either / or',
      );

    // ── Colour ───────────────────────────────────────────────────────────
    const active = HSL_BANDS.filter((b) => {
      const v = a.hsl[b.key];
      return Math.abs(v.hue) >= 0.5 || Math.abs(v.sat) >= 0.5 || Math.abs(v.lum) >= 0.5;
    });
    const cell = (n: number) => `<span class="n${Math.abs(n) < 0.5 ? ' z' : ''}">${Math.abs(n) < 0.5 ? '·' : sig(n)}</span>`;
    const mixer = active.length
      ? group('Colour Mixer', [
          `<div class="mx-mixer">
             <span class="hdr"></span><span class="hdr n">Hue</span><span class="hdr n">Sat</span><span class="hdr n">Lum</span>
             ${active
               .map((b) => {
                 const v = a.hsl[b.key];
                 return `<span class="band"><span class="chip" style="background:oklch(0.66 0.15 ${b.H})"></span>${esc(b.label)}</span>${cell(v.hue)}${cell(v.sat)}${cell(v.lum)}`;
               })
               .join('')}
           </div>`,
        ])
      : '';

    // Lightroom shows Shadows/Midtones/Highlights as a 3-way cluster — one
    // large "active" wheel plus two small ones — and reaches Global through a
    // separate toggle rather than a fourth wheel in the row. The active range
    // defaults to whichever one the preset actually moved, so the biggest
    // move is what greets you; a click on a small wheel promotes it, and that
    // choice sticks across strength-slider re-renders via `gradeUi`.
    const ranges = { shadows: a.grading.shadows, midtones: a.grading.midtones, highlights: a.grading.highlights };
    const rangeLabel = { shadows: 'Shadows', midtones: 'Midtones', highlights: 'Highlights' } as const;
    const rangeKeys = ['shadows', 'midtones', 'highlights'] as const;
    const activeKey =
      gradeUi.active ?? rangeKeys.slice().sort((x, y) => ranges[y].sat - ranges[x].sat)[0] ?? 'midtones';
    const smallKeys = rangeKeys.filter((k) => k !== activeKey);

    // Balance/Blending sit beside the wheel cluster rather than stacked full-
    // width beneath it — the cluster alone never fills this group's width
    // (it's sized to three circles, not to the panel), and these two rows
    // are the only other content this card has, so the empty flank next to
    // the wheels is exactly where they belong. Wraps below on a narrow
    // viewport rather than compressing either side.
    const gradeStats = [rowIf('Balance', a.grading.balance), row('Blending', String(Math.round(a.grading.blending)))]
      .filter(Boolean)
      .join('');
    const grading = group('Colour Grading', [
      `<div class="mx-gradebox">
         <div class="mx-gradewheels">
           <div class="mx-wheelcluster"${gradeUi.showGlobal ? ' hidden' : ''}>
             <div class="mx-wheelhero">${wheel(rangeLabel[activeKey], ranges[activeKey], 'lg', activeKey)}</div>
             <div class="mx-wheelsmalls">
               ${smallKeys.map((k) => wheel(rangeLabel[k], ranges[k], 'sm', k)).join('')}
             </div>
           </div>
           ${gradeUi.showGlobal ? `<div class="mx-wheelglobalbox">${wheel('Global', a.grading.global, 'lg')}</div>` : ''}
           <button type="button" class="mx-globaltoggle" id="mx-globaltoggle" aria-pressed="${gradeUi.showGlobal}">
             ${gradeUi.showGlobal ? '‹ Shadows · Midtones · Highlights' : 'Global ›'}
           </button>
         </div>
         ${gradeStats ? `<div class="mx-gradestats">${gradeStats}</div>` : ''}
       </div>`,
    ]);

    $('mx-colour').innerHTML =
      grading +
      `<div class="mx-two">
         <div>${group('Saturation', [rowIf('Vibrance', a.vibrance), rowIf('Saturation', a.saturation)]) || ''}</div>
         <div>${group(
           'White balance',
           [tempKelvinRowIf(a.temp), rowIf('Tint', a.tint)],
           'Temp is relative to your RAW’s current setting.',
           'either / or',
         )}</div>
       </div>` +
      mixer;

    // ── Details ──────────────────────────────────────────────────────────
    const effects = group('Effects & Detail', [
      rowIf('Texture', a.texture),
      rowIf('Clarity', a.clarity),
      rowIf('Vignette', a.vignette),
      a.grainAmount > 0.5 ? row('Grain amount', sig(a.grainAmount)) : '',
      a.grainAmount > 0.5 ? row('Grain size', String(Math.round(a.grainSize))) : '',
      rowIf('Noise reduction', a.noiseReduction),
      a.sharpenAmount > 0.5 ? row('Sharpening', String(Math.round(a.sharpenAmount))) : '',
    ]);
    const masks = a.masks
      .map((m) =>
        group(
          m.label,
          [rowIf('Exposure', m.exposure, 2), rowIf('Temp', m.temp), rowIf('Tint', m.tint), rowIf('Saturation', m.saturation)],
          m.rationale,
          m.kind === 'manual' ? 'mask · draw yourself' : `mask · auto (Select ${m.kind})`,
        ),
      )
      .join('');
    $('mx-details').innerHTML =
      (effects || '<p class="mx-rowhint">Nothing to change in Effects or Detail.</p>') +
      (masks
        ? `<p class="mx-lede">Masks. Subject, Sky and Background rebuild themselves when you import the preset. You draw the rest.</p><div class="mx-grid">${masks}</div>`
        : '');
  }

  // ── Evidence ───────────────────────────────────────────────────────────
  /** A bar centred on zero. Direction and rough size read instantly; the exact
   *  figure sits next to it for anyone who wants it. */
  function bar(caption: string, value: number, max: number): string {
    const v = Math.max(-1, Math.min(1, value / max));
    const half = 50 * Math.abs(v);
    const left = v >= 0 ? 50 : 50 - half;
    return `<div class="mx-bars"><span class="cap">${esc(caption)}</span>
      <div class="mx-track"><i style="left:${left.toFixed(1)}%;width:${half.toFixed(1)}%"></i></div></div>`;
  }

  function renderEvidence(ref: PhotoAnalysis, mine: PhotoAnalysis) {
    const rows: string[] = [];
    for (const key of REGION_ORDER as RegionKey[]) {
      const r = ref.regions[key];
      const m = mine.regions[key];
      if (!r && !m) continue;
      const label = REGION_LABEL[key];
      if (!r || !m) {
        rows.push(
          `<span class="lbl">${esc(label)}</span><span class="val none">${r ? 'reference only' : 'your photo only'}</span>`,
        );
        continue;
      }
      const dL = r.L.mean - m.L.mean;
      const dC = r.C.mean - m.C.mean;
      const weak = r.hue.strength < 0.3 || m.hue.strength < 0.3;
      let dH = r.hue.mean - m.hue.mean;
      while (dH > 180) dH -= 360;
      while (dH < -180) dH += 360;
      rows.push(
        `<span class="lbl">${esc(label)}</span>` +
          `<span class="val">${sig(dL, 3)} light · ${sig(dC, 3)} colour · ${weak ? 'hue unresolved' : `${sig(dH, 0)}° hue`}</span>` +
          bar('light', dL, 0.15) +
          bar('colour', dC, 0.05),
      );
    }

    const comparable = ref.texture.usable && mine.texture.usable;
    $('mx-evidence').innerHTML =
      ''+
      group('Region by region', [`<div class="mx-ev">${rows.join('')}</div>`]) +
      group(
        'Texture',
        comparable
          ? [
              row('Grain', `${ref.texture.grain.toFixed(4)} ref · ${mine.texture.grain.toFixed(4)} yours`),
              row('Acutance', `${ref.texture.acutance.toFixed(3)} ref · ${mine.texture.acutance.toFixed(3)} yours`),
              row('Measured at', `${ref.texture.measuredAt.width}px ref · ${mine.texture.measuredAt.width}px yours`),
            ]
          : [row('Grain', 'not comparable')],
        comparable
          ? undefined
          : (!ref.texture.usable ? ref.texture.reason : mine.texture.reason) ??
            'Measured at different sizes, so the two can’t be fairly compared.',
      ) +
      group('Vignette', [
        row('Reference', `${ref.vignette.falloffStops.toFixed(2)} stops · ${ref.vignette.usable ? 'usable' : 'scene content'}`),
        row('Yours', `${mine.vignette.falloffStops.toFixed(2)} stops · ${mine.vignette.usable ? 'usable' : 'scene content'}`),
      ], ref.vignette.usable && mine.vignette.usable ? undefined : 'The dark corners are lopsided, which comes from the scene rather than the lens, so the Vignetting slider stays put.');
  }

  // ── Round trip: check the finished export ───────────────────────────────
  // lib/match/roundtrip.ts holds what each answer may claim; this only draws
  // them. Every piece of text that qualifies a number comes from the server.
  const rtPanel = $('mx-rt');
  const rt: {
    downloads: any[]; history: any[]; calibration: any; result: any;
    busy: boolean; error: string; appliedAs: 'unchanged' | 'changed'; downloadId: string;
  } = { downloads: [], history: [], calibration: null, result: null, busy: false, error: '', appliedAs: 'unchanged', downloadId: '' };

  const pctText = (v: number) => `${Math.round(v * 100)}`;
  const whenText = (iso: string) => {
    const d = new Date(iso);
    const today = new Date().toDateString() === d.toDateString();
    return today
      ? `Today ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`
      : d.toLocaleString([], { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  };
  const downloadLabel = (d: any) => {
    const s = d.strength;
    const same = s.light === s.colour && s.colour === s.effects;
    const strength = same ? `strength ${pctText(s.light)}` : `Light ${pctText(s.light)} · Colour ${pctText(s.colour)} · Effects ${pctText(s.effects)}`;
    return `${whenText(d.at)} · ${strength} · ${d.variant === 'safe' || !d.hadMasks ? 'without masks' : 'with masks'}`;
  };

  async function loadRoundTrip() {
    if (!current || current.local) return;
    const id = current.id;
    try {
      const [a, b] = await Promise.all([
        fetch(`/api/match/roundtrip?match=${encodeURIComponent(id)}`).then((r) => r.json()),
        fetch('/api/match/calibration').then((r) => r.json()),
      ]);
      if (!current || current.id !== id) return; // another report opened meanwhile
      rt.downloads = a.downloads || [];
      rt.history = a.history || [];
      rt.calibration = b.ok ? b : null;
      if (!rt.downloads.some((d) => d.id === rt.downloadId)) rt.downloadId = rt.downloads[0]?.id || '';
    } catch {
      rt.error = 'Couldn’t reach the Mac to load earlier downloads.';
    }
    renderRoundTrip();
  }

  function renderRoundTrip() {
    const intro =
      `<p class="mx-lede">Drop your Lightroom export to check it.` +
      `</p>`;
    if (!rt.downloads.length) {
      rtPanel.innerHTML = intro +
        `<p class="mx-rt-empty">Download the preset first.</p>` +
        renderCalibration();
      return;
    }
    const options = rt.downloads
      .map((d) => `<option value="${esc(d.id)}"${d.id === rt.downloadId ? ' selected' : ''}>${esc(downloadLabel(d))}</option>`)
      .join('');
    rtPanel.innerHTML = intro +
      `<div class="mx-rt-form">
        <label class="mx-rt-field"><span>Compare with the preset from</span>
          <select id="mx-rt-dl">${options}</select></label>
        <fieldset class="mx-rt-applied"><legend>After applying it, you…</legend>
          <label><input type="radio" name="mx-rt-applied" value="unchanged"${rt.appliedAs === 'unchanged' ? ' checked' : ''}> left every slider as the preset set it</label>
          <label><input type="radio" name="mx-rt-applied" value="changed"${rt.appliedAs === 'changed' ? ' checked' : ''}> changed something</label>
        </fieldset>
        <div class="mx-rt-drop${rt.busy ? ' busy' : ''}" id="mx-rt-drop" role="button" tabindex="0" aria-busy="${rt.busy}">
          ${rt.busy ? 'Measuring your export…' : 'Drop the export here, or <span class="link">choose it</span>'}
        </div>
        <input type="file" id="mx-rt-file" accept="image/jpeg,image/png,image/tiff,image/webp,image/avif,image/heic" hidden />
      </div>` +
      (rt.error ? `<p class="mx-rt-error">${esc(rt.error)}</p>` : '') +
      (rt.result ? renderRoundTripResult(rt.result) : '') +
      renderCalibration() +
      (rt.history.length
        ? `<h3 class="mx-rt-h">Earlier checks of this match</h3><ul class="mx-rt-history">${rt.history
            .map((h) => `<li>${esc(whenText(h.at))} · ${h.overall === null ? 'no gap to measure' : h.overall < 0 ? 'moved away from the reference overall' : `${pctText(h.overall)}% of the gap closed`} · ${h.eligible ? 'calibrated' : 'not used for calibration'}</li>`)
            .join('')}</ul>`
        : '');
  }

  function renderRoundTripResult(r: any) {
    const c = r.comparison;
    const bar = (closed: number | null) => {
      if (closed === null) return '<span class="mx-rt-bar none"></span>';
      const w = Math.max(0, Math.min(1, closed)) * 100;
      return `<span class="mx-rt-bar${closed < 0 ? ' away' : ''}"><span style="width:${w.toFixed(0)}%"></span></span>`;
    };
    const rows = c.rows.map((row: any) => `<li>${bar(row.closed)}<span>${esc(row.text)}</span></li>`).join('');
    const follow = r.followUp
      ? `<div class="mx-rt-follow">
          <button type="button" id="mx-rt-followdl">Download follow-up preset</button>
          <p>Apply this <em>instead of</em> the first preset, not on top of it: a preset sets values rather than adding to them, so this one carries the first preset’s values plus the correction.</p>
        </div>`
      : r.moves && r.moves.length
        ? `<h3 class="mx-rt-h">Moves to make by hand</h3>
           <p class="mx-lede">You changed things after applying the preset, and a follow-up preset would undo them. So here are the moves to make from where you are now.</p>
           <table class="mx-rt-moves">${r.moves.map((m: any) => `<tr><td>${esc(m.panel)}</td><td>${esc(m.control)}</td><td>${esc(m.delta)}</td></tr>`).join('')}</table>`
        : `<p class="mx-lede">Nothing left worth moving by hand.</p>`;
    const cal = r.roundTrip.eligible
      ? `<p class="mx-rt-ok">Saved as a calibration point (${r.roundTrip.rowsAdded} measurements added).</p>`
      : `<div class="mx-rt-no"><p>Not used for calibration:</p><ul>${r.roundTrip.reasons.map((t: string) => `<li>${esc(t)}</li>`).join('')}</ul></div>`;
    return `<section class="mx-rt-result">
      <p class="mx-rt-overall">${c.overall === null
        ? 'Nothing to close. Your photo already matched the reference.'
        : c.overall < 0
          ? 'Overall the edit ended up further from the reference than where you started. Each measurement is below.'
          : `<span class="fig">${pctText(c.overall)}<span class="unit">%</span></span> of the measured gap closed`}</p>
      <ul class="mx-rt-rows">${rows}</ul>
      ${follow}
      ${cal}
    </section>`;
  }

  function renderCalibration() {
    const c = rt.calibration;
    if (!c) return '';
    const fmtV = (v: number) => (Math.abs(v) >= 10 ? v.toFixed(0) : Math.abs(v) >= 1 ? v.toFixed(2) : v.toPrecision(2));
    const rows = c.proposals.map((p: any) => {
      const applied = p.key in (c.approved?.values || {});
      const offer = p.status === 'fitted' && Math.abs(p.value - p.current) > 1e-9;
      return `<tr class="st-${esc(p.status)}">
        <th scope="row">${esc(p.label)}</th>
        <td>${fmtV(p.current)}${applied ? ' <span class="tag">measured</span>' : ' <span class="tag est">estimate</span>'}</td>
        <td>${p.value === undefined ? '—' : fmtV(p.value)}</td>
        <td class="why">${esc(p.text)}</td>
        <td class="act">${offer ? `<button type="button" data-cal-apply="${esc(p.key)}">Apply</button>` : ''}${applied ? `<button type="button" class="ghost" data-cal-reset="${esc(p.key)}">Use estimate</button>` : ''}</td>
      </tr>`;
    }).join('');
    return `<section class="mx-rt-cal">
      <h3 class="mx-rt-h">Slider calibration from your round trips</h3>
      <p class="mx-lede">${c.eligibleRoundTrips} of ${c.totalRoundTrips} round trips could calibrate. A fit changes nothing until you apply it, and only new matches use it.</p>
      <div class="mx-rt-tablewrap"><table class="mx-rt-caltable">
        <thead><tr><th>Control</th><th>In use</th><th>Fitted</th><th>Status</th><th></th></tr></thead>
        <tbody>${rows}</tbody>
      </table></div>
      <details class="mx-rt-never"><summary>Constants round trips can’t teach</summary>
        <ul>${c.notFromRoundTrips.map((n: any) => `<li><code>${esc(n.key)}</code> — ${esc(n.why)}</li>`).join('')}</ul>
      </details>
    </section>`;
  }

  async function checkExport(file: File) {
    if (!rt.downloadId || rt.busy) return;
    rt.busy = true;
    rt.error = '';
    renderRoundTrip();
    try {
      const fd = new FormData();
      fd.append('download', rt.downloadId);
      fd.append('appliedAs', rt.appliedAs);
      fd.append('photo', file);
      const res = await fetch('/api/match/roundtrip', { method: 'POST', body: fd });
      const d = await res.json();
      if (!d.ok) throw new Error(d.error || `HTTP ${res.status}`);
      rt.result = d;
      if (rt.calibration) rt.calibration = { ...rt.calibration, proposals: d.calibration.proposals, eligibleRoundTrips: d.calibration.eligibleRoundTrips, totalRoundTrips: d.calibration.totalRoundTrips };
    } catch (err) {
      rt.error = err instanceof Error ? err.message : String(err);
    } finally {
      rt.busy = false;
    }
    await loadRoundTrip();
  }

  rtPanel.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.id === 'mx-rt-dl') { rt.downloadId = t.value; rt.result = null; renderRoundTrip(); }
    else if (t.name === 'mx-rt-applied') rt.appliedAs = t.value === 'unchanged' ? 'unchanged' : 'changed';
    else if (t.id === 'mx-rt-file' && t.files?.[0]) void checkExport(t.files[0]);
  });
  rtPanel.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#mx-rt-drop')) { ($('mx-rt-file') as HTMLInputElement | null)?.click(); return; }
    if (t.closest('#mx-rt-followdl') && rt.result?.followUp) {
      const f = rt.result.followUp;
      const url = URL.createObjectURL(new Blob([f.contents], { type: 'application/rdf+xml' }));
      saveAs(url, f.filename);
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
      return;
    }
    const apply = t.closest<HTMLElement>('[data-cal-apply]')?.dataset.calApply;
    const reset = t.closest<HTMLElement>('[data-cal-reset]')?.dataset.calReset;
    if (!apply && !reset) return;
    (t as HTMLButtonElement).disabled = true;
    try {
      const res = await fetch('/api/match/calibration', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify(apply ? { apply: [apply] } : { reset: [reset] }),
      });
      const d = await res.json();
      if (d.ok) rt.calibration = d;
      if (d.refused?.length) rt.error = 'That fit changed since this table was drawn — look again before applying.';
    } catch {
      rt.error = 'Could not reach the Mac to change the calibration.';
    }
    renderRoundTrip();
  });
  rtPanel.addEventListener('keydown', (e) => {
    if ((e.key === 'Enter' || e.key === ' ') && (e.target as HTMLElement).id === 'mx-rt-drop') {
      e.preventDefault();
      ($('mx-rt-file') as HTMLInputElement | null)?.click();
    }
  });
  ['dragenter', 'dragover'].forEach((ev) => rtPanel.addEventListener(ev, (e) => {
    if ((e.target as HTMLElement).closest('#mx-rt-drop')) { e.preventDefault(); $('mx-rt-drop')?.classList.add('over'); }
  }));
  ['dragleave', 'drop'].forEach((ev) => rtPanel.addEventListener(ev, () => $('mx-rt-drop')?.classList.remove('over')));
  rtPanel.addEventListener('drop', (e) => {
    if (!(e.target as HTMLElement).closest('#mx-rt-drop')) return;
    e.preventDefault();
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) void checkExport(f);
  });

  // ── Actions ────────────────────────────────────────────────────────────
  const saveAs = (href: string, filename: string) => {
    const a = document.createElement('a');
    a.href = href;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
  };

  const download = (variant: 'full' | 'safe') => {
    const t = Number(strengthEl.value) / 100;
    const gs = currentGroupStrength();
    if (!current.local) {
      const q = new URLSearchParams({
        id: current.id,
        strength: t.toFixed(2),
        light: gs.light.toFixed(2),
        colour: gs.colour.toFixed(2),
        effects: gs.effects.toFixed(2),
        variant,
      });
      saveAs(`/api/match/preset?${q.toString()}`, '');
      // The download is recorded server-side as it is served; pick it up so
      // the Check tab can offer it.
      setTimeout(() => void loadRoundTrip(), 900);
      return;
    }
    // Offline: build the preset here. xmp.ts is isomorphic, so this is the same
    // writer the server uses — not a second implementation.
    const adj = atGroupStrength(current.solution.restrained, current.solution.faithful, gs);
    const clean = (s: string) => s.replace(/\.[^.]+$/, '').replace(/\.[0-9a-f]{8,}$/i, '');
    const files = buildPresetFiles(adj, {
      name: `${clean(current.myName)} as ${clean(current.referenceName)}`.slice(0, 60),
      group: 'Colour Archive',
      seed: `${current.myName}:${current.referenceName}:${gs.light.toFixed(2)}:${gs.colour.toFixed(2)}:${gs.effects.toFixed(2)}`,
    });
    const chosen = variant === 'safe' ? files[files.length - 1] : files[0];
    const url = URL.createObjectURL(new Blob([chosen.contents], { type: 'application/rdf+xml' }));
    saveAs(url, chosen.filename);
    setTimeout(() => URL.revokeObjectURL(url), 10_000);
  };
  $('mx-dl').addEventListener('click', () => download('full'));
  $('mx-dl-safe').addEventListener('click', () => download('safe'));

  $('mx-keep').addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('/api/match/keep', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: current.id }),
      });
      const d = await res.json();
      btn.textContent = d.ok ? 'Kept' : 'Could not keep';
      if (d.ok) void loadKept();   // the library on the page behind this panel
    } catch {
      btn.textContent = 'Could not keep';
      btn.disabled = false;
    }
  });
</script>
