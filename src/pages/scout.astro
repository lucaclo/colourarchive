    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.74rem;
    padding: 0.45rem 0.5rem;
    min-height: 36px;
  }
  .seasons,
  .week { display: grid; gap: 0.3rem; }
  .week { margin-bottom: 0.7rem; }
  /* The day you are on, so the strip reads as a position and not just a list. */
  .week :global(button.on) { border-color: var(--fg); background: color-mix(in oklab, var(--fg) 8%, transparent); }
  .seasons :global(button),
  .week :global(button) {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    min-height: 34px;
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.64rem;
    cursor: pointer;
    text-align: left;
  }
  .seasons :global(button:hover),
  .week :global(button:hover) { border-color: var(--fg); }
  .seasons :global(.se-when),
  .week :global(.se-when) { color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ── Time ─────────────────────────────────────────────────────────────── */

  /* The bar fades into the map rather than sitting on it as a slab. Four stops
     rather than two: a straight two-stop fade to transparent has a visible
     shoulder where it meets the map, and over a bright satellite tile that
     shoulder reads as a hard edge across the picture. */
  .scout-time {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 18;
    padding: 1.4rem 0.9rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--bg) 96%, #000) 0%,
      color-mix(in oklab, var(--bg) 88%, #000) 38%,
      color-mix(in oklab, var(--bg) 55%, transparent) 72%,
      transparent 100%
    );
  }
  .scout-time[hidden] { display: none; }

  /* Two stacked gradients: the day's own phases underneath, and over them a
     mask of when *this spot* is in shade. Knowing golden hour runs 06:20–07:10
     is worth little if your doorway is behind a tower until 08:40. */
  .scout-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 18px;
    background-image: var(--scout-shade, linear-gradient(to right, transparent, transparent)),
      var(--scout-track, linear-gradient(to right, #0a0a0c, #0a0a0c));
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
  }
  .scout-slider:focus-visible { outline: 1px solid var(--fg); outline-offset: 2px; }
  .scout-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 3px;
    height: 32px;
    margin-top: -8px;
    background: #fff;
    border: 1px solid #000;
    border-radius: 1px;
    cursor: ew-resize;
  }
  .scout-slider::-moz-range-thumb {
    width: 3px;
    height: 32px;
    background: #fff;
    border: 1px solid #000;
    border-radius: 1px;
    cursor: ew-resize;
  }

  .jumps { display: flex; gap: 0.3rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
  .jumps button {
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.34rem 0.62rem;
    min-height: 30px;
    transition: color 140ms, border-color 140ms;
  }
  .jumps button:hover:not(:disabled) { color: var(--fg); border-color: var(--fg); }
  .jumps button:disabled { opacity: 0.3; cursor: default; }

  /* ── Map markers ──────────────────────────────────────────────────────── */

  .scout-map :global(.pin) {
    width: 26px;
    height: 26px;
    cursor: grab;
    display: grid;
    place-items: center;
  }
  .scout-map :global(.pin:active) { cursor: grabbing; }
  .scout-map :global(.pin i) {
    width: 15px;
    height: 15px;
    background: #f2efe8;
    border: 2px solid rgba(0, 0, 0, 0.7);
    border-radius: 3px;
    transform: rotate(45deg);
    display: block;
  }
  .scout-map :global(.slabmark) { width: 24px; height: 24px; cursor: grab; display: grid; place-items: center; }
  .scout-map :global(.slabmark i) {
    width: 13px;
    height: 13px;
    background: #cfd6e4;
    border: 2px solid rgba(0, 0, 0, 0.75);
    display: block;
  }
  /* The sightline target: a ring rather than a solid, so what it is placed on
     stays visible — the whole question is what the ground under it looks like. */
  .scout-map :global(.sightmark) { width: 26px; height: 26px; cursor: grab; display: grid; place-items: center; }
  .scout-map :global(.sightmark i) {
    width: 15px;
    height: 15px;
    background: transparent;
    border: 2.5px solid #c1863c;
    border-radius: 50%;
    box-shadow: 0 0 0 1.5px rgba(0, 0, 0, 0.55);
    display: block;
  }

  .scout-map :global(.maplibregl-ctrl-attrib) {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    font-family: var(--font-label);
    font-size: 0.56rem;
  }
  .scout-map :global(.maplibregl-ctrl-attrib a) { color: var(--muted); }
  .scout-map :global(.maplibregl-ctrl-bottom-right) { bottom: 5.2rem; }

  @media (max-width: 820px) {
    .panel { width: calc(100vw - 1.8rem); }
    .panel[data-open='true'] { width: calc(100vw - 1.8rem); }
    .edge { top: auto; bottom: calc(9.6rem + var(--safe-bottom)); transform: none; flex-direction: row; align-items: center; }
    .sheet { bottom: calc(5.2rem + var(--safe-bottom)); }
    .layers { top: auto; bottom: calc(9.6rem + var(--safe-bottom)); }
    .datesheet { top: auto; bottom: calc(9.6rem + var(--safe-bottom)); transform: none; }
    /* The nav and the view controls share the top row, and on a phone there is
       not room for both at full width — measured, they touch at 390px. The way
       back is the one that has to survive, so Inspiration stands down; it is
       one tap away through the archive. */
    .scout-nav a[href='/inspiration'] { display: none; }
    .cards { grid-template-columns: repeat(2, 1fr); }
    .jumps button { padding: 0.45rem 0.6rem; min-height: 34px; }

    /* The layers panel grew two control blocks. Anchored to the bottom, its own
       70vh could now run off the top of a short phone and put the basemap
       buttons under the status bar, so it is measured from where it actually
       starts instead. */
    .layers { max-height: calc(100vh - 11.4rem - var(--safe-bottom)); }

    /* Sensor and lens stack: side by side each select is about 150px wide, which
       is not enough for "Micro Four Thirds" and truncates the one thing the
       control is for. */
    .frame-row { flex-direction: column; gap: 0.5rem; }

    /* Everything you drag or tap in these two blocks, at a thumb's size. The
       range inputs are the ones that matter — a 4px-tall track on glass is a
       coin toss, and the aim slider is the control this feature turns on. */
    .frame-field select { min-height: 40px; padding: 0.5rem 0.5rem; }
    .frame-aims .chip { min-height: 38px; }
    #framebox input[type='range'],
    #sightbox input[type='range'] { min-height: 34px; }

    /* Taller on a phone: the profile is read for the shape of one ridge against
       one line, and 84px of that on a narrow screen is a smudge. */
    .sight-chart { height: 104px; }
  }

  /* iOS zooms the whole page in when a focused control's text is under 16px, and
     then leaves it zoomed. The layers panel is fixed to the corner, so the zoom
     puts half of it off-screen — the select has to opt out by being big enough. */
  @media (pointer: coarse) {
    .frame-field select { font-size: 16px; }
  }
</style>

<script>
  // Pinned to maplibre-gl v5, which ships one default export carrying
