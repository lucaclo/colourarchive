  .photos-note {
    margin: 0.6rem 0 0;
    font-family: var(--font-label);
    font-size: 0.55rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .photos { left: 0.9rem; width: auto; top: auto; height: 58vh; bottom: calc(5.2rem + var(--safe-bottom)); }
    .photo-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── The date sheet ───────────────────────────────────────────────────── */

  .datesheet {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 22;
    width: 15rem;
    max-width: calc(100vw - 1.8rem);
    padding: 0.75rem;
    border-radius: 14px;
