    font-family: var(--font-label);
    font-size: 0.58rem;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The licence is not fine print here — it is the condition of use, and it is
     shown at the same weight as the name it belongs to. */
  .photo-grid :global(.lic) {
    display: block;
    padding: 0 0.4rem 0.35rem;
    font-family: var(--font-label);
    font-size: 0.54rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
