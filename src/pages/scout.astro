  /* A thumbnail that never arrived reads as a gap, not as a broken page. */
  .photo-grid :global(img.missing) { display: none; }
  .photo-grid :global(.acc) {
    display: inline-block;
    margin: 0.35rem 0.4rem 0;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
