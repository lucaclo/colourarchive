---
import Layout from '../layouts/Layout.astro';
import 'maplibre-gl/dist/maplibre-gl.css';

// Prerendered, so /scout ships in the static publish alongside the archive.
// Nothing above this line reads anything server-side: the page is an empty shell
// and every coordinate, forecast and photograph arrives in the browser. Where
// those come from depends on whether there is a server behind it — see
// `browser/sources.ts`.
export const prerender = true;
---

<Layout
  title="Scout — Colour Archive"
  description="Type a place, set a radius, and see how the light falls inside it."
  preconnect={[
    // The basemap: style, sprite, glyphs and vector tiles all come from here,
    // and nothing draws until they do.
    'https://tiles.openfreemap.org',
    // The elevation the hillshade, the landform shadows and the line of sight
    // are all built from.
    'https://s3.amazonaws.com',
  ]}
>
  <main class="scout">
    <div class="scout-stage">
      <div class="scout-map" id="map"></div>

      <p class="scout-hint" id="scout-hint">Type a place to begin.</p>

      <!-- ── Top left: the way back ──────────────────────────────────────────
           Scout is a full-bleed map with no topbar, so the two links every
           other page carries have nowhere to live. They go here, in the same
           segmented control the view switch uses, and unlike everything else
           on the stage they are never hidden — being unable to pick a place is
           the most likely reason to want to leave. -->
      <nav class="seg scout-nav" aria-label="Colour Archive">
        <a href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
          Archive
        </a>
        <a href="/inspiration">Inspiration</a>
      </nav>

      <!-- A map that fails renders as a black rectangle and says nothing. Every
           way that can happen gets a sentence here instead. -->
      <div class="scout-mapmsg" id="mapmsg" hidden>
        <p class="scout-mapmsg-title" id="mapmsg-title"></p>
        <p class="scout-mapmsg-body" id="mapmsg-body"></p>
      </div>

      <!-- Undo for a tap that moved the pin somewhere you did not mean. -->
      <div class="toast" id="toast" hidden>
        <span id="toast-text"></span>
        <button class="toast-do" id="toast-undo" type="button">Undo</button>
      </div>

      <!-- Everything that changes under the slider, for a screen reader. It is
           polite and it is throttled: announcing every minute of a scrub would
           make the page unusable to listen to. -->
      <p class="sr" id="say" role="status" aria-live="polite"></p>

      <!-- ── The panel ──────────────────────────────────────────────────────
           Collapsed to a single line by default, because the map is the point
           and this used to cover a quarter of it. Hovering — or tapping, where
           there is no hover — opens the whole stack. -->
      <section class="panel" id="panel" hidden>
        <button
          class="panel-head"
          id="panel-head"
          type="button"
          aria-expanded="false"
          aria-controls="panel-body"
        >
          <span class="panel-name" id="panel-name"></span>
          <span class="panel-glance" id="panel-glance"></span>
          <span class="panel-cue" aria-hidden="true"></span>
        </button>

        <div class="panel-body" id="panel-body">
          <p class="panel-detail" id="panel-detail"></p>

          <!-- Weather. Kept at the top and kept visibly apart from the
               arithmetic below it: everything else on this panel is computed,
               this one thing is a forecast and can simply be wrong. -->
          <button class="wx" id="wx" type="button" hidden>
            <span class="wx-icon" id="wx-icon" aria-hidden="true"></span>
            <span class="wx-text">
              <span class="wx-label" id="wx-label"></span>
              <span class="wx-sum" id="wx-sum"></span>
            </span>
            <span class="wx-stale" id="wx-stale"></span>
          </button>
          <p class="wx-note" id="wx-note"></p>
          <!-- The three decks. One total cannot tell cirrus over a clear sun
               from a grey afternoon, and they are opposite photographs. -->
          <p class="wx-decks" id="wx-decks"></p>
          <!-- The sky the light has to come through, which is not this one. -->
          <p class="wx-horizon" id="wx-horizon"></p>

          <div class="cards" id="cards">
            <div class="card"><span class="card-k">Azimuth</span><span class="card-v" id="c-azimuth">—</span></div>
            <div class="card"><span class="card-k">Altitude</span><span class="card-v" id="c-altitude">—</span></div>
            <div class="card"><span class="card-k">Shadow</span><span class="card-v" id="c-shadow">—</span></div>
            <div class="card"><span class="card-k">Elevation</span><span class="card-v" id="c-elevation">—</span></div>
          </div>

          <ul class="events" id="events"></ul>

          <details class="fold" id="fold-twilight">
            <summary>Twilight</summary>
            <ul class="events events-sub" id="twilight"></ul>
          </details>

          <details class="fold" id="fold-moon">
            <summary>Moon</summary>
            <div class="moon">
              <svg class="moon-disc" id="moon-disc" viewBox="-13 -13 26 26" aria-hidden="true">
                <circle cx="0" cy="0" r="12" class="moon-dark"></circle>
                <path id="moon-lit" class="moon-lit" d=""></path>
                <circle cx="0" cy="0" r="12" class="moon-rim"></circle>
              </svg>
              <div class="moon-text">
                <p class="moon-phase" id="moon-phase">—</p>
                <p class="moon-line" id="moon-times">—</p>
                <p class="moon-line" id="moon-now">—</p>
                <p class="moon-note" id="moon-note"></p>
              </div>
            </div>
          </details>

          <!-- The core is the one subject here whose answer is usually "no":
               it has to be above the horizon, the sky has to be astronomically
               dark and the moon has to be down, all at once. Each line is one
               of those conditions, so a refusal says which one failed. -->
          <details class="fold" id="fold-core">
            <summary>Milky Way core</summary>
            <p class="core-line" id="core-times">—</p>
            <p class="core-line" id="core-window">—</p>
            <p class="core-note" id="core-note"></p>
            <!-- Where the core falls in the picture, and how long the shutter
                 can stay open before the stars stop being points. The framing
                 needs an aim, so it appears only once the frame layer is on —
                 asserting one from a bearing nobody chose is the fabrication
                 `lighting.ts` refuses for a photograph. The shutter needs only
                 the lens, so it is always offered. -->
            <p class="core-line" id="core-frame"></p>
            <p class="core-note" id="core-extent"></p>
            <p class="core-note" id="core-exposure"></p>
            <p class="core-caveat">Light pollution is not modelled.</p>
          </details>

          <!-- The per-spot answer: not where the shade is, but when the light
               gets here. The thing every other readout on the page is for. -->
          <div class="spot" id="spot">
            <p class="spot-line" id="spot-windows">—</p>
            <p class="spot-next" id="spot-next"></p>
            <p class="spot-basis" id="spot-basis"></p>
          </div>

          <!-- Where the sun falls relative to the picture, rather than
               relative to north. -->
          <div class="framing" id="framing" hidden>
            <p class="framing-head" id="framing-lens">—</p>
            <p class="framing-line" id="framing-sun">—</p>
            <!-- The join, for the pin: the aim above crossed with whether the
                 light actually gets here. Only meaningful once an aim exists,
                 which is why it lives with the lens and not with the spot. -->
            <p class="framing-line framing-light" id="framing-light"></p>
            <p class="framing-line framing-moon" id="framing-moon"></p>
            <p class="framing-note" id="framing-width"></p>
          </div>

          <!-- ── Best right now ────────────────────────────────────────────
               Every hotspot near the pin, ordered by what the light is doing
               at the minute on the slider. The order is four stated criteria
               in a stated priority — lit, then light remaining, then how many
               people photographed it, then how far — and never a score: a
               number nobody can reproduce is exactly what this project
               refuses to publish about sunsets, and it would be no better
               here. Each row prints the facts it was ordered by. -->
          <div class="best" id="best" hidden>
            <p class="best-head">Best right now</p>
            <ol class="best-list" id="best-list"></ol>
            <p class="best-note" id="best-note"></p>
          </div>

          <!-- The ground between here and there, and whether it is in the way. -->
          <div class="sightline" id="sightline" hidden>
            <svg class="sight-chart" id="sight-chart" viewBox="0 0 320 84" preserveAspectRatio="none" aria-hidden="true">
              <path class="sight-ground" id="sight-ground" d="" />
              <path class="sight-ray" id="sight-ray" d="" />
              <circle class="sight-block" id="sight-block" r="3" cx="-10" cy="-10" />
            </svg>
            <p class="sight-line" id="sight-verdict">—</p>
            <p class="sight-note" id="sight-detail"></p>
          </div>

          <dl class="facts">
            <div><dt>Centre</dt><dd id="f-coords">—</dd></div>
            <div><dt>Radius</dt><dd id="f-radius">—</dd></div>
            <div><dt>A 10 m wall</dt><dd id="f-throw">—</dd></div>
            <div><dt>Buildings</dt><dd id="f-buildings">—</dd></div>
            <div><dt>Landform</dt><dd id="f-landform">—</dd></div>
            <div><dt>Photographed</dt><dd id="f-photos">—</dd></div>
            <div>
              <dt>Light</dt>
              <dd id="f-light">
                <!-- The colour, as a colour. A number in kelvin is a fact about
                     the light that a photographer has to translate; the swatch
                     is the same fact, already translated. -->
                <span class="light-swatch" id="light-swatch" aria-hidden="true"></span>
                <span id="light-text">—</span>
              </dd>
            </div>
          </dl>

          <!-- The day's light as one picture. The row above is the light at
               one minute, which is what you set a camera by; this is the shape
               of the whole day, which is what you plan by — and both come out
               of the same spectral computation, so they cannot disagree. -->
          <div class="lightday" id="lightday" hidden>
            <div class="lightday-strip" id="lightday-strip"></div>
            <p class="lightday-note" id="lightday-note"></p>
          </div>

          <!-- ── The notebook ───────────────────────────────────────────────
               Only for a kept spot. A place you are passing through does not
               need a note, and a note with nowhere to live would be lost the
               moment the pin moved — so the star is what opens this. -->
          <details class="fold" id="fold-note" hidden>
            <summary>Notebook</summary>
            <div class="note">
              <textarea
                class="note-text"
                id="note-text"
                rows="3"
                maxlength="600"
                placeholder="What is worth remembering about this spot?"
                aria-label="Note about this spot"
              ></textarea>
              <p class="note-kept" id="note-kept"></p>
              <ul class="note-photos" id="note-photos"></ul>
              <div class="note-add">
                <input
                  class="note-url"
                  id="note-url"
                  type="url"
                  inputmode="url"
                  placeholder="Link a reference photograph"
                  aria-label="Reference photograph URL"
                />
                <button class="ghost" id="note-add" type="button">Add</button>
              </div>
              <p class="note-say" id="note-say"></p>
            </div>
          </details>

          <!-- ── The day plan ──────────────────────────────────────────────
               Every other answer on this page is about one place. A day of
               shooting is several, and the two constraints pull against each
               other: each spot's light is fixed by the sun, the travel between
               them by geography. Pick two to six kept spots and the solver in
               `itinerary.ts` orders them exhaustively — reporting whatever it
               could not fit rather than quietly leaving it out. -->
          <details class="fold" id="fold-plan" hidden>
            <summary>Day plan</summary>
            <div class="plan">
              <p class="plan-help" id="plan-help">Choose two to six kept spots.</p>
              <ul class="plan-pick" id="plan-pick"></ul>
              <ol class="plan-stops" id="plan-stops"></ol>
              <p class="plan-total" id="plan-total"></p>
              <ul class="plan-trouble" id="plan-trouble"></ul>
              <p class="plan-assume" id="plan-assume"></p>
              <button class="ghost" id="plan-copy" type="button" hidden>Copy the day</button>
              <p class="note-say" id="plan-say"></p>
            </div>
          </details>
        </div>
      </section>

      <!-- ── Date, left edge ─────────────────────────────────────────────── -->
      <div class="edge edge-left" id="edge-date" hidden>
        <button class="chip chip-strong" id="chip-today" type="button">Today</button>
        <div class="stepper">
          <button class="chip chip-step" id="day-back" type="button" aria-label="A day earlier">−</button>
          <button class="chip chip-date" id="chip-date" type="button">—</button>
          <button class="chip chip-step" id="day-forward" type="button" aria-label="A day later">+</button>
        </div>
      </div>

      <!-- ── Time, right edge ────────────────────────────────────────────── -->
      <div class="edge edge-right" id="edge-time" hidden>
        <button
          class="chip chip-strong"
          id="chip-play"
          type="button"
          aria-pressed="false"
          title="Run the day (space)"
        >
          <span id="play-label">Play</span>
        </button>
        <button
          class="chip chip-strong"
          id="chip-now"
          type="button"
          aria-pressed="false"
          title="Follow the clock (n)"
        >Now</button>
        <span class="chip chip-clock" id="chip-clock">--:--</span>
        <span class="chip chip-phase" id="chip-phase"></span>
      </div>

      <!-- ── Top right: view controls ────────────────────────────────────── -->
      <div class="tools" id="tools" hidden>
        <div class="seg" id="viewseg">
          <button type="button" data-view="2d" class="on">2D</button>
          <button type="button" data-view="3d">3D</button>
        </div>
        <!-- The night, in one press. Everything the Milky Way answer needs was
             reachable before this and none of it was findable: a panel section
             that opens by clicking a heading, a layer toggle two menus deep with
             the same name as that section, and a framing answer that stays
             silent until a *different* toggle is on. Three discoveries for one
             question is two too many. -->
        <button class="round" id="night-button" type="button" aria-pressed="false" title="Milky Way">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 17c5.5 0 9-2 11-5.5S17.5 4 21 3"/>
            <circle cx="8.5" cy="14.5" r="1" class="star"/>
            <circle cx="13" cy="10" r="1" class="star"/>
            <circle cx="17.5" cy="6" r="1" class="star"/>
          </svg>
          <span class="sr">Milky Way</span>
        </button>
        <button class="round" id="layers-button" type="button" aria-expanded="false" aria-controls="layers" title="Layers">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 13l10 5 10-5"/></svg>
          <span class="sr">Layers</span>
        </button>
        <button class="round compass" id="compass" type="button" title="Point north">
          <svg viewBox="0 0 24 24" aria-hidden="true" id="compass-rose">
            <polygon points="12,3 15,13 12,11 9,13" class="needle-n"/>
            <polygon points="12,21 9,11 12,13 15,11" class="needle-s"/>
          </svg>
          <span class="sr">Point north</span>
        </button>
      </div>

      <div class="layers" id="layers" hidden>
        <p class="layers-head">Basemap</p>
        <div class="seg seg-wide" id="baseseg">
          <button type="button" data-base="light" class="on">Light</button>
          <button type="button" data-base="dark">Dark</button>
          <button type="button" data-base="satellite">Satellite</button>
        </div>
        <p class="layers-head">Show</p>
        <label class="toggle"><input type="checkbox" id="t-buildings" checked /> <span>Building shadows</span></label>
        <label class="toggle"><input type="checkbox" id="t-landform" checked /> <span>Landform shadows</span></label>
        <label class="toggle"><input type="checkbox" id="t-hillshade" checked /> <span>Hillshade</span></label>
        <label class="toggle"><input type="checkbox" id="t-sunpath" checked /> <span>Sun path</span></label>
        <label class="toggle"><input type="checkbox" id="t-moonpath" /> <span>Moon path</span></label>
        <label class="toggle"><input type="checkbox" id="t-solstice" /> <span>Solstice paths</span></label>
        <!-- "arc", not "core": this draws the path across the sky dome and
             nothing else. It shared its name with the panel section that holds
             all the text, so ticking it looked like it had done nothing. -->
        <label class="toggle"><input type="checkbox" id="t-core" /> <span>Milky Way arc</span></label>
        <label class="toggle"><input type="checkbox" id="t-monolith" /> <span>Monolith</span></label>
        <label class="toggle"><input type="checkbox" id="t-photos" checked /> <span>Photo hotspots</span></label>
        <label class="toggle"><input type="checkbox" id="t-frame" /> <span>Frame</span></label>
        <label class="toggle"><input type="checkbox" id="t-sight" /> <span>Line of sight</span></label>

        <!-- The lens. The wedge on the map is where the frame lands on the
             ground; the answer that needs it is whether the sun is *in* the
             picture, which no bearing readout can tell you without a focal
             length. -->
        <div class="slab" id="framebox" hidden>
          <div class="frame-row">
            <label class="frame-field" for="frame-sensor"><span>Sensor</span>
              <select id="frame-sensor"></select>
            </label>
            <label class="frame-field" for="frame-focal"><span>Lens</span>
              <select id="frame-focal"></select>
            </label>
          </div>
          <!-- Not part of the frame at all — the rectangle is the same however
               finely it is sampled. It is here because it belongs to the body,
               and it is the one number the night's shutter limit turns on. -->
          <div class="frame-row">
            <label class="frame-field" for="frame-mp"><span>Sensor pixels</span>
              <select id="frame-mp"></select>
            </label>
          </div>
          <div class="seg seg-wide" id="frameorient">
            <button type="button" data-orient="landscape" class="on">Landscape</button>
            <button type="button" data-orient="portrait">Portrait</button>
          </div>
          <label class="slab-row" for="frame-bearing">
            <span>Aim</span>
            <output id="frame-bearing-out">270° W</output>
          </label>
          <input id="frame-bearing" type="range" min="0" max="359" step="1" value="270" />
          <label class="slab-row" for="frame-tilt">
            <span>Tilt</span>
            <output id="frame-tilt-out">0°</output>
          </label>
          <input id="frame-tilt" type="range" min="-60" max="80" step="1" value="0" />
          <div class="frame-aims">
            <button class="chip chip-step" id="aim-sun" type="button">Aim at the sun</button>
            <button class="chip chip-step" id="aim-moon" type="button">At the moon</button>
            <!-- The core does not move with the slider, so this aims at where it
                 will be at the best moment of the night rather than at now. -->
            <button class="chip chip-step" id="aim-core" type="button">At the core</button>
          </div>
          <p class="slab-note" id="frame-lens">—</p>
        </div>

        <!-- Can I see it from here? Bare earth only, and it says so. -->
        <div class="slab" id="sightbox" hidden>
          <label class="slab-row" for="sight-height">
            <span>Subject height</span>
            <output id="sight-out">0 m</output>
          </label>
          <input id="sight-height" type="range" min="0" max="300" step="1" value="0" />
          <p class="slab-note">Drag the ring on the map to what you want to see. Terrain only — trees and buildings are not in this.</p>
        </div>

        <div class="slab" id="slab" hidden>
          <label class="slab-row" for="slab-height">
            <span>Monolith height</span>
            <output id="slab-out">10 m</output>
          </label>
          <input id="slab-height" type="range" min="1" max="200" step="1" value="10" />
          <p class="slab-note">Drag the slab on the map. Its shadow is the one on this page with no guessing in it.</p>
        </div>
        <p class="layers-head">This view</p>
        <button class="wide" id="open-month" type="button">The month, hour by hour</button>
        <button class="wide" id="export" type="button">Save as an image</button>
        <button class="wide" id="copy-plan" type="button">Copy the plan</button>
        <button class="wide" id="copy-link" type="button">Copy a link to this spot</button>
      </div>

      <!-- ── The month, as a grid ─────────────────────────────────────────
           Rows are days, columns are hours, and the shape of the golden hour
           across a month is the thing you cannot get by scrubbing a slider
           thirty times. -->
      <div class="monthgrid" id="monthgrid" hidden role="dialog" aria-modal="true" aria-label="The month, hour by hour">
        <div class="mg-head">
          <button class="chip chip-step" id="mg-back" type="button" aria-label="The month before">−</button>
          <p class="mg-title" id="mg-title">—</p>
          <button class="chip chip-step" id="mg-forward" type="button" aria-label="The month after">+</button>
          <button class="mg-close" id="mg-close" type="button" aria-label="Close">×</button>
        </div>
        <div class="mg-scroll">
          <div class="mg-body" id="mg-body"></div>
        </div>
        <p class="mg-legend" id="mg-legend"></p>
      </div>

      <!-- ── Bottom: place sheet, then the day ───────────────────────────── -->
      <div class="sheet" id="sheet">
        <div class="sheet-row">
          <button class="round" id="search-button" type="button" aria-expanded="false" aria-controls="searchbox" title="Search for a place">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="sr">Search for a place</span>
          </button>
          <div class="sheet-place">
            <p class="sheet-name" id="sheet-name">Nowhere yet</p>
            <p class="sheet-zone" id="sheet-zone"></p>
          </div>
          <button class="round" id="star" type="button" aria-pressed="false" title="Keep this spot" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" id="star-mark">
              <path d="m12 3.6 2.6 5.6 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L3.4 10l6-.8Z"/>
            </svg>
            <span class="sr">Keep this spot</span>
          </button>
          <button class="round" id="radius-button" type="button" aria-expanded="false" aria-controls="radiusbox" title="Radius">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke-dasharray="3 3"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></svg>
            <span class="sr">Radius</span>
          </button>
        </div>

        <div class="searchbox" id="searchbox" hidden>
          <input
            id="place"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="A city, a street, a hill"
            aria-expanded="false"
            aria-controls="place-results"
            role="combobox"
          />
          <ul class="results" id="place-results" role="listbox" aria-label="Places" hidden></ul>
          <!-- Shown when the field is empty, which is exactly when you are
               looking for somewhere you have already been. -->
          <div class="kept" id="kept" hidden>
            <p class="kept-head">Kept spots</p>
            <ul class="results" id="kept-list" aria-label="Kept spots"></ul>
          </div>
        </div>

        <div class="radiusbox" id="radiusbox" hidden>
          <input id="radius" type="range" min="1" max="50" step="1" value="10" aria-label="Radius" />
          <output class="radius-out" id="radius-out" for="radius">10 km</output>
        </div>
      </div>

      <div class="scout-time" id="timebar" hidden>
        <input
          class="scout-slider"
          id="time"
          type="range"
          min="0"
          max="1440"
          step="1"
          value="720"
          aria-label="Time of day"
        />
        <div class="jumps" id="jumps">
          <button type="button" data-jump="civilDawn">Dawn</button>
          <button type="button" data-jump="sunrise">Sunrise</button>
          <button type="button" data-jump="goldenMorning">Golden</button>
          <button type="button" data-jump="solarNoon">Noon</button>
          <button type="button" data-jump="goldenEvening">Golden</button>
          <button type="button" data-jump="sunset">Sunset</button>
          <button type="button" data-jump="civilDusk">Dusk</button>
        </div>
      </div>

      <!-- The date sheet, opened from the date chip. -->
      <div class="datesheet" id="datesheet" hidden>
        <div class="datesheet-row">
          <input type="date" id="date-input" aria-label="Date" />
          <button class="chip" id="date-close" type="button">Done</button>
        </div>
        <!-- Pick a date by the light rather than by the number. -->
        <p class="layers-head">The week ahead</p>
        <div class="week" id="week"></div>
        <p class="layers-head">Jump to</p>
        <div class="seasons" id="seasons"></div>
      </div>

      <!-- ── What other people photographed here ────────────────────────────
           Opened by tapping a hotspot. Every photograph carries its author and
           its licence, because showing someone's work without their name is
           the same failure as asserting a shadow you did not compute. -->
      <div class="photos" id="photos" hidden>
        <div class="photos-head">
          <div>
            <p class="photos-title" id="photos-title">Photographs</p>
            <p class="photos-sub" id="photos-sub"></p>
            <!-- What the light does here, on the date and minute on the
                 slider. Tracks the slider while the sheet is open. -->
            <p class="photos-light" id="photos-light"></p>
          </div>
          <button class="chip" id="photos-close" type="button">Close</button>
        </div>
        <ul class="photo-grid" id="photo-grid"></ul>
        <p class="photos-note">
          Peer-reviewed photographs from Wikimedia Commons — featured pictures and quality
          images only. Each is its author's, under the licence shown.
        </p>
      </div>

      <a id="download" hidden aria-hidden="true"></a>
    </div>
  </main>
</Layout>

<style>
  /* The map is the page. Everything else floats on top of it — on an iPad in
     the field, every row of chrome is a row of ground you cannot see. */
  .scout {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  /* `--stage-top` is where the left column starts *below* the nav, so the nav
     and the panel cannot be nudged out of agreement by editing one of them. */
  /* `--stage-top` is where the left column starts below the nav; `--safe-bottom`
     is how much of the screen the phone itself has taken at the other end. The
     timebar already grew by it — everything anchored *above* the timebar has to
     grow by it too, or on a device with a home indicator the sheet and the
     layers panel sit a centimetre into the jump buttons. */
  .scout-stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    --stage-top: 3.4rem;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  .scout-map { position: absolute; inset: 0; }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Every control here is a pale pill on a map, so the browser's own focus ring
     is often invisible against whatever is underneath it. `:focus-visible`
     rather than `:focus`, so a mouse click does not leave a ring behind. */
  .scout :global(button:focus-visible),
  .scout :global(a:focus-visible),
  .scout :global(input:focus-visible),
  .scout :global([tabindex]:focus-visible) {
    outline: 2px solid #e0603a;
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* Someone who has asked for less motion has asked for less motion. The sun
     still moves — that is the information — but nothing slides, fades or
     animates its way there, and `Play` steps rather than sweeps (see the
     script). */
  @media (prefers-reduced-motion: reduce) {
    .scout :global(*) {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
  }

  /* One surface for every floating thing, so the page reads as a set rather
     than as a pile of separate panels. */
  .panel,
  .layers,
  .sheet,
  .datesheet,
  .chip,
  .round,
  .seg {
    background: color-mix(in oklab, var(--bg) 86%, #000);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }

  .scout-hint {
    position: absolute;
    left: 50%;
    top: 42%;
    transform: translate(-50%, -50%);
    margin: 0;
    font-family: var(--font-display);
    font-style: var(--title-style);
    font-size: 1.5rem;
    color: var(--muted);
    pointer-events: none;
    text-align: center;
  }
  .scout-hint[hidden] { display: none; }

  .scout-mapmsg {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
    max-width: min(32rem, calc(100% - 3rem));
    padding: 1.1rem 1.3rem;
    background: color-mix(in oklab, var(--bg) 92%, #000);
    border: 1px solid var(--border);
    border-left: 2px solid #e0603a;
    border-radius: 2px;
  }
  .scout-mapmsg[hidden] { display: none; }
  .scout-mapmsg-title {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e0603a;
  }
  .scout-mapmsg-body {
    margin: 0.5rem 0 0;
    font-family: var(--font-label);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ── The panel ────────────────────────────────────────────────────────── */

  .scout-nav {
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    z-index: 21;
  }

  .panel {
    position: absolute;
    left: 0.9rem;
    top: var(--stage-top);
    z-index: 20;
    width: 15.5rem;
    max-width: calc(100vw - 1.8rem);
    border-radius: 14px;
    overflow: hidden;
    transition: width 220ms ease;
  }
  .panel[hidden] { display: none; }

  .panel-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.6rem;
    width: 100%;
    padding: 0.6rem 0.75rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: var(--fg);
  }
  .panel-name {
    font-family: var(--font-display);
    font-style: var(--title-style);
    font-size: 1rem;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .panel-glance {
    grid-column: 1 / -1;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* A chevron that turns, so the card looks like something that opens. */
  .panel-cue {
    grid-row: 1;
    grid-column: 2;
    width: 8px;
    height: 8px;
    margin-top: 0.25rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 220ms ease;
  }

  .panel-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 0.75rem;
    transition: max-height 260ms ease, opacity 180ms ease, padding 260ms ease;
  }

  /* Hover to open where there is a pointer; the head button toggles it
     everywhere else, so a finger is never left without a way in. */
  @media (hover: hover) and (pointer: fine) {
    .panel:hover { width: 21rem; }
    .panel:hover .panel-body,
    .panel:focus-within .panel-body {
      max-height: min(76vh, 46rem);
      opacity: 1;
      overflow-y: auto;
      padding-bottom: 0.75rem;
    }
    .panel:hover .panel-cue,
    .panel:focus-within .panel-cue { transform: rotate(225deg); }
  }
  .panel[data-open='true'] { width: 21rem; }
  .panel[data-open='true'] .panel-body {
    max-height: min(76vh, 46rem);
    opacity: 1;
    overflow-y: auto;
    padding-bottom: 0.75rem;
  }
  .panel[data-open='true'] .panel-cue { transform: rotate(225deg); }

  .panel-detail {
    margin: 0 0 0.6rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .panel-detail:empty { display: none; }

  /* ── Weather ──────────────────────────────────────────────────────────── */

  .wx {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.5rem 0.6rem;
    margin-bottom: 0.5rem;
    background: color-mix(in oklab, var(--fg) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 9px;
    cursor: pointer;
    color: var(--fg);
    text-align: left;
  }
  .wx[hidden] { display: none; }
  .wx-icon { font-size: 1rem; line-height: 1; }
  .wx-text { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; flex: 1; }
  .wx-label { font-family: var(--font-label); font-size: 0.76rem; }
  .wx-sum {
    font-family: var(--font-label);
    font-size: 0.6rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .wx-stale {
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c1863c;
  }
  .wx-note {
    margin: 0 0 0.7rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .wx-note:empty { display: none; }

  /* The deck breakdown and the horizon reading sit under the forecast and
     inside its margin, so it stays visually one block: all three are the same
     kind of statement, and none of them is arithmetic. */
  .wx-decks,
  .wx-horizon {
    margin: -0.45rem 0 0.7rem;
    padding-left: 0.55rem;
    border-left: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    font-family: var(--font-label);
    font-size: 0.58rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .wx-horizon { margin-top: 0.35rem; }
  .wx-decks:empty,
  .wx-horizon:empty { display: none; }
  .wx-horizon[data-verdict='lit'] { color: #c1863c; border-left-color: #c1863c; }
  .wx-horizon[data-verdict='blocked'] { opacity: 0.75; }

  /* ── The frame, and the line of sight ─────────────────────────────────── */

  .framing,
  .sightline {
    margin: 0.7rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }
  .framing[hidden],
  .sightline[hidden] { display: none; }
  .framing-head {
    margin: 0 0 0.3rem;
    font-family: var(--font-label);
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .framing-line {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .framing-line:empty { display: none; }
  .framing-note {
    margin: 0.25rem 0 0;
    font-family: var(--font-label);
    font-size: 0.56rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .framing-note:empty { display: none; }
  /* The verdict is the answer the lens row exists to produce, so it carries the
     sun's own colour rather than the body colour of the lines above it. */
  .framing-light { color: #f0b866; }

  /* ── Best right now ───────────────────────────────────────────────────── */

  .best {
    margin: 0.7rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }
  .best[hidden] { display: none; }
  .best-head {
    margin: 0 0 0.4rem;
    font-family: var(--font-label);
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .best-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  /* Every row below is built by the page script, so each selector has to leave
     this component's scope to reach it — an unscoped rule here matches nothing
     and the rows fall back to the user agent's defaults. */
  .best-list :global(li) {
    display: grid;
    grid-template-columns: 0.55rem 1fr auto;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.3rem 0.35rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--border) 22%, transparent);
    /* 44px targets are the field standard on this page; these are rows in a
       list rather than controls, so they take the smaller of the two. */
    min-height: 2rem;
    cursor: pointer;
  }
  .best-list :global(li:hover),
  .best-list :global(li:focus-visible) {
    background: color-mix(in oklab, var(--border) 40%, transparent);
    outline: none;
  }
  .best-list :global(.best-rank) {
    font-family: var(--font-label);
    font-size: 0.58rem;
    color: var(--muted);
  }
  .best-list :global(.best-name) {
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--fg);
    /* Commons titles run long and a wrapped one pushes the light off the row. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .best-list :global(.best-where) {
    display: block;
    font-family: var(--font-label);
    font-size: 0.56rem;
    color: var(--muted);
  }
  .best-list :global(.best-light) {
    justify-self: end;
    text-align: right;
    font-family: var(--font-label);
    font-size: 0.58rem;
    line-height: 1.4;
    white-space: nowrap;
  }
  /* The same three states the pins take, so the list and the map agree without
     the reader having to learn two vocabularies. */
  .best-list :global(.best-light.is-lit) { color: #f0b866; }
  .best-list :global(.best-light.is-shaded) { color: #7fa8c4; }
  .best-list :global(.best-light.is-down) { color: var(--muted); }
  .best-note {
    margin: 0.4rem 0 0;
    font-family: var(--font-label);
    font-size: 0.56rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .best-note:empty { display: none; }

  /* ── The day plan ─────────────────────────────────────────────────────── */

  .plan { display: flex; flex-direction: column; gap: 0.45rem; }
  .plan-help { margin: 0; font-family: var(--font-label); font-size: 0.6rem; color: var(--muted); }
  .plan-pick,
  .plan-stops,
  .plan-trouble { margin: 0; padding: 0; list-style: none; }
  .plan-pick { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  /* Every row below is built by the page script, so each selector has to leave
     this component's scope to reach it. See the month grid above. */
  .plan-pick :global(label) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    /* 44px is the field target on this page; a checkbox row keeps it. */
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: var(--fg);
    cursor: pointer;
  }
  .plan-pick :global(label:has(input:checked)) {
    border-color: #f0b866;
    background: color-mix(in oklab, #f0b866 16%, transparent);
  }
  /* A spot already at its ceiling should look unavailable, not broken. */
  .plan-pick :global(label:has(input:disabled)) { opacity: 0.45; cursor: default; }

  .plan-stops { display: flex; flex-direction: column; gap: 0.3rem; counter-reset: stop; }
  .plan-stops :global(li) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    padding: 0.35rem 0.4rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--border) 22%, transparent);
  }
  .plan-stops :global(.plan-when) {
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: #f0b866;
    white-space: nowrap;
  }
  .plan-stops :global(.plan-where) { font-size: 0.7rem; line-height: 1.35; color: var(--fg); }
  .plan-stops :global(.plan-leg) {
    display: block;
    font-family: var(--font-label);
    font-size: 0.56rem;
    color: var(--muted);
  }
  .plan-total {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.6rem;
    color: var(--fg);
  }
  .plan-total:empty { display: none; }
  .plan-trouble { display: flex; flex-direction: column; gap: 0.25rem; }
  /* What did not fit is not a footnote. It is the other half of the answer, so
     it is drawn as loudly as the plan itself. */
  .plan-trouble :global(li) {
    font-family: var(--font-label);
    font-size: 0.58rem;
    line-height: 1.45;
    color: #e8a0a0;
    padding-left: 0.7rem;
    text-indent: -0.7rem;
  }
  .plan-assume {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.56rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .plan-assume:empty { display: none; }

  .sight-chart {
    display: block;
    width: 100%;
    height: 84px;
    margin-bottom: 0.4rem;
    overflow: visible;
  }
  .sight-ground { fill: color-mix(in oklab, var(--fg) 16%, transparent); stroke: none; }
  /* Not vector-effect: the chart is deliberately non-uniformly scaled, and a
     stroke that resisted that would be the only thing on it that did. */
  .sight-ray { fill: none; stroke: #c1863c; stroke-width: 1.2; stroke-dasharray: 4 3; }
  .sight-block { fill: #c1863c; }
  .sight-line { margin: 0; font-size: 0.72rem; line-height: 1.5; color: var(--fg); }
  .sight-note {
    margin: 0.25rem 0 0;
    font-family: var(--font-label);
    font-size: 0.56rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .sight-note:empty { display: none; }

  /* ── Stat cards ───────────────────────────────────────────────────────── */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
    margin-bottom: 0.6rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.45rem 0.55rem;
    background: color-mix(in oklab, var(--fg) 5%, transparent);
    border-radius: 9px;
  }
  .card-k {
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-v {
    font-family: var(--font-label);
    font-size: 0.85rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* ── Events ───────────────────────────────────────────────────────────── */

  .events { list-style: none; margin: 0 0 0.5rem; padding: 0; }
  .events :global(li) { border-bottom: 1px solid color-mix(in oklab, var(--border) 45%, transparent); }
  .events :global(li:last-child) { border-bottom: 0; }
  .events :global(button) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.42rem 0.15rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--fg);
    text-align: left;
    min-height: 34px;
  }
  .events :global(button:disabled) { cursor: default; opacity: 0.45; }
  .events :global(button:not(:disabled):hover) { background: color-mix(in oklab, var(--fg) 7%, transparent); }
  .events :global(.ev-label) { font-family: var(--font-label); font-size: 0.68rem; color: var(--muted); }
  .events :global(.ev-time) {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .events :global(.ev-now) { color: #f0b866; }
  .events-sub :global(.ev-time) { font-size: 0.7rem; }

  .fold { margin-bottom: 0.5rem; }
  .fold summary {
    font-family: var(--font-label);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    padding: 0.35rem 0;
    min-height: 30px;
  }

  /* ── The month grid ────────────────────────────────────────────────────
     A whole month of light in one picture. Rows are days and columns are the
     local clock, so the golden hour reads as a pair of curves bending across
     the month rather than as a time you look up thirty times. */

  .monthgrid {
    position: absolute;
    inset: var(--stage-top) 0.6rem calc(1rem + var(--safe-bottom));
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.7rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .monthgrid[hidden] { display: none; }
  .mg-head { display: flex; align-items: center; gap: 0.5rem; }
  .mg-title {
    margin: 0;
    flex: 1;
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mg-close {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.3rem;
  }
  .mg-scroll { flex: 1; overflow: auto; -webkit-overflow-scrolling: touch; }
  /* The rows share whatever height there is: a month is a fixed number of rows,
     so letting them stretch fills the panel on a laptop without making them
     unreadably thin on a phone, where the floor takes over and it scrolls. */
  .mg-body {
    display: grid;
    gap: 1px;
    min-width: 34rem;
    height: 100%;
    grid-auto-rows: minmax(12px, 1fr);
  }
  .mg-legend { margin: 0; font-size: 0.62rem; color: var(--muted); line-height: 1.4; }

  /* Runtime-built, so scoping cannot reach it — see the notebook above. */
  .mg-body :global(.mg-row) { display: contents; }
  .mg-body :global(.mg-day) {
    font-family: var(--font-label);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding-right: 0.35rem;
    text-align: right;
    white-space: nowrap;
    position: sticky;
    left: 0;
    background: var(--bg);
  }
  .mg-body :global(.mg-cell) {
    min-height: 11px;
    border: 0;
    padding: 0;
    cursor: pointer;
    /* Every cell is a button, and a focus ring you cannot see is not one. */
    outline-offset: -2px;
  }
  /* An hour the local clock never read. Not black, not white — hatched, so it
     cannot be mistaken for a dark night or a missing measurement. */
  .mg-body :global(.mg-gap) {
    cursor: default;
    background: repeating-linear-gradient(
      45deg,
      transparent 0 2px,
      color-mix(in oklab, var(--fg) 22%, transparent) 2px 3px
    );
  }
  .mg-body :global(.mg-now) { box-shadow: inset 0 0 0 1.5px var(--fg); }

  /* ── Notebook ─────────────────────────────────────────────────────────── */

  .note { display: grid; gap: 0.45rem; padding: 0.2rem 0 0.5rem; }
  .note-text {
    width: 100%;
    resize: vertical;
    font: inherit;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--fg);
    background: color-mix(in oklab, var(--bg) 78%, var(--fg) 6%);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.45rem 0.55rem;
  }
  .note-kept, .note-say { font-size: 0.68rem; color: var(--muted); margin: 0; }
  /* Every row in here is built by the script, and Astro's scoping only reaches
     elements that were in the markup — without `:global()` these fall back to
     the browser's own stylesheet, which is how the credits came out as default
     blue underlined links and the thumbnails had no box at all. */
  .note-photos { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .note-photos :global(li) { display: flex; gap: 0.45rem; align-items: center; }
  .note-photos :global(img) {
    width: 44px;
    height: 32px;
    object-fit: cover;
    border-radius: 4px;
    background: color-mix(in oklab, var(--bg) 78%, var(--fg) 6%);
    flex: none;
  }
  /* The credit is the reason these are references rather than copies, so it is
     never the thing that gets truncated away to nothing. */
  .note-photos :global(.cr) {
    font-size: 0.68rem;
    color: var(--muted);
    line-height: 1.3;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .note-photos :global(.cr a) { color: inherit; }
  .note-add { display: flex; gap: 0.35rem; }
  .note-url {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.72rem;
    color: var(--fg);
    background: color-mix(in oklab, var(--bg) 78%, var(--fg) 6%);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.5rem;
  }
  #note-add {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0 0.7rem;
    cursor: pointer;
  }
  /* Elements built at runtime are outside Astro's scoping, so anything the
     script creates needs :global() or it falls back to the UA stylesheet. */
  .note-photos :global(.drop-photo) {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1;
    padding: 0 0.2rem;
    cursor: pointer;
  }
  .note-photos :global(.drop-photo:hover) { color: #e0603a; }

  /* ── Moon ─────────────────────────────────────────────────────────────── */

  .moon { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.2rem 0 0.4rem; }
  .moon-disc { width: 42px; height: 42px; flex: 0 0 auto; }
  .moon-dark { fill: color-mix(in oklab, var(--fg) 12%, transparent); }
  .moon-lit { fill: #e8e4dc; }
  .moon-rim { fill: none; stroke: color-mix(in oklab, var(--fg) 30%, transparent); stroke-width: 0.75; }
  .moon-text { min-width: 0; }
  .moon-phase { margin: 0; font-family: var(--font-label); font-size: 0.74rem; color: var(--fg); }
  .moon-line {
    margin: 0.15rem 0 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .moon-note { margin: 0.25rem 0 0; font-family: var(--font-label); font-size: 0.6rem; color: var(--muted); font-style: italic; }
  .moon-note:empty { display: none; }

  /* ── The light's colour ───────────────────────────────────────────────── */

  .light-swatch {
    display: inline-block;
    width: 0.66rem;
    height: 0.66rem;
    border-radius: 50%;
    margin-right: 0.35rem;
    vertical-align: -0.06rem;
    /* A ring, because a warm swatch on paper and a cool one on the dark style
       both need an edge or they read as a smudge rather than as a sample. */
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--fg) 35%, transparent);
    background: transparent;
  }
  .light-swatch:not([style*='background']) { display: none; }

  .lightday { margin: 0.1rem 0 0.55rem; }
  .lightday-strip {
    height: 0.5rem;
    border-radius: 0.25rem;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--fg) 18%, transparent);
  }
  .lightday-note {
    margin: 0.25rem 0 0;
    font-family: var(--font-label);
    font-size: 0.58rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── Milky Way core ───────────────────────────────────────────────────── */

  .core-line {
    margin: 0.15rem 0 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .core-note { margin: 0.3rem 0 0; font-family: var(--font-label); font-size: 0.6rem; color: var(--fg); }
  .core-note:empty { display: none; }
  /* Never hidden and never :empty — it is a standing limit on every answer
     above it, not a footnote to whichever one is on screen. */
  .core-caveat {
    margin: 0.3rem 0 0;
    font-family: var(--font-label);
    font-size: 0.58rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── The spot's own day ───────────────────────────────────────────────── */

  .spot {
    padding: 0.55rem 0.6rem;
    margin-bottom: 0.6rem;
    background: color-mix(in oklab, #c1863c 12%, transparent);
    border-left: 2px solid #c1863c;
    border-radius: 0 9px 9px 0;
  }
  .spot-line { margin: 0; font-family: var(--font-label); font-size: 0.68rem; line-height: 1.55; color: var(--fg); }
  .spot-next { margin: 0.3rem 0 0; font-family: var(--font-label); font-size: 0.68rem; color: #f0b866; }
  .spot-next:empty { display: none; }
  .spot-basis { margin: 0.3rem 0 0; font-family: var(--font-label); font-size: 0.56rem; line-height: 1.5; color: var(--muted); }
  .spot-basis:empty { display: none; }

  /* ── Facts ────────────────────────────────────────────────────────────── */

  .facts { margin: 0; display: grid; gap: 0.2rem; }
  .facts > div { display: flex; justify-content: space-between; gap: 1rem; }
  .facts dt {
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.66rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* ── Chips at the edges ───────────────────────────────────────────────── */

  .edge {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 18;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .edge[hidden] { display: none; }
  .edge-left { left: 0.9rem; align-items: flex-start; }
  .edge-right { right: 0.9rem; align-items: flex-end; }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    min-height: 34px;
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: 0.66rem;
    color: var(--fg);
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  button.chip:hover { border-color: var(--fg); }
  .chip-strong { letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.56rem; }
  /* Now is a mode, not a jump, so it has to look held down while it is on. */
  .chip.on { color: var(--bg); background: var(--fg); border-color: var(--fg); }
  .chip-clock { font-size: 1rem; padding: 0.35rem 0.7rem; cursor: default; }
  .chip-phase { font-size: 0.58rem; color: var(--muted); cursor: default; }
  .chip-phase:empty { display: none; }
  .stepper { display: flex; gap: 0.25rem; align-items: center; }
  .chip-step { padding: 0.4rem 0.55rem; font-size: 0.9rem; line-height: 1; }

  /* ── Tools, top right ─────────────────────────────────────────────────── */

  .tools {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    z-index: 20;
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .tools[hidden] { display: none; }

  .seg { display: flex; border-radius: 999px; overflow: hidden; }
  .seg button,
  .seg a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--muted);
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    padding: 0.5rem 0.8rem;
    min-height: 36px;
    text-decoration: none;
    transition: color 140ms, background 140ms;
  }
  .seg button.on { color: var(--bg); background: var(--fg); }
  .seg button:not(.on):hover,
  .seg a:hover { color: var(--fg); }
  .seg a svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; }
  .seg-wide { width: 100%; margin-bottom: 0.6rem; }
  .seg-wide button { flex: 1; }

  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 999px;
    cursor: pointer;
    color: var(--fg);
  }
  .round:hover { border-color: var(--fg); }
  .round svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  /* Held down, in the same violet the core's arc is drawn in — the button and
     the mark it puts on the map have to read as the same thing. */
  .round[aria-pressed='true'] {
    color: #bd99f2;
    border-color: #bd99f2;
    background: color-mix(in oklab, #bd99f2 16%, transparent);
  }
  #night-button .star { fill: currentColor; stroke: none; }
  .compass svg { transform: rotate(var(--bearing, 0deg)); transition: transform 120ms linear; }
  .compass .needle-n { fill: #e0603a; stroke: none; }
  .compass .needle-s { fill: color-mix(in oklab, var(--fg) 55%, transparent); stroke: none; }

  /* ── Layers menu ──────────────────────────────────────────────────────── */

  .layers {
    position: absolute;
    right: 0.9rem;
    top: 3.6rem;
    z-index: 21;
    width: 16rem;
    max-width: calc(100vw - 1.8rem);
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    padding: 0.75rem;
    border-radius: 14px;
  }
  .layers[hidden] { display: none; }
  .layers-head {
    margin: 0 0 0.4rem;
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0;
    min-height: 34px;
    font-family: var(--font-label);
    font-size: 0.68rem;
    color: var(--fg);
    cursor: pointer;
  }
  .toggle input { accent-color: var(--fg); width: 15px; height: 15px; }

  .slab { margin: 0.4rem 0 0.6rem; padding: 0.5rem 0 0; border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent); }
  .slab[hidden] { display: none; }
  .slab-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-label);
    font-size: 0.6rem;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .slab-row output { color: var(--fg); font-variant-numeric: tabular-nums; }
  .slab input[type='range'] { width: 100%; accent-color: var(--fg); }
  .slab-note { margin: 0.35rem 0 0; font-family: var(--font-label); font-size: 0.56rem; line-height: 1.5; color: var(--muted); }

  .frame-row { display: flex; gap: 0.4rem; margin-bottom: 0.5rem; }
  .frame-field { flex: 1; display: grid; gap: 0.2rem; font-family: var(--font-label); font-size: 0.56rem; color: var(--muted); }
  .frame-field select {
    width: 100%;
    padding: 0.3rem 0.35rem;
    font: inherit;
    font-size: 0.62rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 5px;
  }
  .frame-aims { display: flex; gap: 0.3rem; margin-top: 0.5rem; }
  .frame-aims .chip { flex: 1; }

  .wide {
    display: block;
    width: 100%;
    padding: 0.5rem;
    min-height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.64rem;
    cursor: pointer;
  }
  .wide:hover { border-color: var(--fg); }

  /* ── Bottom sheet ─────────────────────────────────────────────────────── */

  .sheet {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(5.6rem + var(--safe-bottom));
    z-index: 19;
    width: min(30rem, calc(100vw - 1.8rem));
    padding: 0.5rem;
    border-radius: 14px;
  }
  .sheet-row { display: flex; align-items: center; gap: 0.6rem; }
  .sheet-place { flex: 1; min-width: 0; text-align: center; }
  .sheet-name {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sheet-zone {
    margin: 0.1rem 0 0;
    font-family: var(--font-label);
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .searchbox { position: relative; margin-top: 0.5rem; }
  .searchbox[hidden] { display: none; }
  .searchbox input {
    width: 100%;
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.82rem;
    padding: 0.6rem 0.7rem;
    min-height: 40px;
  }
  .searchbox input:focus-visible { outline: none; border-color: var(--fg); }
  .searchbox input::-webkit-search-cancel-button { filter: invert(1); opacity: 0.4; }

  .radiusbox { display: flex; align-items: center; gap: 0.7rem; margin-top: 0.5rem; padding: 0 0.2rem; }
  .radiusbox[hidden] { display: none; }
  .radiusbox input[type='range'] { flex: 1; accent-color: var(--fg); min-width: 0; height: 34px; }
  .radius-out {
    font-family: var(--font-label);
    font-size: 0.74rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    min-width: 4rem;
    text-align: right;
  }

  /* Results are built by the script, so everything under the list has to be
     :global() — a scoped selector would be stamped with an attribute those
     nodes never receive, and would silently match nothing. */
  .results {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    z-index: 30;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 15rem;
    overflow-y: auto;
    background: color-mix(in oklab, var(--bg) 96%, #000);
    border: 1px solid var(--border);
    border-radius: 10px;
    backdrop-filter: blur(8px);
  }
  .results[hidden] { display: none; }
  .results :global(li) {
    padding: 0.6rem 0.7rem;
    cursor: pointer;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }
  .results :global(li:last-child) { border-bottom: 0; }
  .results :global(li:hover),
  .results :global(li[aria-selected='true']) { background: color-mix(in oklab, var(--fg) 8%, transparent); }
  .results :global(.nm) { display: block; font-family: var(--font-label); font-size: 0.8rem; color: var(--fg); }
  .results :global(.dt) {
    display: block;
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: var(--muted);
    margin-top: 0.1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .results :global(.kd) {
    float: right;
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--muted) 70%, transparent);
    margin-left: 0.6rem;
  }
  .results :global(.msg) { padding: 0.7rem; color: var(--muted); font-size: 0.74rem; cursor: default; }
  .results :global(.msg.err) { color: #e0603a; }

  /* ── Kept spots ───────────────────────────────────────────────────────────
     Shown in place of the search results while the field is empty, which is
     exactly the moment you are looking for somewhere you have already been. */

  .kept {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    z-index: 30;
  }
  .kept[hidden] { display: none; }
  .kept-head {
    margin: 0 0 0.3rem;
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* The list inside is `.results`, which is absolutely placed for the search
     box; here it is already in the right spot and must sit still. */
  .kept .results { position: static; }
  .kept :global(.drop-spot) {
    float: right;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1;
    padding: 0 0.2rem;
  }
  .kept :global(.drop-spot:hover) { color: #e0603a; }

  /* The star fills once the spot is kept — an outline you have to read is not
     a state you can see at a glance. */
  #star svg { fill: none; stroke: currentColor; stroke-width: 1.5; }
  #star[aria-pressed='true'] { color: #e8b33a; }
  #star[aria-pressed='true'] svg { fill: currentColor; stroke: currentColor; }
  #star[hidden] { display: none; }

  /* ── Undo ─────────────────────────────────────────────────────────────────
     A tap that moves the pin is fast, and fast is only safe if it is also
     reversible. */

  .toast {
    position: absolute;
    left: 50%;
    bottom: calc(7.5rem + var(--safe-bottom));
    transform: translateX(-50%);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.6rem 0.5rem 0.85rem;
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: 0.68rem;
    color: var(--fg);
    background: color-mix(in oklab, var(--bg) 92%, #000);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }
  .toast[hidden] { display: none; }
  .toast-do {
    border: 0;
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    min-height: 28px;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Photo hotspots ───────────────────────────────────────────────────── */

  .photos {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    bottom: 0.9rem;
    z-index: 26;
    width: 21rem;
    max-width: calc(100vw - 1.8rem);
    display: flex;
    flex-direction: column;
    padding: 0.85rem;
    border-radius: 14px;
  }
  .photos[hidden] { display: none; }
  .photos-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.6rem; }
  .photos-title { margin: 0; font-family: var(--font-label); font-size: 0.82rem; color: var(--fg); }
  .photos-sub { margin: 0.15rem 0 0; font-family: var(--font-label); font-size: 0.62rem; color: var(--muted); }
  .photos-light { margin: 0.2rem 0 0; font-family: var(--font-label); font-size: 0.62rem; line-height: 1.45; color: #f0b866; }
  .photos-light:empty { display: none; }
  .photo-grid {
    flex: 1 1 auto;
    overflow-y: auto;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .photo-grid :global(li) {
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in oklab, var(--bg) 88%, #000);
  }
  .photo-grid :global(a) { display: block; text-decoration: none; color: inherit; }
  .photo-grid :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: color-mix(in oklab, var(--fg) 6%, transparent);
  }
  /* A thumbnail that never arrived reads as a gap, not as a broken page. */
  .photo-grid :global(img.missing) { display: none; }
  .photo-grid :global(.acc) {
    display: inline-block;
    margin: 0.35rem 0.4rem 0;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-family: var(--font-label);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .photo-grid :global(.acc-featured) { background: #e8b33a; color: #1a1408; }
  .photo-grid :global(.acc-quality) { background: color-mix(in oklab, #6fc3f0 70%, transparent); color: #08121c; }
  .photo-grid :global(.acc-valued) { background: color-mix(in oklab, var(--fg) 18%, transparent); color: var(--fg); }
  .photo-grid :global(.by) {
    display: block;
    padding: 0.35rem 0.4rem 0;
    font-family: var(--font-label);
    font-size: 0.58rem;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The licence is not fine print here — it is the condition of use, and it is
     shown at the same weight as the name it belongs to. */
  .photo-grid :global(.lic) {
    display: block;
    padding: 0 0.4rem 0.35rem;
    font-family: var(--font-label);
    font-size: 0.54rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .photos-note {
    margin: 0.6rem 0 0;
    font-family: var(--font-label);
    font-size: 0.55rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .photos { left: 0.9rem; width: auto; top: auto; height: 58vh; bottom: calc(5.2rem + var(--safe-bottom)); }
    .photo-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── The date sheet ───────────────────────────────────────────────────── */

  .datesheet {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 22;
    width: 15rem;
    max-width: calc(100vw - 1.8rem);
    padding: 0.75rem;
    border-radius: 14px;
  }
  .datesheet[hidden] { display: none; }
  .datesheet-row { display: flex; gap: 0.4rem; margin-bottom: 0.7rem; }
  .datesheet input[type='date'] {
    flex: 1;
    min-width: 0;
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.74rem;
    padding: 0.45rem 0.5rem;
    min-height: 36px;
  }
  .seasons,
  .week { display: grid; gap: 0.3rem; }
  .week { margin-bottom: 0.7rem; }
  /* The day you are on, so the strip reads as a position and not just a list. */
  .week :global(button.on) { border-color: var(--fg); background: color-mix(in oklab, var(--fg) 8%, transparent); }
  .seasons :global(button),
  .week :global(button) {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    min-height: 34px;
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.64rem;
    cursor: pointer;
    text-align: left;
  }
  .seasons :global(button:hover),
  .week :global(button:hover) { border-color: var(--fg); }
  .seasons :global(.se-when),
  .week :global(.se-when) { color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ── Time ─────────────────────────────────────────────────────────────── */

  /* The bar fades into the map rather than sitting on it as a slab. Four stops
     rather than two: a straight two-stop fade to transparent has a visible
     shoulder where it meets the map, and over a bright satellite tile that
     shoulder reads as a hard edge across the picture. */
  .scout-time {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 18;
    padding: 1.4rem 0.9rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--bg) 96%, #000) 0%,
      color-mix(in oklab, var(--bg) 88%, #000) 38%,
      color-mix(in oklab, var(--bg) 55%, transparent) 72%,
      transparent 100%
    );
  }
  .scout-time[hidden] { display: none; }

  /* Two stacked gradients: the day's own phases underneath, and over them a
     mask of when *this spot* is in shade. Knowing golden hour runs 06:20–07:10
     is worth little if your doorway is behind a tower until 08:40. */
  .scout-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 18px;
    background-image: var(--scout-shade, linear-gradient(to right, transparent, transparent)),
      var(--scout-track, linear-gradient(to right, #0a0a0c, #0a0a0c));
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
  }
  .scout-slider:focus-visible { outline: 1px solid var(--fg); outline-offset: 2px; }
  .scout-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 3px;
    height: 32px;
    margin-top: -8px;
    background: #fff;
    border: 1px solid #000;
    border-radius: 1px;
    cursor: ew-resize;
  }
  .scout-slider::-moz-range-thumb {
    width: 3px;
    height: 32px;
    background: #fff;
    border: 1px solid #000;
    border-radius: 1px;
    cursor: ew-resize;
  }

  .jumps { display: flex; gap: 0.3rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
  .jumps button {
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.34rem 0.62rem;
    min-height: 30px;
    transition: color 140ms, border-color 140ms;
  }
  .jumps button:hover:not(:disabled) { color: var(--fg); border-color: var(--fg); }
  .jumps button:disabled { opacity: 0.3; cursor: default; }

  /* ── Map markers ──────────────────────────────────────────────────────── */

  .scout-map :global(.pin) {
    width: 26px;
    height: 26px;
    cursor: grab;
    display: grid;
    place-items: center;
  }
  .scout-map :global(.pin:active) { cursor: grabbing; }
  .scout-map :global(.pin i) {
    width: 15px;
    height: 15px;
    background: #f2efe8;
    border: 2px solid rgba(0, 0, 0, 0.7);
    border-radius: 3px;
    transform: rotate(45deg);
    display: block;
  }
  .scout-map :global(.slabmark) { width: 24px; height: 24px; cursor: grab; display: grid; place-items: center; }
  .scout-map :global(.slabmark i) {
    width: 13px;
    height: 13px;
    background: #cfd6e4;
    border: 2px solid rgba(0, 0, 0, 0.75);
    display: block;
  }
  /* The sightline target: a ring rather than a solid, so what it is placed on
     stays visible — the whole question is what the ground under it looks like. */
  .scout-map :global(.sightmark) { width: 26px; height: 26px; cursor: grab; display: grid; place-items: center; }
  .scout-map :global(.sightmark i) {
    width: 15px;
    height: 15px;
    background: transparent;
    border: 2.5px solid #c1863c;
    border-radius: 50%;
    box-shadow: 0 0 0 1.5px rgba(0, 0, 0, 0.55);
    display: block;
  }

  .scout-map :global(.maplibregl-ctrl-attrib) {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    font-family: var(--font-label);
    font-size: 0.56rem;
  }
  .scout-map :global(.maplibregl-ctrl-attrib a) { color: var(--muted); }
  .scout-map :global(.maplibregl-ctrl-bottom-right) { bottom: 5.2rem; }

  @media (max-width: 820px) {
    .panel { width: calc(100vw - 1.8rem); }
    .panel[data-open='true'] { width: calc(100vw - 1.8rem); }
    .edge { top: auto; bottom: calc(9.6rem + var(--safe-bottom)); transform: none; flex-direction: row; align-items: center; }
    .sheet { bottom: calc(5.2rem + var(--safe-bottom)); }
    .layers { top: auto; bottom: calc(9.6rem + var(--safe-bottom)); }
    .datesheet { top: auto; bottom: calc(9.6rem + var(--safe-bottom)); transform: none; }
    /* The nav and the view controls share the top row, and on a phone there is
       not room for both at full width — measured, they touch at 390px. The way
       back is the one that has to survive, so Inspiration stands down; it is
       one tap away through the archive. */
    .scout-nav a[href='/inspiration'] { display: none; }
    .cards { grid-template-columns: repeat(2, 1fr); }

    /* The seven jumps want 409px on a phone and have 379, so Dusk — the last of
       them — wrapped onto a line of its own and sat there looking like a
       mistake rather than like the end of a day. Thirty pixels is all it is
       over, so it comes off the padding and the gaps instead of off the row:
       the letter-spacing these chips are set in is most of their width, and
       trimming the box around it costs nothing anyone can see. They stay a
       thumb's height, which is the measurement that matters. */
    .jumps { gap: 0.18rem; }
    .jumps button { padding: 0.45rem 0.45rem; min-height: 34px; }

    /* The layers panel grew two control blocks. Anchored to the bottom, its own
       70vh could now run off the top of a short phone and put the basemap
       buttons under the status bar, so it is measured from where it actually
       starts instead. */
    .layers { max-height: calc(100vh - 11.4rem - var(--safe-bottom)); }

    /* Sensor and lens stack: side by side each select is about 150px wide, which
       is not enough for "Micro Four Thirds" and truncates the one thing the
       control is for. */
    .frame-row { flex-direction: column; gap: 0.5rem; }

    /* Everything you drag or tap in these two blocks, at a thumb's size. The
       range inputs are the ones that matter — a 4px-tall track on glass is a
       coin toss, and the aim slider is the control this feature turns on. */
    .frame-field select { min-height: 40px; padding: 0.5rem 0.5rem; }
    .frame-aims .chip { min-height: 38px; }
    #framebox input[type='range'],
    #sightbox input[type='range'] { min-height: 34px; }

    /* Taller on a phone: the profile is read for the shape of one ridge against
       one line, and 84px of that on a narrow screen is a smudge. */
    .sight-chart { height: 104px; }
  }

  /* ── Where the two chip rows stop fitting on one line ──────────────────────
     Measured on this markup, not guessed: the date row is 209–215px and the
     time row 254–327px, the spread depending on how long the phase is called —
     "Astronomical twilight" is two and a half times "Daylight" — so together
     they want 491–570px plus margins. A 393px phone has never had that, and
     the two were overlapping by about 100px: the date chip sat *underneath*
     Play and Now, which read as a stray letter between two buttons rather than
     as a date anyone could tap.

     So below 620px they take a row each. The clock keeps the lower one, next to
     the thumb and directly above the track it drives; the date, which is
     changed far less often, moves up. */
  @media (max-width: 620px) {
    .edge-left { bottom: calc(12.6rem + var(--safe-bottom)); }

    /* One row on its own still needs 355px at the longest phase name, which a
       320px phone does not have either. The phase is the part that gives: the
       clock beside it is the number you came to read, and a truncated
       "Astronomical twi…" still says which twilight it is. */
    .edge-right { max-width: calc(100vw - 1.8rem); }
    .edge-right .chip-phase {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* iOS zooms the whole page in when a focused control's text is under 16px, and
     then leaves it zoomed. The layers panel is fixed to the corner, so the zoom
     puts half of it off-screen — the select has to opt out by being big enough. */
  @media (pointer: coarse) {
    .frame-field select { font-size: 16px; }
  }
</style>

<script>
  // The page is markup; everything it does is in `view/page.ts`.
  //
  // It lives there rather than here because a script inside an .astro file is
  // unreachable to the rest of the toolchain: `tsc --noEmit` does not look
  // inside .astro at all — `scripts/check-astro-scripts.ts` exists precisely to
  // work around that — and no test can import one. Moving it out means the
  // whole of Scout's behaviour is typechecked by the ordinary build and open to
  // being tested.
  import { startScout } from '../lib/scout/view/page';

  // Floating: nothing on this page awaits it, and a rejection here would only
  // ever be a bug in the module rather than a condition to handle.
  void startScout();
</script>
