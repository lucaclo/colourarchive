---
import Layout from '../layouts/Layout.astro';
import 'maplibre-gl/dist/maplibre-gl.css';

// Prerendered, so /scout ships in the static publish alongside the archive.
// Nothing above this line reads anything server-side: the page is an empty shell
// and every coordinate, forecast and photograph arrives in the browser. Where
// those come from depends on whether there is a server behind it — see
// `browser/sources.ts`.
export const prerender = true;
---

<Layout
  title="Scout — Colour Archive"
  description="Type a place, set a radius, and see how the light falls inside it."
  preconnect={[
    // The basemap: style, sprite, glyphs and vector tiles all come from here,
    // and nothing draws until they do.
    'https://tiles.openfreemap.org',
    // The elevation the hillshade, the landform shadows and the line of sight
    // are all built from.
    'https://s3.amazonaws.com',
  ]}
>
  <main class="scout">
    <div class="scout-stage">
      <div class="scout-map" id="map"></div>

      <p class="scout-hint" id="scout-hint">Type a place to begin.</p>

      <!-- ── Top left: the way back ──────────────────────────────────────────
           Scout is a full-bleed map with no topbar, so the two links every
           other page carries have nowhere to live. They go here, in the same
           segmented control the view switch uses, and unlike everything else
           on the stage they are never hidden — being unable to pick a place is
           the most likely reason to want to leave. -->
      <nav class="seg scout-nav" aria-label="Colour Archive">
        <a href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
          Archive
        </a>
        <a href="/inspiration">Inspiration</a>
      </nav>

      <!-- A map that fails renders as a black rectangle and says nothing. Every
           way that can happen gets a sentence here instead. -->
      <div class="scout-mapmsg" id="mapmsg" hidden>
        <p class="scout-mapmsg-title" id="mapmsg-title"></p>
        <p class="scout-mapmsg-body" id="mapmsg-body"></p>
      </div>

      <!-- Undo for a tap that moved the pin somewhere you did not mean. -->
      <div class="toast" id="toast" hidden>
        <span id="toast-text"></span>
        <button class="toast-do" id="toast-undo" type="button">Undo</button>
      </div>

      <!-- Everything that changes under the slider, for a screen reader. It is
           polite and it is throttled: announcing every minute of a scrub would
           make the page unusable to listen to. -->
      <p class="sr" id="say" role="status" aria-live="polite"></p>

      <!-- ── The panel ──────────────────────────────────────────────────────
           Collapsed to a single line by default, because the map is the point
           and this used to cover a quarter of it. Hovering — or tapping, where
           there is no hover — opens the whole stack. -->
      <section class="panel" id="panel" hidden>
        <button
          class="panel-head"
          id="panel-head"
          type="button"
          aria-expanded="false"
          aria-controls="panel-body"
        >
          <span class="panel-name" id="panel-name"></span>
          <span class="panel-glance" id="panel-glance"></span>
          <span class="panel-cue" aria-hidden="true"></span>
        </button>

        <div class="panel-body" id="panel-body">
          <p class="panel-detail" id="panel-detail"></p>

          <!-- Weather. Kept at the top and kept visibly apart from the
               arithmetic below it: everything else on this panel is computed,
               this one thing is a forecast and can simply be wrong. -->
          <button class="wx" id="wx" type="button" hidden>
            <span class="wx-icon" id="wx-icon" aria-hidden="true"></span>
            <span class="wx-text">
              <span class="wx-label" id="wx-label"></span>
              <span class="wx-sum" id="wx-sum"></span>
            </span>
            <span class="wx-stale" id="wx-stale"></span>
          </button>
          <p class="wx-note" id="wx-note"></p>
          <!-- The three decks. One total cannot tell cirrus over a clear sun
               from a grey afternoon, and they are opposite photographs. -->
          <p class="wx-decks" id="wx-decks"></p>
          <!-- The sky the light has to come through, which is not this one. -->
          <p class="wx-horizon" id="wx-horizon"></p>

          <div class="cards" id="cards">
            <div class="card"><span class="card-k">Azimuth</span><span class="card-v" id="c-azimuth">—</span></div>
            <div class="card"><span class="card-k">Altitude</span><span class="card-v" id="c-altitude">—</span></div>
            <div class="card"><span class="card-k">Shadow</span><span class="card-v" id="c-shadow">—</span></div>
            <div class="card"><span class="card-k">Elevation</span><span class="card-v" id="c-elevation">—</span></div>
          </div>

          <ul class="events" id="events"></ul>

          <details class="fold" id="fold-twilight">
            <summary>Twilight</summary>
            <ul class="events events-sub" id="twilight"></ul>
          </details>

          <details class="fold" id="fold-moon">
            <summary>Moon</summary>
            <div class="moon">
              <svg class="moon-disc" id="moon-disc" viewBox="-13 -13 26 26" aria-hidden="true">
                <circle cx="0" cy="0" r="12" class="moon-dark"></circle>
                <path id="moon-lit" class="moon-lit" d=""></path>
                <circle cx="0" cy="0" r="12" class="moon-rim"></circle>
              </svg>
              <div class="moon-text">
                <p class="moon-phase" id="moon-phase">—</p>
                <p class="moon-line" id="moon-times">—</p>
                <p class="moon-line" id="moon-now">—</p>
                <p class="moon-note" id="moon-note"></p>
              </div>
            </div>
          </details>

          <!-- The per-spot answer: not where the shade is, but when the light
               gets here. The thing every other readout on the page is for. -->
          <div class="spot" id="spot">
            <p class="spot-line" id="spot-windows">—</p>
            <p class="spot-next" id="spot-next"></p>
            <p class="spot-basis" id="spot-basis"></p>
          </div>

          <!-- Where the sun falls relative to the picture, rather than
               relative to north. -->
          <div class="framing" id="framing" hidden>
            <p class="framing-head" id="framing-lens">—</p>
            <p class="framing-line" id="framing-sun">—</p>
            <p class="framing-line framing-moon" id="framing-moon"></p>
            <p class="framing-note" id="framing-width"></p>
          </div>

          <!-- The ground between here and there, and whether it is in the way. -->
          <div class="sightline" id="sightline" hidden>
            <svg class="sight-chart" id="sight-chart" viewBox="0 0 320 84" preserveAspectRatio="none" aria-hidden="true">
              <path class="sight-ground" id="sight-ground" d="" />
              <path class="sight-ray" id="sight-ray" d="" />
              <circle class="sight-block" id="sight-block" r="3" cx="-10" cy="-10" />
            </svg>
            <p class="sight-line" id="sight-verdict">—</p>
            <p class="sight-note" id="sight-detail"></p>
          </div>

          <dl class="facts">
            <div><dt>Centre</dt><dd id="f-coords">—</dd></div>
            <div><dt>Radius</dt><dd id="f-radius">—</dd></div>
            <div><dt>A 10 m wall</dt><dd id="f-throw">—</dd></div>
            <div><dt>Buildings</dt><dd id="f-buildings">—</dd></div>
            <div><dt>Landform</dt><dd id="f-landform">—</dd></div>
            <div><dt>Photographed</dt><dd id="f-photos">—</dd></div>
            <div><dt>Light</dt><dd id="f-light">—</dd></div>
          </dl>

          <!-- ── The notebook ───────────────────────────────────────────────
               Only for a kept spot. A place you are passing through does not
               need a note, and a note with nowhere to live would be lost the
               moment the pin moved — so the star is what opens this. -->
          <details class="fold" id="fold-note" hidden>
            <summary>Notebook</summary>
            <div class="note">
              <textarea
                class="note-text"
                id="note-text"
                rows="3"
                maxlength="600"
                placeholder="What is worth remembering about this spot?"
                aria-label="Note about this spot"
              ></textarea>
              <p class="note-kept" id="note-kept"></p>
              <ul class="note-photos" id="note-photos"></ul>
              <div class="note-add">
                <input
                  class="note-url"
                  id="note-url"
                  type="url"
                  inputmode="url"
                  placeholder="Link a reference photograph"
                  aria-label="Reference photograph URL"
                />
                <button class="ghost" id="note-add" type="button">Add</button>
              </div>
              <p class="note-say" id="note-say"></p>
            </div>
          </details>
        </div>
      </section>

      <!-- ── Date, left edge ─────────────────────────────────────────────── -->
      <div class="edge edge-left" id="edge-date" hidden>
        <button class="chip chip-strong" id="chip-today" type="button">Today</button>
        <div class="stepper">
          <button class="chip chip-step" id="day-back" type="button" aria-label="A day earlier">−</button>
          <button class="chip chip-date" id="chip-date" type="button">—</button>
          <button class="chip chip-step" id="day-forward" type="button" aria-label="A day later">+</button>
        </div>
      </div>

      <!-- ── Time, right edge ────────────────────────────────────────────── -->
      <div class="edge edge-right" id="edge-time" hidden>
        <button
          class="chip chip-strong"
          id="chip-play"
          type="button"
          aria-pressed="false"
          title="Run the day (space)"
        >
          <span id="play-label">Play</span>
        </button>
        <button
          class="chip chip-strong"
          id="chip-now"
          type="button"
          aria-pressed="false"
          title="Follow the clock (n)"
        >Now</button>
        <span class="chip chip-clock" id="chip-clock">--:--</span>
        <span class="chip chip-phase" id="chip-phase"></span>
      </div>

      <!-- ── Top right: view controls ────────────────────────────────────── -->
      <div class="tools" id="tools" hidden>
        <div class="seg" id="viewseg">
          <button type="button" data-view="2d" class="on">2D</button>
          <button type="button" data-view="3d">3D</button>
        </div>
        <button class="round" id="layers-button" type="button" aria-expanded="false" aria-controls="layers" title="Layers">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M2 13l10 5 10-5"/></svg>
          <span class="sr">Layers</span>
        </button>
        <button class="round compass" id="compass" type="button" title="Point north">
          <svg viewBox="0 0 24 24" aria-hidden="true" id="compass-rose">
            <polygon points="12,3 15,13 12,11 9,13" class="needle-n"/>
            <polygon points="12,21 9,11 12,13 15,11" class="needle-s"/>
          </svg>
          <span class="sr">Point north</span>
        </button>
      </div>

      <div class="layers" id="layers" hidden>
        <p class="layers-head">Basemap</p>
        <div class="seg seg-wide" id="baseseg">
          <button type="button" data-base="light" class="on">Light</button>
          <button type="button" data-base="dark">Dark</button>
          <button type="button" data-base="satellite">Satellite</button>
        </div>
        <p class="layers-head">Show</p>
        <label class="toggle"><input type="checkbox" id="t-buildings" checked /> <span>Building shadows</span></label>
        <label class="toggle"><input type="checkbox" id="t-landform" checked /> <span>Landform shadows</span></label>
        <label class="toggle"><input type="checkbox" id="t-hillshade" checked /> <span>Hillshade</span></label>
        <label class="toggle"><input type="checkbox" id="t-sunpath" checked /> <span>Sun path</span></label>
        <label class="toggle"><input type="checkbox" id="t-moonpath" /> <span>Moon path</span></label>
        <label class="toggle"><input type="checkbox" id="t-solstice" /> <span>Solstice paths</span></label>
        <label class="toggle"><input type="checkbox" id="t-monolith" /> <span>Monolith</span></label>
        <label class="toggle"><input type="checkbox" id="t-photos" checked /> <span>Photo hotspots</span></label>
        <label class="toggle"><input type="checkbox" id="t-frame" /> <span>Frame</span></label>
        <label class="toggle"><input type="checkbox" id="t-sight" /> <span>Line of sight</span></label>

        <!-- The lens. The wedge on the map is where the frame lands on the
             ground; the answer that needs it is whether the sun is *in* the
             picture, which no bearing readout can tell you without a focal
             length. -->
        <div class="slab" id="framebox" hidden>
          <div class="frame-row">
            <label class="frame-field" for="frame-sensor"><span>Sensor</span>
              <select id="frame-sensor"></select>
            </label>
            <label class="frame-field" for="frame-focal"><span>Lens</span>
              <select id="frame-focal"></select>
            </label>
          </div>
          <div class="seg seg-wide" id="frameorient">
            <button type="button" data-orient="landscape" class="on">Landscape</button>
            <button type="button" data-orient="portrait">Portrait</button>
          </div>
          <label class="slab-row" for="frame-bearing">
            <span>Aim</span>
            <output id="frame-bearing-out">270° W</output>
          </label>
          <input id="frame-bearing" type="range" min="0" max="359" step="1" value="270" />
          <label class="slab-row" for="frame-tilt">
            <span>Tilt</span>
            <output id="frame-tilt-out">0°</output>
          </label>
          <input id="frame-tilt" type="range" min="-60" max="80" step="1" value="0" />
          <div class="frame-aims">
            <button class="chip chip-step" id="aim-sun" type="button">Aim at the sun</button>
            <button class="chip chip-step" id="aim-moon" type="button">At the moon</button>
          </div>
          <p class="slab-note" id="frame-lens">—</p>
        </div>

        <!-- Can I see it from here? Bare earth only, and it says so. -->
        <div class="slab" id="sightbox" hidden>
          <label class="slab-row" for="sight-height">
            <span>Subject height</span>
            <output id="sight-out">0 m</output>
          </label>
          <input id="sight-height" type="range" min="0" max="300" step="1" value="0" />
          <p class="slab-note">Drag the ring on the map to what you want to see. Terrain only — trees and buildings are not in this.</p>
        </div>

        <div class="slab" id="slab" hidden>
          <label class="slab-row" for="slab-height">
            <span>Monolith height</span>
            <output id="slab-out">10 m</output>
          </label>
          <input id="slab-height" type="range" min="1" max="200" step="1" value="10" />
          <p class="slab-note">Drag the slab on the map. Its shadow is the one on this page with no guessing in it.</p>
        </div>
        <p class="layers-head">This view</p>
        <button class="wide" id="export" type="button">Save as an image</button>
        <button class="wide" id="copy-plan" type="button">Copy the plan</button>
        <button class="wide" id="copy-link" type="button">Copy a link to this spot</button>
      </div>

      <!-- ── Bottom: place sheet, then the day ───────────────────────────── -->
      <div class="sheet" id="sheet">
        <div class="sheet-row">
          <button class="round" id="search-button" type="button" aria-expanded="false" aria-controls="searchbox" title="Search for a place">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="sr">Search for a place</span>
          </button>
          <div class="sheet-place">
            <p class="sheet-name" id="sheet-name">Nowhere yet</p>
            <p class="sheet-zone" id="sheet-zone"></p>
          </div>
          <button class="round" id="star" type="button" aria-pressed="false" title="Keep this spot" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" id="star-mark">
              <path d="m12 3.6 2.6 5.6 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L3.4 10l6-.8Z"/>
            </svg>
            <span class="sr">Keep this spot</span>
          </button>
          <button class="round" id="radius-button" type="button" aria-expanded="false" aria-controls="radiusbox" title="Radius">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke-dasharray="3 3"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></svg>
            <span class="sr">Radius</span>
          </button>
        </div>

        <div class="searchbox" id="searchbox" hidden>
          <input
            id="place"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="A city, a street, a hill"
            aria-expanded="false"
            aria-controls="place-results"
            role="combobox"
          />
          <ul class="results" id="place-results" role="listbox" aria-label="Places" hidden></ul>
          <!-- Shown when the field is empty, which is exactly when you are
               looking for somewhere you have already been. -->
          <div class="kept" id="kept" hidden>
            <p class="kept-head">Kept spots</p>
            <ul class="results" id="kept-list" aria-label="Kept spots"></ul>
          </div>
        </div>

        <div class="radiusbox" id="radiusbox" hidden>
          <input id="radius" type="range" min="1" max="50" step="1" value="10" aria-label="Radius" />
          <output class="radius-out" id="radius-out" for="radius">10 km</output>
        </div>
      </div>

      <div class="scout-time" id="timebar" hidden>
        <input
          class="scout-slider"
          id="time"
          type="range"
          min="0"
          max="1440"
          step="1"
          value="720"
          aria-label="Time of day"
        />
        <div class="jumps" id="jumps">
          <button type="button" data-jump="civilDawn">Dawn</button>
          <button type="button" data-jump="sunrise">Sunrise</button>
          <button type="button" data-jump="goldenMorning">Golden</button>
          <button type="button" data-jump="solarNoon">Noon</button>
          <button type="button" data-jump="goldenEvening">Golden</button>
          <button type="button" data-jump="sunset">Sunset</button>
          <button type="button" data-jump="civilDusk">Dusk</button>
        </div>
      </div>

      <!-- The date sheet, opened from the date chip. -->
      <div class="datesheet" id="datesheet" hidden>
        <div class="datesheet-row">
          <input type="date" id="date-input" aria-label="Date" />
          <button class="chip" id="date-close" type="button">Done</button>
        </div>
        <!-- Pick a date by the light rather than by the number. -->
        <p class="layers-head">The week ahead</p>
        <div class="week" id="week"></div>
        <p class="layers-head">Jump to</p>
        <div class="seasons" id="seasons"></div>
      </div>

      <!-- ── What other people photographed here ────────────────────────────
           Opened by tapping a hotspot. Every photograph carries its author and
           its licence, because showing someone's work without their name is
           the same failure as asserting a shadow you did not compute. -->
      <div class="photos" id="photos" hidden>
        <div class="photos-head">
          <div>
            <p class="photos-title" id="photos-title">Photographs</p>
            <p class="photos-sub" id="photos-sub"></p>
          </div>
          <button class="chip" id="photos-close" type="button">Close</button>
        </div>
        <ul class="photo-grid" id="photo-grid"></ul>
        <p class="photos-note">
          Peer-reviewed photographs from Wikimedia Commons — featured pictures and quality
          images only. Each is its author's, under the licence shown.
        </p>
      </div>

      <a id="download" hidden aria-hidden="true"></a>
    </div>
  </main>
</Layout>

<style>
  /* The map is the page. Everything else floats on top of it — on an iPad in
     the field, every row of chrome is a row of ground you cannot see. */
  .scout {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  /* `--stage-top` is where the left column starts *below* the nav, so the nav
     and the panel cannot be nudged out of agreement by editing one of them. */
  /* `--stage-top` is where the left column starts below the nav; `--safe-bottom`
     is how much of the screen the phone itself has taken at the other end. The
     timebar already grew by it — everything anchored *above* the timebar has to
     grow by it too, or on a device with a home indicator the sheet and the
     layers panel sit a centimetre into the jump buttons. */
  .scout-stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    --stage-top: 3.4rem;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  .scout-map { position: absolute; inset: 0; }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Every control here is a pale pill on a map, so the browser's own focus ring
     is often invisible against whatever is underneath it. `:focus-visible`
     rather than `:focus`, so a mouse click does not leave a ring behind. */
  .scout :global(button:focus-visible),
  .scout :global(a:focus-visible),
  .scout :global(input:focus-visible),
  .scout :global([tabindex]:focus-visible) {
    outline: 2px solid #e0603a;
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* Someone who has asked for less motion has asked for less motion. The sun
     still moves — that is the information — but nothing slides, fades or
     animates its way there, and `Play` steps rather than sweeps (see the
     script). */
  @media (prefers-reduced-motion: reduce) {
    .scout :global(*) {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
  }

  /* One surface for every floating thing, so the page reads as a set rather
     than as a pile of separate panels. */
  .panel,
  .layers,
  .sheet,
  .datesheet,
  .chip,
  .round,
  .seg {
    background: color-mix(in oklab, var(--bg) 86%, #000);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }

  .scout-hint {
    position: absolute;
    left: 50%;
    top: 42%;
    transform: translate(-50%, -50%);
    margin: 0;
    font-family: var(--font-display);
    font-style: var(--title-style);
    font-size: 1.5rem;
    color: var(--muted);
    pointer-events: none;
    text-align: center;
  }
  .scout-hint[hidden] { display: none; }

  .scout-mapmsg {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
    max-width: min(32rem, calc(100% - 3rem));
    padding: 1.1rem 1.3rem;
    background: color-mix(in oklab, var(--bg) 92%, #000);
    border: 1px solid var(--border);
    border-left: 2px solid #e0603a;
    border-radius: 2px;
  }
  .scout-mapmsg[hidden] { display: none; }
  .scout-mapmsg-title {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e0603a;
  }
  .scout-mapmsg-body {
    margin: 0.5rem 0 0;
    font-family: var(--font-label);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ── The panel ────────────────────────────────────────────────────────── */

  .scout-nav {
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    z-index: 21;
  }

  .panel {
    position: absolute;
    left: 0.9rem;
    top: var(--stage-top);
    z-index: 20;
    width: 15.5rem;
    max-width: calc(100vw - 1.8rem);
    border-radius: 14px;
    overflow: hidden;
    transition: width 220ms ease;
  }
  .panel[hidden] { display: none; }

  .panel-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.6rem;
    width: 100%;
    padding: 0.6rem 0.75rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: var(--fg);
  }
  .panel-name {
    font-family: var(--font-display);
    font-style: var(--title-style);
    font-size: 1rem;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .panel-glance {
    grid-column: 1 / -1;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* A chevron that turns, so the card looks like something that opens. */
  .panel-cue {
    grid-row: 1;
    grid-column: 2;
    width: 8px;
    height: 8px;
    margin-top: 0.25rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 220ms ease;
  }

  .panel-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 0.75rem;
    transition: max-height 260ms ease, opacity 180ms ease, padding 260ms ease;
  }

  /* Hover to open where there is a pointer; the head button toggles it
     everywhere else, so a finger is never left without a way in. */
  @media (hover: hover) and (pointer: fine) {
    .panel:hover { width: 21rem; }
    .panel:hover .panel-body,
    .panel:focus-within .panel-body {
      max-height: min(76vh, 46rem);
      opacity: 1;
      overflow-y: auto;
      padding-bottom: 0.75rem;
    }
    .panel:hover .panel-cue,
    .panel:focus-within .panel-cue { transform: rotate(225deg); }
  }
  .panel[data-open='true'] { width: 21rem; }
  .panel[data-open='true'] .panel-body {
    max-height: min(76vh, 46rem);
    opacity: 1;
    overflow-y: auto;
    padding-bottom: 0.75rem;
  }
  .panel[data-open='true'] .panel-cue { transform: rotate(225deg); }

  .panel-detail {
    margin: 0 0 0.6rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .panel-detail:empty { display: none; }

  /* ── Weather ──────────────────────────────────────────────────────────── */

  .wx {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.5rem 0.6rem;
    margin-bottom: 0.5rem;
    background: color-mix(in oklab, var(--fg) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 9px;
    cursor: pointer;
    color: var(--fg);
    text-align: left;
  }
  .wx[hidden] { display: none; }
  .wx-icon { font-size: 1rem; line-height: 1; }
  .wx-text { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; flex: 1; }
  .wx-label { font-family: var(--font-label); font-size: 0.76rem; }
  .wx-sum {
    font-family: var(--font-label);
    font-size: 0.6rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .wx-stale {
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c1863c;
  }
  .wx-note {
    margin: 0 0 0.7rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .wx-note:empty { display: none; }

  /* The deck breakdown and the horizon reading sit under the forecast and
     inside its margin, so it stays visually one block: all three are the same
     kind of statement, and none of them is arithmetic. */
  .wx-decks,
  .wx-horizon {
    margin: -0.45rem 0 0.7rem;
    padding-left: 0.55rem;
    border-left: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    font-family: var(--font-label);
    font-size: 0.58rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .wx-horizon { margin-top: 0.35rem; }
  .wx-decks:empty,
  .wx-horizon:empty { display: none; }
  .wx-horizon[data-verdict='lit'] { color: #c1863c; border-left-color: #c1863c; }
  .wx-horizon[data-verdict='blocked'] { opacity: 0.75; }

  /* ── The frame, and the line of sight ─────────────────────────────────── */

  .framing,
  .sightline {
    margin: 0.7rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }
  .framing[hidden],
  .sightline[hidden] { display: none; }
  .framing-head {
    margin: 0 0 0.3rem;
    font-family: var(--font-label);
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .framing-line {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .framing-line:empty { display: none; }
  .framing-note {
    margin: 0.25rem 0 0;
    font-family: var(--font-label);
    font-size: 0.56rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .framing-note:empty { display: none; }

  .sight-chart {
    display: block;
    width: 100%;
    height: 84px;
    margin-bottom: 0.4rem;
    overflow: visible;
  }
  .sight-ground { fill: color-mix(in oklab, var(--fg) 16%, transparent); stroke: none; }
  /* Not vector-effect: the chart is deliberately non-uniformly scaled, and a
     stroke that resisted that would be the only thing on it that did. */
  .sight-ray { fill: none; stroke: #c1863c; stroke-width: 1.2; stroke-dasharray: 4 3; }
  .sight-block { fill: #c1863c; }
  .sight-line { margin: 0; font-size: 0.72rem; line-height: 1.5; color: var(--fg); }
  .sight-note {
    margin: 0.25rem 0 0;
    font-family: var(--font-label);
    font-size: 0.56rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .sight-note:empty { display: none; }

  /* ── Stat cards ───────────────────────────────────────────────────────── */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
    margin-bottom: 0.6rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.45rem 0.55rem;
    background: color-mix(in oklab, var(--fg) 5%, transparent);
    border-radius: 9px;
  }
  .card-k {
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-v {
    font-family: var(--font-label);
    font-size: 0.85rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* ── Events ───────────────────────────────────────────────────────────── */

  .events { list-style: none; margin: 0 0 0.5rem; padding: 0; }
  .events :global(li) { border-bottom: 1px solid color-mix(in oklab, var(--border) 45%, transparent); }
  .events :global(li:last-child) { border-bottom: 0; }
  .events :global(button) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.42rem 0.15rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--fg);
    text-align: left;
    min-height: 34px;
  }
  .events :global(button:disabled) { cursor: default; opacity: 0.45; }
  .events :global(button:not(:disabled):hover) { background: color-mix(in oklab, var(--fg) 7%, transparent); }
  .events :global(.ev-label) { font-family: var(--font-label); font-size: 0.68rem; color: var(--muted); }
  .events :global(.ev-time) {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .events :global(.ev-now) { color: #f0b866; }
  .events-sub :global(.ev-time) { font-size: 0.7rem; }

  .fold { margin-bottom: 0.5rem; }
  .fold summary {
    font-family: var(--font-label);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    padding: 0.35rem 0;
    min-height: 30px;
  }

  /* ── Notebook ─────────────────────────────────────────────────────────── */

  .note { display: grid; gap: 0.45rem; padding: 0.2rem 0 0.5rem; }
  .note-text {
    width: 100%;
    resize: vertical;
    font: inherit;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--fg);
    background: color-mix(in oklab, var(--bg) 78%, var(--fg) 6%);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.45rem 0.55rem;
  }
  .note-kept, .note-say { font-size: 0.68rem; color: var(--muted); margin: 0; }
  /* Every row in here is built by the script, and Astro's scoping only reaches
     elements that were in the markup — without `:global()` these fall back to
     the browser's own stylesheet, which is how the credits came out as default
     blue underlined links and the thumbnails had no box at all. */
  .note-photos { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .note-photos :global(li) { display: flex; gap: 0.45rem; align-items: center; }
  .note-photos :global(img) {
    width: 44px;
    height: 32px;
    object-fit: cover;
    border-radius: 4px;
    background: color-mix(in oklab, var(--bg) 78%, var(--fg) 6%);
    flex: none;
  }
  /* The credit is the reason these are references rather than copies, so it is
     never the thing that gets truncated away to nothing. */
  .note-photos :global(.cr) {
    font-size: 0.68rem;
    color: var(--muted);
    line-height: 1.3;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .note-photos :global(.cr a) { color: inherit; }
  .note-add { display: flex; gap: 0.35rem; }
  .note-url {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.72rem;
    color: var(--fg);
    background: color-mix(in oklab, var(--bg) 78%, var(--fg) 6%);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.5rem;
  }
  #note-add {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0 0.7rem;
    cursor: pointer;
  }
  /* Elements built at runtime are outside Astro's scoping, so anything the
     script creates needs :global() or it falls back to the UA stylesheet. */
  .note-photos :global(.drop-photo) {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1;
    padding: 0 0.2rem;
    cursor: pointer;
  }
  .note-photos :global(.drop-photo:hover) { color: #e0603a; }

  /* ── Moon ─────────────────────────────────────────────────────────────── */

  .moon { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.2rem 0 0.4rem; }
  .moon-disc { width: 42px; height: 42px; flex: 0 0 auto; }
  .moon-dark { fill: color-mix(in oklab, var(--fg) 12%, transparent); }
  .moon-lit { fill: #e8e4dc; }
  .moon-rim { fill: none; stroke: color-mix(in oklab, var(--fg) 30%, transparent); stroke-width: 0.75; }
  .moon-text { min-width: 0; }
  .moon-phase { margin: 0; font-family: var(--font-label); font-size: 0.74rem; color: var(--fg); }
  .moon-line {
    margin: 0.15rem 0 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .moon-note { margin: 0.25rem 0 0; font-family: var(--font-label); font-size: 0.6rem; color: var(--muted); font-style: italic; }
  .moon-note:empty { display: none; }

  /* ── The spot's own day ───────────────────────────────────────────────── */

  .spot {
    padding: 0.55rem 0.6rem;
    margin-bottom: 0.6rem;
    background: color-mix(in oklab, #c1863c 12%, transparent);
    border-left: 2px solid #c1863c;
    border-radius: 0 9px 9px 0;
  }
  .spot-line { margin: 0; font-family: var(--font-label); font-size: 0.68rem; line-height: 1.55; color: var(--fg); }
  .spot-next { margin: 0.3rem 0 0; font-family: var(--font-label); font-size: 0.68rem; color: #f0b866; }
  .spot-next:empty { display: none; }
  .spot-basis { margin: 0.3rem 0 0; font-family: var(--font-label); font-size: 0.56rem; line-height: 1.5; color: var(--muted); }
  .spot-basis:empty { display: none; }

  /* ── Facts ────────────────────────────────────────────────────────────── */

  .facts { margin: 0; display: grid; gap: 0.2rem; }
  .facts > div { display: flex; justify-content: space-between; gap: 1rem; }
  .facts dt {
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.66rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* ── Chips at the edges ───────────────────────────────────────────────── */

  .edge {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 18;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .edge[hidden] { display: none; }
  .edge-left { left: 0.9rem; align-items: flex-start; }
  .edge-right { right: 0.9rem; align-items: flex-end; }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    min-height: 34px;
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: 0.66rem;
    color: var(--fg);
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  button.chip:hover { border-color: var(--fg); }
  .chip-strong { letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.56rem; }
  /* Now is a mode, not a jump, so it has to look held down while it is on. */
  .chip.on { color: var(--bg); background: var(--fg); border-color: var(--fg); }
  .chip-clock { font-size: 1rem; padding: 0.35rem 0.7rem; cursor: default; }
  .chip-phase { font-size: 0.58rem; color: var(--muted); cursor: default; }
  .chip-phase:empty { display: none; }
  .stepper { display: flex; gap: 0.25rem; align-items: center; }
  .chip-step { padding: 0.4rem 0.55rem; font-size: 0.9rem; line-height: 1; }

  /* ── Tools, top right ─────────────────────────────────────────────────── */

  .tools {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    z-index: 20;
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .tools[hidden] { display: none; }

  .seg { display: flex; border-radius: 999px; overflow: hidden; }
  .seg button,
  .seg a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--muted);
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    padding: 0.5rem 0.8rem;
    min-height: 36px;
    text-decoration: none;
    transition: color 140ms, background 140ms;
  }
  .seg button.on { color: var(--bg); background: var(--fg); }
  .seg button:not(.on):hover,
  .seg a:hover { color: var(--fg); }
  .seg a svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; }
  .seg-wide { width: 100%; margin-bottom: 0.6rem; }
  .seg-wide button { flex: 1; }

  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 999px;
    cursor: pointer;
    color: var(--fg);
  }
  .round:hover { border-color: var(--fg); }
  .round svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .compass svg { transform: rotate(var(--bearing, 0deg)); transition: transform 120ms linear; }
  .compass .needle-n { fill: #e0603a; stroke: none; }
  .compass .needle-s { fill: color-mix(in oklab, var(--fg) 55%, transparent); stroke: none; }

  /* ── Layers menu ──────────────────────────────────────────────────────── */

  .layers {
    position: absolute;
    right: 0.9rem;
    top: 3.6rem;
    z-index: 21;
    width: 16rem;
    max-width: calc(100vw - 1.8rem);
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    padding: 0.75rem;
    border-radius: 14px;
  }
  .layers[hidden] { display: none; }
  .layers-head {
    margin: 0 0 0.4rem;
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0;
    min-height: 34px;
    font-family: var(--font-label);
    font-size: 0.68rem;
    color: var(--fg);
    cursor: pointer;
  }
  .toggle input { accent-color: var(--fg); width: 15px; height: 15px; }

  .slab { margin: 0.4rem 0 0.6rem; padding: 0.5rem 0 0; border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent); }
  .slab[hidden] { display: none; }
  .slab-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-label);
    font-size: 0.6rem;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .slab-row output { color: var(--fg); font-variant-numeric: tabular-nums; }
  .slab input[type='range'] { width: 100%; accent-color: var(--fg); }
  .slab-note { margin: 0.35rem 0 0; font-family: var(--font-label); font-size: 0.56rem; line-height: 1.5; color: var(--muted); }

  .frame-row { display: flex; gap: 0.4rem; margin-bottom: 0.5rem; }
  .frame-field { flex: 1; display: grid; gap: 0.2rem; font-family: var(--font-label); font-size: 0.56rem; color: var(--muted); }
  .frame-field select {
    width: 100%;
    padding: 0.3rem 0.35rem;
    font: inherit;
    font-size: 0.62rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 5px;
  }
  .frame-aims { display: flex; gap: 0.3rem; margin-top: 0.5rem; }
  .frame-aims .chip { flex: 1; }

  .wide {
    display: block;
    width: 100%;
    padding: 0.5rem;
    min-height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.64rem;
    cursor: pointer;
  }
  .wide:hover { border-color: var(--fg); }

  /* ── Bottom sheet ─────────────────────────────────────────────────────── */

  .sheet {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(5.6rem + var(--safe-bottom));
    z-index: 19;
    width: min(30rem, calc(100vw - 1.8rem));
    padding: 0.5rem;
    border-radius: 14px;
  }
  .sheet-row { display: flex; align-items: center; gap: 0.6rem; }
  .sheet-place { flex: 1; min-width: 0; text-align: center; }
  .sheet-name {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sheet-zone {
    margin: 0.1rem 0 0;
    font-family: var(--font-label);
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .searchbox { position: relative; margin-top: 0.5rem; }
  .searchbox[hidden] { display: none; }
  .searchbox input {
    width: 100%;
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 0.82rem;
    padding: 0.6rem 0.7rem;
    min-height: 40px;
  }
  .searchbox input:focus-visible { outline: none; border-color: var(--fg); }
  .searchbox input::-webkit-search-cancel-button { filter: invert(1); opacity: 0.4; }

  .radiusbox { display: flex; align-items: center; gap: 0.7rem; margin-top: 0.5rem; padding: 0 0.2rem; }
  .radiusbox[hidden] { display: none; }
  .radiusbox input[type='range'] { flex: 1; accent-color: var(--fg); min-width: 0; height: 34px; }
  .radius-out {
    font-family: var(--font-label);
    font-size: 0.74rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
    min-width: 4rem;
    text-align: right;
  }

  /* Results are built by the script, so everything under the list has to be
     :global() — a scoped selector would be stamped with an attribute those
     nodes never receive, and would silently match nothing. */
  .results {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    z-index: 30;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 15rem;
    overflow-y: auto;
    background: color-mix(in oklab, var(--bg) 96%, #000);
    border: 1px solid var(--border);
    border-radius: 10px;
    backdrop-filter: blur(8px);
  }
  .results[hidden] { display: none; }
  .results :global(li) {
    padding: 0.6rem 0.7rem;
    cursor: pointer;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }
  .results :global(li:last-child) { border-bottom: 0; }
  .results :global(li:hover),
  .results :global(li[aria-selected='true']) { background: color-mix(in oklab, var(--fg) 8%, transparent); }
  .results :global(.nm) { display: block; font-family: var(--font-label); font-size: 0.8rem; color: var(--fg); }
  .results :global(.dt) {
    display: block;
    font-family: var(--font-label);
    font-size: 0.62rem;
    color: var(--muted);
    margin-top: 0.1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .results :global(.kd) {
    float: right;
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--muted) 70%, transparent);
    margin-left: 0.6rem;
  }
  .results :global(.msg) { padding: 0.7rem; color: var(--muted); font-size: 0.74rem; cursor: default; }
  .results :global(.msg.err) { color: #e0603a; }

  /* ── Kept spots ───────────────────────────────────────────────────────────
     Shown in place of the search results while the field is empty, which is
     exactly the moment you are looking for somewhere you have already been. */

  .kept {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    z-index: 30;
  }
  .kept[hidden] { display: none; }
  .kept-head {
    margin: 0 0 0.3rem;
    font-family: var(--font-label);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* The list inside is `.results`, which is absolutely placed for the search
     box; here it is already in the right spot and must sit still. */
  .kept .results { position: static; }
  .kept :global(.drop-spot) {
    float: right;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1;
    padding: 0 0.2rem;
  }
  .kept :global(.drop-spot:hover) { color: #e0603a; }

  /* The star fills once the spot is kept — an outline you have to read is not
     a state you can see at a glance. */
  #star svg { fill: none; stroke: currentColor; stroke-width: 1.5; }
  #star[aria-pressed='true'] { color: #e8b33a; }
  #star[aria-pressed='true'] svg { fill: currentColor; stroke: currentColor; }
  #star[hidden] { display: none; }

  /* ── Undo ─────────────────────────────────────────────────────────────────
     A tap that moves the pin is fast, and fast is only safe if it is also
     reversible. */

  .toast {
    position: absolute;
    left: 50%;
    bottom: calc(7.5rem + var(--safe-bottom));
    transform: translateX(-50%);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.6rem 0.5rem 0.85rem;
    border-radius: 999px;
    font-family: var(--font-label);
    font-size: 0.68rem;
    color: var(--fg);
    background: color-mix(in oklab, var(--bg) 92%, #000);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }
  .toast[hidden] { display: none; }
  .toast-do {
    border: 0;
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    min-height: 28px;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Photo hotspots ───────────────────────────────────────────────────── */

  .photos {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    bottom: 0.9rem;
    z-index: 26;
    width: 21rem;
    max-width: calc(100vw - 1.8rem);
    display: flex;
    flex-direction: column;
    padding: 0.85rem;
    border-radius: 14px;
  }
  .photos[hidden] { display: none; }
  .photos-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.6rem; }
  .photos-title { margin: 0; font-family: var(--font-label); font-size: 0.82rem; color: var(--fg); }
  .photos-sub { margin: 0.15rem 0 0; font-family: var(--font-label); font-size: 0.62rem; color: var(--muted); }
  .photo-grid {
    flex: 1 1 auto;
    overflow-y: auto;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .photo-grid :global(li) {
