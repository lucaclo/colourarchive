---
import Layout from '../../layouts/Layout.astro';
import { readManifest } from '../../lib/manifest';
import { readBookCuration, curatedChapters } from '../../lib/book';
import { FOLD_STEPS } from '../../lib/zine/imposition';

// The magazine maker: an eight-page, one-sheet zine built from the archive,
// laid out the way Dirty Little Zine (dirtylittlezine.com) does it. Server-
// rendered like the book editor, for the book's own order. Everything after
// that happens in the browser: nothing is uploaded, and the zine is kept in
// this browser's storage between visits.
export const prerender = false;

const manifest = await readManifest();
const curation = await readBookCuration();
const chapters = curatedChapters(manifest.chapters, curation).map((ch) => ({
  name: ch.name,
  photos: ch.photos.map((p) => {
    const d = p.derivatives;
    return {
      id: p.id,
      w: p.width,
      h: p.height,
      small: d[0].avif,
      thumb: (d[1] ?? d[0]).avif,
      full: d[d.length - 1].avif,
    };
  }),
}));
---

<Layout title="Magazine — Colour Archive" tab="book">
  <script type="application/json" id="zn-data" is:inline set:html={JSON.stringify({ chapters })} />

  <main class="zn" id="zn">
    <header class="zn-top">
      <a class="zn-back" href="/book" aria-label="Back to the book">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        <span>The book</span>
      </a>
      <h1 class="zn-title">Magazine</h1>
      <div class="zn-tools">
        <div class="zn-seg" role="radiogroup" aria-label="Paper size" id="zn-paper">
          <button type="button" role="radio" data-paper="letter" aria-checked="false">Letter</button>
          <button type="button" role="radio" data-paper="a4" aria-checked="true">A4</button>
          <button type="button" role="radio" data-paper="a3" aria-checked="false">A3</button>
        </div>
        <button type="button" class="zn-btn" id="zn-colours">Colours</button>
        <button type="button" class="zn-btn" id="zn-preview">Preview</button>
        <button type="button" class="zn-btn zn-primary" id="zn-download">Download PDF</button>
      </div>
    </header>

    <nav class="zn-rail" aria-label="Pages">
      <ol id="zn-rail"></ol>
    </nav>

    <section class="zn-stage" id="zn-stage" aria-label="Page">
      <canvas id="zn-canvas" aria-hidden="true"></canvas>
      <p class="zn-stagehint" id="zn-stagehint" aria-live="polite"></p>
    </section>

    <section class="zn-edit" id="zn-edit" aria-label="Edit this page"></section>

    <footer class="zn-foot">
      <button type="button" class="zn-textbtn" id="zn-fold">How to fold</button>
      <button type="button" class="zn-textbtn" id="zn-frombook">Fill from book</button>
      <button type="button" class="zn-textbtn" id="zn-jpg">JPG</button>
      <button type="button" class="zn-textbtn zn-quiet" id="zn-reset">Start over</button>
    </footer>
  </main>

  <!-- Choosing a photo: the archive in book order, or a file from this device. -->
  <dialog class="zn-dialog zn-picker" id="zn-picker" aria-labelledby="zn-picker-title">
    <header class="zn-dhead">
      <h2 id="zn-picker-title">Choose a photo</h2>
      <label class="zn-btn zn-upload">
        From this device
        <input type="file" accept="image/*" id="zn-file" hidden />
      </label>
      <button type="button" class="zn-close" data-close aria-label="Close">×</button>
    </header>
    <div class="zn-pickgrid" id="zn-pickgrid"></div>
  </dialog>

  <!-- Flip through it as a reader would, or see the sheet as it prints. -->
  <dialog class="zn-dialog zn-viewer" id="zn-viewer" aria-label="Preview">
    <header class="zn-dhead">
      <div class="zn-seg" role="radiogroup" aria-label="Show" id="zn-viewmode">
        <button type="button" role="radio" data-mode="pages" aria-checked="true">Pages</button>
        <button type="button" role="radio" data-mode="sheet" aria-checked="false">The sheet</button>
      </div>
      <p class="zn-viewlabel" id="zn-viewlabel"></p>
      <button type="button" class="zn-close" data-close aria-label="Close">×</button>
    </header>
    <div class="zn-viewbody">
      <button type="button" class="zn-nav" id="zn-prev" aria-label="Previous page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <canvas id="zn-viewcanvas"></canvas>
      <button type="button" class="zn-nav" id="zn-next" aria-label="Next page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
    <p class="zn-viewnote" id="zn-viewnote"></p>
  </dialog>

  <dialog class="zn-dialog zn-fold" id="zn-folddlg" aria-labelledby="zn-fold-title">
    <header class="zn-dhead">
      <h2 id="zn-fold-title">How to fold it</h2>
      <button type="button" class="zn-close" data-close aria-label="Close">×</button>
    </header>
    <div class="zn-foldbody">
      <svg class="zn-folddiagram" viewBox="0 0 220 120" role="img" aria-label="The sheet: eight panels, top row upside down, cut across the middle two">
        <g class="sheet">
          <rect x="10" y="10" width="200" height="100" />
          <path d="M60 10v100M110 10v100M160 10v100M10 60h200" class="fold" />
          <path d="M60 60h100" class="cut" />
        </g>
        <g class="nums">
          <text x="35" y="35" transform="rotate(180 35 35)">7</text>
          <text x="85" y="35" transform="rotate(180 85 35)">6</text>
          <text x="135" y="35" transform="rotate(180 135 35)">5</text>
          <text x="185" y="35" transform="rotate(180 185 35)">4</text>
          <text x="35" y="85">back</text>
          <text x="85" y="85">cover</text>
          <text x="135" y="85">2</text>
          <text x="185" y="85">3</text>
        </g>
      </svg>
      <ol class="zn-steps">
        {FOLD_STEPS.map((s) => (
          <li><strong>{s.title}</strong> {s.body}</li>
        ))}
      </ol>
      <p class="zn-foldtip">Print at 100%, one side.</p>
    </div>
  </dialog>

  <dialog class="zn-dialog zn-confirm" id="zn-confirm" aria-labelledby="zn-confirm-title">
    <h2 id="zn-confirm-title"></h2>
    <p id="zn-confirm-body"></p>
    <div class="zn-confirm-row">
      <button type="button" class="zn-btn" data-close>Cancel</button>
      <button type="button" class="zn-btn zn-primary" id="zn-confirm-ok">Go ahead</button>
    </div>
  </dialog>

  <!-- A colour wheel for any text or paper colour, with the nearest colour in
       Wada's dictionary and the combinations it belongs to. -->
  <dialog class="zn-dialog zn-wheel" id="zn-wheel" aria-labelledby="zn-wheel-title">
    <header class="zn-dhead">
      <h2 id="zn-wheel-title">Text colour</h2>
      <button type="button" class="zn-close" data-close aria-label="Close">×</button>
    </header>
    <div class="zn-wheelbody">
      <div class="zn-wheelpick">
        <canvas id="zn-wheelcanvas" width="240" height="240" role="slider" tabindex="0" aria-label="Hue and strength"></canvas>
        <label class="zn-wheelrow"><span>Brightness</span><input type="range" id="zn-wheelv" min="0" max="100" aria-label="Brightness" /></label>
        <div class="zn-wheelrow">
          <span class="zn-wheelchip" id="zn-wheelchip"></span>
          <input id="zn-wheelhex" spellcheck="false" maxlength="7" aria-label="Hex colour" />
        </div>
      </div>
      <div class="zn-wheelside">
        <div class="zn-wheeltheory" id="zn-theorywrap" hidden>
          <p class="zn-wheelsub">Six from the book, by colour theory</p>
          <div id="zn-wheelkey"></div>
          <div class="zn-theorygrid" id="zn-wheeltheory"></div>
        </div>
        <p class="zn-wheelsub">Nearest in Wada’s dictionary</p>
        <button type="button" class="zn-wada" id="zn-wada"><span class="zn-wheelchip"></span><span class="zn-wadaname"></span><small></small></button>
        <p class="zn-wheelsub">It goes with</p>
        <div class="zn-goes" id="zn-goes"></div>
        <p class="zn-wheelnote">Tap a combination to keep its colours by every swatch.</p>
      </div>
    </div>
  </dialog>

  <!-- Wada's 348 combinations, ranked against the photographs in the zine. -->
  <dialog class="zn-dialog zn-pal" id="zn-pal" aria-labelledby="zn-pal-title">
    <header class="zn-dhead">
      <h2 id="zn-pal-title">Colour combinations</h2>
      <div class="zn-seg" role="radiogroup" aria-label="Show" id="zn-palmode">
        <button type="button" role="radio" data-mode="photos" aria-checked="true">For your photos</button>
        <button type="button" role="radio" data-mode="all" aria-checked="false">The whole book</button>
      </div>
      <button type="button" class="zn-close" data-close aria-label="Close">×</button>
    </header>
    <div class="zn-palbody">
      <div class="zn-palphotos" id="zn-palphotos"></div>
      <div class="zn-palcount" id="zn-palcount" hidden>
        <div class="zn-seg" role="radiogroup" aria-label="Colours in a combination">
          <button type="button" role="radio" data-count="0" aria-checked="true">All</button>
          <button type="button" role="radio" data-count="2" aria-checked="false">Two</button>
          <button type="button" role="radio" data-count="3" aria-checked="false">Three</button>
          <button type="button" role="radio" data-count="4" aria-checked="false">Four</button>
        </div>
      </div>
      <div class="zn-palgrid" id="zn-palgrid"></div>
    </div>
    <footer class="zn-palfoot">
      <p id="zn-palpicked">Pick a combination.</p>
      <button type="button" class="zn-textbtn zn-quiet" id="zn-palnone">None</button>
      <button type="button" class="zn-btn zn-primary" id="zn-palapply" disabled>Colour the whole zine</button>
    </footer>
    <p class="zn-palcredit">From Sanzo Wada, <cite>A Dictionary of Color Combinations</cite> (1933–34). Screen colours are approximate conversions of the book’s inks.</p>
  </dialog>

  <p class="zn-toast" id="zn-toast" role="status" hidden></p>
</Layout>

<style>
  /* ── Frame ───────────────────────────────────────────────────────────────
     Dirty Little Zine's layout: a bar across the top, the pages down the
     left, the page you're on large in the middle, and its controls beneath.
     On a phone the rail turns into a row under the page. */
  .zn {
    --rail: 9.5rem;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    grid-template-rows: auto minmax(18rem, 1fr) auto auto;
    grid-template-areas: 'top top' 'rail stage' 'rail edit' 'foot foot';
    min-height: 100dvh;
    padding-bottom: var(--tabbar-space);
  }
  .zn-top {
    grid-area: top; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    padding: calc(env(safe-area-inset-top, 0px) + 0.7rem) var(--edge) 0.7rem;
    border-bottom: 1px solid var(--separator);
  }
  .zn-back {
    display: inline-flex; align-items: center; gap: 0.2rem; min-height: var(--hit);
    color: var(--secondary); text-decoration: none; font-size: var(--t-footnote);
  }
  .zn-back svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .zn-back:hover { color: var(--fg); }
  .zn-title { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 1.6rem; line-height: 1; }
  .zn-tools { margin-left: auto; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }

  /* :global — the edit panel's segmented controls are built at runtime and
     never carry Astro's scoping attribute. */
  :global(.zn .zn-seg), .zn-seg { display: inline-flex; border: 1px solid var(--rule); border-radius: 2px; }
  :global(.zn .zn-seg button), .zn-seg button {
    appearance: none; border: 0; background: none; color: var(--secondary); cursor: pointer;
    font: inherit; font-size: var(--t-footnote); min-height: 2.5rem; padding: 0 0.85rem;
  }
  :global(.zn .zn-seg button + button), .zn-seg button + button { border-left: 1px solid var(--rule); }
  :global(.zn .zn-seg button[aria-checked='true']), .zn-seg button[aria-checked='true'] { background: var(--fg); color: var(--bg); }
  .zn-btn {
    appearance: none; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    min-height: 2.5rem; padding: 0 1rem; border-radius: 2px; cursor: pointer;
    font: inherit; font-size: var(--t-footnote); font-weight: 500;
    background: none; color: var(--fg); border: 1px solid var(--rule);
    transition: background 140ms var(--ease), border-color 140ms var(--ease), transform 110ms ease-out;
  }
  .zn-btn:hover { border-color: var(--fg); }
  .zn-btn:active { transform: scale(0.97); }
  .zn-btn:disabled { opacity: 0.45; cursor: default; }
  .zn-primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .zn-primary:hover { background: color-mix(in oklab, var(--fg) 86%, var(--bg)); }
  .zn-textbtn {
    appearance: none; background: none; border: 0; padding: 0; cursor: pointer; min-height: var(--hit);
    font-family: var(--font-display); font-style: italic; font-size: var(--t-note); color: var(--secondary);
    text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 5px;
  }
  .zn-textbtn:hover { color: var(--fg); text-decoration-color: currentColor; }
  .zn-quiet { color: var(--muted); }

  /* ── Rail ──────────────────────────────────────────────────────────── */
  .zn-rail { grid-area: rail; border-right: 1px solid var(--separator); overflow-y: auto; }
  .zn-rail ol { list-style: none; margin: 0; padding: 0.9rem 0.8rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .zn-rail :global(li) { position: relative; }
  .zn-rail :global(.zn-thumb) {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem; width: 100%;
    appearance: none; background: none; border: 0; padding: 0.35rem; cursor: pointer; color: var(--secondary);
    border-radius: 2px; transition: background 140ms var(--ease);
  }
  .zn-rail :global(.zn-thumb canvas) { display: block; max-width: 100%; box-shadow: 0 1px 4px rgb(0 0 0 / 0.35); }
  .zn-rail :global(.zn-thumb span) { font-family: var(--font-display); font-style: italic; font-size: var(--t-footnote); }
  .zn-rail :global(.zn-thumb:hover) { background: var(--fill); }
  .zn-rail :global(.zn-thumb[aria-current='true']) { background: var(--fill-active); color: var(--fg); }
  .zn-rail :global(.zn-thumb[aria-current='true'] canvas) { outline: 2px solid var(--fg); outline-offset: 2px; }
  .zn-rail :global(li[draggable='true'] .zn-thumb) { cursor: grab; }
  .zn-rail :global(li.dragging) { opacity: 0.4; }
  .zn-rail :global(li.drop-before)::before {
    content: ''; position: absolute; left: 0.4rem; right: 0.4rem; top: -0.5rem; height: 2px; background: var(--fg);
  }

  /* ── Stage ─────────────────────────────────────────────────────────── */
  .zn-stage {
    grid-area: stage; position: relative; display: flex; align-items: center; justify-content: center;
    min-height: 0; padding: 1.4rem; background: color-mix(in oklab, var(--fg) 9%, var(--bg));
  }
  .zn-stage canvas { display: block; touch-action: none; box-shadow: 0 2px 6px rgb(0 0 0 / 0.35), 0 18px 40px -16px rgb(0 0 0 / 0.6); }
  .zn-stage.over { outline: 2px dashed var(--fg); outline-offset: -10px; }
  .zn-stagehint {
    position: absolute; left: 50%; bottom: 0.3rem; transform: translateX(-50%); margin: 0; white-space: nowrap;
    font-family: var(--font-display); font-style: italic; font-size: var(--t-footnote); color: var(--muted);
  }

  /* ── Edit panel ────────────────────────────────────────────────────── */
  .zn-edit { grid-area: edit; border-top: 1px solid var(--separator); padding: 1rem var(--edge) 1.2rem; }
  .zn-edit :global(.zn-cols) { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 1.4rem; align-items: start; }
  .zn-edit :global(.zn-cols.one) { grid-template-columns: minmax(0, 1fr) auto; }
  .zn-edit :global(.zn-cover) { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 1.2rem; }
  .zn-edit :global(.zn-page) { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.6rem 1rem; align-content: start; }
  .zn-edit :global(.zn-page.wide) { grid-template-columns: 11rem minmax(0, 1fr); }
  .zn-edit :global(.zn-pagehead) {
    grid-column: 1 / -1; margin: 0; font-family: var(--font-display); font-style: italic; font-size: 1.05rem;
    display: flex; align-items: baseline; gap: 0.6rem;
  }
  .zn-edit :global(.zn-pagehead small) { font-family: var(--font-label); font-style: normal; font-size: var(--t-caption); color: var(--muted); }
  .zn-edit :global(.zn-mid) { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding-top: 2rem; }
  .zn-edit :global(.zn-wellcol) { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }

  /* The photo well: a crop-marked frame, like the drop zones on Inspiration. */
  .zn-edit :global(.zn-well) {
    position: relative; display: flex; align-items: center; justify-content: center; text-align: center;
    width: 100%; aspect-ratio: var(--page-aspect, 0.7); padding: 0.4rem; cursor: pointer; overflow: hidden;
    appearance: none; border: 1px solid var(--separator); border-radius: 0; color: var(--secondary);
    background: transparent;
    background-image: var(--cropmarks-image); background-size: var(--cropmarks-size);
    background-position: var(--cropmarks-pos); background-repeat: no-repeat;
    font-family: var(--font-display); font-style: italic; font-size: var(--t-footnote); line-height: 1.3;
  }
  .zn-edit :global(.zn-well.wide) { aspect-ratio: calc(var(--page-aspect, 0.7) * 2); }
  .zn-edit :global(.zn-well:hover), .zn-edit :global(.zn-well.over) { --mark: var(--fg); border-color: var(--rule); color: var(--fg); }
  .zn-edit :global(.zn-well img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .zn-edit :global(.zn-well .zn-change) {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 0.3rem; font-size: var(--t-caption);
    background: rgb(0 0 0 / 0.6); color: #fff; opacity: 0; transition: opacity 140ms;
  }
  .zn-edit :global(.zn-well:hover .zn-change), .zn-edit :global(.zn-well:focus-visible .zn-change) { opacity: 1; }
  @media (hover: none) { .zn-edit :global(.zn-well .zn-change) { opacity: 1; } }

  .zn-edit :global(.zn-fields) { display: grid; gap: 0.75rem; min-width: 0; }
  .zn-edit :global(.zn-row) { display: flex; flex-wrap: wrap; gap: 0.75rem 1.6rem; align-items: end; }
  .zn-edit :global(.zn-field) { display: grid; gap: 0.3rem; flex: 1 1 11rem; min-width: 0; }
  .zn-edit :global(.zn-field > span), .zn-edit :global(.zn-ctl > span) {
    font-family: var(--font-display); font-style: italic; font-size: var(--t-footnote); color: var(--secondary);
  }
  .zn-edit :global(.zn-field input), .zn-edit :global(.zn-field textarea) {
    width: 100%; background: transparent; color: var(--fg); border: 0; border-bottom: 1px solid var(--rule);
    border-radius: 0; padding: 0.4rem 0.05rem; font: inherit; font-size: 16px; resize: vertical;
  }
  .zn-edit :global(.zn-field textarea) { min-height: 2.6rem; }
  .zn-edit :global(.zn-field input:focus-visible), .zn-edit :global(.zn-field textarea:focus-visible) { outline: none; border-bottom-color: var(--fg); }
  .zn-edit :global(.zn-field input::placeholder), .zn-edit :global(.zn-field textarea::placeholder) { color: var(--muted); }
  .zn-edit :global(.zn-ctl) { display: grid; gap: 0.3rem; }
  .zn-edit :global(.zn-ctl .zn-seg button) { min-height: 2.25rem; padding: 0 0.7rem; }
  .zn-edit :global(.zn-ctl .zn-seg svg) { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; display: block; }
  .zn-edit :global(.zn-group) { display: grid; gap: 0.45rem; padding-top: 0.6rem; border-top: 1px solid var(--separator); }
  .zn-edit :global(.zn-grouphead) {
    margin: 0; font-family: var(--font-label); font-size: var(--t-caption); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
  }
  .zn-edit :global(.zn-chips) { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .zn-edit :global(.zn-chips button) {
    appearance: none; min-height: 2.25rem; padding: 0 0.75rem; cursor: pointer; font-size: 0.95rem;
    background: none; color: var(--secondary); border: 1px solid var(--rule); border-radius: 2px;
  }
  .zn-edit :global(.zn-chips button:hover) { border-color: var(--fg); color: var(--fg); }
  .zn-edit :global(.zn-chips button[aria-checked='true']) { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .zn-edit :global(.zn-ink) { display: flex; gap: 0.5rem; }
  .zn-edit :global(.zn-ink button) {
    width: 2.25rem; height: 2.25rem; border-radius: 50%; cursor: pointer; border: 1px solid var(--rule);
  }
  .zn-edit :global(.zn-ink button[aria-checked='true']) { outline: 2px solid var(--fg); outline-offset: 2px; }
  .zn-edit :global(.zn-icon) {
    appearance: none; display: grid; place-items: center; width: var(--hit); height: var(--hit); cursor: pointer;
    background: none; color: var(--fg); border: 1px solid var(--rule); border-radius: 2px;
  }
  .zn-edit :global(.zn-icon:hover) { border-color: var(--fg); }
  .zn-edit :global(.zn-icon svg) { width: 1.2rem; height: 1.2rem; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .zn-edit :global(.zn-midlabel) { font-family: var(--font-display); font-style: italic; font-size: var(--t-caption); color: var(--muted); margin-top: -0.35rem; }

  .zn-foot {
    grid-area: foot; display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 1.4rem;
    padding: 0.5rem var(--edge) 0.8rem; border-top: 1px solid var(--separator);
  }
  .zn-note { margin-left: auto; font-size: var(--t-caption); color: var(--muted); }

  /* ── Dialogs ───────────────────────────────────────────────────────── */
  .zn-dialog {
    border: 1px solid var(--rule); border-radius: 2px; padding: 0; color: var(--fg); background: var(--bg);
    max-width: min(60rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); width: 100%;
  }
  .zn-dialog::backdrop { background: rgb(0 0 0 / 0.72); }
  .zn-dhead {
    position: sticky; top: 0; z-index: 1; display: flex; align-items: center; gap: 0.8rem;
    padding: 0.8rem 1rem; background: var(--bg); border-bottom: 1px solid var(--separator);
  }
  .zn-dhead h2 { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 1.3rem; }
