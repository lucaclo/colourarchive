---
/**
 * The Updates panel, on every page (Layout.astro): whether this device runs
 * the newest build, where the Mac app is, and a way to update now. The Mac
 * app's window gets "Update now" (swap and relaunch); a phone, the iPad or a
 * browser gets "Reload" (drop the saved offline copy and load fresh).
 *
 * Opens from ⌘K ("Updates"), the Archive's top bar in an app window, and the
 * hash #updates (the Mac app's "Check for Updates…" sets it), which it then
 * removes. What shows is worked out in src/lib/updates.ts; this file only
 * asks the server and draws it.
 *
 * Also, once per load, each page the Mac serves tells it which device it is
 * and which build it has (POST /api/devices), and reloads itself when it
 * comes back to the screen and the Mac serves a newer build.
 *
 * `hidden` while closed, not just un-[open]: lib/ui/modal.ts and the
 * Archive's scroll treat any `[data-modal]` without `hidden` as an open
 * overlay.
 */
---

<button type="button" class="updates-cmdk" hidden data-updates-open data-cmdk="Updates" data-cmdk-always data-cmdk-keywords="update, version, reload">Updates</button>
<dialog class="updates" id="updates" aria-labelledby="updates-title" data-modal data-backdrop-close hidden tabindex="-1">
  <div class="updates-in">
    <header class="updates-head">
      <h2 class="updates-title" id="updates-title">Updates</h2>
      <button type="button" class="updates-close" id="updates-close" aria-label="Close">×</button>
    </header>
    <div class="updates-body" id="updates-body"></div>
  </div>
</dialog>

<style is:global>
  /* Like the Book's Similar shots (book.astro .survey). Rows are built at
     runtime, so these are global, all under .updates. */
  .updates {
    width: min(92vw, 26rem); max-width: none; max-height: 92svh; padding: 0;
    border: 1px solid var(--glass-edge); border-radius: var(--r-lg);
    background: var(--bg); color: var(--fg);
  }
  .updates::backdrop { background: rgb(0 0 0 / 0.72); }
  .updates:focus { outline: none; }
  .updates-head { display: flex; align-items: center; gap: 1rem; padding: 1rem 1rem 0 1.4rem; }
  .updates-title { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 1.4rem; }
  .updates-close {
    margin-left: auto; appearance: none; cursor: pointer; border: 0; border-radius: 50%;
    width: var(--hit); height: var(--hit); background: var(--fill); color: var(--fg); font-size: 1.2rem;
  }
  .updates-close:focus-visible, .updates-link:focus-visible { outline: 2px solid var(--accent-mix); outline-offset: 2px; }
  .updates-body { padding: 0.25rem 1.4rem 1.4rem; }
  .updates-sec + .updates-sec { margin-top: 1.1rem; }
  .updates-sec-title {
    margin: 0.6rem 0 0.4rem; font-family: var(--font-display); font-style: italic; font-weight: 500;
    font-size: var(--t-footnote); color: var(--secondary);
  }
  .updates-rows { margin: 0; }
  .updates-row {
    display: grid; grid-template-columns: 6rem minmax(0, 1fr) auto; align-items: baseline; gap: 0.75rem;
    padding: 0.6rem 0; border-top: 1px solid var(--separator);
  }
  .updates-row:last-child { border-bottom: 1px solid var(--separator); }
  .updates-row dt { font-family: var(--font-ui); font-size: var(--t-caption); color: var(--muted); }
  .updates-row dd { margin: 0; }
  .updates-value { font-family: var(--font-data); font-style: normal; font-size: var(--t-footnote); color: var(--fg); overflow-wrap: anywhere; }
  .updates-note { font-family: var(--font-ui); font-size: var(--t-caption); color: var(--secondary); text-align: right; }
  /* "Show in Finder": a word, not a capsule; its target still reaches --hit. */
  .updates-link {
    position: relative; appearance: none; cursor: pointer; border: 0; padding: 0; background: none;
    font: inherit; color: var(--fg); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px;
  }
  .updates-link:hover { text-decoration-color: currentColor; }
  .updates-link::after { content: ''; position: absolute; left: -8px; right: -8px; top: 50%; height: var(--hit); translate: 0 -50%; }
  .updates-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem; }
  @media (max-width: 600px) {
    .updates { width: calc(100vw - 32px); }
    .updates-head { padding-left: 1.1rem; }
    .updates-body { padding: 0.25rem 1.1rem 1.1rem; }
    .updates-row { grid-template-columns: 5.25rem minmax(0, 1fr) auto; gap: 0.6rem; }
  }
</style>

<script>
  import { BUILD } from '../lib/build-info';
  import { inAppWindow, inMacApp } from '../lib/install';
  import {
    deviceName,
    keepPressed,
    newDeviceId,
    panelSections,
    POLL_MS,
    shouldCheck,
    shouldPoll,
    UPDATES_HASH,
    validDeviceId,
    type Action,
    type Section,
    type UpdatesReply,
    type Where,
  } from '../lib/updates';

  const STATIC = import.meta.env.PUBLIC_STATIC === 'true';
  const where: Where = STATIC ? 'published' : inMacApp() ? 'mac-app' : 'served';
  const device = deviceName(navigator.userAgent, navigator.maxTouchPoints);

  const dlg = document.getElementById('updates') as HTMLDialogElement;
  const body = document.getElementById('updates-body') as HTMLElement;

  let reply: UpdatesReply | null = null;
  let live: string | null | undefined;
  let pressed = false;
  let timer = 0;
  let drawn = '';
  let lastError: string | null = null;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  function sectionEl(s: Section, i: number): HTMLElement {
    const sec = el('section', 'updates-sec');
    const head = el('h3', 'updates-sec-title', s.title);
    head.id = `updates-s${i}`;
    sec.setAttribute('aria-labelledby', head.id);
    const dl = el('dl', 'updates-rows');
    for (const r of s.rows) {
      const row = el('div', 'updates-row');
      const value = el('dd', 'updates-value', r.value ?? '');
      if (r.title) value.title = r.title;
      row.append(el('dt', '', r.label), value);
      if (r.status) row.append(el('dd', 'updates-note', r.status));
      if (r.reveal) {
        const dd = el('dd', 'updates-note');
        const show = el('button', 'updates-link', 'Show in Finder');
        show.type = 'button';
        show.dataset.key = `${i}:reveal`;
        show.addEventListener('click', () => void post({ do: 'reveal' }));
        dd.append(show);
        row.append(dd);
      }
      dl.append(row);
    }
    sec.append(head, dl);
    if (s.actions.length) {
      const bar = el('div', 'updates-actions');
      s.actions.forEach((a, j) => {
        const b = el('button', a.primary ? 'btn btn-primary' : 'btn btn-outline', a.label);
        b.type = 'button';
        b.disabled = a.disabled;
        b.dataset.key = `${i}:act:${j}`;
        b.addEventListener('click', () => void act(a));
        bar.append(b);
      });
      sec.append(bar);
    }
    return sec;
  }

  /** Redraw only when something changed, and keep focus on the same control. */
  function render() {
    const sections = panelSections({ where, device, page: BUILD, reply, live, pressed });
    const next = JSON.stringify(sections);
    if (next === drawn) return;
    drawn = next;
    const focused = body.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.key : undefined;
    body.replaceChildren(...sections.map(sectionEl));
    if (focused === undefined) return;
    const again = body.querySelector<HTMLButtonElement>(`[data-key="${focused}"]`);
    if (again && !again.disabled) again.focus();
    else dlg.focus();
  }

  async function post(ask: { do: 'check' | 'install' | 'reveal'; page?: string }): Promise<boolean> {
    try {
      const res = await fetch('/api/updates', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(ask) });
      if (res.ok) return true;
      console.warn(`[updates] ${ask.do}: ${res.status}`, await res.text().catch(() => ''));
    } catch (err) {
      console.warn(`[updates] ${ask.do}`, err);
    }
    return false;
  }

  async function refresh() {
    try {
      const res = await fetch('/api/updates', { cache: 'no-store' });
      if (!res.ok) throw new Error(`${res.status}`);
      reply = (await res.json()) as UpdatesReply;
      pressed = keepPressed(reply.app, pressed);
      const error = reply.app?.state === 'error' ? reply.app.error : null;
      if (error && error !== lastError) console.warn('[updates] the Mac couldn’t check:', error);
      lastError = error;
    } catch (err) {
      console.warn('[updates] couldn’t ask the Mac', err);
    }
    render();
  }

  /** Ask again in POLL_MS while something is moving (or once, after asking for something). */
  function schedule(force = false) {
    clearTimeout(timer);
    if (!dlg.open) return;
    if (!force && !shouldPoll(reply?.app, pressed)) return;
    timer = window.setTimeout(async () => {
      await refresh();
      schedule();
    }, POLL_MS);
  }

  async function liveBuild(): Promise<string | null> {
    try {
      const res = await fetch('/publish.json', { cache: 'no-store' });
      if (!res.ok) return null;
      const stamp = await res.json();
      return typeof stamp?.builtAt === 'string' ? stamp.builtAt : null;
    } catch {
      return null;
    }
  }

  /** Drop the saved offline copy, then load the page fresh. Reloads whatever fails. */
  async function reloadFresh() {
    try {
      const regs = await navigator.serviceWorker.getRegistrations();
      await Promise.all(regs.map((r) => r.unregister()));
    } catch (err) {
      console.warn('[updates] service worker', err);
    }
    try {
      const keys = await caches.keys();
      await Promise.all(keys.map((k) => caches.delete(k)));
    } catch (err) {
      console.warn('[updates] caches', err);
    }
    location.reload();
  }

  async function act(a: Action) {
    if (a.do === 'reload') return reloadFresh();
    if (a.do === 'install') {
      pressed = true;
      render();
      if (!(await post({ do: 'install', page: location.pathname + location.search }))) {
        pressed = false;
        render();
        return;
      }
    } else if (!(await post({ do: 'check' }))) {
      return;
    }
    schedule(true);
  }

  async function open() {
    if (dlg.open) return;
    pressed = false;
    dlg.hidden = false;
    dlg.showModal();
    // Like the lightbox: the dialog itself takes focus, not its first control,
    // so opening from the menu or ⌘K draws no ring on the close button. Tab
    // still reaches every control.
    dlg.focus();
    if (where === 'published') {
      live = undefined;
      render();
      live = await liveBuild();
      render();
      return;
    }
    render();
    await refresh();
    if (!dlg.open) return;
    if (shouldCheck(reply?.app) && (await post({ do: 'check' }))) schedule(true);
    else schedule();
  }

  dlg.addEventListener('close', () => {
    clearTimeout(timer);
    dlg.hidden = true;
  });
  // A press on the backdrop closes it: data-backdrop-close (lib/ui/backdrop.ts).
  document.getElementById('updates-close')?.addEventListener('click', () => dlg.close());
  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest?.('[data-updates-open]')) void open();
  });

  /** #updates opens the panel and goes; any other hash (#chapter=…) is left alone. */
  function fromHash() {
    if (location.hash !== UPDATES_HASH) return;
    history.replaceState(history.state, '', location.pathname + location.search);
    void open();
  }
  fromHash();
  addEventListener('hashchange', fromHash);

  /** This device's id, kept in its own storage; null when storage is blocked. */
  function deviceId(): string | null {
    try {
      const kept = localStorage.getItem('ca-device-id');
      if (validDeviceId(kept)) return kept;
      const id = newDeviceId(crypto.getRandomValues(new Uint8Array(16)));
      localStorage.setItem('ca-device-id', id);
      return id;
    } catch {
      return null;
    }
  }
  // Pages the Mac serves, but not its own window: say once per load which
  // device this is and which build it has, for the Phones and iPads list.
  if (!STATIC && !inMacApp()) {
    const id = deviceId();
    if (id) {
      fetch('/api/devices', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, name: device, standalone: inAppWindow(), builtAt: BUILD.builtAt }),
      }).catch(() => {});
    }
  }

  // A page the Mac serves, left open, keeps the build it was loaded with; when
  // it comes back to the screen and the Mac serves a newer one, load that.
  // (The published site has its own check in Layout.astro.)
  if (!STATIC && !import.meta.env.DEV) {
    document.addEventListener('visibilitychange', async () => {
      if (document.visibilityState !== 'visible') return;
      try {
        const res = await fetch('/api/build', { cache: 'no-store' });
        const now = res.ok ? await res.json() : null;
        if (typeof now?.builtAt === 'string' && now.builtAt !== BUILD.builtAt) location.reload();
      } catch {
        /* the Mac isn't answering: keep this page */
      }
    });
  }
</script>
