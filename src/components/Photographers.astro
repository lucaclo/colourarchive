<script>
  import { canFetch, creditLabel, linkLabel, type ProfileLink, type WorkItem } from '../lib/photographers/kinds';

  interface Person { id: string; name: string; favourite: boolean; links: ProfileLink[]; seenAt?: string }
  interface Item extends WorkItem { mark: 'pinned' | 'passed' | null; isNew: boolean }
  interface Suggestion { key: string; name: string; link: ProfileLink; thumbs: { src: string; url: string }[]; reason: string; traits: string[]; via: string }

  const data = JSON.parse(document.getElementById('ph-data')?.textContent || '{}') as {
    people: { id: string; name: string; favourite: boolean }[];
    refs: { id: string; thumb: string; credit?: string }[];
    similar: string[][];
    instagram: { username: string } | null;
  };
  const igConnected = () => Boolean(data.instagram);
  // A link new work can be read from now; Instagram only once connected.
  const readableLink = (l: ProfileLink) => canFetch(l.kind) || (l.kind === 'instagram' && igConnected());
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  /** Build an element without innerHTML: names and captions come from other
   *  people's sites, so they only ever go in as text. */
  function h<K extends keyof HTMLElementTagNameMap>(
    tag: K, attrs: Record<string, string | boolean | undefined> = {}, ...kids: (Node | string | null | undefined | false)[]
  ): HTMLElementTagNameMap[K] {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (v === undefined || v === false) continue;
      if (k === 'class') el.className = String(v);
      else el.setAttribute(k, v === true ? '' : v);
    }
    for (const k of kids) if (k !== null && k !== undefined && k !== false) el.append(k);
    return el;
  }

  async function api<T = Record<string, unknown>>(path: string, body?: unknown): Promise<T & { ok: boolean; error?: string }> {
    const res = await fetch(path, body === undefined ? undefined : { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const out = await res.json().catch(() => ({ ok: false, error: `The app answered ${res.status}.` }));
    return out;
  }
  const act = (action: string, rest: Record<string, unknown> = {}) => api<{ photographer?: Person }>('/api/photographers', { action, ...rest });

  // Changes to who's credited or starred move tiles between groups that the
  // server builds, so the board reloads on close — keeping its place, the
  // same way the board's own Add does (inspiration.astro, "insp-resume").
  let dirty = false;
  function reloadKeepingPlace() {
    try { sessionStorage.setItem('insp-resume', JSON.stringify({ y: window.scrollY, source: '', newIds: [] })); } catch { /* private mode */ }
    location.reload();
  }

  let openCount = 0;
  function show(el: HTMLElement) {
    el.hidden = false;
    if (openCount++ === 0) document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => el.classList.add('show'));
  }
  function hide(el: HTMLElement) {
    if (el.hidden) return;
    el.classList.remove('show');
    openCount = Math.max(0, openCount - 1);
    if (!openCount) document.body.style.overflow = '';
    setTimeout(() => { el.hidden = true; }, 180);
  }

  const dateWords = (iso?: string | null) => {
    if (!iso) return '';
    const d = new Date(iso);
    return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', ...(d.getFullYear() !== new Date().getFullYear() ? { year: 'numeric' } : {}) });
  };

  /* ── Shelf ─────────────────────────────────────────────────────────── */

  const addToggle = $('ph-add-toggle');
  const addRow = $<HTMLFormElement>('ph-addrow');
  const addInput = $<HTMLInputElement>('ph-add-input');
  const shelfNote = $('ph-shelf-note');

  const setAddRow = (open: boolean) => {
    addRow.hidden = !open;
    addToggle.setAttribute('aria-expanded', String(open));
    if (open) addInput.focus();
  };
  addToggle.addEventListener('click', () => setAddRow(addRow.hidden));
  // Escape closes it, like every other panel in the app, unless something
  // on top of it (a sheet, a dialog) is the thing Escape is for.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || addRow.hidden || e.defaultPrevented) return;
    if ([...document.querySelectorAll<HTMLElement>('dialog[open], [role="dialog"]')].some((d) => d.checkVisibility())) return;
    setAddRow(false);
    addToggle.focus();
  });
  addRow.addEventListener('submit', async (e) => {
    e.preventDefault();
    const raw = addInput.value.trim();
    if (!raw) return;
    shelfNote.hidden = false;
    shelfNote.textContent = /^https?:/i.test(raw) ? 'Reading their profile…' : 'Adding…';
    const r = await act('add', /^https?:/i.test(raw) ? { link: raw } : { name: raw });
    if (!r.ok || !r.photographer) { shelfNote.textContent = r.error || 'That did not work.'; return; }
    shelfNote.hidden = true;
    addInput.value = '';
    dirty = true;
    void openPhotographer(r.photographer.id);
  });

  document.getElementById('ph-empty')?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-ph]');
    if (chip) void openPhotographer(chip.dataset.ph!);
  });
  document.getElementById('ph-row')?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-ph]');
    if (card) void openPhotographer(card.dataset.ph!);
  });

  // How much is new from each favourite, fetched after the board is up.
  if (document.querySelector('[data-new]')) {
    void api<{ counts: Record<string, number>; covers: Record<string, string> }>('/api/photographers/work?news=1').then((r) => {
      if (!r.ok) return;
      for (const [id, n] of Object.entries(r.counts)) {
        const el = document.querySelector<HTMLElement>(`[data-new="${CSS.escape(id)}"]`);
        if (el && n > 0) { el.hidden = false; el.textContent = `${n} new`; }
      }
      for (const [id, src] of Object.entries(r.covers)) {
        const cover = document.querySelector(`[data-ph="${CSS.escape(id)}"] .ph-cover`);
        if (cover && !cover.querySelector('img')) cover.append(h('img', { src, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' }));
      }
    }).catch(() => {});
  }

  /* ── One photographer ──────────────────────────────────────────────── */

  const sheet = $('ph-sheet');
  let current: Person | null = null;
  let items: Item[] = [];
  let showPassed = false;

  async function people(): Promise<{ photographers: Person[]; credits: Record<string, string> }> {
    const r = await api<{ photographers: Person[]; credits: Record<string, string> }>('/api/photographers');
    return { photographers: r.photographers ?? [], credits: r.credits ?? {} };
  }

  async function openPhotographer(id: string) {
    const { photographers, credits } = await people();
    const p = photographers.find((x) => x.id === id);
    if (!p) return;
    current = p;
    items = [];
    showPassed = false;
    renderHead(p);
    renderYours(Object.entries(credits).filter(([, who]) => who === id).map(([ref]) => ref));
    for (const s of ['ph-new', 'ph-more', 'ph-find'] as const) $(s).hidden = true;
    $('ph-end').hidden = true;
    $('ph-status').textContent = '';
    show(sheet);
    $('ph-scroll').scrollTop = 0;

    void api<{ words: string[] }>(`/api/photographers/look?id=${encodeURIComponent(id)}`).then((r) => {
      if (current?.id === id) $('ph-look').textContent = r.ok ? r.words.join(' · ') : '';
    });
    if (p.links.some(readableLink)) await loadWork(id);
    else void loadFind(id);
  }

  function renderHead(p: Person) {
    $('ph-name').textContent = p.name;
    $('ph-rename').hidden = true;
    $('ph-name').hidden = false;
    const star = $('ph-star');
    star.setAttribute('aria-pressed', String(p.favourite));
    star.textContent = p.favourite ? '★ Favourite' : '☆ Favourite';
    const links = $('ph-links');
    links.replaceChildren(...p.links.flatMap((l, i) => [
      i ? ' · ' : '',
      h('a', { href: l.url, target: '_blank', rel: 'noopener noreferrer' }, `${linkLabel(l)} ↗`),
      h('button', { type: 'button', class: 'ph-unlink', 'data-unlink': l.url, 'aria-label': `Unlink ${linkLabel(l)}` }, '×'),
    ]));
    $('ph-linkrow').hidden = true;
    $('ph-ig-connect-here').hidden = igConnected() || !p.links.some((l) => l.kind === 'instagram');
    $('ph-addlink').setAttribute('aria-expanded', 'false');
    $('ph-look').textContent = '';
  }

  function renderYours(refIds: string[]) {
    const sec = $('ph-yours');
    const list = sec.querySelector('ul')!;
    const refs = refIds.map((id) => data.refs.find((r) => r.id === id)).filter((r): r is NonNullable<typeof r> => Boolean(r));
    sec.hidden = !refs.length;
    sec.querySelector('.n')!.textContent = String(refs.length);
    list.replaceChildren(...refs.map((r) => h('li', {}, h('img', { src: r.thumb, alt: '', loading: 'lazy' }))));
    const match = $('ph-match');
    match.hidden = !refs.length;
    match.dataset.ids = refs.map((r) => r.id).join(',');
  }

  async function loadWork(id: string, force = false) {
    $('ph-status').textContent = 'Fetching their work…';
    const r = await api<{ items: Item[]; seenAt: string | null; errors: string[] }>(`/api/photographers/work?id=${encodeURIComponent(id)}${force ? '&force=1' : ''}`);
    if (current?.id !== id) return;
    if (!r.ok) { $('ph-status').textContent = r.error || 'Their work could not be read.'; return; }
    items = r.items;
    renderWork(r.seenAt);
    $('ph-status').textContent = r.errors.length && !items.length ? r.errors[0] : !items.length ? 'Nothing public to show yet.' : '';
    // What's on screen now is no longer new next time.
    void act('seen', { id });
  }

  function itemCell(it: Item): HTMLLIElement {
    const pinned = it.mark === 'pinned';
    const li = h('li', { class: `ph-item${pinned ? ' pinned' : ''}`, 'data-key': it.key },
      h('button', { type: 'button', class: 'ph-thumb', 'aria-label': it.title ? `View: ${it.title}` : 'View' },
        h('img', { src: it.thumb, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' })),
      h('button', { type: 'button', class: 'ph-pin', disabled: pinned, 'aria-label': pinned ? 'Pinned' : 'Pin to the board' }, pinned ? 'Pinned' : 'Pin'),
      pinned ? null : h('button', { type: 'button', class: 'ph-pass', 'aria-label': 'Pass' }, '×'),
    );
    // A picture the site no longer serves is left out, not shown broken.
    li.querySelector('img')?.addEventListener('error', () => li.remove(), { once: true });
    return li;
  }

  function renderWork(seenAt: string | null) {
    const visible = items.filter((i) => i.mark !== 'passed' || showPassed);
    const fresh = visible.filter((i) => i.isNew);
    const rest = visible.filter((i) => !i.isNew);
    const newSec = $('ph-new'), moreSec = $('ph-more');
    newSec.hidden = !fresh.length;
    newSec.querySelector('.n')!.textContent = String(fresh.length);
    newSec.querySelector('ul')!.replaceChildren(...fresh.map(itemCell));
    // The feed ends. Glass's fans and Cosmos's critics agree on that one.
    const end = $('ph-end');
    end.hidden = !fresh.length || !seenAt;
    end.textContent = seenAt ? `That's everything since ${dateWords(seenAt)}` : '';
    moreSec.hidden = !rest.length;
    moreSec.querySelector('h3')!.firstChild!.textContent = fresh.length ? 'Earlier ' : 'Their work ';
    moreSec.querySelector('.n')!.textContent = String(rest.length);
    moreSec.querySelector('ul')!.replaceChildren(...rest.map(itemCell));
    const passed = items.filter((i) => i.mark === 'passed').length;
    const passedBtn = $('ph-passed');
    passedBtn.hidden = !passed;
    passedBtn.textContent = showPassed ? 'Hide passed' : `${passed} passed`;
    if (!fresh.length && !rest.length && passed) moreSec.hidden = false;
  }

  $('ph-passed').addEventListener('click', () => { showPassed = !showPassed; renderWork(current?.seenAt ?? null); });

  // Pins still on their way. Closing the sheet waits for them, so the board
  // it reloads into has them on it.
  const pending = new Set<Promise<unknown>>();

  async function pin(key: string, cell?: Element | null) {
    if (!current) return;
    // Shown pinned at once: adding runs the board's whole colour pipeline,
    // which takes a few seconds. Put back if it fails.
    const it = items.find((i) => i.key === key);
    if (it?.mark === 'pinned') return;
    const was = it?.mark ?? null;
    if (it) it.mark = 'pinned';
    const btn = cell?.querySelector<HTMLButtonElement>('.ph-pin');
    if (btn) { btn.disabled = true; btn.textContent = 'Pinned'; }
    cell?.classList.add('pinned');
    cell?.querySelector('.ph-pass')?.remove();
    if (viewKey === key) syncView();
    dirty = true;
    const req = api<{ refId: string }>('/api/photographers/pin', { id: current.id, key });
    pending.add(req);
    const r = await req.finally(() => pending.delete(req));
    if (r.ok) return;
    if (it) it.mark = was;
    if (current) renderWork(current.seenAt ?? null);
    if (viewKey === key) syncView();
    $('ph-status').textContent = r.error || 'That one could not be pinned.';
  }


  async function pass(key: string) {
    if (!current) return;
    const it = items.find((i) => i.key === key);
    if (it) it.mark = 'passed';
    renderWork(current.seenAt ?? null);
    void act('mark', { id: current.id, key, mark: 'passed' });
  }

  const coarse = matchMedia('(hover: none), (pointer: coarse)');
  for (const id of ['ph-new', 'ph-more']) {
    $(id).addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const cell = t.closest<HTMLElement>('.ph-item');
      if (!cell) return;
      const key = cell.dataset.key!;
      if (t.closest('.ph-pin')) void pin(key, cell);
      else if (t.closest('.ph-pass')) void pass(key);
      else if (t.closest('.ph-thumb')) {
        // Touch: the first tap shows Pin and ×, the next enlarges, like the board's tiles.
        if (coarse.matches && !cell.classList.contains('is-active')) {
          for (const other of document.querySelectorAll('.ph-item.is-active')) other.classList.remove('is-active');
          cell.classList.add('is-active');
          return;
        }
        openView(key);
      }
    });
  }

  // Enlarged, inside the sheet; ← → walk the feed.
  const view = $('ph-view');
  let viewKey: string | null = null;
  const viewable = () => items.filter((i) => i.mark !== 'passed' || showPassed);
  function syncView() {
    const it = items.find((i) => i.key === viewKey);
    if (!it) return;
    const img = $<HTMLImageElement>('ph-view-img');
    img.src = it.thumb;
    // The large one replaces the thumbnail once it has arrived.
    const big = new Image();
    big.referrerPolicy = 'no-referrer';
    big.onload = () => { if (viewKey === it.key) img.src = it.full; };
    big.src = it.full;
    img.alt = it.title ?? '';
    $<HTMLAnchorElement>('ph-view-post').href = it.url;
    const pinBtn = $<HTMLButtonElement>('ph-view-pin');
    pinBtn.disabled = it.mark === 'pinned';
    pinBtn.textContent = it.mark === 'pinned' ? 'Pinned' : 'Pin';
    $('ph-view-pass').hidden = it.mark === 'pinned';
  }
  function openView(key: string) { viewKey = key; syncView(); view.hidden = false; $('ph-view-close').focus(); }
  function closeView() { view.hidden = true; viewKey = null; }
  function step(d: number) {
    const list = viewable();
    const i = list.findIndex((x) => x.key === viewKey);
    const next = list[i + d];
    if (next) { viewKey = next.key; syncView(); }
  }
  $('ph-view-close').addEventListener('click', closeView);
  $('ph-view-pin').addEventListener('click', () => { if (viewKey) void pin(viewKey, document.querySelector(`.ph-item[data-key="${CSS.escape(viewKey)}"]`)); });
  $('ph-view-pass').addEventListener('click', () => { if (!viewKey) return; const k = viewKey; step(1); if (viewKey === k) closeView(); void pass(k); });

  // Find their work elsewhere: for a name or an Instagram handle.
  async function loadFind(id: string) {
    const sec = $('ph-find');
    const list = $('ph-find-list');
    sec.hidden = false;
    list.replaceChildren(h('li', { class: 'ph-note' }, 'Looking for their site and profiles…'));
    const r = await api<{ options: { name: string; note?: string; link: ProfileLink; thumbs: string[]; sure?: boolean }[] }>(`/api/photographers/find?id=${encodeURIComponent(id)}`);
    if (current?.id !== id) return;
    // Their own site at their own name: linked straight away, and the × by
    // the link undoes it. Anything less certain waits for "This is them".
    const sure = r.ok ? r.options.find((o) => o.sure) : undefined;
    if (sure) {
      const res = await act('link', { id, link: sure.link });
      if (res.ok && res.photographer && current?.id === id) {
        dirty = true; current = res.photographer; renderHead(current);
        r.options = r.options.filter((o) => o !== sure);
        await loadWork(id, true);
        if (!r.options.length) { sec.hidden = true; return; }
      }
    }
    if (!r.ok || !r.options.length) {
      list.replaceChildren(h('li', { class: 'ph-note' }, 'Nothing found. Paste a link with + link.'));
      return;
    }
    list.replaceChildren(...r.options.map((o, i) => h('li', { class: 'ph-find' },
      o.thumbs.length
        ? h('div', { class: 'ph-find-thumbs' }, ...o.thumbs.map((src) => h('img', { src, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' })))
        : h('div', { class: 'ph-find-thumbs ph-find-empty' }, 'opens on Instagram'),
      h('div', { class: 'ph-find-text' },
        h('a', { href: o.link.url, target: '_blank', rel: 'noopener noreferrer', class: 'ph-find-name' }, o.name),
        h('span', { class: 'ph-find-note' }, `${linkLabel(o.link)}${o.note ? ` · ${o.note}` : ''}`)),
      h('button', { type: 'button', class: 'ph-pinbtn', 'data-find': String(i) }, 'This is them'),
    )));
    list.onclick = async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-find]');
      if (!btn || !current) return;
      btn.disabled = true;
      const res = await act('link', { id: current.id, link: r.options[Number(btn.dataset.find)].link });
      if (res.ok && res.photographer) { dirty = true; current = res.photographer; renderHead(current); sec.hidden = true; await loadWork(current.id, true); }
      else btn.disabled = false;
    };
  }

  // Header controls.
  $('ph-star').addEventListener('click', async () => {
    if (!current) return;
    const r = await act('favourite', { id: current.id, on: !current.favourite });
    if (r.ok && r.photographer) { dirty = true; current = r.photographer; renderHead(current); }
  });
  $('ph-name').addEventListener('click', () => {
    if (!current) return;
    $('ph-name').hidden = true;
    $('ph-rename').hidden = false;
    const input = $<HTMLInputElement>('ph-rename-input');
    input.value = current.name;
    input.focus();
    input.select();
  });
  $('ph-rename').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!current) return;
    const r = await act('rename', { id: current.id, name: $<HTMLInputElement>('ph-rename-input').value });
    if (r.ok && r.photographer) { dirty = true; current = r.photographer; }
    renderHead(current);
  });
  $('ph-addlink').addEventListener('click', () => {
    const row = $('ph-linkrow');
    row.hidden = !row.hidden;
    $('ph-addlink').setAttribute('aria-expanded', String(!row.hidden));
    if (!row.hidden) $('ph-link-input').focus();
  });
  $('ph-linkrow').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!current) return;
    const input = $<HTMLInputElement>('ph-link-input');
    $('ph-status').textContent = 'Reading their profile…';
    const r = await act('link', { id: current.id, link: input.value });
    if (!r.ok || !r.photographer) { $('ph-status').textContent = r.error || 'That link could not be read.'; return; }
    input.value = '';
    dirty = true;
    current = r.photographer;
    renderHead(current);
    $('ph-find').hidden = true;
    await loadWork(current.id, true);
  });
  $('ph-links').addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-unlink]');
    if (!btn || !current) return;
    const r = await act('unlink', { id: current.id, url: btn.dataset.unlink });
    if (r.ok && r.photographer) { dirty = true; current = r.photographer; renderHead(current); await loadWork(current.id, true); }
  });
  $('ph-match').addEventListener('click', () => {
    const ids = ($('ph-match').dataset.ids || '').split(',').filter(Boolean);
    if (!ids.length) return;
    // Closed without the reload a change would bring: that would take the
    // workbench down with it.
    closeView();
    hide(sheet);
    current = null;
    // Style Match lives in the page's other script; it listens for this.
    window.dispatchEvent(new CustomEvent('insp:match', { detail: { ids } }));
  });
  let removeArmed = false;
  $('ph-remove').addEventListener('click', async () => {
    if (!current) return;
    const btn = $('ph-remove');
    if (!removeArmed) {
      removeArmed = true;
      btn.textContent = 'Remove them and their credits?';
      setTimeout(() => { removeArmed = false; btn.textContent = 'Remove'; }, 3000);
      return;
    }
    await act('remove', { id: current.id });
    dirty = true;
    void closeSheet();
  });

  async function closeSheet() {
    closeView();
    hide(sheet);
    current = null;
    if (pending.size) await Promise.allSettled([...pending]);
    if (dirty) reloadKeepingPlace();
  }
  $('ph-close').addEventListener('click', () => void closeSheet());
  sheet.addEventListener('click', (e) => { if (e.target === sheet) void closeSheet(); });

  /* ── More of their work, wherever a name or link went in ──────────── */

  // A credit typed, inferred from a shared link, or picked in "Who took
  // these?" — the board reloads after each, so who it was is carried across
  // (sessionStorage) and offered here, under the shelf.
  const CREDITED_KEY = 'ph-credited';
  function rememberCredited(p?: { id: string; name: string } | null) {
    try { if (p) sessionStorage.setItem(CREDITED_KEY, JSON.stringify({ id: p.id, name: p.name })); } catch { /* private mode */ }
  }
  (function offerCredited() {
    let by: { id: string; name: string } | null = null;
    try { by = JSON.parse(sessionStorage.getItem(CREDITED_KEY) || 'null'); sessionStorage.removeItem(CREDITED_KEY); } catch { return; }
    if (!by?.id) return;
    const note = $('ph-credited');
    const more = h('button', { type: 'button', class: 'ph-credited-more', 'data-ph': by.id }, 'See more of their work');
    const close = h('button', { type: 'button', class: 'ph-credited-close', 'aria-label': 'Dismiss' }, '×');
    note.replaceChildren(h('span', {}, 'By ', h('em', {}, by.name)), more, close);
    note.hidden = false;
    more.addEventListener('click', () => { note.hidden = true; void openPhotographer(by!.id); });
    close.addEventListener('click', () => { note.hidden = true; });
  })();

  // /inspiration?ph=<id>: the share sheet's "More by …" lands here.
  {
    const params = new URLSearchParams(location.search);
    const ph = params.get('ph');
    if (ph) {
      params.delete('ph');
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
      void openPhotographer(ph);
    }
  }

  // The enlarged view: "More by …" under a credited reference.
  const lbMore = document.getElementById('lb-more');
  window.addEventListener('insp:lightbox', (e) => {
    if (!lbMore) return;
    const ref = data.refs.find((r) => r.id === (e as CustomEvent<{ id: string }>).detail?.id);
    const who = ref?.credit ? data.people.find((p) => p.id === ref.credit) : undefined;
    lbMore.hidden = !who;
    if (who) { lbMore.textContent = `More by ${creditLabel(who.name)}`; lbMore.dataset.ph = who.id; }
  });
  window.addEventListener('insp:lightbox-close', () => { if (lbMore) lbMore.hidden = true; });
  lbMore?.addEventListener('click', () => { if (lbMore.dataset.ph) void openPhotographer(lbMore.dataset.ph); });

  /* ── Who took these? ───────────────────────────────────────────────── */

  const credit = $('ph-credit');
  let picked = new Set<string>();

  function openCredit(refId: string) {
    const uncredited = data.refs.filter((r) => !r.credit);
    // One name often covers several, so the rest are offered too, the ones
    // that look like this one first. Only the tapped one starts ticked: a
    // look-alike guess is a suggestion, and a wrong credit is worse than none.
    const kin = new Set(data.similar.find((g) => g.includes(refId)) ?? []);
    picked = new Set([refId]);
    const rest = uncredited.map((r) => r.id).filter((id) => id !== refId);
    const order = [refId, ...rest.filter((id) => kin.has(id)), ...rest.filter((id) => !kin.has(id))];
    $('ph-credit-refs').replaceChildren(...order.map((id) => {
      const r = data.refs.find((x) => x.id === id)!;
      return h('li', {}, h('button', { type: 'button', 'data-ref': id, 'aria-pressed': String(picked.has(id)), 'aria-label': 'Include this reference' },
        h('img', { src: r.thumb, alt: '', loading: 'lazy' })));
    }));
    const everyone = [...data.people].sort((a, b) => Number(b.favourite) - Number(a.favourite) || a.name.localeCompare(b.name));
    $('ph-credit-people').replaceChildren(...everyone.map((p) => h('li', {}, h('button', { type: 'button', 'data-person': p.id }, p.name))));
    $('ph-credit-status').textContent = '';
    show(credit);
    setTimeout(() => $('ph-credit-input').focus(), 60);
  }
  $('ph-credit-refs').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-ref]');
    if (!b) return;
    const id = b.dataset.ref!;
    if (picked.has(id)) picked.delete(id); else picked.add(id);
    b.setAttribute('aria-pressed', String(picked.has(id)));
  });
  async function saveCredit(body: Record<string, unknown>) {
    if (!picked.size) { $('ph-credit-status').textContent = 'Pick at least one.'; return; }
    $('ph-credit-status').textContent = 'Saving…';
    const r = await act('credit', { refIds: [...picked], ...body });
    if (!r.ok) { $('ph-credit-status').textContent = r.error || 'That did not save.'; return; }
    rememberCredited(r.photographer);
    reloadKeepingPlace();
  }
  $('ph-credit-people').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-person]');
    if (b) void saveCredit({ id: b.dataset.person });
  });
  $('ph-credit-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const v = $<HTMLInputElement>('ph-credit-input').value.trim();
    if (v) void saveCredit(/^https?:/i.test(v) ? { link: v } : { name: v });
  });
  $('ph-credit-close').addEventListener('click', () => hide(credit));
  credit.addEventListener('click', (e) => { if (e.target === credit) hide(credit); });

  // The board's tiles: a credit opens its photographer, "Who?" asks. In the
  // capture phase, so the board's own handler (enlarge) never sees the tap.
  document.getElementById('board')?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const who = t.closest<HTMLElement>('.cell-who');
    const by = t.closest<HTMLElement>('.credit[data-ph]');
    if (!who && !by) return;
    e.stopPropagation();
    if (who) openCredit(who.dataset.ref!);
    else void openPhotographer(by!.dataset.ph!);
  }, true);

  /* ── Your own Instagram connection ────────────────────────────────── */

  const igc = $('ph-igc');
  function openConnect() {
    $('ph-igc-state').textContent = data.instagram ? `Connected as @${data.instagram.username}` : '';
    $('ph-igc-off').hidden = !data.instagram;
    $('ph-igc-status').textContent = '';
    (igc.querySelector('details') as HTMLDetailsElement).open = !data.instagram;
    show(igc);
  }
  $('ph-igc-open').addEventListener('click', openConnect);
  $('ph-ig-connect-here').addEventListener('click', openConnect);
  $('ph-igc-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = (id: string) => $<HTMLInputElement>(id).value.trim();
    $('ph-igc-status').textContent = 'Connecting…';
    const r = await api<{ username: string }>('/api/photographers/instagram-connect', { appId: v('ph-igc-app'), appSecret: v('ph-igc-secret'), token: v('ph-igc-token') });
    if (!r.ok) { $('ph-igc-status').textContent = r.error || 'That did not connect.'; return; }
    data.instagram = { username: r.username };
    for (const id of ['ph-igc-app', 'ph-igc-secret', 'ph-igc-token']) $<HTMLInputElement>(id).value = '';
    $('ph-igc-open').textContent = `Instagram: @${r.username}`;
    $('ph-igc-status').textContent = `Connected as @${r.username}`;
    // The open photographer's Instagram posts, now that they can be read.
    if (current) { renderHead(current); if (current.links.some((l) => l.kind === 'instagram')) { $('ph-find').hidden = true; void loadWork(current.id, true); } }
    setTimeout(() => hide(igc), 900);
  });
  $('ph-igc-off').addEventListener('click', async () => {
    await fetch('/api/photographers/instagram-connect', { method: 'DELETE' });
    data.instagram = null;
    $('ph-igc-open').textContent = 'Connect Instagram';
    $('ph-igc-off').hidden = true;
    $('ph-igc-state').textContent = '';
    $('ph-igc-status').textContent = 'Disconnected';
  });
  $('ph-igc-close').addEventListener('click', () => hide(igc));
  igc.addEventListener('click', (e) => { if (e.target === igc) hide(igc); });

  /* ── From your Instagram export ─────────────────────────────────────── */

  // Instagram can't be read, but your own data export can: who you save and
  // like most is a favourites list you didn't have to type. The export is
  // read on the Mac and not kept (api/photographers/instagram.ts).
  interface IgPerson { username: string; saved: number; liked: number; following: boolean; known: boolean }
  const ig = $('ph-ig');
  const igFile = $<HTMLInputElement>('ph-ig-file');
  let igPeople: IgPerson[] = [];
  const igPicked = new Set<string>();

  $('ph-ig-pick').addEventListener('click', () => igFile.click());
  igFile.addEventListener('change', async () => {
    const files = [...(igFile.files ?? [])];
    if (!files.length) return;
    shelfNote.hidden = false;
    shelfNote.textContent = 'Reading the export…';
    const fd = new FormData();
    for (const f of files) fd.append('files', f);
    let r: { ok: boolean; error?: string; people?: IgPerson[] };
    try { r = await (await fetch('/api/photographers/instagram', { method: 'POST', body: fd })).json(); }
    catch { r = { ok: false, error: 'The export could not be sent.' }; }
    igFile.value = '';
    if (!r.ok || !r.people) { shelfNote.textContent = r.error || 'That did not work.'; return; }
    shelfNote.hidden = true;
    igPeople = r.people;
    igPicked.clear();
    // Ticked to start: people you've saved from more than once.
    for (const p of igPeople) if (!p.known && p.saved >= 2) igPicked.add(p.username);
    renderIg();
    show(ig);
  });

  function igLine(p: IgPerson): string {
    return [p.saved && `${p.saved} saved`, p.liked && `${p.liked} liked`, p.following && 'following'].filter(Boolean).join(' · ');
  }
  function renderIg() {
    $('ph-ig-count').textContent = `${igPeople.length} people`;
    $('ph-ig-list').replaceChildren(...igPeople.map((p) => h('li', {},
      h('label', { class: `ph-ig-row${p.known ? ' known' : ''}` },
        h('input', { type: 'checkbox', 'data-ig': p.username, checked: p.known || igPicked.has(p.username), disabled: p.known }),
        h('span', { class: 'ph-ig-name' }, p.username),
        h('span', { class: 'ph-ig-line' }, p.known ? 'already here' : igLine(p)),
        h('a', { href: `https://www.instagram.com/${p.username}/`, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `Open ${p.username} on Instagram` }, '↗')),
    )));
    syncIgButton();
  }
  function syncIgButton() {
    const btn = $<HTMLButtonElement>('ph-ig-add');
    btn.textContent = igPicked.size ? `Add ${igPicked.size}` : 'Add';
    btn.disabled = !igPicked.size;
  }
  $('ph-ig-list').addEventListener('change', (e) => {
    const box = e.target as HTMLInputElement;
    const name = box.dataset.ig;
    if (!name) return;
    if (box.checked) igPicked.add(name); else igPicked.delete(name);
    syncIgButton();
  });
  $('ph-ig-add').addEventListener('click', async () => {
    if (!igPicked.size) return;
    $('ph-ig-status').textContent = 'Adding…';
    const r = await act('addMany', { instagram: [...igPicked] });
    if (!r.ok) { $('ph-ig-status').textContent = r.error || 'That did not work.'; return; }
    reloadKeepingPlace();
  });
  $('ph-ig-close').addEventListener('click', () => hide(ig));
  ig.addEventListener('click', (e) => { if (e.target === ig) hide(ig); });

  /* ── Photographers like these ──────────────────────────────────────── */

  const sug = $('ph-sug');
  let suggestions: Suggestion[] = [];

  function renderSuggestions(at: string | null) {
    $('ph-sug-when').textContent = at ? `Looked ${dateWords(at)}` : '';
    $('ph-sug-run').textContent = at ? 'Look again' : 'Look';
    $('ph-sug-list').replaceChildren(...suggestions.map((s) => h('li', { class: 'ph-sugcard', 'data-key': s.key },
      h('div', { class: 'ph-sug-thumbs' }, ...s.thumbs.map((t) => h('a', { href: t.url, target: '_blank', rel: 'noopener noreferrer', 'aria-label': 'Open the post' },
        h('img', { src: t.src, alt: '', loading: 'lazy', referrerpolicy: 'no-referrer' })))),
      h('div', { class: 'ph-sug-text' },
        h('a', { class: 'ph-sug-name', href: s.link.url, target: '_blank', rel: 'noopener noreferrer' }, s.name),
        h('span', { class: 'ph-sug-via' }, `${linkLabel(s.link)} · ${s.via}`),
        h('p', { class: 'ph-sug-reason' }, s.reason),
        s.traits.length ? h('p', { class: 'ph-sug-traits' }, s.traits.join(' · ')) : null),
      h('div', { class: 'ph-sug-actions' },
        h('button', { type: 'button', class: 'ph-pinbtn', 'data-fav': s.key }, 'Favourite'),
        h('button', { type: 'button', class: 'ph-textbtn', 'data-no': s.key }, 'Not for me')),
    )));
  }

  async function openSuggestions() {
    show(sug);
    const r = await api<{ at: string | null; items: Suggestion[] }>('/api/photographers/suggest');
    suggestions = r.items ?? [];
    renderSuggestions(r.at ?? null);
    if (!r.at) void runSuggestions();
  }

  let running = false;
  async function runSuggestions() {
    if (running) return;
    running = true;
    const status = $('ph-sug-status');
    const progress = $('ph-sug-progress');
    status.textContent = '';
    progress.hidden = false;
    $('ph-sug-run').setAttribute('disabled', '');
    try {
      const res = await fetch('/api/photographers/suggest', { method: 'POST' });
      const reader = res.body!.getReader();
      const dec = new TextDecoder();
      let buf = '';
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop() ?? '';
        for (const line of lines) {
          if (!line.trim()) continue;
          const msg = JSON.parse(line);
          if (msg.progress) {
            const { stage, done: n, total } = msg.progress;
            $('ph-sug-stage').textContent = total > 1 ? `${stage} · ${n} of ${total}` : stage;
