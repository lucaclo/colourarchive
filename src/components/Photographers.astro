  $('ph-like').addEventListener('click', () => void openSuggestions());
  $('ph-sug-run').addEventListener('click', () => void runSuggestions());
  $('ph-sug-list').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const fav = t.closest<HTMLButtonElement>('[data-fav]');
    const no = t.closest<HTMLButtonElement>('[data-no]');
    const key = fav?.dataset.fav ?? no?.dataset.no;
    const s = suggestions.find((x) => x.key === key);
    if (!s) return;
    const card = t.closest('.ph-sugcard');
