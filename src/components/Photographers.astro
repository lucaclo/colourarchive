---
// The photographers behind the inspiration board: a shelf of favourites, a
// sheet per photographer with their public work to pin from, "who took
// these?" for uncredited references, and photographers like your
// favourites. Server side in lib/photographers/; this is the board's half.
interface Props {
  favourites: { id: string; name: string; cover?: string }[];
  people: { id: string; name: string; favourite: boolean }[];
  refs: { id: string; thumb: string; credit?: string }[];
  /** Board references grouped by look (similar.ts clusters), to preselect
   *  likely companions when crediting one. */
  similar: string[][];
  /** Your own Instagram connection, if made (photographers/instagram-api.ts). */
  instagram: { username: string } | null;
}
const { favourites, people, refs, similar, instagram } = Astro.props;
// With no favourites yet, the people already credited on the board are the
// likeliest ones to follow: offered as one tap each, most credited first.
const creditCount = new Map<string, number>();
for (const r of refs) if (r.credit) creditCount.set(r.credit, (creditCount.get(r.credit) ?? 0) + 1);
const credited = favourites.length ? [] : people
  .filter((p) => creditCount.has(p.id))
  .sort((a, b) => creditCount.get(b.id)! - creditCount.get(a.id)!)
  .slice(0, 6);
---

<section class="ph-shelf" id="ph-shelf" aria-labelledby="ph-shelf-title">
  <header class="ph-shelf-head">
    <h2 id="ph-shelf-title">Photographers</h2>
    <button type="button" class="ph-textbtn" id="ph-like" hidden={!favourites.length} data-cmdk="Photographers like my favourites" data-cmdk-keywords="similar, suggest, discover">Like these</button>
  </header>
  <ul class="ph-row" id="ph-row">
    {favourites.map((f) => (
      <li>
        <button type="button" class="ph-card" data-ph={f.id}>
          <span class="ph-cover">{f.cover && <img src={f.cover} alt="" loading="lazy" />}</span>
          <span class="ph-name">{f.name}</span>
          <span class="ph-new" data-new={f.id} hidden></span>
        </button>
      </li>
    ))}
    <li>
      <button type="button" class="ph-card ph-addcard" id="ph-add-toggle" aria-expanded="false" aria-controls="ph-addrow" data-cmdk="Add a photographer" data-cmdk-keywords="follow, favourite, profile">
        <span class="ph-cover ph-plus" aria-hidden="true">+</span>
        <span class="ph-name ph-name-add">Add<span class="ph-name-more"> a photographer</span></span>
        <span class="ph-name ph-name-cancel">Cancel</span>
      </button>
    </li>
  </ul>
  <form class="ph-addrow" id="ph-addrow" hidden>
    <input id="ph-add-input" class="field" type="text" inputmode="url" autocomplete="off" placeholder="Profile link or name" aria-label="Profile link or name" />
    <button type="submit">Add</button>
    <button type="button" class="ph-textbtn" id="ph-ig-pick">From your Instagram export</button>
    <button type="button" class="ph-textbtn" id="ph-igc-open">{instagram ? `Instagram: @${instagram.username}` : 'Connect Instagram'}</button>
    <input id="ph-ig-file" type="file" accept=".zip,.json,application/zip,application/json" multiple hidden />
  </form>
  <p class="ph-note" id="ph-shelf-note" role="status" hidden></p>
  <p class="ph-credited" id="ph-credited" role="status" hidden></p>
  {!favourites.length && (
    <p class="ph-empty" id="ph-empty" aria-label={credited.length ? 'Photographers credited on your board' : undefined}>
      {!credited.length && 'Follow photographers you like to see their new work here.'}
      {credited.map((p) => (
        <button type="button" class="ph-chip" data-ph={p.id}>{p.name} <span>{creditCount.get(p.id)}</span></button>
      ))}
    </p>
  )}
</section>

<script type="application/json" id="ph-data" is:inline set:html={JSON.stringify({ people, refs, similar, instagram })} />

<!-- One photographer -->
<div class="ph-sheet" id="ph-sheet" hidden role="dialog" aria-modal="true" aria-labelledby="ph-name">
  <div class="ph-panel">
    <header class="ph-head">
