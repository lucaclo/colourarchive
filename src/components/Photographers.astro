            // so the way there is a button, not a sentence to act on.
            const go = h('button', { type: 'button', class: 'btn btn-sm' }, 'Add someone to the shelf');
            go.addEventListener('click', () => {
              hide(sug);
              $('ph-add-toggle').click();
              $('ph-shelf').scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
