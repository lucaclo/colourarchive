        <button type="button" class="ph-textbtn" id="ph-ig-connect-here" hidden>Connect Instagram to see their posts</button>
      </div>
      <form class="ph-inline" id="ph-linkrow" hidden>
        <input id="ph-link-input" type="url" inputmode="url" placeholder="Bluesky, Mastodon, Are.na, Flickr or a site" aria-label="Profile link" />
