---
// The one way between the archive's sections, identical on every page.
//
// This replaces five hand-rolled topbars that each listed the *other* pages —
// in a different order every time, with nothing marking where you were, and
// with Scout's own version able to reach only two of the four. Tabs navigate,
// they never act; Add & remove is a place too, but a utility one, so it sits
// beside the tabs as its own round button rather than as a fifth tab.
//
// Floats over content in the glass material (see `.tabbar` in global.css) and
// every page reserves `--tabbar-space` at its foot so nothing it owns hides
// underneath. Scrolling down minimises it to icons; scrolling up restores it.

export type Tab = 'archive' | 'inspiration' | 'scout' | 'book' | 'upload';
interface Props {
  current: Tab;
}
const { current } = Astro.props;

// The static publish carries only the archive and Scout — Inspiration, the
// book editor and upload write to disk and do not exist there.
const STATIC = import.meta.env.PUBLIC_STATIC === 'true';

const tabs: { id: Tab; href: string; label: string; icon: string; server?: boolean }[] = [
  {
    id: 'archive', href: '/', label: 'Archive',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 16.5 4.8-4.8a1.2 1.2 0 0 1 1.7 0l3.5 3.5 2.2-2.2a1.2 1.2 0 0 1 1.7 0l3.6 3.6"/><circle cx="15.5" cy="9.5" r="1.4"/>',
  },
  {
    id: 'inspiration', href: '/inspiration', label: 'Inspiration', server: true,
    icon: '<rect x="3.5" y="3.5" width="7.5" height="10" rx="1.8"/><rect x="13" y="3.5" width="7.5" height="6" rx="1.8"/><rect x="3.5" y="15.5" width="7.5" height="5" rx="1.8"/><rect x="13" y="11.5" width="7.5" height="9" rx="1.8"/>',
  },
  {
    id: 'scout', href: '/scout', label: 'Scout',
    icon: '<path d="M3 18.5h18"/><path d="M6.5 18.5a5.5 5.5 0 0 1 11 0"/><path d="M12 5v3M5.2 8.7l2 2M18.8 8.7l-2 2"/><path d="M8 21.5h8"/>',
  },
  {
    id: 'book', href: '/book', label: 'Book', server: true,
    icon: '<path d="M12 6.8C10 5.3 7.2 4.7 3.5 5v13.2c3.7-.3 6.5.3 8.5 1.8 2-1.5 4.8-2.1 8.5-1.8V5c-3.7-.3-6.5.3-8.5 1.8Z"/><path d="M12 6.8V20"/>',
  },
];
const shown = tabs.filter((t) => !(STATIC && t.server));
---

<nav class="tabbar" id="tabbar" aria-label="Sections">
  <div class="tabbar-tabs">
    {shown.map((t) => (
      <a class="tab" href={t.href} aria-current={t.id === current ? 'page' : undefined} data-section={t.id}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
        <span class="tab-label">{t.label}</span>
      </a>
    ))}
  </div>
  {!STATIC && (
    <a
      class="tabbar-add"
      href="/upload"
      aria-label="Add & remove photos"
      title="Add & remove photos"
      aria-current={current === 'upload' ? 'page' : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </a>
  )}
</nav>

<script>
  // Minimise on scroll down, restore on scroll up — the bar gives the
  // photographs the room while you are reading, and is back the instant you
  // reverse, which is the gesture that means "I want to go somewhere".
  // Pages with no document scroll (Scout's full-bleed map) never trigger it.
  const bar = document.getElementById('tabbar');
  if (bar) {
    let lastY = scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = scrollY;
      const dy = y - lastY;
      if (Math.abs(dy) < 6) return;
      bar.classList.toggle('compact', dy > 0 && y > 160);
      lastY = y;
    };
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    // Reaching the foot of a page means there is nothing left to give room
    // to — restore it, so the way onward is there when you arrive.
    addEventListener('scrollend', () => {
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) bar.classList.remove('compact');
    });
  }
</script>
