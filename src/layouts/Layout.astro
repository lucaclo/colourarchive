---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Third-party origins this page will contact almost immediately.
   *
   * Only worth naming for a page that certainly talks to them, and only a
   * handful: a preconnect opens a socket and holds it, so speculatively opening
   * several to hosts a page may not use costs more than it saves. Scout is the
   * case that earns it — the map cannot draw until a style, a sprite and a tile
   * have all come back from hosts the browser has never seen, and on a phone
   * that is a DNS lookup plus a TCP handshake plus a TLS negotiation standing
   * between a blank rectangle and a map.
   */
  preconnect?: string[];
  /**
   * A CSS colour string that seeds --accent for this page — see
   * `--accent`/`--accent-mix`/`--accent-hair` in global.css. Pages with a
   * natural colour signal (the archive's chapters, the inspiration board)
   * pass a representative hue computed server-side; pages with none (Scout —
   * there is no photograph behind it to draw a colour from) leave this unset
   * and --accent falls back to its global.css default (`= --fg`), same as
   * before this existed.
   */
  accent?: string;
}
const {
  title = 'Colour Archive',
  description = 'A photographic archive as one continuous scroll — grouped into chapters by dominant colour, ordered along the hue.',
  preconnect = [],
  accent,
} = Astro.props;
---

<!doctype html>
<html lang="en" style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- The palette is fixed; tell the UA so form controls, scrollbars and
         the pre-paint canvas match instead of flashing white. -->
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#100f0e" />
    <!-- iOS home-screen app (Add to Home Screen → standalone window) -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Colour Archive" />
    <!-- Fonts are self-hosted (@font-face lives in global.css). Preload the
         three faces that paint above the fold, so they start downloading with
         the stylesheet rather than after it: the cover title, the chapter
         titles, and the mono labels. The rest load on demand.
         Only Fraunces + JetBrains Mono are shipped in public/fonts (see
         README → Fonts) — the app has one typeface pairing, not several. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fraunces-italic-600-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fraunces-italic-500-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/jetbrains-mono-normal-400-latin.woff2" />

    {/* `crossorigin` is not optional here: every one of these is fetched by
        MapLibre as a CORS request, and a preconnect opened without it warms a
        different connection pool than the one the real request uses — so the
        handshake is paid twice and the hint is worse than nothing. */}
    {preconnect.map((href) => <link rel="preconnect" href={href} crossorigin />)}
  </head>
  <body>
    <slot />
    <div class="cursor-ring" id="cursor-ring" aria-hidden="true"></div>
    <script is:inline>
      // Custom cursor: a ring tinted to whatever --accent currently is (set
      // per-page/per-chapter elsewhere), difference-blended so it reads over
      // any background. Site-wide, since --accent is a global.css token every
      // page now carries. Skipped entirely on touch — nothing to follow there.
      (function () {
        if (matchMedia('(hover: none), (pointer: coarse)').matches) return;
        const ring = document.getElementById('cursor-ring');
        if (!ring) return;
        let raf = 0, mx = -100, my = -100;
        const move = () => { ring.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`; raf = 0; };
        addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY;
          ring.classList.add('show');
          if (!raf) raf = requestAnimationFrame(move);
        }, { passive: true });
        addEventListener('mouseleave', () => ring.classList.remove('show'));
        const HOVERABLE = 'a, button, .frame, [role="button"], input, textarea, select, .cs-seg, .spectrum-seg, .pr-seg';
        document.addEventListener('mouseover', (e) => { if (e.target.closest(HOVERABLE)) ring.classList.add('hover'); });
        document.addEventListener('mouseout', (e) => { if (e.target.closest(HOVERABLE)) ring.classList.remove('hover'); });
        addEventListener('mousedown', () => ring.classList.add('down'));
        addEventListener('mouseup', () => ring.classList.remove('down'));
      })();

      // iOS Safari never matches `:active` at all unless some ancestor has a
      // touch listener attached — a long-documented quirk, not a bug in any
      // one page's CSS. Every `:active` press-feedback rule in this app (the
      // photo grid, Inspiration's board and workbench, Scout's controls)
      // silently does nothing on an iPad without this one no-op listener.
      addEventListener('touchstart', () => {}, { passive: true });
    </script>
    <script is:inline>
      // Offline snapshot: register the service worker, then pre-cache every
      // image on the page so the archive is fully browsable offline after one
      // online visit. Only runs on a secure origin (https://…local or
      // localhost) — iOS refuses service workers otherwise.
      (function () {
        if (!('serviceWorker' in navigator)) return;

        // Resolve a `sizes` descriptor to the CSS length that applies at the
        // current viewport (the same "first matching condition wins, last
        // one is the default" the browser itself uses) — only `NNvw`/`NNpx`
        // tokens, which is all this app's own `sizes` attributes ever use.
        function resolveSizes(sizes) {
          const parts = sizes.split(',').map((s) => s.trim());
          for (const part of parts) {
            const m = part.match(/^(\(.*?\))\s+(.+)$/);
            if (!m) return part;
            if (matchMedia(m[1]).matches) return m[2];
          }
          return parts[parts.length - 1];
        }
        function lengthToPx(length) {
          const vw = length.match(/^([\d.]+)vw$/);
          if (vw) return (parseFloat(vw[1]) / 100) * innerWidth;
          const px = length.match(/^([\d.]+)px$/);
          return px ? parseFloat(px[1]) : null;
        }
        // The masonry grid's own `srcset` always lists all three derivative
        // widths (640/1280/2000w), but `sizes` caps its rendered width well
        // under what the 2000w tier is for — the grid never needs it, only
        // the lightbox does, at a `sizes` this function was never asked to
        // resolve because the lightbox's own `<img>` carries no `srcset`
        // until a photo is actually opened. So this only ever trims what the
        // *current* element could actually render: one candidate — the
        // smallest whose width covers the rendered size at this device's
        // pixel ratio — rather than every width the markup happens to list.
        function neededSrcsetUrls(el) {
          const candidates = (el.getAttribute('srcset') || '').split(',').map((part) => {
            const [u, w] = part.trim().split(/\s+/);
            return { u, w: w && w.endsWith('w') ? parseFloat(w) : null };
          }).filter((c) => c.u);
          const sizes = el.getAttribute('sizes');
          if (!sizes || candidates.some((c) => c.w == null)) return candidates.map((c) => c.u);
          const displayPx = lengthToPx(resolveSizes(sizes));
          if (displayPx == null) return candidates.map((c) => c.u);
          const neededPx = displayPx * (devicePixelRatio || 1);
          const sorted = [...candidates].sort((a, b) => a.w - b.w);
          const best = sorted.find((c) => c.w >= neededPx) || sorted[sorted.length - 1];
          return [best.u];
        }

        // A cheap, non-cryptographic fingerprint of the URL set this page
        // would warm — good enough to notice "this page's snapshot changed
        // since last time", which is all it is used for.
        function hashUrls(urls) {
          const s = [...urls].sort().join('\n');
          let h = 5381;
          for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
          return `${h.toString(36)}:${s.length}`;
        }

        function collectUrls() {
          const urls = new Set([location.pathname]);
          // srcset lives on <img> now (the <picture>/<source> wrapper was
          // dropped — every derivative is AVIF), but keep reading <source>
          // so any page still using one caches too.
          document.querySelectorAll('img[srcset], source[srcset]').forEach((s) => {
            neededSrcsetUrls(s).forEach((u) => { if (u && !u.startsWith('data:')) urls.add(u); });
          });
          document.querySelectorAll('img[src], [data-src]').forEach((el) => {
            const u = el.getAttribute('src') || el.getAttribute('data-src');
            if (u && !u.startsWith('data:')) urls.add(u);
          });
          // Fonts are ours now, so they belong in the snapshot too.
          document.querySelectorAll('link[rel="preload"][as="font"]').forEach((l) => {
            if (l.getAttribute('href')) urls.add(l.getAttribute('href'));
          });
          return urls;
        }

        window.addEventListener('load', async () => {
          try {
            const reg = await navigator.serviceWorker.register('/sw.js');
            const warm = () => {
              if (!navigator.onLine) return;
              const urls = collectUrls();
              const sw = navigator.serviceWorker.controller || reg.active;
              if (!sw) return;
              // Ask first whether this page's snapshot already matches what
              // was last completed here — a few dozen bytes — instead of
              // reaching straight for the full list. Only a mismatch (first
              // visit, or the archive actually changed) sends it.
              sw.postMessage({ type: 'WARM_SIG', sig: hashUrls(urls), path: location.pathname });
              lastUrls = urls;
            };
            let lastUrls = null;
            if (navigator.serviceWorker.controller) warm();
            else navigator.serviceWorker.addEventListener('controllerchange', warm, { once: true });
            navigator.serviceWorker.addEventListener('message', (e) => {
              const d = e.data || {};
              // A tagged run belongs to something else entirely (Scout's own
              // "save this area", currently) — not this page's automatic
              // per-load warm, and not this pill's business.
              if (d.tag) return;
              if (d.type === 'WARM_NEED_URLS') {
                const urls = lastUrls || collectUrls();
                const sw = navigator.serviceWorker.controller || reg.active;
                if (sw) sw.postMessage({ type: 'WARM', urls: Array.from(urls), sig: hashUrls(urls), path: location.pathname });
              }
              if (d.type === 'WARM_PROGRESS') offlineProgress(d.done, d.total);
              if (d.type === 'WARM_DONE') offlineDone(d);
            });
          } catch (err) { console.warn('[offline] service worker failed', err); }
        });

        // --- Offline status ------------------------------------------------
        // Caching a 69-photo archive over the LAN is hundreds of files and can
        // run for a minute or more. It used to happen in total silence and then
        // announce itself once, at the end — so there was no way to know
        // whether the iPad had a complete snapshot or you'd walked away too
        // early. Now it counts up while it works, and says when it's safe to go.
        let pill = null, pillHide = 0;
        function showPill(text, sticky) {
          if (!pill) {
            pill = document.createElement('div');
            pill.className = 'offline-pill';
            pill.setAttribute('role', 'status');
            pill.setAttribute('aria-live', 'polite');
            document.body.appendChild(pill);
            // Force a style flush, then reveal. requestAnimationFrame would be
            // the usual way to do this, but it does not fire in a background
            // tab — and caching the archive for offline is precisely the thing
            // you start and then switch away from. The pill would have been
            // created, never shown, and quietly removed by its own timer.
            void pill.offsetWidth;
            pill.classList.add('show');
          }
          pill.textContent = text;
          clearTimeout(pillHide);
          if (!sticky) pillHide = setTimeout(hidePill, 2600);
        }
        function hidePill() {
          if (!pill) return;
          const el = pill; pill = null;
          el.classList.remove('show');
          setTimeout(() => el.remove(), 600);
        }
        function offlineProgress(done, total) {
          if (total > 12 && done < total) showPill(`Saving for offline · ${done} / ${total}`, true);
        }
        function offlineDone(d) {
          // A full cache is the one ending that "Saved for offline" would be a
          // lie about, and the device cannot get out of it on its own — nothing
          // is evicted to make room. So it stays on screen and says how much of
          // the archive is actually on here, rather than fading out reassuringly.
          if (d.full) {
            showPill(`No room left · ${d.have} of ${d.total} saved`, true);
            return;
          }
          showPill(d.added > 0 ? 'Saved for offline' : 'Up to date offline');
        }
        // Viewing a cached snapshot with nothing behind it is a different state
        // from being live, and the archive looks identical either way. Say so.
        addEventListener('offline', () => showPill('Offline · showing your saved archive', true));
        // Reuse the pill rather than hiding it first — two overlapping elements
        // meant the stale "Offline" text sat on top of the new message.
        addEventListener('online', () => showPill('Back online'));

        if (!navigator.onLine) showPill('Offline · showing your saved archive', true);
      })();
    </script>
  </body>
</html>
