{
  "name": "Colour Archive",
  "short_name": "Colour Archive",
  "id": "/",
  "description": "A photographic archive as one continuous scroll — chapters by dominant colour, ordered along the hue.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "_orientation_note": "Deliberately unlocked. Locking to portrait meant the installed iPad app refused to rotate, so every landscape photograph was shown at half the height it could have been.",
  "orientation": "any",
  "background_color": "#100f0e",
  "theme_color": "#100f0e",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "_launch_note": "Chrome on a computer: focus-existing brings the open app window forward instead of opening a second one. The web+colour protocol is how /get and the archive's top bar open the installed app from a browser tab, since a plain link stays in the tab. related_applications lets those pages ask whether the app is installed.",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+colour",
      "url": "/?open=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/site.webmanifest"
    }
  ]
}
