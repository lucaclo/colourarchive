{
  "name": "colour-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A colour-ordered archive of your photographs.",
  "author": "lucaclo",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "export:static": "PUBLIC_STATIC=true astro build && echo '\\nStatic archive ready in dist/client — drag that folder onto Netlify Drop (app.netlify.com/drop).'",
    "preview": "node ./dist/server/entry.mjs",
    "manifest": "tsx scripts/build-manifest.ts",
    "reanalyze": "tsx scripts/reanalyze.ts",
    "backfill:genre": "tsx scripts/backfill-genre.ts",
    "backfill:clip": "tsx scripts/backfill-clip.ts",
    "backfill:palette": "tsx scripts/backfill-palette.ts",
    "deploy:site": "tsx scripts/deploy-site.ts",
    "drift": "tsx scripts/deploy-site.ts --check",
    "check:photos": "tsx scripts/check-photos.ts",
    "doctor": "tsx scripts/doctor.ts",
    "mobile": "tsx scripts/mobile.ts",
    "export:sequence": "tsx scripts/export-sequence.ts",
    "export:print": "tsx scripts/export-print.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "light-pollution": "tsx scripts/fetch-light-pollution.ts",
    "bright-stars": "tsx scripts/fetch-bright-stars.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "smoke": "node --import tsx --test tests/scout.smoke.ts",
    "canary:scout-photos": "node --import tsx --test src/lib/scout/sources/photo-client.canary.ts",
    "check": "astro sync && tsc --noEmit && tsx scripts/check-astro-scripts.ts",
    "lint": "eslint .",
    "match:bench": "tsx scripts/match-bench.ts",
    "floor:test": "tsx scripts/floor-test.ts",
    "app:build": "node desktop/build.mjs",
    "app": "electron .",
    "app:dist": "node desktop/build.mjs && electron-builder --mac"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@xenova/transformers": "^2.17.2",
    "astro": "^5.6.1",
    "earcut": "^3.2.4",
    "exif-reader": "^2.0.1",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^5.24.0",
    "sharp": "^0.34.1",
    "tz-lookup": "^6.1.25",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/culori": "^4.0.1",
    "@types/web-push": "^3.6.4",
    "astro-eslint-parser": "^3.0.0",
    "culori": "^4.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.9.0",
    "netlify-cli": "^27.5.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "sharp@0.32.6": true,
    "fsevents@2.3.3": true,
    "protobufjs@6.11.6": true,
    "@xenova/transformers@2.17.2": true,
    "onnxruntime-node@1.14.0": true
  },
  "build": {
    "appId": "com.lucaclo.colourarchive",
    "productName": "Colour Archive",
    "copyright": "Colour Archive",
    "directories": {
      "output": "desktop/dist",
      "buildResources": "desktop/resources"
    },
    "asar": false,
    "files": [
      "package.json",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/start.html",
      "desktop/server.mjs",
      "desktop/certs.cjs",
      "desktop/build/**/*",
      "public/fonts/**/*",
      "public/match-lr/**/*",
      "src/data/notable-photographers.json",
      "!node_modules/@xenova/transformers/.cache${/*}",
      "!node_modules/**/*.{md,map,ts,tsx}",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}${/*}",
      "!node_modules/@xenova/transformers/dist${/*}",
      "!node_modules/onnxruntime-node/bin/napi-v3/{linux,win32}${/*}",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/x64${/*}"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "desktop/resources/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "Scout uses your location to plan light where you are.",
        "NSMicrophoneUsageDescription": "Voice notes are written down on this Mac."
      }
    },
    "dmg": {
      "title": "Colour Archive",
      "artifactName": "Colour-Archive-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
